[{"number":1,"title":"الرب راعيَّ","tune":"HAMZA","meter":"8.7.8.7","key":"C","author":"مزمور ٢٣","composer":"—","chorus":"القرار","verses":[{"label":"١","chorus":true,"lines":["الرب راعيَّ فلا يعوزني شيء","في رَعٍ خُضْرٍ يُربِضُني","يردُّ نفسي إلى السَّبيل"]},{"label":"٢","lines":["إني آوي في ظلِّهِ التَّوافِح","ونارٌ في المَنطَقِ تُنوِّرُ لي","يُهيِّئُ لي مائدةً في وجه مُضايِقي"],"chorus":false},{"label":"٣","lines":["خيرٌ ورحمةٌ يتبعانني كلَّ يومي","وأُسكنُ في بيتِ الربِّ إلى مَدَى الأيام"],"chorus":false}],"id":"h0001"},{"number":2,"title":"أسبح للرب","tune":"MAYYA","meter":"8.8.8.8","key":"G","author":"مزمور ١٠٠","composer":"—","chorus":"القرار","verses":[{"label":"١","chorus":true,"lines":["أسبِحْ للربِّ كلَّ حين","ادخُلوا بابهِ بفرَح"]},{"label":"٢","lines":["اعلَمُوا أنَّ الربَّ هو الله","هو صَنَعَنا ونحن عملُه","نحن قَعْلُهُ ورَعْيَّتُه"],"chorus":false},{"label":"٣","lines":["ادخُلُوا بابه بشكرٍ وبابَه بتسبيح","اشكُروا له وسبِّحوا باسمِه"],"chorus":false}],"id":"h0002"},{"number":3,"title":"إليكم أرفع عيني","tune":"HAMZA","meter":"8.7.8.7","key":"D","author":"مزمور ١٢١","composer":"—","chorus":"القرار","verses":[{"label":"١","chorus":true,"lines":["إليكم أرفعُ عيني","إلى الجبالِ من أين يأتي العَوْن"]},{"label":"٢","lines":["إلهي يحفظُك من الشرّ","يحفظُ من كلِّ مساوئ"],"chorus":false},{"label":"٣","lines":["الشمسُ لا تضرَمك ولا القمرُ","من فوقِك يقعُ الضرُّ","الربُّ يحفظُك من كلِّ شرٍّ"],"chorus":false}],"id":"h0003"},{"number":4,"title":"ارحمني يا الله","tune":"DENVER","meter":"10.6.10.6","key":"Eb","author":"مزمور ٥١","composer":"—","chorus":"القرار","verses":[{"label":"١","chorus":true,"lines":["ارحَمْني يا اللهُ حسبَ رحمتِك","حسبَ كثرةِ رأفتِك امحُ معاصيَّ"]},{"label":"٢","lines":["أَكْرِمْني يا اللهُ بفمِكَ الصادق","وتُقَطِّرْ ماءَ الرحمةِ على مَشاكي"],"chorus":false},{"label":"٣","lines":["أَحْطِفْ بالحقِّ معاصيَّ","وتَطَهَّرْ من كلِّ آثام"],"chorus":false}],"id":"h0004"},{"number":5,"title":"السماوات تروي","tune":"MAYYA","meter":"8.8.8.8","key":"F","author":"مزمور ١٩","composer":"—","chorus":"القرار","verses":[{"label":"١","chorus":true,"lines":["السَّماواتُ تُرْوي","قَصْرَهُ العَدْلَ"]},{"label":"٢","lines":["أحكامُهُ على البَرايا","رأسُهُ مَجْدُكَ"],"chorus":false},{"label":"٣","lines":["يومَ يُشْرِقُ شمسُهُ تذهبُ وراءَها","وللجادةِ إِغَارٌ"],"chorus":false}],"id":"h0005"},{"number":6,"title":"اللهم اقتدت","tune":"HAMZA","meter":"8.7.8.7","key":"Bb","author":"مزمور ٩٠","composer":"—","chorus":"القرار","verses":[{"label":"١","chorus":true,"lines":["اللَّهُمَّ اقْتَدَمتَ ولن يزولَ","إنَّ صِهْرَ المتقدِّمِ يثبت"]},{"label":"٢","lines":["وأنتَ سكنتَ من قَبْلُ","من الأزلِ وإلى الأبد"],"chorus":false},{"label":"٣","lines":["فلا تَسَلَّكَ منكَ موتٌ ولا ضَيْع","ولن يرى خَديٌّ عنك وفى"],"chorus":false}],"id":"h0006"},{"number":7,"title":"أنت تعرفني","tune":"DENVER","meter":"8.8.8.8","key":"A","author":"مزمور ١٣٩","composer":"—","chorus":"القرار","verses":[{"label":"١","chorus":true,"lines":["أنتَ تعرفُني","تعرفُ مَضْجَعِي"]},{"label":"٢","lines":["تعرفُ قِفْلي وفكِّي","تعرفُ طُرُقي كلَّها"],"chorus":false},{"label":"٣","lines":["أنتَ تعرفُ كلَّ أفكاري","طُرُقي ليستْ عنكَ خفيَّة"],"chorus":false}],"id":"h0007"},{"number":8,"title":"يا رب سيدنا","tune":"HAMZA","meter":"8.7.8.7","key":"C","author":"مزمور ٨","composer":"—","chorus":"القرار","verses":[{"label":"١","chorus":true,"lines":["يا ربُّ سيّدُنا","ما أحدَ مثلَك في الجميع"]},{"label":"٢","lines":["في الصَّلَواتِ يأخذُ بَرَكَتَهُ","ومنْ بفمِكَ ينالُ القدرة"],"chorus":false},{"label":"٣","lines":["ملكٌ لا يُمسَكُ به ملكٌ","يحكمُ بما شاءَ في أجيالِنا"],"chorus":false}],"id":"h0008"},{"number":9,"title":"هللوا الله","tune":"MAYYA","meter":"4.4.4.10","key":"G","author":"مزمور ١٥٠","composer":"—","chorus":"القرار","verses":[{"label":"١","chorus":true,"lines":["هلِّلُوا اللهَ في تُرْبَتِه","سبِّحُوه في بسطِ قُوَّتِه"]},{"label":"٢","lines":["سبِّحُوه لأجلِ عَظائِمِه","لأنَّ عَظائِمَه عظيمةٌ جدًّا"],"chorus":false},{"label":"٣","lines":["هلِّلُوا اللهَ كلَّ ما ينفخُ به","كلَّ ما يتنفَّسُ به"],"chorus":false}],"id":"h0009"},{"number":10,"title":"إن كان لي إله","tune":"HAMZA","meter":"8.7.8.7","key":"D","author":"مزمور ٢٧","composer":"—","chorus":"القرار","verses":[{"label":"١","chorus":true,"lines":["إنْ كانَ لي إلهٌ يُعْتَنى بي","يسمعُ الربُّ صوتي"]},{"label":"٢","lines":["يحفظُني ويُميِّزُني","من الضِّيقِ ينقذُني"],"chorus":false},{"label":"٣","lines":["ففيَّ يَسْرٌ وعَجائِبُه","أقتربُ إلى اللهِ وأناجيه"],"chorus":false}],"id":"h0010"}]
