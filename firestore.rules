rules_version = '2';

// Hymn book backend: the whole world reads, only the signed-in admin writes.
// IMPORTANT: in Firebase console → Authentication → Settings, turn OFF
// user sign-up ("Create" action) after creating the admin account, so no
// one else can register. Deletion is disabled entirely — hymns are only
// ever created or updated from the app's Admin panel.
service cloud.firestore {
  match /databases/{database}/documents {
    // Shape check for the one public write path (app ratings). It keeps
    // anonymous visitors from using `feedbacks` as arbitrary document
    // storage while still accepting every field the app sends.
    function isValidFeedback() {
      let data = request.resource.data;
      return data.keys().hasOnly(['rating', 'category', 'comment', 'status', 'adminNotes', 'createdAt'])
        && data.rating is int
        && data.rating >= 1
        && data.rating <= 5
        && data.category is string
        && data.category.size() <= 64
        && data.comment is string
        && data.comment.size() <= 1000
        && data.status == 'pending';
    }

    match /hymns/{hymnId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }
    // Shared tombstone set for admin deletions. Readers must see it so
    // deleted hymns stay hidden on every device; only admins may write it.
    match /meta/deleted {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // App ratings submitted from "تقييم التطبيق". Visitors are anonymous on
    // the web build, so anyone may create a well-formed pending rating, but
    // only the signed-in admin can list, triage or delete them.
    match /feedbacks/{feedbackId} {
      allow create: if isValidFeedback();
      allow read, update, delete: if request.auth != null;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
