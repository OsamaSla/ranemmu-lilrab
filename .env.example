# Copy to .env.local and fill in from Firebase console → Project settings.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Comma-separated admin accounts allowed into الإدارة (falls back to the owner
# when unset). Must match the `isAdmin()` list in firestore.rules.
EXPO_PUBLIC_ADMIN_EMAILS=osama.sla@gmail.com
