  "verses_he": [
    {
      "label": "١",
      "lines": [
        "נַפְשִׁי קִרְבִי בְּכִסּוּף · אֶל־כִּסֵּא רַחֲמָיו",
        "שָׁם יֵשׁוּעַ לַתְּפִלָּה · מַקְשִׁיב בְּחַסְדּוֹ"
      ]
    },
    {
      "label": "٢",
      "lines": [
        "אַתָּה שֶׁהִבְטַחְתָּ לַיָּגֵעַ · מְנוּחָה עֲצוּמָה",
        "אֶקְרַב וְאֶתְבַּע · אֶת־הַבְטָחָתְךָ הָעֶלְיוֹנָה"
      ]
    },
    {
      "label": "٣",
      "lines": [
        "מִמַּשָּׂא עֲוֺנֹתַי וּמִן · לַחַץ אֹיְבָי",
        "אֲדֹנָי הָנִיחַ לִי כִּי · בָאתִי בְּעָנְיִי"
      ]
    },
    {
      "label": "٤",
      "lines": [
        "אֲדֹנָי הֱיֵה לִי מָגֵן · וּמַחֲסֶה חָזָק",
        "כִּי־טַעֲנָתִי בְּשַׁוְעִי · פִּדְיוֹנְךָ הַיָּקָר"
      ]
    },
    {
      "label": "٥",
      "lines": [
        "תַּמְהִירֵנִי הָאַהֲבָה · אֲשֶׁר נִגְלְתָה בַּצְּלָב",
        "בָּהּ הָיִיתִי בִּשְׁמֶךָ · קוֹרֵא וְאַתָּה תַּעֲנֶה"
      ]
    }
  ]
