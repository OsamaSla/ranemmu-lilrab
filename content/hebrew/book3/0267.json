  "title_he": "בַּחַיִּים הָאֵלֶּה אֶחְיֶה לְמִי שֶׁאָהַבְנִי",
  "verses_he": [
    {
      "label": "١",
      "lines": [
        "בַּחַיִּים הָאֵלֶּה אֶחְיֶה · לְמִי שֶׁאָהַבְנִי",
        "שִׂמְחוֹת לִבִּי תִּשְׁלַמְנָה · וְנַפְשִׁי תִּשְׁבֶּה",
        "בּוֹ מַה שֶּׁאֶחְפֹּץ · אַהֲבָה שֶׁלֹּא תִּכְלֶה",
        "יָזוּב לִי כְּנָהָר · וּמִמֶּנּוּ אֶשְׁאַב"
      ]
    },
    {
      "label": "٢",
      "lines": [
        "וְאִם אֶכָּשֵׁל יוֹם אֶחָד · בְּיֵאוּשׁ וּבְכִשָּׁלוֹן",
        "אֶשְׁכֹּחַ מִמְּךָ עֶזְרָה · כִּי אַתָּה תִקְוָתִי",
        "מַחֲסִי חֲסוּתְךָ · וּקְרָבִי בְּפִדְיוֹנְךָ",
        "תִּרְפָּא לִי כָּל־פֶּצַע · אֲדֹנָי וְאֵין זוּלָתְךָ"
      ]
    },
    {
      "label": "٣",
      "lines": [
        "אֲדֹנָי כְּמִיהַת לִבִּי · לִחְיוֹת בִּרְצוֹנְךָ",
        "וְאֶחְיֶה בֶּאֱמוּנָה · אֵלֵךְ בְּהַדְרָכָתְךָ",
        "טְבֹלֵנִי בַּשָּׁלוֹם · קַדְּשֵׁנִי בִּשְׁלֵמוּת",
        "כּוֹנְנֵנִי בִּצְעָדֶיךָ · בֶּאֱמֶת וְלֹא בְּמִלִּים"
      ]
    },
    {
      "label": "٤",
      "lines": [
        "אֲבָרֵךְ אֶת־שֵׁם אֲדֹנָי · אֶכְרַע בְּכָל־עֵת",
        "כִּי הוּא רְצוֹנִי · וְרֹעִי הַנֶּאֱמָן",
        "לֹא אֶבְקֵּשׁ זוּלָתוֹ · כִּי שִׂמְחָתִי רְצוֹנוֹ",
        "עֻזִּי וְתִפְאֶרֶת לִבִּי · תִּקְוָתִי אֵין זוּלָתוֹ"
      ]
    }
