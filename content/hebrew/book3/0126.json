  "title_he": "רָם וְלֹא־יִכּוֹף רֹאשִׁי בְּכָל־צָרָה",
  "verses_he": [
    {
      "label": "١",
      "lines": [
        "רָם אָנֹכִי לֹא יִכּוֹף רֹאשִׁי בְּכָל־צָרָה",
        "נוֹשֵׂא עֵינַי אֶל־הָאֵל הָאֲמִתִּי",
        "מְבַקֵּשׁ מִמֶּנּוּ יְשׁוּעָתִי בַּדֶּרֶךְ",
        "וְנִצְחוֹן הָרוּחַ בְּצָרָה סוֹבֶבֶת",
        "הוּא אוֹרִי יְשׁוּעָתִי וְרֵעִי"
      ]
    },
    {
      "label": "٢",
      "lines": [
        "מַבִּיט לְמַעְלָה אֶל־מְרוֹמֵי שָׁמַיִם",
        "דּוֹמֵם לֵאלֹהִים עֻזִּי וְתַנְחוּמִי",
        "מַאֲמִין בֵּאלֹהִים בְּכָל־צָרָה וָפֶגַע",
        "הוּא בְּחֶבְרָתִי עֶזְרָתִי וּמְאוֹרִי",
        "וְסוֹמְכִי בְּכָל־עֵת וְתִקְוָתִי"
      ]
    },
    {
      "label": "٣",
      "lines": [
        "וְתִקְוָתִי בֵּאלֹהַי לֹא תֵבוֹשׁ",
        "אַהֲבָתוֹ נָטְפָה וַאֲנִי בְּצִלּוֹ",
        "פָּעַל הַשָּׁלוֹם מַה־נָּאוּ פְעָלָיו",
        "בְּדָם יָקָר מָחָה פִּשְׁעִי וְטִהֵר",
        "אֵיךְ אַחֲרֵי רָחְצִי לֹא יִרְעֶה וְיָגֵן"
      ]
    },
    {
      "label": "٤",
      "lines": [
        "אַחֲרֵי אֹרֶךְ הַלַּיְלָה בֹּא יָבֹא אוֹר",
        "וְהַתְּקוּמָה אַחֲרֵי מָוֶת הִיא נִצָּחוֹן",
        "הוּא סוֹד הַיְקוּם וְהַמַּשּׂוּאָה",
        "וּמַפְגִּיעִי בְּכָל־עֵת אֲשֶׁר יָקוּמוּ צָרָי",
        "עָרֵב לַבְּרִית וּבַעַל הָעֵצָה"
      ]
    },
    {
      "label": "٥",
      "lines": [
        "נַפְשִׁי בּוֹ נוּחִי כִּי הוּא אֲדֹנָי",
        "מְנוּחָתִי בּוֹ וּמַה־תְּקַוֶּה לִבִּי",
        "שְׁבִי בְּחֶבְרַת אֵל הָאוֹהֵב",
        "בְּשֶׁקֶט וּבְבִטְחָה נֶחְמָדָה",
        "בְּבִטָּחוֹן אַהֲבָתוֹ אֶתֵּן לוֹ אַהֲבָתִי"
      ]
    }
  ]
