  "title_he": "אֲדוֹנִי הַפּוֹדֶה יֵשׁוּעַ יוֹצֵר הָעוֹלָמִים",
  "verses_he": [
    {
      "label": "١",
      "lines": [
        "אֲדוֹנִי הַפּוֹדֶה יֵשׁוּעַ · יוֹצֵר הָעוֹלָמִים",
        "וְנוֹתֵן הַשָּׁלוֹם · וְהַשִּׂמְחוֹת בַּצָּרוֹת",
        "אַתָּה עוֹשֶׂה הַשָּׁמַיִם · בּוֹרֵא הָאָדָם",
        "בִּפְדוּתְךָ לִי עָשִׂיתָ · בַּדָּם הַסְּלִיחָה",
        "לָכֵן יָמַי · אַהֲבָתִי וּשְׁחוֹתַי",
        "מַחְשְׁבוֹתַי תִּקְווֹתַי · אֲדֹנִי לְךָ",
        "אַתָּה אֱלֹהַי · מִבְצָרִי יְשׁוּעָתִי",
        "אַתָּה חַיָּתִי · אֵין זוּלָתְךָ"
      ]
    }
