{
  "book": "main",
  "number": 976,
  "title_he": "לִפְנֵי הַשּׁוֹפֵט בְּשָׁעַת הַמֹּאזְנַיִם",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "לִפְנֵי הַשּׁוֹפֵט בְּשָׁעַת הַמֹּאזְנַיִם",
        "תַּעֲמֹד הַחוֹטֵא יָרֵא וְנָבוֹךְ"
      ]
    },
    {
      "label": "2",
      "lines": [
        "יֹאמַר קָחוּהוּ וְאִסְרוּהוּ",
        "וְאֶל הַחֹשֶׁךְ מַהֵר הַשְׁלִיכוּהוּ"
      ]
    },
    {
      "label": "3",
      "lines": [
        "תִּחְיֶה נִקְלֶה לְעוֹלְמֵי עַד",
        "שָׁם הַבְּכִי וַחֲרֹק הַשִּׁנָּיִם"
      ]
    },
    {
      "label": "4",
      "lines": [
        "תֹּאמַר מִי יִתֵּן וְהִקְשַׁבְתִּי",
        "כַּמָּה קָרָא לִי אַךְ מֵאַנְתִּי"
      ]
    },
    {
      "label": "5",
      "lines": [
        "יֵשׁוּעַ קוֹרֵא לְךָ: בּוֹא נָא",
        "הַבֵּט בְּמַכְאוֹבַי וַעֲטֶרֶת הַקּוֹצִים"
      ]
    },
    {
      "label": "6",
      "lines": [
        "פּוֹרֵשׂ זְרוֹעוֹתָיו מַהֵר אֵלָיו",
        "קוֹרֵא לְךָ בְּשִׁמְךָ עֲנֵה לוֹ"
      ]
    },
    {
      "label": "7",
      "lines": [
        "טֶרֶם הַקָּלוֹן טֶרֶם הַיָּגוֹן",
        "אִם מַשְׂכִּיל אַתָּה שׁוּב עַתָּה"
      ]
    }
  ]
}
