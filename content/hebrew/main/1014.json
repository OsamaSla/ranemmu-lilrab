  "title_he": "בַּצְּלָב הָיִיתָ חָפֵץ לְהוֹשִׁיעַ",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "בַּצְּלָב הָיִיתָ חָפֵץ · לְהוֹשִׁיעַ הָאָשֵׁם",
        "בְּשָׂשׂוֹן בִּקַּשְׁתָּ לִפְדּוֹת · בַּדָּם הַזַּךְ הַנִּכְבָּד",
        "הָלַכְתָּ לְבַדְּךָ לְמַעֲנִי · עַל־גִּבְעַת גָּלְגָּלְתָּא",
        "נוֹשֵׂא הָעֹנֶשׁ בַּעֲדִי · זוֹרֵעַ בִּי הַחַיִּים"
      ]
    },
    {
      "label": "2",
      "lines": [
        "כָּל־יְגוֹנַי נָשָׂאתָ · מַכְרִיז אַהֲבָה יְחִידָה",
        "וּבְמַעֲשֶׂיךָ בָּרָאתָ · בְּקִרְבִּי לֵב חָדָשׁ",
        "דָּבַקְתָּ בְּנַפְשִׁי · עַד מַתָּ בַּצְּלָב",
        "וְהִשְׁלַכְתָּ כָּל־עֲוֺנִי · הוֹי לְאַהֲבָתְךָ הַנִּפְלָאָה"
      ]
    },
    {
      "label": "3",
      "lines": [
        "דּוֹדִי כַּמָּה מָצָאתָ · מִיָּדַי פְּצָעִים",
        "וּבִמְחִילָה קָרָאתָ · מְבַקֵּשׁ לִי הַסְּלִיחָה",
        "דּוֹדִי נִשְׂגַּבְתָּ · אֵין כָּמוֹךָ רַחוּם",
        "פֻּצַּעְתָּ לְמַעַן תְּחַבֵּשׁ · כָּל־פִּצְעֵי הָאָשֵׁם"
      ]
    },
    {
      "label": "4",
      "lines": [
        "בְּקָרְבִי אֵלֶיךָ · אֶזְכֶּה בְּטַל הַחֶמְלָה",
        "וּקְרִיאַת הָאַהֲבָה מִמְּךָ · הִיא לִי יַבֶּשֶׁת הַבֶּטַח",
        "כִּסִּיתָ לִי מוּמַי · וְסָלַחְתָּ לִי הָעֲוֺנוֹת",
        "וּמָחִיתָ לִי פְּשָׁעַי · וַיְמַלְּאֵנִי שָׁלוֹם"
      ]
    }
  ]
