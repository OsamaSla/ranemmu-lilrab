  "title_he": "הָשֵׁב עָלַי שִׂיחָה",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "הָשֵׁב עָלַי שִׂיחָה",
        "יֶעֱרַב לְאָזְנִי הֵדָהּ",
        "עַל אֲדֹנִי וְדוֹדִי",
        "וְרוֹחֲצִי בְּדָמָיו",
        "עַל צְבָאוֹ אֲשֶׁר נִרְאוּ",
        "וְרִנְּנוּ בַּחֹשֶׁךְ",
        "בִּכְבוֹד אֲדוֹן הַמְּרוֹמִים",
        "וּבִשְּׂרוּ אֶת־הַשָּׁלוֹם"
      ]
    },
    {
      "label": "2",
      "lines": [
        "הָשֵׁב עָלַי שִׂיחַת הַ־",
        "פּוֹדֶה הַנִּכְבָּד הַדּוֹד",
        "וְסַפֵּר וְשַׁנֵּן דְּבַר",
        "הַסֵּפֶר הֶעָרֵב הַנִּפְלָא",
        "עַל אֲדוֹן הַיְקוּם כַּאֲשֶׁר",
        "בָּא אֶל מְעוֹנוֹת הֶעָמָל",
        "וְהִתְהַלֵּךְ בָּהֶם בָּזוּי",
        "מֻצָּב לְמַטָּרָה לַפְּגָעִים"
      ]
    },
    {
      "label": "3",
      "lines": [
        "עַל צוֹמוֹ בַּמִּדְבָּרִיּוֹת",
        "חָשׂוּף לַמַּסּוֹת",
        "עַל נִצָּחוֹן שֶׁזָּכָה בוֹ",
        "עַל הָאוֹיֵב הַלּוֹחֵם",
        "עַל כָּל־צָרָה וּמְצוּקָה",
        "אֲשֶׁר סָבַל בֵּין בְּנֵי אָדָם",
        "עַל סַבְלָנוּתוֹ בְּיַצִּיבוּת",
        "לְנֹכַח כָּל־מְרִיבָה"
      ]
    },
    {
      "label": "4",
      "lines": [
        "הָשֵׁב עָלַי שִׂיחַת הַ־",
        "פּוֹדֶה הַדּוֹד הַנָּדִיב",
        "עַל אַהֲבָתוֹ וּפְדוּתוֹ",
        "לְכָל־פּוֹשֵׁעַ אָשֵׁם",
        "וְעַל חֶמְלָה וְרֹךְ",
        "לְכָל־סוֹבֵל חוֹלֶה",
        "וְכָל־מַעֲשֶׂה יָפֶה",
        "אֲשֶׁר גִּלָּה כְּלַפֵּי הַכֹּל"
      ]
    },
    {
      "label": "5",
      "lines": [
        "הָשֵׁב עָלַי שִׂיחַת הַ־",
        "פּוֹדֶה אֲשֶׁר מֵת בַּעֲדִי",
        "וְקָם בַּכָּבוֹד עַד",
        "אֶזְכֶּה עִמּוֹ בְּאִמּוּץ הַבָּנִים",
        "כִּי זֹאת מֵיטַב הַשִּׂיחָה",
        "יֶעֱרַב לְאָזְנִי הֵדָהּ",
