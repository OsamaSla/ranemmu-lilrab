  "title_he": "אֲדוֹנְךָ וַאֲדוֹנִי גָּדוֹל",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "אֲדוֹנְךָ וַאֲדוֹנִי גָּדוֹל",
        "חַיָּיו לֹא יִשְׁכָּחֵנוּ",
        "הָרַע לוֹ בַּשִּׁיר",
        "וּשְׂמַח כָּכָה עִמָּנוּ"
      ]
    },
    {
      "label": "1",
      "lines": [
        "הוֹדֵה וְהוֹסֵף הַתּוֹדָה",
        "כַּאֲשֶׁר הַמַּצָּבִים יִגְבְּרוּ",
        "אֲדוֹנְךָ בְּיָדוֹ הַדָּבָר",
        "וּמִן־הַמַּצָּבִים גִּבּוֹר"
      ],
      "chorus": true
    },
    {
      "label": "2",
      "lines": [
        "אֲדוֹנְךָ בְּיָדוֹ הַכֹּל",
        "אַל־תִּירָא וְאַל־תְּנַחֵשׁ",
        "לֹא יִשְׁכַּח וְלֹא יִמָּאֵס",
        "מְסֹר לוֹ וְשִׁקְטָה"
      ]
    },
    {
      "label": "3",
      "lines": [
        "אַל־תִּירָא מִן־הָאֵימוֹת",
        "וְאַל־תִּטָּרֵד בָּהֶן",
        "וְאַל־תִּתְלוֹנֵן עַל־הַמַּצָּבִים",
        "אֲדוֹנְךָ יַעֲבִירֵם"
      ]
    }
  ],
