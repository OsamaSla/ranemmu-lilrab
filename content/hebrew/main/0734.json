{
  "book": "main",
  "number": 734,
  "title_he": "עָרַכְתָּ לָנוּ שֻׁלְחָן",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "עָרַכְתָּ לָנוּ שֻׁלְחָן",
        "וַאֲנַחְנוּ בַּמַּעֲבָר",
        "אֶל בּוֹאֲךָ הַקָּרוֹב",
        "מַעְיַן הַשָּׂשׂוֹן"
      ]
    },
    {
      "label": "2",
      "lines": [
        "כָּאָדוֹן תַּרְאִישֵׁנוּ",
        "תַּנְהִיג קְהָלֵנוּ",
        "בְּרוּחֲךָ נַקְדִּישׁ",
        "סַלֵּי הַלֵּלֵנוּ"
      ]
    },
    {
      "label": "3",
      "lines": [
        "לְפָנֶיךָ אֲדֹנֵנוּ",
        "נִשְׁכַּח מָה סְבִיבֵנוּ",
        "נִזְכְּרֶךָ אֲשֶׁר הִקְרַבְ",
        "תָּ נַפְשְׁךָ בַּעֲדֵנוּ"
      ]
    },
    {
      "label": "4",
      "lines": [
        "יִשְׁפֹּעַ מִלִּבּוֹתֵינוּ הַ",
        "תּוֹדָה לְאַהֲבָתֶךָ",
        "נָרִיעַ כֻּלָּנוּ לָךְ",
        "לְגֹדֶל נְדִיבוּתֶךָ"
      ]
    }
  ]
}
