  "verses_he": [
    {
      "label": "1",
      "lines": [
        "בָּאִים אֵלֶיךָ, רִבּוֹן הָעוֹלָמִים",
        "אַתָּה שֶׁאָהַבְתָּנוּ",
        "נוֹדֶה לְּךָ, נִכְרַע לְפָנֶיךָ",
        "נַגִּישׁ לְּךָ כְּבוֹדֵנוּ",
        "נָשִׁיר לְּךָ, כִּי אַתָּה הוּא",
        "הַמְּחַיֶּה לָנוּ אֶת־רוּחוֹתֵינוּ",
        "וְאַתָּה הוּא הָרוֹעֶה אוֹתָנוּ",
        "אַף מְחַיֶּה תִּקְוָה בְּלִבֵּנוּ"
      ]
    },
    {
      "label": "1",
      "lines": [
