{
  "book": "main",
  "number": 733,
  "title_he": "בְּטַח וַדַּאי בַּמָּשִׁיחַ",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "בְּטַח וַדַּאי בַּמָּשִׁיחַ",
        "כִּי הוּא לַהַבְטָחָה נֶאֱמָן",
        "תִּחְיֶה בּוֹ נָח",
        "לֹא מְהוּמָה לֹא אֲנָחָה",
        "בִּיבֹשֶׁת הַנֶּפֶשׁ תִּמְצָא",
        "מִמֶּנּוּ שֶׁפַע וּרְוָיָה",
        "לֹא תַּאֲכְזֵב כִּי הוּא יַאֲזִין",
        "לִקְרִיאַת הַחַלָּשִׁים",
        "אִם רָצִיתָ הָעֵזֶר מִיָּד",
        "קוּם וְהִתְפַּלֵּל בַּעֲנָוָה",
        "לֹא יִסְבֹּל הָאֵל בְּהֶחְלֵט",
        "כָּל־עַצְמִי בָּרוּם",
        "בִּשְׁבִירַת הַנֶּפֶשׁ יְמַלֵּא",
        "כָּל־חִסָּרוֹן וְצֹרֶךְ",
        "אַף יַקִּיף הַלֵּב אוֹר",
        "וְשָׁלוֹם וְשִׂמְחָה",
        "בְּטַח וַדַּאי בַּמָּשִׁיחַ",
        "כִּי הוּא לַהַבְטָחָה נֶאֱמָן"
      ]
    }
  ]
}
