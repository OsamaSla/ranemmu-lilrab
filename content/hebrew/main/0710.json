{
  "book": "main",
  "number": 710,
  "title_he": "יֵשׁוּעַ פֶּלֶא בִּשְׁמוֹ",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "יֵשׁוּעַ פֶּלֶא בִּשְׁמוֹ",
        "נְדִיב בְּאַהֲבָתוֹ הַנִּפְלָאָה",
        "כִּי אֵין אִישׁ זוּלָתוֹ",
        "אֲהֵבָנוּ עַד הַצְּלָב"
      ]
    },
    {
      "label": "2",
      "lines": [
        "כִּי הָאֵל בָּא בַּבָּשָׂר",
        "וְשָׁכַן גַּם בֵּינֵינוּ",
        "וְהַחֶסֶד וְהָאֱמֶת כְּבָר",
        "הָיוּ בְּיֵשׁוּעַ לָנוּ"
      ]
    },
    {
      "label": "3",
      "lines": [
        "וּבוֹ כָּל־חֶסֶד",
        "נִרְאָה מֵהָאֵל לָנוּ",
        "כִּי הִנּוֹ אֲהֵבָנוּ",
        "רְחָצָנוּ מֵעֲוֺנֵנוּ"
      ]
    },
    {
      "label": "4",
      "lines": [
        "וְהוּא רַחוּם כֹּהֵן",
        "יָחוּס לַאֲשֶׁר כְּבָר נֻסָּה",
        "כִּי הִנּוֹ אֲהֵבָנוּ",
        "וְנַפְשׁוֹ כְּבָר נָתַן"
      ]
    },
    {
      "label": "5",
      "lines": [
        "וְהוּא יָשִׁיב נַפְשֵׁנוּ",
        "כִּי כָּל־עֵת יַפְגִּיעַ",
        "וְהַתּוֹדָה וְהַהַלֵּל לוֹ",
        "עִם הַשֶּׁבַח נָרִים"
      ]
    },
    {
      "label": "6",
      "lines": [
        "זֵכֶר שְׁמוֹ יִיטַב לָנוּ",
        "בּוֹ הַשָּׂשׂוֹן וְהַנֶּחָמָה",
        "בְּכָל־עֵת נְקַוֶּה",
        "בּוֹאוֹ מִן־הַשָּׁמַיִם"
      ]
    }
  ]
}
