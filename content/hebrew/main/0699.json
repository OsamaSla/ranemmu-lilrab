    {
      "label": "2",
      "lines": [
        "כָּל־אֲשֶׁר הָיוּ מַצָּבֵינוּ",
        "אוֹ סָעַר בָּנוּ יַמֵּנוּ",
        "אֵין פַּחַד בְּלִבּוֹתֵינוּ",
        "אַךְ תְּמִידִי שְׁלוֹמֵנוּ"
      ]
    },
    {
      "label": "3",
      "lines": [
        "כָּל־אֲשֶׁר קָרַב אוֹיְבֵנוּ",
        "מְנַסֶּה הַכְשָׁלָתֵנוּ",
        "מְחֻזָּק אֱמוּנָתֵנוּ",
        "וְכָכָה נִצְּחוֹנֵנוּ"
      ]
    },
    {
      "label": "4",
      "lines": [
