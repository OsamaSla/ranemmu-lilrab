  "verses_he": [
    {
      "label": "1",
      "lines": [
        "כָּל־אֲשֶׁר רָמוּ תִּקְווֹתֵינוּ",
        "אוֹ גָּדְלוּ מַטְּרוֹתֵינוּ",
        "מְקֻיָּם הַגָּעָתֵנוּ",
        "מֻבְטָח הַצְלָחָתֵנוּ"
      ]
    },
    {
      "label": "1",
      "lines": [
        "כִּי אֲנַחְנוּ יְכוֹלִים",
        "יֵשׁוּעַ מְנַצֵּחַ הַמָּוֶת",
        "בַּלֵּב יִחְיֶה לְמַעַן נִהְיֶה",
        "תָּמִיד בּוֹ יְכוֹלִים"
      ],
      "chorus": true
