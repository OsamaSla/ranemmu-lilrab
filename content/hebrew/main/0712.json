{
  "book": "main",
  "number": 712,
  "title_he": "הִנְנוּ אֲדוֹן הַיְּקוּם",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "הִנְנוּ אֲדוֹן הַיְּקוּם",
        "כְּבָר בָּאנוּ נְבַקֵּשׁ הַסְּגִידָה",
        "מִסָּבִיב לְפוֹדֵנוּ הַדּוֹד",
        "נוֹדֶה לְךָ עַל כָּל־נְדִיבוּת"
      ]
    },
    {
      "label": "2",
      "lines": [
        "כִּי הִנְּךָ בְּעַצְמוֹ",
        "בְּחַרְתָּנוּ מִנִּי נֶצַח",
        "וּבָא בִּמְלֹא הַזְּמַן",
        "מַשְׁלִים כָּל־הַמַּעֲשֶׂה"
      ]
    },
    {
      "label": "3",
      "lines": [
        "בַּעֲדֵנוּ כִּלָּה עַל הַצְּלָב",
        "וְהִשְׁלִים רְצוֹנֶךָ",
        "וְהֵשִׁיב כְּבוֹדְךָ הַבָּזוּז",
        "מַשְׁלִים חֶפְצֶךָ"
      ]
    },
    {
      "label": "4",
      "lines": [
        "וְאַתָּה הָרַחוּם",
        "שַׂמְתּוֹ עַל הַכֹּל",
        "הֲקִימוֹתוֹ מוֹשִׁיעַ",
        "וְרֹעֶה עַל הָעֵדֶר"
      ]
    },
    {
      "label": "5",
      "lines": [
        "בְּשִׁמְךָ אֲנַחְנוּ נִסְגֹּד",
        "מִלִּבֵּנוּ נַקְדִּישׁ הַשֶּׁבַח",
        "שׁוֹנִים תְּהִלָּתֶךָ",
        "אָבִינוּ וֵאלֹהֵינוּ"
      ]
    }
  ]
}
