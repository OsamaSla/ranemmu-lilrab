{
  "book": "main",
  "number": 869,
  "title_he": "אֶל בְּאֵר שֹׁמְרוֹן בָּאתִי לְבַדִּי",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "אֶל בְּאֵר שֹׁמְרוֹן בָּאתִי לְבַדִּי",
        "לְמַעַן אֲמַלֵּא כַּדַּי מַיִם",
        "וְאֶצְלָהּ פָּגַשְׁתִּי אֲדֹנִי",
        "וַיִּשְׁפֹּעַ בְּלִבִּי מֵי הַחַיִּים"
      ]
    },
    {
      "label": "1",
      "lines": [
        "שְׁפֹעַ בְּלִבִּי וּמַלֵּא חַיַּי",
        "כִּי רֵיק הָעוֹלָם נוֹרָא",
        "אַתָּה הַמָּן הַיּוֹרֵד מִן־הַשָּׁמַיִם",
        "וּמַלֵּא־נָא וְהַשְׂבַּע־נָא לִבִּי הַשָּׁפוּךְ"
      ],
      "chorus": true
    },
    {
      "label": "2",
      "lines": [
        "הָיִיתִי חוֹתֵר בַּחַיִּים לִדְבָרִים",
        "לֹא יַשְׂבִּיעוּ־נָא רְעָבוֹנִי הֶחָזָק",
        "אַךְ מָצָאתִי כִּי",
        "אֵין דּוֹמֶה לַאֲדֹנִי הַנֶּהְדָּר"
      ]
    },
    {
      "label": "3",
      "lines": [
        "רֵעִי הַיֵּרָאֶה כְּבָר נִמְשַׁכְתָּ",
        "מִן־הַחֵטְא וְאֵין מָנוֹס",
        "בּוֹא לְיֵשׁוּעַ כִּי הוּא",
        "יְבַקֵּשׁ כִּי יַעֲנִיקְךָ הַיְשׁוּעָה"
      ]
    }
  ],
  "chorus_he": "פְּזָמוֹן"
}
