{
  "book": "main",
  "number": 582,
  "title_he": "נֵר מֵאִיר לָנוּ בַּשְּׁבִיל",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "נֵר מֵאִיר לָנוּ בַּשְּׁבִיל",
        "דְּבָרְךָ הוֹי אֲדֹנֵנוּ",
        "נֶשֶׁק חַלָּשׁ מַרְפֵּא חוֹלֶה",
        "וְשַׁעַר יְשׁוּעָה לָנוּ"
      ]
    },
    {
      "label": "2",
      "lines": [
        "וְאִמְרְךָ מָתוֹק כְּנֹפֶת צוּפִים",
        "וּמָגֵן לָנוּ בַּמִּלְחָמוֹת",
        "בְּשׂוֹרַת טוֹב לְכָל־הָעֲבָדִים",
        "וְגִיל כָּל־הַלְּבָבוֹת"
      ]
    },
    {
      "label": "3",
      "lines": [
        "יַיִן שָׂשׂוֹן עֶרֶב גָּדוֹל",
        "מַאֲכָל וְרוּחַ הַחַיִּים",
        "וְתוֹרָתְךָ הַתְּמִימָה הַיְּשָׁרָה",
        "תַּרְאֶה לָנוּ דֶּרֶךְ הַהַצָּלָה"
      ]
    },
    {
      "label": "4",
      "lines": [
        "עֲנַק גַּרְגְּרוֹת וְכֶתֶר הַיֹּפִי",
        "יִשְׂמַח בּוֹ הַמַּאֲמִין",
        "כִּי אַתָּה אֲדֹנִי עֵין הַשְּׁלֵמוּת",
        "וִישַׁבְּחוּךָ הַלְּשׁוֹנוֹת"
      ]
    }
  ]
}
