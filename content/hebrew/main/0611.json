{
  "book": "main",
  "number": 611,
  "title_he": "אָבוֹא שְׁעָרֶיךָ",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "אָבוֹא שְׁעָרֶיךָ בְּתוֹדָה וּבִתְהִלָּה",
        "לְךָ אָרִיעַ אֲדֹנִי הַמָּשִׁיחַ",
        "אָשִׁיר: זֶה הַיּוֹם אֲשֶׁר עָשִׂיתָ",
        "וְאֶשְׂמַח בַּאֲשֶׁר פָּעַלְתָּ",
        "אָרִיעַ לְךָ מִי אֲשֶׁר הֶחֱיִיתַנִי",
        "אֲרַנֵּן לְךָ מִי אֲשֶׁר שִׂמַּחְתַּנִי",
        "אֲסַפֵּר בְּךָ, אַשְׁמִיעַ חַסְדֶּךָ",
        "וְכֹה אֲשַׁבֵּחַ אֶת־שְׁמֶךָ"
      ]
    }
  ]
}
