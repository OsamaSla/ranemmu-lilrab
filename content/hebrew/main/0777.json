      "lines": [
        "לָמָּה בָּאתָ אֲדֹנִי",
        "וְטָעַמְתָּ הָעִנּוּי הַזֶּה",
        "הַכָּל־זֶה בַּעֲדִי",
        "מָה וְאַיֵּה הַתְּשׁוּבָה",
        "מָסַרְתִּי נַפְשִׁי לְאַהֲבָתֶךָ",
        "עָבַרְתִּי דֶּרֶךְ מָרָה",
        "עַל הַצְּלָב פְּדִיתִיךָ",
        "וְאֵיךְ תִּשָּׁאֵר אָסִיר"
      ]
    },
    {
      "label": "1",
      "lines": [
        "הִנְנִי בָּא אֲדֹנִי",
        "בְּכָל־חֻלְשָׁתִי וַעֲוֺנִי",
        "בּוֹא שַׁנֵּה חַיַּי",
        "בּוֹא הַחֲלֵף עַבְדֶּךָ"
      ],
      "chorus": true
    },
    {
      "label": "2",
      "lines": [
        "אַל־תַּעַזְבֵנִי לְבַדִּי",
        "טֶרֶף לַחֹשֶׁךְ",
        "אֶסְבֹּל מָוֶת וַדַּאי",
        "אַיֵּה אֵפוֹא זֶה הַשָּׁלוֹם",
        "הִנְנִי עוֹמֵד וְדוֹפֵק",
        "וְהַאִם תַּעֲנֶה הַקְּרִיאָה",
        "הִנֵּה כָּל־דָּבָר הוּכַן",
        "קְרַב תִּזְכֶּה הַפְּדוּת"
      ]
    },
    {
      "label": "3",
      "lines": [
        "אֲדֹנִי הַשְׁלֵם יְשׁוּעָתִי",
        "הַכְנִיסֵנִי עֹמֶק הַמַּיִם",
        "הָכֵן דְּבָרְךָ בְּלִבִּי",
        "וְשִׂים חַיַּי תְּפִלָּה",
        "כְּבָשַׂי הֵם בְּיָדַי",
        "כְּבָשַׂי לֹא יֵחָטֵפוּ",
        "אַל־תִּירָא יוֹם תְּבוּסָה",
        "כִּי אִם נָפַלְתָּ תָּקוּם"
      ]
