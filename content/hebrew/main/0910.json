  "title_he": "לְךָ מָקוֹם לְךָ מָקוֹם",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "לְךָ מָקוֹם לְךָ מָקוֹם",
        "בְּלֵב הָאָב הַאֲמֵן כִּי לְךָ מָקוֹם",
        "שָׁמוּר בְּלִבּוֹ חָקוּק עַל־כַּפּוֹ",
        "מֵאָז לְךָ מָקוֹם",
        "הוּא מְחַפֵּשׂ אוֹתָךְ",
        "שׁוֹמֵעַ קוֹלוֹ קוֹרֵא לָךְ",
        "פּוֹתֵחַ לִבּוֹ מְקַבֵּל פָּנֶיךָ",
        "בּוֹא אֵלָיו בַּאֲשֶׁר בָּךְ",
        "כִּי בְּלִבּוֹ לְךָ מָקוֹם",
        "הַאֲמֵן כִּי לְךָ מָקוֹם"
      ]
    }
  ]
}
