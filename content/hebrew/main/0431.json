  "verses_he": [
    {
      "label": "1",
      "lines": [
        "עָרֵב לִי לָלֶכֶת בְּעִקְּבוֹת רוֹעִי",
        "שֶׁאֶמְעַט וְאֶסָּתֵר, לְמַעַן יוֹפִיעַ גּוֹאֵלִי"
      ]
    },
    {
      "label": "1",
      "lines": [
        "כִּי אַחֲרָיו עָרֵב לִי הַמַּהֲלָךְ",
        "פָּנָיו הַנְּעִימִים לְפָנַי",
        "שְׁמוֹ מִבְצָרִי וּמַחֲסִי",
        "בְּאִישׁוּתוֹ אֲנִי מְסֻפָּק"
      ],
      "chorus": true
