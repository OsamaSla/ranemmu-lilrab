  "title_he": "נְגִיעוֹתֶיךָ מְנַחֲמוֹת אוֹתָנוּ",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "נְגִיעוֹתֶיךָ מְנַחֲמוֹת אוֹתָנוּ",
        "כָּבוֹד כָּבוֹד פּוֹדֵנוּ",
        "וְנֹכְחוּתְךָ פֹּה אֲסָפַתְנוּ",
        "אַתָּה שִׂמְחָתֵנוּ וּמִשְׁאֲלוֹתֵינוּ"
      ]
    },
    {
      "label": "1",
      "lines": [
        "תּוֹדָה עַל שְׂמָחוֹתֶיךָ לָנוּ",
        "תּוֹדָה לָךְ",
        "כָּבוֹד לְךָ יָקָר עָלֵינוּ",
        "כָּבוֹד לָךְ",
        "כָּבוֹד כָּבוֹד הַלְלוּיָהּ"
      ],
      "chorus": true
    },
    {
      "label": "2",
      "lines": [
        "טֶרֶם נָרִיעַ הִתְפַּלַּלְנוּ",
        "מַגָּע בְּרוּחֲךָ יְחַיֵּנוּ",
        "גְּבוּרַת אַהֲבָתְךָ תַּאַסְפֵנוּ",
        "נָרִים בִּכְבוֹדְךָ פּוֹדֵנוּ"
      ]
    },
    {
      "label": "3",
      "lines": [
        "נָרִים וְנַעֲלֶה יָדֵינוּ",
        "רַחֵף בְּרוּחֲךָ שְׁבֵנוּ",
        "נָעִיד וְהָעָם יִשְׁמָעוּנוּ",
        "נְדַבֵּר וְיֵשׁוּעַ בָּנוּ"
      ]
    },
    {
      "label": "4",
      "lines": [
        "הַשְׁלֵם הַבְטָחָתְךָ פּוֹדֵנוּ",
        "מָתַי עֲנָנְךָ יְבוֹאֵנוּ",
        "הַשֶּׁבַח יִהְיֶה לוֹ מַשְׁמָעוּת",
        "כַּאֲשֶׁר תְּרוּעָתֵנוּ תְּכַסֵּנוּ"
      ]
    }
  ],
  "chorus_he": "פְּזָמוֹן"
