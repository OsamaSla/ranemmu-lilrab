{
  "book": "main",
  "number": 698,
  "title_he": "שָׁמַעְתִּי קוֹל דּוֹדִי",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "שָׁמַעְתִּי קוֹל דּוֹדִי",
        "וּכְבָר רָאִיתִי דָּמָיו",
        "וָאֹמַר מַה־לִּי וְלָזֶה",
        "כְּכָל־דָּבָר אֲשֶׁר אֶרְאֶה",
        "אַךְ דּוֹדִי רָאָנִי",
        "וּבִי הִקִּיפוּ יָדָיו",
        "הוֹי לְאַהֲבָה שָׁבַתְנִי",
        "כִּי כְבָר קִבַּלְתִּי פְּדוּתוֹ",
        "וְהַכֹּל הָיָה חָדָשׁ",
        "אֲדֹנִי מוֹרִי בַּצְּלָב",
        "הָיָה לְשׁוֹנִי חָדָשׁ",
        "אֶקְרָאֲךָ בוֹ דּוֹדִי"
      ]
    },
    {
      "label": "2",
      "lines": [
        "הָיִיתִי חַי אָסִיר",
        "מְעֻנֶּה בִּכְבָלַי",
        "לֹא אֵדַע אָנָה גּוֹרָלִי",
        "וּמָה גּוֹרַל קִיּוּמִי",
        "וְאוֹבֵד וַיָּבֹא אֵלַי",
        "הֱקִימַנִי מִשְּׁנָתִי",
        "הֵסִיר עֲוֺנִי פְּדָנִי",
        "וּכְבָר הֵאִיר נִצְחִי",
        "וְהַכֹּל הָיָה חָדָשׁ",
        "אֲדֹנִי מוֹרִי בַּצְּלָב",
        "וְהָיָה גִּילִי חָדָשׁ",
        "אֶחְיֵהוּ לְדוֹדִי"
      ]
    },
    {
      "label": "3",
      "lines": [
        "מִי אֵפוֹא יְשַׁלֵּם חוֹבוֹתַי",
        "וּמִי יְמַלֵּא לִבִּי",
        "לוּ צָלַלְתִּי בְּיַם עֲוֺנוֹתַי",
        "וְהָלַכְתִּי לְבַדִּי בְּדַרְכִּי",
        "זָנַחְתִּי אֲשֶׁר קְרָאַנִי",
        "אוֹ אָמַרְתִּי חָלִילָה לַאֲדֹנִי",
        "מִי זֶה יָמוּת מְקוֹמִי",
        "מִי זֶה יִשָּׂא עֲוֺנִי",
        "וְהַכֹּל הָיָה חָדָשׁ",
        "אֲדֹנִי מוֹרִי בַּצְּלָב",
        "וְהָיָה לִבִּי חָדָשׁ",
        "יִחְיֶה בּוֹ דּוֹדִי"
      ]
    }
  ]
}
