  "title_he": "נְגַדֵּל דַּם יֵשׁוּעַ הַשֶּׂה הַשָּׁחוּט",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "נְגַדֵּל דַּם יֵשׁוּעַ הַשֶּׂה הַשָּׁחוּט",
        "נִשְׁחַק בּוֹ הַשָּׂטָן וּנְשַׁלַּח הַנְּפָשׁוֹת",
        "זְרוֹעַ הָאָדוֹן רָמָה וְיָדוֹ גִּבּוֹרָה",
        "נְגַדֵּל דַּם יֵשׁוּעַ הַשֶּׂה הַשָּׁחוּט"
      ]
    },
    {
      "label": "2",
      "lines": [
        "נְשַׁבֵּחַ שֵׁם יֵשׁוּעַ אֲשֶׁר פָּדָה נַפְשׁוֹתֵינוּ",
        "נְגָרֵשׁ בּוֹ הַשָּׂטָן מִלְּפָנֵינוּ",
        "כָּבוֹד לִשְׁמוֹ כִּי הוּא יְשׁוּעָתֵנוּ",
        "נָרִים הַדְּגָלִים וְנַכְרִיז נִצְחוֹנֵנוּ"
      ]
    },
    {
      "label": "3",
      "lines": [
        "יָדַיִם טְהוֹרוֹת נָרִים לַשָּׁמַיִם",
        "נְכַבֵּד אוֹתוֹ וְיִשְׁלַם שִׂמְחָתֵנוּ",
        "נָרִיעַ וְנֶחֱזַק עַל אוֹיְבֵינוּ",
        "וּבְעֹז נִצְחוֹנֵנוּ בַּאֲשֶׁר אֲהֵבָנוּ"
      ]
    }
  ]
