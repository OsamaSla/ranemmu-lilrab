{
  "book": "main",
  "number": 853,
  "title_he": "יְשַׁלַּח לִבִּי בְּךָ תְּהִלָּה",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "יְשַׁלַּח לִבִּי בְּךָ תְּהִלָּה",
        "וְתַבִּיעַ שְׂפָתִי שֶׁבַח",
        "אַהֲבָתְךָ תִּשְׁבֶּה כָּל־הֲוָיָתִי",
        "לֹא אֶרְצֶה זוּלָתְךָ מָשִׁיחַ"
      ]
    },
    {
      "label": "2",
      "lines": [
        "כֻּלְּךָ מָתוֹק מַחֲמַדִּים",
        "וּדְבָרְךָ דְּבַשׁ וְחַיִּים",
        "אֶתֵּן לְךָ מַפְתְּחוֹת לְשׁוֹנִי",
        "לְמַעַן תִּמְתַּקְנָה בְּךָ הַמִּלִּים"
      ]
    },
    {
      "label": "3",
      "lines": [
        "אֵין שְׁלֵמוּת בִּלְתִּי אִם מִמְּךָ",
        "אֵין יֹפִי יִרְחַק מִמְּךָ",
        "כָּל־אֲשֶׁר עָלוּ בְּךָ שִׁירַי",
        "תִּשָּׁאַרְנָה מִדּוֹת לֹא תְסֻפַּרְנָה"
      ]
    },
    {
      "label": "4",
      "lines": [
        "קָרְבֵנִי מִמְּךָ לְמַעַן אֶשָּׁאֵר",
        "לְצִדְּךָ מַעְיָנִי הַזַּךְ",
        "עַצְמְךָ נוֹשֵׂא הָאֱמוּנָה",
        "בְּךָ לְבַדְּךָ לַכָּבוֹד אֶעֱלֶה"
      ]
    }
  ]
}
