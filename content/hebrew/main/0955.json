{
  "book": "main",
  "number": 955,
  "title_he": "הָיִיתִי בְּסֹהַר הַחַטָּאִים",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "הָיִיתִי בְּסֹהַר הַחַטָּאִים",
        "עֶבֶד הַשָּׂטָן הָרָגוּם",
        "בִּלְתִּי מְקֻוֶּה יְשׁוּעָתִי",
        "אָז הוֹשִׁיעַנִי הָרַחוּם",
        "וַיִּקְנֵנִי וַיִּקְנֵנִי",
        "הַהוּא בַּדָּם הַנִּכְבָּד"
      ]
    },
    {
      "label": "2",
      "lines": [
        "לֹא שִׁלֵּם בַּכֶּסֶף חוֹבִי",
        "הַפּוֹדֶה הַגָּדוֹל הַהוּא",
        "כִּי אִם פְּדָנִי בְּדָמוֹ",
        "מֵעִנּוּיֵי הַשְּׁאוֹל",
        "וַיִּקְנֵנִי וַיִּקְנֵנִי",
        "הַהוּא בַּדָּם הַנִּכְבָּד"
      ]
    },
    {
      "label": "3",
      "lines": [
        "כִּי אֵין אֲנִי לְעַצְמִי",
        "אֵין לִי דָּבָר פֹּה",
        "כָּל־אֲשֶׁר אֶצְלִי לְפוֹדֶה הַ",
        "בְּרִיאָה נוֹתֵן הַמִּשְׁאֲלוֹת",
        "כִּי פְּדָנִי כִּי פְּדָנִי",
        "הַהוּא בַּדָּם הַנִּכְבָּד"
      ]
    },
    {
      "label": "4",
      "lines": [
        "הִנְנִי אֲבַלֶּה זְמַנִּי",
        "מְשָׁרֵת הָאָדוֹן הַנֶּאֱמָן",
        "מוֹסֵר גְּוִיָּתִי וְרוּחִי",
        "וְכֹחוֹת שִׂכְלִי הַיָּקָר",
        "כִּי פְּדָנִי כִּי פְּדָנִי",
        "הַהוּא בַּדָּם הַנִּכְבָּד"
      ]
    }
  ]
}
