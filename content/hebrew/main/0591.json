{
  "book": "main",
  "number": 591,
  "title_he": "הִנֵּה תְּפִלַּת הַתְּשׁוּבָה בִּשְׂפָתַי",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "הִנֵּה תְּפִלַּת הַתְּשׁוּבָה בִּשְׂפָתַי",
        "וּזְעָקָה מֵעֹמֶק הַמֵּעַיִם",
        "תִּתְפּוֹצֵץ תִּתְלַהֵט לַהַב",
        "תִּתְפַּשֵּׁט בְּכָל־הַמֶּרְחַבִּים"
      ]
    },
    {
      "label": "2",
      "lines": [
        "הוֹי אֱלֹהַי קְרָאתִיךָ הוֹשִׁיעֵנִי",
        "הַבְרִיאֵנִי וּרְפָאֵנִי מִן־הַחֹלִי",
        "שָׂטָן קְשָׁרַנִי בִּכְבָלִים",
        "וַעֲשָׂאַנִי עֶבֶד הַדְּבָרִים",
        "שְׁבֹר נָא עָקְצוֹ אֲדֹנִי",
        "מִי כָמוֹךָ יַעֲנִיק לִי פְּדוּת"
      ]
    }
  ]
}
