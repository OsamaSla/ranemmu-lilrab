      "chorus": true
    },
    {
      "label": "1",
      "lines": [
        "חָיִיתִי יָהִיר",
        "אֶל הָעוֹלָם מָשׁוּךְ",
        "וְהַשָּׂטָן מַטְּרָתוֹ הַרְחָקָתִי",
        "מִדֶּרֶךְ הָאוֹר"
      ]
    },
    {
      "label": "2",
      "lines": [
        "בָּאתִי אֵלָיו בְּלֵב נִשְׁבָּר",
        "וּדְמָעוֹתַי עַל־הַלְּחָיַיִם",
        "טִהֵר לִבִּי וְשִׁנָּה מַצָּבִי",
        "וְשִׁלֵּם כָּל־הַחוֹב"
      ]
    },
    {
      "label": "3",
      "lines": [
        "אָמַר לִי: שָׂמַחְתִּי בְּךָ",
        "כָּל־אֲשֶׁר לִי לְךָ הוּא",
        "אוֹצָרוֹת צְפוּנִים בַּקֵּשׁ אוֹתָם",
        "הִנֵּה הַמַּפְתְּחוֹת בְּיָדֶיךָ"
      ]
    }
