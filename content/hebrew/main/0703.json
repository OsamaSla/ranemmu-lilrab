{
  "book": "main",
  "number": 703,
  "title_he": "אֵין שֵׁם יִיטַב זִכְרוֹ",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "אֵין שֵׁם יִיטַב זִכְרוֹ",
        "כְּשֵׁם יֵשׁוּעַ הַמָּשִׁיחַ",
        "שְׁנוּהוּ הִנּוֹ",
        "כְּרֵיחַ הַבֹּשֶׂם יָפִיחַ"
      ]
    },
    {
      "label": "2",
      "lines": [
        "שִׂמְחַת הַלֵּב בּוֹ",
        "וְהַנֶּחָמָה וְהַשָּׁלוֹם",
        "שַׁבְּחוּהוּ הִנּוֹ",
        "בּוֹ כְּבָר חָלַף הַחֹשֶׁךְ"
      ]
    },
    {
      "label": "3",
      "lines": [
        "וְנָכוֹן דְּבָרֵנוּ",
        "בּוֹ וְהַסָּפֵק סָר",
        "פָּאֲרוּהוּ הִנּוֹ",
        "כָּל־חוֹבֵנוּ שִׁלֵּם"
      ]
    },
    {
      "label": "4",
      "lines": [
        "אֵינֶנִּי מְבַקֵּשׁ זוּלָתוֹ",
        "כִּי הוּא לִי טוֹב הַחֵלֶק",
        "הַלְלוּהוּ הִנּוֹ",
        "כְּבָר כִּלָּה בַּעֲדֵנוּ הַדּוֹד"
      ]
    },
    {
      "label": "5",
      "lines": [
        "עָבַר בְּאֶרֶץ הֶעָמָל",
        "מַרְאֶה כָּל־שְׁלֵמוּת",
        "גַּדְּלוּהוּ וְהָלְכוּ",
        "עִקְבוֹתָיו כִּי הוּא הַמּוֹפֵת"
      ]
    },
    {
      "label": "6",
      "lines": [
        "אֲשֶׁר הֻשְׁפַּל יָבוֹא",
        "עוֹד מְעַט בָּאֲוִיר",
        "וְהִתְאַזְּרוּ תַּגִּיעוּ הַ",
        "כָּבוֹד עִמּוֹ וְהָאֹשֶׁר"
      ]
    }
  ]
}
