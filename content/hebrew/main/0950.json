  "title_he": "נָרִים הַתְּרוּעָה לְפָנֶיךָ אֲדֹנָי",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "נָרִים הַתְּרוּעָה לְפָנֶיךָ אֲדֹנָי",
        "נָרִיעַ שְׂמֵחִים בְּךָ מֶלֶךְ",
        "נָרִים הַתְּרוּעָה לְפָנֶיךָ אֲדֹנָי",
        "מְרִימִים הַדְּגָלִים עָל",
        "כִּי קְנִיתָנוּ בְּדָמֶךָ",
        "עַם סְגֻלָּה יָרִים שִׁמְךָ",
        "לָכֵן נְרַנֵּן וְנָרִיעַ לָךְ",
        "מֶלֶךְ הַמְּלָכִים"
      ]
    }
  ]
