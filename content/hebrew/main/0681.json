  "title_he": "אַתָּה מַטְּרַת מַטְּרוֹת הַגִּיל",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "אַתָּה מַטְּרַת מַטְּרוֹת הַגִּיל",
        "אֲשֶׁר אֲנִי אֶחְיֵהוּ לְמַעַן אֲרַצֶּךָ",
        "אַתָּה דּוֹד אֲהוּבֵי הַלֵּב",
        "אֲשֶׁר אַתָּה מְלַכְתּוֹ וְנִשְׁאַר לָךְ"
      ]
    },
    {
      "label": "1",
      "lines": [
        "חַי מַכְרִיז בֵּין הָאֲנָשִׁים",
        "כִּי הַדָּם אֲשֶׁר פְּדָנִי יָקָר",
        "סוֹד יְשׁוּעָתִי וּבוֹ קִדּוּשִׁי",
        "וּדְמֵי כְּנִיסַת הַפְּדוּיִים"
      ],
      "chorus": true
    },
    {
      "label": "2",
      "lines": [
        "אֲשֶׁר רִפֵּאתָ הַנֶּפֶשׁ בְּפִצְעֶךָ",
        "כַּאֲשֶׁר שָׁפַכְתָּ הַדָּם שָׁם",
        "עַל הָעֵץ נָשָׂאתָ עֲוֺנוֹתַי",
        "וְנִשְׁאַר לִי מָקוֹם בִּשְׁמֶיךָ"
      ]
    },
    {
      "label": "3",
      "lines": [
        "כַּאֲשֶׁר אַבִּיט לִצְלָבְךָ יֵקַל",
        "בְּעֵינַי כְּבוֹדוֹת הַיְּקוּם",
        "וְאֶחְשֹׁב חֶרְפָּתְךָ הִיא עָשְׁרִי",
        "וְרֶוַח שְׁמֵימִי בְּךָ מֻבְטָח"
      ]
    },
    {
      "label": "4",
      "lines": [
        "לִבִּי שְׁבִיתוֹ בְּאַהֲבָתְךָ לִי",
        "וּמַה־יָּפְתָה הָעַבְדוּת עִמָּךְ",
        "זֹאת הַחֵרוּת וְזֹאת הַנִּצְחִיּוּת",
        "וְשִׂמְחַת הַכָּבוֹד תִּשָּׁלֵם שָׁם"
      ]
