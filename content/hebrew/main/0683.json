{
  "book": "main",
  "number": 683,
  "title_he": "עֲטַרְתּוֹ קְלוּעָה בַּקּוֹצִים בַּעֲדִי",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "עֲטַרְתּוֹ קְלוּעָה",
        "בַּקּוֹצִים בַּעֲדִי",
        "יֻדָּם בּוֹ מֵצַח",
        "עָלָה עַל נֹגַהּ הָאֲצִילוּת",
        "כְּבָר שָׂמוּהוּ יָדַיִם",
        "אֲשֵׁמוֹת לַחֶרְפָּה",
        "כֶּתֶר לְרֹאשׁ הַפּוֹדֶה",
        "אֲדוֹן הַשָּׁמַיִם הַצַּדִּיק"
      ]
    },
    {
      "label": "2",
      "lines": [
        "בַּחֶרְפָּה תִּרְצֶה בְּרָצוֹן",
        "וּמַכְאוֹב הַצְּלָב",
        "דָּמֶיךָ יָרוּצוּ טֹהַר",
        "לַסְּלִיחָה דּוֹדִי",
        "מַכְאוֹבֶיךָ הַגְּדוֹלִים",
        "יָקֵלּוּ הַמַּשָּׂאוֹת",
        "וְרוּחֲךָ הָרַחוּמָה",
        "תְּחַיֶּה בָּנוּ הַתִּקְווֹת"
      ]
    },
    {
      "label": "3",
      "lines": [
        "תַּחַת הַצְּלָב אֶכְרַע",
        "לְמַעַן אָרִים הַתְּפִלָּה",
        "מוֹשִׁיעִי פְּדָנִי",
        "בִּשְׁפִיכַת דָּמָיו",
        "יֵשׁוּעַ כְּבָר הִנְחָנִי",
        "בְּחֶשְׁכַת הַקִּיּוּם",
        "בִּצְלִיבָתוֹ הֶחֱיַנִי",
        "וְזָכִיתִי בַּנֶּצַח"
      ]
    }
  ]
}
