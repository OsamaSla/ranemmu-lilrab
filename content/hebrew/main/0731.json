{
  "book": "main",
  "number": 731,
  "title_he": "לִפְנֵי שֶׁבָּנָה הֶהָרִים",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "לִפְנֵי שֶׁבָּנָה הֶהָרִים",
        "אֲדֹנֵנוּ בַּעַל הַיְכֹלֶת",
        "לִפְנֵי שֶׁנָּטָה הַגְּבָעוֹת",
        "אוֹ שָׂם גְּבוּל הַיַּמִּים"
      ]
    },
    {
      "label": "2",
      "lines": [
        "הָיִיתָ תַּעֲנוּג הָאֵל",
        "נִמְצָא מִנִּי נֶצַח",
        "וְשִׁמְךָ הַחָכְמָה הוֹי",
        "אֲשֶׁר בְּךָ הַכֹּל פָּעַל"
      ]
    },
    {
      "label": "3",
      "lines": [
        "תַּעֲנוּג הָאָב הַנָּדִיב",
        "שִׂמְחַת הָאֵל הַגָּדוֹל",
        "וְכָכָה תַּעֲנוּגֶיךָ",
        "בִּבְנֵי אָדָם תִּשְׁכֹּן"
      ]
    },
    {
      "label": "4",
      "lines": [
        "פֶּלֶא לְתַעֲנוּגֶיךָ",
        "בְּחַטָּאִים חֵרְפוּךָ",
        "וְעַל עֵץ נוֹרָא",
        "הֱרִימוּךָ מִסְמְרוּךָ"
      ]
    },
    {
      "label": "5",
      "lines": [
        "פֶּלֶא בְּלִי גְּבוּלוֹת",
        "הָרָם הַנּוֹרָא",
        "כִּי תֹאמַר לָאָשֵׁם",
        "הִנְנִי הַפּוֹדֶה הַדּוֹד"
      ]
    },
    {
      "label": "6",
      "lines": [
        "נִכְרַע בָּאַהֲבָה לָךְ",
        "נִסְגֹּד לְעַצְמֶךָ",
        "הוֹי לִנְדִיבוּת הַחֶסֶד",
        "הוֹי לְגֹדֶל חַסְדֶּךָ"
      ]
    }
  ]
}
