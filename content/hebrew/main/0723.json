{
  "book": "main",
  "number": 723,
  "title_he": "הֲמוֹן צֶדֶק הָאֵל כְּבָר",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "הֲמוֹן צֶדֶק הָאֵל כְּבָר",
        "הִשְׁתִּיקוֹ אֶל הָעַד",
        "כַּאֲשֶׁר הֵצִיפוּ מְצוּלוֹתָיו",
        "עָלֶיךָ טוֹב הַמִּשְׁעָן"
      ]
    },
    {
      "label": "2",
      "lines": [
        "גַּלָּיו הִשְׁקַטְתָּם",
        "אֶל הַתֹּם הוֹי דּוֹד",
        "כִּי הָיִיתָ בַּעֲדֵנוּ מְמַלֵּא מָקוֹם",
        "בְּמוֹתְךָ עַל הַצְּלָב"
      ]
    },
    {
      "label": "3",
      "lines": [
        "לֹא הָיִיתָ אַתָּה הָאָשֵׁם",
        "אַךְ הָיִינוּ אֲנַחְנוּ הָאֲשֵׁמִים",
        "אַךְ נָשָׂאתָ הָעֹנֶשׁ",
        "בְּעַד הַחַטָּאִים הַחוֹטְאִים"
      ]
    },
    {
      "label": "4",
      "lines": [
        "הוֹי פֶּלֶא מֵחָכְמָה",
        "נִתְגַּוְּנָה בְּךָ נִרְאֲתָה",
        "שִׁלַּמְתָּ חֹק הַצֶּדֶק וְהַ",
        "חֶסֶד לָנוּ הֶרְאֵיתָ"
      ]
    },
    {
      "label": "5",
      "lines": [
        "אֵין דָּבָר מִמִּשְׁפָּט",
        "אֵפוֹא עַל אֲשֶׁר בָּךְ",
        "כִּי כָּל־מִשְׁפָּטֵנוּ",
        "כְּבָר נָפַל בְּפֹעַל עָלֶיךָ"
      ]
    },
    {
      "label": "6",
      "lines": [
        "וְהַתּוֹדָה נַקְדִּישְׁךָ עַל",
        "אַהֲבָתְךָ לְעֵבֶר הָאֲשֵׁמִים",
        "וְהַשֶּׁבַח וְהַהַלֵּל אֶל הַ",
        "דּוֹר וְדוֹר הַדּוֹרִים"
      ]
    }
  ]
}
