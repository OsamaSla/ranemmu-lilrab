{
  "book": "main",
  "number": 659,
  "title_he": "עֵינִי אֶל הַשֶּׂה הַזָּבוּחַ",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "פִּצְעֵי דוֹדִי יְקָרִים לִי",
        "עָשׂוּנִי אֶשְׂנָא כָּל־חֵטְא",
        "וְאֶכְסֹף מִלִּבִּי אֲשָׁרֵת אֲשֶׁר",
        "הֵיטִיב אֵלַי"
      ]
    },
    {
      "label": "2",
      "lines": [
        "עֵינִי אֶל הַשֶּׂה הַזָּבוּחַ",
        "הֲרִימֵנִי הֲרִימֵנִי בָּרוּחַ",
        "לְמַעַן אֲנַשֵּׁק סוֹד מַרְפְּאִי",
        "וְהֵם הַפְּצָעִים"
      ]
    },
    {
      "label": "3",
      "lines": [
        "לִבִּי מוּרָם אֶל הַנֶּצַח",
        "נִכְסָף אֶל הַמַּעֲמָד הַמַּזְהִיר",
        "וְאֶרְאֶה דוֹדִי וּצְלָמוֹ הַמָּתוֹק",
        "יְמַלֵּא עֵינִי"
      ]
    },
    {
      "label": "4",
      "lines": [
        "קוֹמַת דּוֹדִי כַּלְּבָנוֹן",
        "לֹא יִדְמֶה לוֹ כָּל־אָדָם",
        "מָלֵא עָלַי חַיַּי וְרוֹאֵהוּ",
        "בָּאֱמוּנָה"
      ]
    },
    {
      "label": "5",
      "lines": [
        "מְשִׁיחִי לִי מַחְסֶה וָעֹז",
        "עֶזְרִי בַּמְּצוּקוֹת וְאֵין לִי זוּלַת הוּא",
        "וּבְנֹגַהּ אַהֲבָתוֹ רוֹאֶה צַלְמִי",
        "בְּלִבּוֹ מִבִּפְנִים"
      ]
    }
  ]
}
