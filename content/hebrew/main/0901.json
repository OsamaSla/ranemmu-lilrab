  "title_he": "עוֹזְבִים הָעוֹלָם וַעֲמָלוֹ",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "עוֹזְבִים הָעוֹלָם וַעֲמָלוֹ",
        "עוֹזְבִים אוֹתוֹ בְּכַסְפּוֹ וּבַעֲפָרוֹ",
        "לֹא אֲנַחְנוּ מִמֶּנּוּ וְלֹא רֵעָיו",
        "יָבוֹא לָנוּ הַיּוֹם וְנַעַזְבֶנּוּ"
      ]
    },
    {
      "label": "1",
      "lines": [
        "הוֹי מוֹלַדְתֵּנוּ הַיְקָרָה עָלֵינוּ",
        "וְהַסַּבְלָנוּת נִכְסְפָה בְּעֵינֵינוּ",
        "מָתַי יֵשׁוּעַ תָּבוֹא אֵלֵינוּ",
        "הוֹי שָׁמֵינוּ הוֹי מְתוּקָה בֶּעָרִים"
      ],
      "chorus": true
    },
    {
      "label": "2",
      "lines": [
        "עוֹזְבִים הָעוֹלָם וְחַגָּיו",
        "לֹא יְשַׂמַּח לֵב וְלֹא בְּיָדוֹ",
        "נִשְׂמַח עִם אֲשֶׁר פְּדָנוּ",
        "וְהַיָּגוֹן שָׁם יִשְׁכָּחֵנוּ"
      ]
    },
    {
      "label": "3",
      "lines": [
        "הַסְּפִינָה הִנֵּה מַעֲבִירָה אוֹתָנוּ",
        "וְהַגַּל אִם עָלָה נוֹשֵׂא אוֹתָנוּ",
        "וְהַשִּׂמְחָה הַזֹּאת אֵינָהּ מְכִילָה אוֹתָנוּ",
        "הִנֵּה חֲתָנֵנוּ מְחַכֶּה לָנוּ"
      ]
    },
    {
      "label": "4",
      "lines": [
        "בַּשָּׁמַיִם נְרַנֵּן שְׂמֵחִים",
        "וְעַל הַכִּנּוֹרוֹת כֻּלָּנוּ מְנַגְּנִים",
        "וְעַל הַכִּסֵּא בְּתוֹכֵנוּ",
        "אֲדוֹן הָאֲדוֹנִים וּפוֹדֵנוּ"
      ]
    }
  ],
