{
  "book": "main",
  "number": 673,
  "title_he": "מָה לַשֶּׁמֶשׁ תַּסְתִּיר פָּנֶיהָ",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "מָה לַשֶּׁמֶשׁ תַּסְתִּיר פָּנֶיהָ",
        "מָה לַסֶּלַע יִזְרֹק הַלַּבָּה",
        "מָה לָרַעַם יִרְעַם קוֹצֵף",
        "אֲדוֹן הַטֶּבַע בַּמַּכְאוֹבִים"
      ]
    },
    {
      "label": "2",
      "lines": [
        "אֲנָחוֹת תְּדַמֵּינָה אַכְזְרֵי הַלְּבָבוֹת",
        "הֻשְׁלְכוּ עָלָיו כָּל־הָעֲוֺנוֹת",
        "צְעָקָה מִלֵּב יִסְבֹּל",
        "אֵלִי אֵלִי לָמָה עֲזַבְתָּנִי"
      ]
    },
    {
      "label": "3",
      "lines": [
        "אֵיזוֹ אַהֲבָה זֹאת אֲשֶׁר קְרָאַתְךָ",
        "בְּתוֹךְ הַמַּכְאוֹבִים תִּקְרָא רַחוּם",
        "סְלַח לָהֶם אָבִי כִּי הֵם",
        "לֹא יָדְעוּ מָה יַעֲשׂוּ"
      ]
    },
    {
      "label": "4",
      "lines": [
        "הוֹי צְלָב הַחֶרְפָּה הָיִיתָ לָנוּ",
        "פְּאֵר הַחַיִּים סֵמֶל כְּבוֹדֵנוּ",
        "כְּבָר רָצָה בְךָ בֶּן־הָאֵל",
        "לְמַעַן יַצִּילֵנוּ אֲנַחְנוּ הַחַטָּאִים"
      ]
    },
    {
      "label": "5",
      "lines": [
        "אֵיךְ נְשַׁלֵּם חוֹבֵנוּ הַגָּדוֹל",
        "אֶל מִי פְּדָנוּ עַל הַצְּלָב",
        "כְּבָר נִגֵּב דִּמְעֵנוּ הַשּׁוֹפֵעַ",
        "וּכְבָר מָחָה כָּל־קִינָה"
      ]
    }
  ]
}
