{
  "book": "main",
  "number": 808,
  "title_he": "אֲשֶׁר הָפַכְתָּ הַמְּרִירוּת",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "אֲשֶׁר הָפַכְתָּ הַמְּרִירוּת",
        "אֲשֶׁר בְּחַיַּי לִזְמִירוֹת",
        "גַּם חֻלְשָׁתִי וְאִוֶּלֶת לִבִּי",
        "לֹא מָנְעוּ הַחֲסָדִים",
        "כָּל־שְׁנִיָּה בְּגִילִי עָבְרָה",
        "לוּ תְּסַפֵּר תֹּאמַר הַרְבֵּה",
        "כָּל־דֹּפֶק בְּלִבִּי שָׁר",
        "אֶזְכֹּר לְךָ כָּל־טוֹב"
      ]
    },
    {
      "label": "1",
      "lines": [
        "אֶזְכֹּר לָךְ",
        "כָּל־טוֹב"
      ],
      "chorus": true
    },
    {
      "label": "2",
      "lines": [
        "חֲסָדֶיךָ כֶּתֶר וַעֲנָק",
        "עַל רֹאשִׁי וְעַל לִבִּי",
        "וְיַהֲלוֹם הַכֶּתֶר אֲשֶׁר מֵעַל",
        "הִנֵּה כֻּלּוֹ מוֹת הַצְּלָב אֲדֹנִי",
        "הִנֵּה אֲשֶׁר עָשַׂנִי אָבוֹא סוֹגֵד",
        "וְאָכֹף רֹאשִׁי וְאֹמַר קָטָן",
        "בַּצְּלָב אֲנִי הָיִיתִי מוֹצֵא",
        "בַּמָּשִׁיחַ טוֹב הַגּוֹרָל"
      ]
    },
    {
      "label": "3",
      "lines": [
        "לוּלֵא אֲחִיזַת יָדְךָ אַתָּה",
        "הָיִיתִי אֹבֵד עִם אֲשֶׁר אָבַד",
        "אֲנִי אֵינֶנִּי טוֹב מִן־אֲשֶׁר",
        "בָּגַד וְכִחֵשׁ וַאֲשֶׁר מָכַר",
        "לִבִּי חַיָּב לְךָ יָקָר",
        "וְגִילִי כֻּלּוֹ אֶחְיֶה אָסִיר",
        "חַסְדְּךָ חָמַל בְּמַצָּבִי",
        "וְיַשְׁלִים גִּבּוֹר"
      ]
    }
  ],
  "chorus_he": "פְּזָמוֹן"
}
