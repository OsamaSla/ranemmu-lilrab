  "title_he": "עַמְּךָ מַכְרִיז בְּךָ אֱמוּנָתוֹ",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "עַמְּךָ מַכְרִיז בְּךָ אֱמוּנָתוֹ",
        "וְאוֹחֵז בְּהַבְטָחוֹתֶיךָ",
        "אַתָּה רֹעֵנוּ וְכָל־אֲשֶׁר לָנוּ",
        "וּמַרְוֶה אוֹתָנוּ בְּטוּבֶךָ"
      ]
    },
    {
      "label": "1",
      "lines": [
        "עִמָּנוּאֵל, עִמָּנוּאֵל",
        "הָאֵל עִמָּנוּ"
      ],
      "chorus": true
    },
    {
      "label": "2",
      "lines": [
        "כָּל־אֲשֶׁר תִּכְבַּד מִלְחָמָה עָלֵינוּ",
        "הִתְגַּלּוּת רוּחֲךָ בְּקִרְבֵּנוּ",
        "כִּי אַתָּה לָנוּ וּמִי יַסְפִּיקֵנוּ",
        "זוּלָתְךָ אַתָּה פּוֹדֵנוּ"
      ]
    },
    {
      "label": "3",
      "lines": [
        "דְּבַר אֲמִתְּךָ מְלַמֵּד אוֹתָנוּ",
        "וְנֵר לְרַגְלֵינוּ",
        "רוּחֲךָ בָּנוּ וּמְנַחֵם אוֹתָנוּ",
        "וּמֵאִיר אֶת־עֵינֵינוּ"
      ]
    },
    {
      "label": "4",
      "lines": [
        "רוֹאִים עַל כַּפְּךָ אֶת־שְׁמוֹתֵינוּ",
        "חֲקוּקִים עַל יָדֶךָ",
        "וְהַנֹּגֵעַ בְּבָנֶיךָ אֲדֹנִי",
        "הִנּוֹ נוֹגֵעַ בְּבָבַת עֵינֶךָ"
      ]
    }
  ],
