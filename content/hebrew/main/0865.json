  "verses_he": [
    {
      "label": "1",
      "lines": [
        "הָרֵם לִבְּךָ לָרַחוּם",
        "בְּטַח בֵּאלֹהֶיךָ הוּא יִשְׁמֹר",
        "הָכֵן עֵינְךָ בֶּאֱמוּנָה",
        "כִּי אֱלֹהֶיךָ הוּא רַחוּם"
      ]
    },
    {
      "label": "1",
      "lines": [
        "הִנֵּה יֵשׁוּעַ יְמַלֵּא הַלֵּב בְּשִׂמְחָה",
        "יָדוֹ תְּרַפֵּא דְּאָגוֹתַי הַפּוֹצְעוֹת",
        "הַבְטָחָתוֹ כִּי לִי עוֹזֵר",
        "הוּא אֵל צַדִּיק וְנֶאֱמָן"
      ],
      "chorus": true
    },
    {
      "label": "2",
      "lines": [
        "יוּכַל יֹאחַז יָדְךָ שֵׁנִית",
        "וְיַעֲבִירְךָ עַל כָּל־מִבְצָרִים",
        "יְשַׂמַּח לִבְּךָ כָּל־אֲשֶׁר אִם הָיָה",
        "בּוֹ מַכְאוֹבִים וּמִלְחָמוֹת וַאֲנָחוֹת"
      ]
    },
    {
      "label": "3",
      "lines": [
        "גַּם אִם הָיָה הַשָּׂטָן סוֹעֵר",
        "אוֹ אִם הָיוּ בּוֹ חֲרָבוֹת וּבָתֵּי־סֹהַר",
        "כַּאֲשֶׁר תִּחְיֶה בְּחַיֶּיךָ בּוֹ",
        "כָּל־הַמְּגוּרִים עִמּוֹ יֵקַלּוּ"
      ]
    },
    {
      "label": "4",
      "lines": [
        "הַנַּח חַיֶּיךָ יָעִידוּ לוֹ",
        "בְּתוֹךְ הָעוֹלָם כָּל־אֲשֶׁר יִהְיֶה",
        "חְיֵה לֵאלֹהֶיךָ וְכֹן בּוֹ",
        "תּוּכַל תַּכְרִיעַ כָּל־מַחֲשָׁבוֹת"
      ]
    }
  ],
