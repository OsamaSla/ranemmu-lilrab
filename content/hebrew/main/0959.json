{
  "book": "main",
  "number": 959,
  "title_he": "חֲפֵצִים יָדְךָ תִּפְעַל",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "חֲפֵצִים יָדְךָ תִּפְעַל",
        "לְמַעַן הָעֲבוֹדָה תַּפְרֶה",
        "בְּגַעַתְךָ בַּלְּבָבוֹת",
        "מִיָּד כָּל־הָעָם יָשׁוּבוּ"
      ]
    },
    {
      "label": "1",
      "lines": [
        "וְגַע וְהַכְרֵז אוֹתְךָ",
        "נַחֲמֵנוּ בְּרוּחַ קָדְשֶׁךָ"
      ],
      "chorus": true
    },
    {
      "label": "2",
      "lines": [
        "רַבּוֹת דָּבָר אֲמַרְנוּהוּ",
        "וְהָעָם עוֹדָם חַטָּאִים",
        "הִנֵּה הַדָּבָר אֵינֶנּוּ עִיּוּנִים",
        "אֵלֶּה נְגִיעוֹת וְהַכְרָזוֹת"
      ]
    },
    {
      "label": "3",
      "lines": [
        "שָׁאוּל מִי עָשָׂהוּ",
        "שָׁבוּי בְּאַהֲבַת הָאֵל",
        "בְּהֵרָאוֹתְךָ לוֹ בָּרְאִיָּה",
        "גִּלִּיתָ לוֹ סוֹד הָאֱמוּנָה"
      ]
    },
    {
      "label": "4",
      "lines": [
        "לוּדְיָה בְּפִילִיפִּי",
        "נָגַעְתָּ בָּהּ אֲדֹנִי",
        "פָּתְחָה לִבָּהּ מִיָּד",
        "וַתְּקַבֶּלְךָ בֶּאֱמוּנָה"
      ]
    },
    {
      "label": "5",
      "lines": [
        "הַשֹּׁמְרוֹנִית שָׁם",
        "עַל הַבְּאֵר עִמָּךְ",
        "הִכְרַזְתָּ לָהּ חַטֹּאתֶיהָ",
        "וְהַלֵּב הִשְׁתַּנָּה בְּקִרְבָּהּ"
      ]
    },
    {
      "label": "6",
      "lines": [
        "פּוֹתֵחַ לָנוּ חֵיקֶיךָ",
        "מַכְרִיז לָנוּ חֶמְלָתֶךָ",
        "בְּבוֹא הַחוֹטֵא וְיָשׁוּב",
        "תִּסְלַח לוֹ כָּל־הַפְּשָׁעִים"
      ]
    }
  ],
  "chorus_he": "וְגַע וְהַכְרֵז אוֹתְךָ · נַחֲמֵנוּ בְּרוּחַ קָדְשֶׁךָ"
}
