  "verses_he": [
    {
      "label": "1",
      "lines": [
        "רִבּוֹנִי יֵשׁוּעַ הַיָּקָר",
        "אֵין אָהוּב מִבַּלְעָדָיו",
        "עִמּוֹ קַלָּה הַגָּלוּת",
        "וְיָקֵל מַשָּׂא הַצְּלָב"
      ]
    },
    {
      "label": "1",
      "lines": [
        "מַה־נָּעִים הַחֶבְרָה עִמּוֹ",
        "יֵשׁוּעַ, רִבּוֹן הַשָּׁמַיִם",
        "מְבָרֵךְ אֶת־הַחַיִּים",
        "וְהַחַיִּים מְתוּקִים עִמּוֹ",
        "אֲנִי חַי בְּמַחֲסֵהוּ"
      ],
      "chorus": true
    },
    {
      "label": "2",
      "lines": [
        "וּבְעֹז, נַפְשִׁי, רְדִי",
        "עַל כָּל־הַפִּתּוּיִים",
        "זֶה דּוֹדִי, חֶבְרָתוֹ מְתוּקָה",
        "כֻּלּוֹ חֶמְדוֹת"
      ]
    },
    {
      "label": "3",
      "lines": [
        "וְיִסּוּרַי בַּמִּדְבָּר",
        "אַף אִם רַבּוּ מְאֹד",
        "עַל זְרוֹעוֹת עוֹלָם",
        "הַשַּׁדַּי יִשָּׂאֵנִי"
      ]
    },
    {
      "label": "4",
      "lines": [
        "וְשִׂמְחַת עוֹלָם",
        "כִּדְבַר הַכָּתוּב",
        "כָּאן בְּחַיִּים נְעִימִים",
        "וְשָׁם בְּבֵית הָאָב"
      ]
    }
  ],
