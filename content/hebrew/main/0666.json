{
  "book": "main",
  "number": 666,
  "title_he": "הָעוֹלָם יִבְנֶה וְיִזְרַע",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "הָעוֹלָם יִבְנֶה וְיִזְרַע",
        "וְתָמִיד אֵינוֹ שָׂבֵעַ",
        "דַּאֲגָתוֹ יִלְבַּשׁ וְיִפְשֹׁט",
        "וְעַל יֵשׁוּעַ שׁוֹכֵחַ"
      ]
    },
    {
      "label": "1",
      "lines": [
        "אַךְ אֲנִי אֵינֶנִּי מִפֹּה",
        "הִנֵּה פֹּה עוֹלָם חוֹלֵף",
        "לֹא מָמוֹן וְלֹא גְדֻלָּה וְלֹא עֹשֶׁר",
        "אֲנִי לִי מוֹלֶדֶת אַחֶרֶת"
      ],
      "chorus": true
    },
    {
      "label": "2",
      "lines": [
        "הָעוֹלָם יָרוּץ וְיִגְעַע",
        "אַחַר אָדוֹן שְׁמוֹ הַמָּמוֹן",
        "וְזֶרַע הָרַע לֹא יַצְלִיחַ",
        "וְכָל־דָּבָר חוֹלֵף"
      ]
    },
    {
      "label": "3",
      "lines": [
        "נוֹשֵׂא דַּאֲגַת הַיָּמִים",
        "מָנוּעַ מִן־הַשָּׁלוֹם",
        "וּתְלוּנָה וְרֹב דִּבּוּר",
        "מִן־הַמְּצוּקָה וְהַמַּכְאוֹבִים"
      ]
    },
    {
      "label": "4",
      "lines": [
        "יִבְכּוּ עַל הַגּוֹרָל הַבּוֹגֵד",
        "אֵינוֹ בָּא עַל רְצוֹנָם",
        "חֲפֵצִים בָּעוֹלָם גַּנִּים",
        "וְהַגִּיל יְחַכֵּם"
      ]
    }
  ],
  "chorus_he": "פְּזָמוֹן"
}
