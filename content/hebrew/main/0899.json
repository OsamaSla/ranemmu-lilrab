{
  "book": "main",
  "number": 899,
  "title_he": "מִשְׁאֲלוֹתֵינוּ עִמְּךָ תִּתְקַיֵּמְנָה",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "מִשְׁאֲלוֹתֵינוּ עִמְּךָ תִּתְקַיֵּמְנָה",
        "עֲמָלֵנוּ בְּנִצָּחוֹן יֵעָלֵם",
        "הוֹלְכִים עִמְּךָ מַאֲמִינִים",
        "בְּהַבְטָחָתְךָ הַנִּפְלָאָה",
        "שְׂמָחוֹתֵינוּ הַיּוֹם תָּעֵדְנָה",
        "בֶּאֱמוּנָתֵנוּ בַּצַּדִּיק",
        "וְהָרוּחַ בְּקִרְבֵּנוּ תְּאַשֵּׁר",
        "מְנַצְּחִים מַכְאוֹבִים וּמְרוֹרִים",
        "וְחַיֵּינוּ מְלֵאִים שְׁלוֹמֶךָ",
        "שִׁלְטוֹנְךָ עִם דְּבָרֶךָ",
        "וַאֲנָחָה בַּלֵּב בּוֹרַחַת",
        "וּמְקוֹמָהּ יָבוֹא חֶמְלָתֶךָ"
      ]
    },
    {
      "label": "2",
      "lines": [
        "וּבְרוּחֲךָ בָּנוּ נִקְרָא",
        "בְּהַבְטָחוֹתֶיךָ לָנוּ פּוֹדֶה",
        "לִלְבָבוֹת בִּפְצָעִים אֲסוּרִים",
        "וְחַיִּים חַיִּים בּוֹכִים",
        "הִנֵּה בְּחֵיקְךָ כָּל־הַמְּנוּחָה",
        "חֵיקְךָ מָלֵא בֶּטַח",
        "וְאִם יָבוֹאוּ חִצֵּי פְּצִיעָה",
        "יִשָּׁאֵר לִבֵּנוּ שָׂמֵחַ",
        "וְתִשָּׁאֵר לָנוּ פּוֹדֵנוּ",
        "וּמַלְכֵּנוּ וּמְתוּק מִכֹּל אֲשֶׁר לָנוּ",
        "נִתֶּן־לְךָ חַיֵּינוּ כֻּלָּם",
        "וּנְשַׂמַּח לִבְּךָ בָּנוּ"
      ]
    }
  ]
}
