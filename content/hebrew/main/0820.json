  "title_he": "יֵשׁוּעַ נַכְתִּירְךָ נַכְרִיז מַלְכוּתְךָ",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "יֵשׁוּעַ נַכְתִּירְךָ נַכְרִיז מַלְכוּתְךָ",
        "בּוֹא עַתָּה בְּתוֹכֵנוּ",
        "וְיַעֲלֶה",
        "בְּתוֹךְ שִׁבְחֵנוּ",
        "יַעַבְדוּךָ לִבּוֹתֵינוּ",
        "יְרִימְךָ סְגֻדֵּנוּ",
        "יֶעֱרַב לְךָ תְּהִלָּתֵנוּ",
        "בּוֹא וְקַח כְּבוֹדֶךָ"
      ]
    }
  ]
}
