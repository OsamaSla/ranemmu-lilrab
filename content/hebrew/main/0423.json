  "title_he": "אֲנִי צָרִיךְ אוֹתְךָ, תְּטַפֵּל בִּי",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "אֲנִי צָרִיךְ אוֹתְךָ, תְּטַפֵּל בִּי",
        "מִפַּחְדִּי וְתִשְׁמְרֵנִי",
        "וְאֶקְרָא אֵלֶיךָ, תִּשְׁמְעֵנִי",
        "וּבְיָדֵיךָ תְּרִימֵנִי",
        "וְאָבוֹא אֵלֶיךָ בִּבְכִי",
        "בַּחֲלוֹמוֹתַי וְתַאֲווֹתַי",
        "תִּסְמְכֵנִי בְּכְאֵבַי",
        "וְתוֹלִיכֵנִי אֶל מִרְעֶה"
      ]
    },
    {
      "label": "2",
      "lines": [
        "וַאֲנִי כְּאֶקְרָא אֵלֶיךָ, מִיָּד אֶמְצָאֵךָ",
        "תִּשְׁלַח יָדְךָ וְתַדְרִיכֵנִי",
        "מֵעַל הַכְּאָבִים, עַל גֶּשֶׁר בִּטָחוֹן",
        "אַתָּה לוֹקְחֵנִי בְּחֵיקְךָ · וּמַגֵּנִי"
      ]
    }
  ]
}
