{
  "book": "main",
  "number": 794,
  "title_he": "עַל הַצְּלָב מַרְאֶה נִפְלָא",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "עַל הַצְּלָב מַרְאֶה נִפְלָא",
        "וְהַדָּם נוֹזֵל עַל הַצְּלָב",
        "לָמָּה דּוֹד וְהַחוֹב נוֹרָא",
        "תִּשָּׂא עָנְשִׁי לָמָּה דּוֹד"
      ]
    },
    {
      "label": "1",
      "lines": [
        "הוֹי יְפֵהפֶה עַל הַצְּלָב",
        "לֹא תֹאַר לְךָ וְלֹא הָדָר",
        "אַיֵּה הַיֹּפִי",
        "בִּי אָנִי אֵיךְ אָנִי"
      ],
      "chorus": true
    },
    {
      "label": "2",
      "lines": [
        "אֲנִי הָאָשֵׁם עֲוֺנִי גָּדוֹל",
        "וְלִבִּי מַטְעֶה וְאַתָּה הָרַחוּם",
        "אַהֲבָתְךָ חַמָּה דָּמְךָ נָדִיב",
        "וְהַצְּלָב קָשֶׁה וְהַמָּוֶת מַכְאִיב"
      ]
    }
  ],
  "chorus_he": "פְּזָמוֹן"
}
