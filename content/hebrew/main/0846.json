{
  "book": "main",
  "number": 846,
  "title_he": "אֶעֱזֹב הָעוֹלָם וּמְעַרְבֹּלוֹתָיו",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "אֶעֱזֹב הָעוֹלָם וּמְעַרְבֹּלוֹתָיו",
        "וְאָשִׂים הַמַּסָּע בַּאֲשֶׁר אֶתְיַחֵס",
        "וְרָחוֹק מֵהֲמוֹנִים רוֹעֲשִׁים",
        "בֵּין מַסְמְרֵי צְלָב אֶפֹּל",
        "וַאֲשׂוֹחֵחַ אֲשֶׁר דָּמָיו הַטְּהוֹרִים",
        "הִפְרִידוּהוּ לְמַעַן בָּהֶם אֶחֱסֶה"
      ]
    },
    {
      "label": "2",
      "lines": [
        "אַשְׁלִיךְ הַפַּחַד וּמַשְּׂאוֹת הַשָּׁנִים",
        "וְאָשִׂים הַמַּסָּע לַמַּעְיָן הַזַּךְ",
        "אֶרְוֶה הָאַהֲבָה אֲשֶׁר הֲפָכַתְנִי",
        "לְדוֹד הָאָדוֹן מֵעֶבֶד אֻמְלָל",
        "הִנְנִי יוֹדֵעַ כִּי אֵין זוּלָתוֹ",
        "מַעְיַן אַהֲבָה מִמֶּנּוּ לֵב יִרְוֶה"
      ]
    },
    {
      "label": "3",
      "lines": [
        "אֶשָּׂא הָאַהֲבָה וְשִׂמְחוֹת הַיְשׁוּעָה",
        "וְאָשִׂים הַמַּסָּע לְיַד הַגָּלְגָּלְתָּא",
        "וְאֶרְאֶה מִמִּבְצָרִי עוֹלַם הָעִנּוּי",
        "וּגְדוּדֵי הָרָע בּוֹ מַשְׁחִיתִים",
        "וְאֶקְרָא לַנְּפָשׁוֹת הָאֹבְדוֹת",
        "אוּלַי לַכָּבוֹד תִּהְיֶינָה יוֹרְשׁוֹת"
      ]
    }
  ]
}
