  "title_he": "הֶעָוֺן עֲוֺנִי אֲדֹנִי",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "הֶעָוֺן עֲוֺנִי אֲדֹנִי",
        "וְלַמְרוֹת הֶעָוֺן תֹּאהֲבֵנִי",
        "וְתִקְרַב אֵלַי בְּאַהֲבָה",
        "תְּאַמֵּץ חֻלְשַׁת אֱמוּנָתִי",
        "וְלַמְרוֹת הַיָּגוֹן בַּלֵּב",
        "כִּי לִי זִכְרְךָ נֶחָמָתִי",
        "וְלַמְרוֹת הָרָע בַּשְּׁבִיל",
        "אֱלֹהַי עָלֶיךָ בִּטְחוֹנִי"
      ]
    },
    {
      "label": "2",
      "lines": [
        "הֶעָוֺן עֲוֺנִי אֲדֹנִי",
        "וְלַמְרוֹת הֶעָוֺן תִּרְעֵנִי",
        "קָרוֹב אֵלַי כָּאָב",
        "וְתִמְחֶה דִּמְעַת יְגוֹנַי",
        "תִּשְׁכַּח הָאֵם בְּאַהֲבָה",
        "וַאֲדֹנִי לֹא יִשְׁכָּחֵנִי",
        "וְלֹא אֵחַת מִקָּשֶׁה",
        "כָּל־עוֹד הָאָדוֹן עֶזְרָתִי"
      ]
    },
    {
      "label": "3",
      "lines": [
        "הֶעָוֺן עֲוֺנִי אֲדֹנִי",
        "וְלַמְרוֹת שֶׁפַע יְגוֹנַי",
        "קָרוֹב אַתָּה מִלִּבִּי",
        "תְּנַחֵם הַכָּבֵד הָעָנִי",
        "תְּנַחֲמֵנִי אֹרֶךְ הַשְּׁבִיל",
        "עַד הַגִּיעִי מוֹלַדְתִּי",
        "לֹא אֶשְׁכַּח אַהֲבָתְךָ אֲדֹנִי",
        "וְאַהֲבָתְךָ לֹא תִשְׁכָּחֵנִי"
      ]
