{
  "book": "main",
  "number": 931,
  "title_he": "אַיֵּה הַמַּשְׁמָעוּת בְּחַיַּי",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "אַיֵּה הַמַּשְׁמָעוּת בְּחַיַּי",
        "בְּמַעְגָּל עָמְדוּ שְׁעוֹתַי",
        "וְיָרֵא הֵן יָרֵא מֵאֲשֶׁר יָבוֹא",
        "תָּעִיתִי בְּמַעְגָּל זָר",
        "בְּדִמְיוֹן וְהִנֵּה הוּא אֱמֶת",
        "אֵין יוֹדֵעַ אֲנִי מֵת אוֹ חַי"
      ]
    },
    {
      "label": "1",
      "lines": [
        "חָפֵץ אָשׁוּב שִׁמְשִׁי",
        "וְאֶמְצָא עֲבָרִי נִשְׁכָּח",
        "אָשׁוּב אֶהְיֶה נַפְשִׁי אֶהְיֶה אָדָם",
        "מִי זוּלָתְךָ גִּבּוֹר מִמֶּנִּי",
        "גִּבּוֹר מֵאֲשֶׁר יַרְחִיקֵנִי",
        "וִישִׁיבֵנִי מִמְּעִילַת הַהִתְמַכְּרוּת"
      ],
      "chorus": true
    },
    {
      "label": "2",
      "lines": [
        "סְלַח לִי לוּ מֵאַנְתִּיךָ",
        "לוּ בְּפַעַם הִתְעַקַּשְׁתִּי בְּךָ",
        "הָיָה שִׂכְלִי אֲדֹנִי נֶעְדָּר לֹא בַּהַכָּרָה",
        "אֱמֹר לִי עוֹדֶנִּי אֹהֵב אוֹתָךְ",
        "אֱמֹר אוֹתָהּ וְהַנִּיחֵנִי לְחֵיקֶךָ",
        "הֲשִׁיבֵנִי אֹהֵב הָעָם וְאֶרְאֶה הָאוֹר"
      ]
    }
  ],
  "chorus_he": "פְּזָמוֹן"
