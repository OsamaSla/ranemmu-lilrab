  "title_he": "הָבָה שִׂמְחוּ הוֹי עַם הָאָדוֹן",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "הָבָה שִׂמְחוּ הוֹי עַם הָאָדוֹן",
        "הָבָה שִׁירוּ לוֹ בְּכָבוֹד",
        "הָבָה הָרִיעוּ לוֹ בְּגָאוֹן",
        "כִּי הָאָדוֹן רָם, רָם לְעוֹלָם וָעֶד"
      ]
    },
    {
      "label": "2",
      "lines": [
        "הָבָה הַכְרִיזוּ הוֹי עַם הָאָדוֹן",
        "שִׁלְטוֹן הַיּוֹשֵׁב עַל הַכִּסֵּא",
        "הָבָה הָרִיעוּ תְּרוּעַת נִצָּחוֹן",
        "כִּי הָאָדוֹן רָם, רָם לְעוֹלָם וָעֶד"
      ]
    }
  ]
