{
  "book": "main",
  "number": 737,
  "title_he": "הָבָה מַאֲמִינִים הָבָה מַאֲמִינוֹת",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "הָבָה מַאֲמִינִים הָבָה מַאֲמִינוֹת",
        "כָּל־הַיּוֹרְשִׁים כְּבוֹד הַשָּׁמַיִם",
        "נְקַוֶּה הַדּוֹד שְׁלֵם הַמִּדּוֹת",
        "פְּאֵר הַמַּאֲמִינִים מַעְיַן הַבְּרָכוֹת"
      ]
    },
    {
      "label": "2",
      "lines": [
        "כְּבוֹד הָאָרֶץ הֶבֶל פְּאֵרוֹ מַכְאוֹבִים",
        "מְנוּחַת הָעֲיֵפִים מְעוֹן הַשָּׁלוֹם",
        "הָבָה לַמַּסָּע הָבָה לְפָנִים",
        "לֹא לָאָחוֹר אַךְ אֶל קֶדֶם"
      ]
    },
    {
      "label": "3",
      "lines": [
        "הִנֵּה הַדּוֹד רֹאשׁ מִינֵנוּ",
        "מִבְצָרֵנוּ הֶחָזָק מַנְהִיג לָנוּ",
        "מִי זֶה יוּכַל כִּי יַלְשִׁין בָּנוּ",
        "מִי זֶה יוּכַל כִּי יַפְרִידֵנוּ"
      ]
    },
    {
      "label": "4",
      "lines": [
        "נַעֲבֹר הַשְּׁבִיל בְּלִי יְרֵאִים",
        "נְקַוֶּה בּוֹא פּוֹדֵנוּ הַנֶּאֱמָן",
        "נַעֲלֶה לָאֲוִיר בַּנִּצָּחוֹן מְרִיעִים",
        "אֲנַחְנוּ בַּדּוֹד הָיִינוּ בְּטוּחִים"
      ]
    },
    {
      "label": "5",
      "lines": [
        "מַה־יָּפֶה מָקוֹם הוּכַן לָנוּ",
        "קִשְּׁטוֹ יֹפִי עֶצֶם אֲדֹנֵנוּ",
        "בּוֹ נָנוּחַ מֵעֲמָלֵנוּ",
        "וְנִרְאֶה הַדּוֹד אֲשֶׁר הֱנִיחָנוּ"
      ]
    }
  ]
}
