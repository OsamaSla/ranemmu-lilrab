{
  "book": "main",
  "number": 624,
  "title_he": "הוֹי מִי אֲשֶׁר לוֹ כָּל־עִנְיָנִי",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "הוֹי מִי אֲשֶׁר לוֹ כָּל־עִנְיָנִי",
        "אַתָּה יְשׁוּעָתִי וְאוֹרִי",
        "אַתָּה חַיַּי אֲדֹנִי",
        "מוֹחֶה עֲוֺנוֹתַי וְרָעוֹתַי"
      ]
    },
    {
      "label": "1",
      "lines": [
        "הוֹי הַזָּבוּחַ בַּעֲדִי",
        "אַקְדִּישׁ לְךָ נַפְשִׁי אֲדֹנִי",
        "קַבְּלֵנִי נָא טַהֵר־נָא לִבִּי",
        "וְאָעִיד לְךָ חַיַּי"
      ],
      "chorus": true
    },
    {
      "label": "2",
      "lines": [
        "בָּאתִי בַּחֵטְא אֲדֹנִי",
        "וּמִשְׁאֲלָתִי לְהַשְׁלִיךְ מַשָּׂאִי",
        "אֵצֶל הַצְּלָב אֲדֹנִי",
        "רַק שָׁם מְנוּחָתִי"
      ]
    },
    {
      "label": "3",
      "lines": [
        "הִנֵּה בְּרִיתִי אֲדֹנִי לָךְ",
        "עַד תִּפָּגֵשׁ בְּךָ נַפְשִׁי",
        "אֲבַלֶּה חַיַּי כְּעֵד",
        "עַד אֶזְכֶּה בַּעֲטַרְתִּי"
      ]
    }
  ],
  "chorus_he": "פְּזָמוֹן"
