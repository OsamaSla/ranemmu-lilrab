{
  "book": "main",
  "number": 718,
  "title_he": "קוּמִי כַּלַּת הָאָדוֹן אַל",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "קוּמִי כַּלַּת הָאָדוֹן אַל",
        "תִּיעֲפִי מִן־הַנְּדוּדִים",
        "לָךְ חָתָן בַּמָּרוֹם",
        "וְהוּא תִּקְוַת הַכָּבוֹד"
      ]
    },
    {
      "label": "2",
      "lines": [
        "נִכְסַפְתְּ לוֹ בְּגָלוּת",
        "בְּעוֹלַם הָאֵימָה",
        "אֲשֶׁר הַמַּאֲבָק וְהֶעָמָל",
        "וּשְׁמָמַת הַלַּיְלָה"
      ]
    },
    {
      "label": "3",
      "lines": [
        "כִּי כְּבָר כָּלָה הַלַּיְלָה וְהַ",
        "בֹּקֶר קָרַב מְאֹד",
        "וְהָאָדוֹן בָּא מְמַהֵר",
        "לְמַעַן יָרִיץ הַהַבְטָחָה"
      ]
    },
    {
      "label": "4",
      "lines": [
        "כִּי לִבּוֹ הַנִּכְסָף לֹא",
        "יִסְבֹּל הָאִחוּר",
        "וּמַהֵר יִקָּחֵךְ",
        "לִכְבוֹדוֹ הַמֵּאִיר"
      ]
    },
    {
      "label": "5",
      "lines": [
        "וְיִקַּח הַמַּלְכוּת אֲשֶׁר",
        "לוֹ עַל הַכֹּל",
        "וְתִרְאֵהוּ הָאָרֶץ בְּ",
        "כִסְאוֹ הָרָם"
      ]
    },
    {
      "label": "6",
      "lines": [
        "וְתִרְאֵךְ עִמּוֹ",
        "בַּכָּבוֹד וּבַמַּלְכוּת",
        "אַחַר כְּלוֹת הַגָּלוּת וְהַ",
        "מַכְאוֹבִים וְהַמְּצוּקָה"
      ]
    },
    {
      "label": "7",
      "lines": [
        "לָמָּה הַיָּגוֹן עוֹד אֵפוֹא",
        "שִׂמְחִי וְאַל־תִּבְכִּי",
        "כִּי הִנֵּה לָךְ הָאָדוֹן וְהִנֵּה",
        "הַכֹּל בּוֹ לָךְ"
      ]
    }
  ]
}
