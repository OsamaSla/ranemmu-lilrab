  "verses_he": [
    {
      "label": "1",
      "lines": [
        "אֲנִי חָפֵץ אוֹתְךָ אַתָּה",
        "בַּעַל הַגְּבוּרוֹת",
        "תַּפְעִיל יְמִינֶךָ",
        "תַּעֲשֶׂה פְּלָאוֹת"
      ],
      "chorus": true
    },
    {
      "label": "1",
      "lines": [
        "אַתָּה יוֹדֵעַ מַצָּבַי",
        "טֶרֶם אֲנִי אֶתְלוֹנֵן עֲלֵיהֶם",
        "כָּל־אֲשֶׁר הָיוּ קָשִׁים",
        "נוּכַל עֲלֵיהֶם"
      ]
    },
    {
      "label": "2",
      "lines": [
        "הִנֵּה הַיָּם סוֹעֵר",
        "וַאֲנִי מְחַכֶּה לָךְ",
        "וְאַתָּה בַּעַל הַגְּבוּרָה",
        "וְהַשִּׁלְטוֹן בְּיָדֶיךָ"
      ]
    },
    {
      "label": "3",
      "lines": [
        "הָאֲרָיוֹת רְעֵבוֹת",
        "שְׁלַח מַלְאָכְךָ",
        "הַנַּח הַמֶּלֶךְ יֵדַע",
        "כִּי אֲנִי קִנְיָנְךָ"
      ]
    },
    {
      "label": "4",
      "lines": [
        "הַכִּבְשָׁן מֻסָּק",
        "לְשִׁבְעָה כִּפְלַיִם",
        "כָּל־עוֹד יֵשׁוּעַ עִמָּדִי",
        "לֹא יִתָּכֵן אִירָא"
      ]
    },
    {
      "label": "5",
      "lines": [
        "הַכִּבְשָׁן מֻסָּק",
        "רֵד לְפָנַי",
        "וּבְיָדְךָ הַמְּתוּקָה",
        "הַעֲלֵנִי שֵׁנִית"
      ]
    },
    {
      "label": "6",
      "lines": [
        "הָרוֹפְאִים נָבוֹכוּ",
        "הַרְאֵם יָדֶיךָ",
        "הַנַּח לָהֶם יֹאמְרוּ",
        "לֹא יִקְשֶׁה עָלֶיךָ דָּבָר"
      ]
    }
  ],
