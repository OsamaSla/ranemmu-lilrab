{
  "book": "main",
  "number": 694,
  "title_he": "שִׂים בְּלִבִּי אַהֲבָה וַעֲשֵׂה מִמֶּנָּה נִגּוּן",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "שִׂים בְּלִבִּי אַהֲבָה",
        "וַעֲשֵׂה מִמֶּנָּה נִגּוּן",
        "יִמְשֹׁךְ הָרָחוֹק וְהַקָּרוֹב",
        "שִׂים בְּפִי אֹמֶר",
        "וַעֲשֵׂה מִמֶּנּוּ שִׁיר",
        "יִשְׁבֶּה הַשְּׂכָלִים וְהַלְּבָבוֹת",
        "שִׂים בְּשִׂכְלִי דַּעַת",
        "וַעֲשֵׂה מִמֶּנּוּ אוֹר",
        "יַחְזִיר קֶרֶן מִתִּקְוָה",
        "אוֹרְךָ הַנִּפְלָא",
        "אַהֲבָתְךָ הַשְּׁפוּכָה",
        "כַּאֲשֶׁר הִתְגַּלְּתָה בַּפְּדוּת"
      ]
    },
    {
      "label": "2",
      "lines": [
        "תֵּן לִי אֱלֹהַי",
        "רְאִיַּת הָאֱמוּנָה",
        "לְמַעַן אַבִּיט לְעֵבֶר הַשָּׂדוֹת",
        "וְאֶרְאֶה הַקָּצִיר",
        "יְמַלֵּא הַבְּקָעוֹת",
        "וְכָכָה הֶהָרִים וְהַמִּישׁוֹרִים",
        "הַנְּפָשׁוֹת רָעֲבוּ",
        "הַנְּפָשׁוֹת נָמַסּוּ",
        "הַנְּפָשׁוֹת תְּבַקֵּשְׁנָה הַהַצָּלָה",
        "וְעָזְרֵנִי לְמַעַן",
        "אָעִיד בְּאַהֲבָה",
        "כִּי אַתָּה הַדֶּרֶךְ וְהַחַיִּים"
      ]
    },
    {
      "label": "3",
      "lines": [
        "הוֹי אֲדוֹן הַקָּצִיר",
        "שְׁלַח לַקָּצִיר",
        "צָבָא יִפְעַל בְּכַרְמְךָ",
        "יַעֲזֹב הַחַיִּים",
        "יִשָּׂא הַצְּלָב",
        "יַכְרִיז הִתְקָרְבוּת מַלְכוּתְךָ",
        "תֵּן לוֹ אֱלֹהַי",
        "חָכְמַת הַשָּׁמַיִם",
        "וְכָכָה הוֹכָחַת רוּחֲךָ",
        "לְמַעַן אָנָה הָלַךְ",
        "יִזְרַע הַזֶּרַע",
        "יָעִיד עַל חֶסֶד אַהֲבָתְךָ"
      ]
    }
  ]
