{
  "book": "main",
  "number": 701,
  "title_he": "בְּחַנְתַּנִי אֱלֹהַי",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "בְּחַנְתַּנִי אֱלֹהַי",
        "וְיָדַעְתָּ פְּנִימִי",
        "וְשִׁבְתִּי וְקוּמִי",
        "וְכָל־שְׁבִילַי",
        "וּכְבָר בַּנְתָּ מַחְשַׁבְתִּי",
        "מֵרָחוֹק חָכָם",
        "וְיָדַעְתָּ כָּל־לִבִּי",
        "וְדַרְכִּי יוֹדֵעַ"
      ]
    },
    {
      "label": "2",
      "lines": [
        "אֵין דָּבָר מִמְּךָ יֵעָלֵם",
        "לֹא וְלֹא כָּל־דִּבּוּר",
        "כָּל־אֹמֶר בִּלְשׁוֹנִי",
        "כְּבָר יָדַעְתָּ בִּשְׁלֵמוּת",
        "אַתָּה אֲחוֹרַי וְקֶדֶם",
        "אַתָּה כְּבָר כִּתַּרְתַּנִי",
        "יָדְךָ הָעֶלְיוֹנָה עָלַי",
        "וּבָהּ כּוֹנַנְתַּנִי"
      ]
    },
    {
      "label": "3",
      "lines": [
        "אִם עָלִיתִי לַמְּרוֹמִים",
        "אוֹ הִצַּעְתִּי בַּקְּבָרִים",
        "אוֹ לָקַחְתִּי לִי כָּנָף",
        "אוֹ שָׁכַנְתִּי בַּיַּמִּים",
        "שָׁם אַתָּה תַּנְחֶה",
        "רַגְלַי גִּבּוֹר",
        "וְיָדֶיךָ תֹּאחַזְנָה אוֹתִי",
        "בַּאֲשֶׁר אֲנִי הוֹלֵךְ"
      ]
    },
    {
      "label": "4",
      "lines": [
        "אָמַרְתִּי יְכַסֵּנִי חֹשֶׁךְ",
        "וְהִנֵּה סְבִיבִי נֹגַהּ",
        "כִּי אֶצְלְךָ אֵין לַיְלָה",
        "אַתָּה אוֹר הַשָּׁמַיִם",
        "כִּי אַךְ הַלַּיְלָה מֵאִיר",
        "אֵצֶל אֲדֹנִי כַּיּוֹם",
        "וְהַחֹשֶׁךְ כְּמוֹ אוֹר",
        "מַזְהִיר כְּבָר הֵאִיר"
      ]
    },
    {
      "label": "5",
      "lines": [
        "בְּחָנֵנִי אֱלֹהַי",
        "וְנַסֵּנִי בָּקִי",
        "חוֹקֵר לִבִּי וְלִבָּתִי",
        "יוֹדֵעַ אֲשֶׁר בַּמַּצְפּוּן",
        "אִם רָאִיתָ בִּי נְטִיָּה",
        "לַדֶּרֶךְ הַבָּטֵל",
        "הַנְחֵה נַפְשִׁי וְחַיַּי",
        "בַּדֶּרֶךְ הַשָּׁלֵם"
      ]
    }
  ]
}
