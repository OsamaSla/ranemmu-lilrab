{
  "book": "main",
  "number": 897,
  "title_he": "כָּל־יוֹם בָּעֵת הַזֹּאת",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "כָּל־יוֹם בָּעֵת הַזֹּאת",
        "בַּנִּסְיוֹנוֹת הוּא הָעוֹזֵר",
        "בּוֹטֵחַ בַּאֲדֹנִי הַחוֹנֵן",
        "אֵין אֲנִי יָרֵא מִגְּבוּרַת הָרָשָׁע",
        "בַּעַל הַלֵּב הַגָּדוֹל אֲדֹנִי",
        "יַרְעִיף בְּכָל־אֲשֶׁר אֶצְטָרֵךְ",
        "יַחֲלִיף הַדְּאָגָה וְכָל־צָרָה",
        "בִּמְנוּחָה וְכֵן בְּגִיל"
      ]
    },
    {
      "label": "2",
      "lines": [
        "כָּל־יוֹם רַחֲמִים יוֹסִיף",
        "כָּל־שָׁעָה עִמָּדִי יֵלֵךְ",
        "יִשָּׂא הַדְּאָגוֹת וְיִמְלֹךְ",
        "כִּי שְׁמוֹ פֶּלֶא וְגִבּוֹר",
        "וְהִתְחַיְּבוּתוֹ לִי וַדָּאִית",
        "כְּיָמַי עִמָּדִי יִהְיֶה",
        "הִנֵּה הוּא בַּגְּבוּרָה יֵיטִיב",
        "בְּהַבְטָחוֹתָיו לִי נֶאֱמָן"
      ]
    },
    {
      "label": "3",
      "lines": [
        "כָּל־יוֹם בְּתוֹךְ כָּל־צָרָה",
        "אַאֲמִין בְּהַבְטָחָתְךָ הַנֶּאֱמָנָה",
        "כִּי הִיא בְּנֶחָמָתְךָ הָרַכָּה",
        "וְהִיא בִּדְבָרְךָ הַיָּקָר",
        "בְּמַאֲבָקִי חַזֶּק־נָא אֱמוּנָתִי",
        "בְּיָדֶיךָ נְחֵנִי בַּמִּלְחָמָה",
        "יַעֲבֹר הַזְּמַן וְהָרְגָעִים",
        "אַחֲרֵיהֶם אָבוֹא אֶל הַכָּבוֹד"
      ]
    }
  ]
}
