  "verses_he": [
    {
      "label": "1",
      "lines": [
        "הוֹלֵךְ רָחוֹק לְמִי",
        "וְעוֹזֵב בֵּית אָבִיךָ",
        "לִבִּי עָלֶיךָ עָצוּב",
        "הִנֵּה מֵרָחוֹק יִפְצָעוּךָ"
      ]
    },
    {
      "label": "1",
      "lines": [
        "אֶשָּׁאֵר עוֹמֵד בְּנִי",
        "מְחַכֶּה יוֹם שׁוּבֶךָ",
        "אֵין אֲנִי חָפֵץ תַּעַזְבֵנִי",
        "וְאֶרְאֶה בְּעֵינֶיךָ דִּמְעוֹתֶיךָ"
      ],
      "chorus": true
    },
    {
      "label": "2",
      "lines": [
        "לָמָּה אֵין אַתָּה חָפֵץ לָשׁוּב",
        "עֲזֹב כָּל־אֲשֶׁר אַתָּה בּוֹ",
        "תִּתְאַוֶּה לֶחָרוּבִים",
        "וּמִי יִתֵּן וְתִזְכֶּה בָּהֶם"
      ]
    },
    {
      "label": "3",
      "lines": [
        "תִּחְיֶה לְבַדְּךָ גֵּר",
        "וְתָשׁוּב מָלֵא פְּצָעִים",
        "כְּרַע לְיַד הַצְּלָב",
        "וְדַי חַיִּים חָלְפוּ"
      ]
    }
  ],
