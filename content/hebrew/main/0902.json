{
  "book": "main",
  "number": 902,
  "title_he": "אֶרְאֲךָ בֶּאֱמוּנָה שֵׂה הָרַחֲמָן",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "אֶרְאֲךָ בֶּאֱמוּנָה",
        "שֵׂה הָרַחֲמָן",
        "אֲדֹנִי יֵשׁוּעַ",
        "שְׁמַע לְתַחֲנָתִי",
        "וְהָסֵר חַטָּאתִי",
        "מִי יִתֵּן וְכֻלִּי",
        "עֶבֶד יִשְׁמַע"
      ]
    },
    {
      "label": "2",
      "lines": [
        "אֲדֹנָי הוֹסֵף לְנַפְשִׁי",
        "מֵחֶסֶד הַקֹּדֶשׁ",
        "אַתָּה הָרַחוּם",
        "הוֹסֵף קִנְאָתִי אֲדֹנִי",
        "לַצְּלָב הַהוּא",
        "וְהַצֵּת עַל־לִבִּי",
        "אַהֲבָה תַּעֲמֹד"
      ]
    },
    {
      "label": "3",
      "lines": [
        "בְּחֹשֶׁךְ הָעַפְעַפַּיִם",
        "וְחֹזֶק הַיְּגוֹנוֹת",
        "הֱיֵה מַדְרִיכִי",
        "הַנַּח חֶשְׁכָּתִי תִּגָּלֶה",
        "וּדְמָעוֹתַי תִּיבַשְׁנָה",
        "וְהַפָּנִים לֹא יוּסְרוּ",
        "מֵאֲדוֹנִי"
      ]
    },
    {
      "label": "4",
      "lines": [
        "בִּכְלוֹת הַיָּמִים",
        "כַּחֲלוֹם בַּשֵּׁנָה",
        "וְאֶשְׁכַּב",
        "יִשָּׂאֵנִי הַמָּשִׁיחַ",
        "בְּצִדּוֹ הַפָּצוּעַ",
        "שָׁם אָנוּחַ",
        "בַּעֲלוֹתִי"
      ]
    }
  ]
}
