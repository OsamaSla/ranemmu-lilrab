{
  "book": "main",
  "number": 920,
  "title_he": "אַתָּה צוּר יְשׁוּעָתִי",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "אַתָּה צוּר יְשׁוּעָתִי",
        "וּמַעְיַן גְּבוּרָתִי",
        "אַתָּה תִּקְוָתִי וּמִשְׁאֲלוֹתַי",
        "אֵלֶיךָ צַעֲקָתִי",
        "הִנְנִי מַאֲמִין בְּךָ אֲדֹנִי",
        "כִּי הִשְׁלַמְתָּ הָאַהֲבָה לִי",
        "הָיִיתָ עֵזֶר לִי בְּעֵת מַחְסוֹרִי",
        "אַתָּה תָּמִיד מַחְסִי"
      ]
    }
  ]
}
