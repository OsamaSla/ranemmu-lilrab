{
  "book": "main",
  "number": 750,
  "title_he": "אֶשְׂמַח בַּאֲשֶׁר נָתַן לִי חַיָּיו",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "אֶשְׂמַח בַּאֲשֶׁר נָתַן לִי חַיָּיו",
        "אֶשְׂמַח בַּאֲשֶׁר צְלָבוֹ פְּדָנִי",
        "וַאֲשֶׁר בְּדָמוֹ כִּסָּה לִי מוּמַי",
        "מִלִּבִּי אָרִיעַ כָּל־זְמַנִּי"
      ]
    },
    {
      "label": "2",
      "lines": [
        "הִנֵּה אֲנִי שְׁמִי חָקוּק עַל כַּפּוֹ",
        "וּבְאִישׁוֹן עֵינוֹ מְקוֹמִי",
        "אֲשֶׁר פְּדָנִי בְּדָם יָקָר",
        "הִבְטִיחַ כִּי הוּא יִרְעֵנִי"
      ]
    },
    {
      "label": "3",
      "lines": [
        "גַּם וְלוּ תִּשְׁבְּרֵנִי חֵטְא",
        "אוֹ פַּחַד עַל כָּל־אֲשֶׁר לִי",
        "אוֹ יָמִים תָּצַרְנָה בִּי",
        "אֲדֹנִי יֵשׁוּעַ אוֹחֵז בְּיָדִי"
      ]
    },
    {
      "label": "4",
      "lines": [
        "אֲדֹנִי אֲנִי רוֹאֶה שִׁמְשְׁךָ בָּאָה",
        "לַמְרוֹת חֹשֶׁךְ הַלַּיְלָה בְּעֵינַי",
        "שִׁמְשְׁךָ טוֹב וּמַרְפֵּא וְחֵרוּת",
        "טוּבְךָ אֵין לוֹ דּוֹמֶה בַּתֵּבֵל"
      ]
    },
    {
      "label": "5",
      "lines": [
        "אֲנִי רָגוּעַ כִּי אֲנִי בְּיָדֶךָ",
        "לֹא בִּידֵי אָדָם",
        "אַתָּה אָבִי וְיָקָר מָה לִי",
        "עֲרֻבָּתִי בַּיָּמִים"
      ]
    },
    {
      "label": "6",
      "lines": [
        "אֲשֶׁר רַעְיָתְךָ לִי מַחְסִי",
        "וּבְקִרְבָתְךָ אֶמְצָא הַבֶּטַח",
        "אַתָּה רוֹפֵא לִי פִּצְעֵי הֶעָבָר",
        "וּבְחֶמְלָתְךָ יָטְבָה נַפְשִׁי"
      ]
    }
  ]
}
