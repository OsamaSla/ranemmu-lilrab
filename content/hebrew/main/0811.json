  "title_he": "בַּחָכְמָה אַתָּה לְבַדְּךָ",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "בַּחָכְמָה אַתָּה לְבַדְּךָ",
        "אוֹחֵז מוֹסְרוֹת הַדָּבָר",
        "כָּל־הַחוּטִים בְּיָדְךָ",
        "וְנֶאֱמָן בְּאֹרֶךְ הַגִּיל",
        "לְךָ הַמִּלָּה הָאַחֲרוֹנָה",
        "כָּל־אֲשֶׁר אָמְרוּ בְּדִבּוּר",
        "רָם וְיָדְךָ גִּבּוֹרָה",
        "וְלִבְּךָ מָלֵא חֶמְלָה"
      ]
    },
    {
      "label": "2",
      "lines": [
        "טוֹב אַתָּה וּמֵיטִיב",
        "טוֹב בְּאֹרֶךְ הַגִּיל",
        "וּבְסִתְרְךָ אַתָּה נִשְׁכֹּן",
        "כָּל־אֲשֶׁר הַשָּׁנִים עוֹבְרוֹת",
        "כָּל־אֲשֶׁר הַמַּצָּבִים מִתְעַקְּשִׁים",
        "וְאִם עָבְרוּ הַמְּצוּקוֹת",
        "תִּשָּׁאֵר מַנְהִיג וְסוֹעֵד",
        "בִּקְשׁוֹת הָעִתִּים"
      ]
    },
    {
      "label": "3",
      "lines": [
        "לֹא תִּתֵּן בִּלְתִּי אִם הַטּוֹב",
        "כָּל־אֲשֶׁר הַמַּרְאֶה חֹשֶׁךְ",
        "כֻּלּוֹ בְּצַוְּךָ יִהְיֶה",
        "לֹא תִּשְׁגֶּה בַּדִּבּוּר",
        "פְּרָטֵי הַגִּיל אֶצְלְךָ",
        "וְחוֹשְׁבָם בִּשְׁלֵמוּת",
        "וְחַיַּי הִנָּם קִנְיָנְךָ",
        "צְלָבְךָ טוֹב עֲרֻבָּה"
      ]
    },
    {
      "label": "4",
      "lines": [
        "תֵּן לִי עֵינַיִם תִּרְאֶינָה אוֹתָךְ",
        "וְתַאֲמֵנָּה בֶּאֱמוּנָה",
        "הִנֵּה אֵין דָּבָר יַעֲבָרְךָ",
        "וּבְיָדְךָ הַשִּׁלְטוֹן",
        "דּוֹדִי עָזְרֵנִי אוֹדֶה",
        "וְאֶמְסֹר וְאָנוּחַ",
        "וְאֶכָּנַע לְךָ אֲדֹנִי וְאֶסְבֹּל",
        "וְאַתָּה מִשְׁפָּטְךָ צוֹדֵק"
      ]
    },
    {
      "label": "5",
      "lines": [
        "יִרְדְּפֵנִי טוֹב וָחֶסֶד",
        "תָּמִיד וּבְכָל־יוֹם",
        "עֲטֶרֶת טוֹב וְחֶמְלָה",
        "עָלַי תָּמִיד תַּעֲמֹד",
        "וַאֲנִי תּוֹעֶה תַּשְׁגִּיחֵנִי",
        "וְתָחוּס לְכָל־חֻלְשָׁתִי",
        "תַּפְגִּיעַ בִּי וּתְרַפְּאֵנִי",
        "וּבְחֶסֶד תָּשִׁיב נַפְשִׁי"
      ]
    }
  ]
