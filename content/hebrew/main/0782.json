  "verses_he": [
    {
      "label": "1",
      "lines": [
        "אֶכְסֹף אֲדֹנִי אֶשְׂחֶה",
        "בִּנְהַר רוּחֲךָ הֶעָמֹק",
        "אֶעֱזֹב חוֹפִי אֶפְתַּח",
        "חַיַּי לְזֶרֶם רֵעַ"
      ]
    },
    {
      "label": "1",
      "lines": [
        "הַמַּיִם רְדוּדִים פֹּה",
        "קָחֵנִי אֶל עֹמֶק רָחוֹק",
        "וּמֵעֹשֶׁר אֶל עֹשֶׁר",
        "כָּבוֹד אֶל כָּבוֹד חָדָשׁ"
      ],
      "chorus": true
    },
    {
      "label": "2",
      "lines": [
        "אֲדֹנִי אֲבַקֵּשׁ אֹמֶץ",
        "לְמַעַן אֻנְהַג בִּשְׁלֵמוּת",
        "אֶמְסֹר חַיַּי פַּעַם",
        "בֵּין יָדֶיךָ אֶנָּשֵׂא"
      ]
    },
    {
      "label": "3",
      "lines": [
        "הַקַּרְקַע אֵינֶנּוּ מִשְׁכָּנִי",
        "וְלֹא הַחוֹפִים תַּאֲוָתִי",
        "הָעֹמֶק מְתוּק מוֹשָׁבִי",
        "שִׂיאוֹ הָיָה תַכְלִיתִי"
      ]
    },
    {
      "label": "4",
      "lines": [
        "בָּעֹמֶק דֹּפֶק תְּמִידִי",
        "שָׁם כַּמָּה יִיטְבוּ הַחַיִּים",
        "יֵשׁוּעַ סְבִיבִי קָם",
        "נֹכְחוּתוֹ בָּאָה שִׂיאָהּ"
      ]
    }
