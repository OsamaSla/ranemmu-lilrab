{
  "book": "main",
  "number": 455,
  "title_he": "אֱלֹהַי, כַּמָּה נְפָשׁוֹת",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "אֱלֹהַי, כַּמָּה נְפָשׁוֹת",
        "אֲשֶׁר שָׂרְפָן שֶׁמֶשׁ הָעָוֺן",
        "תִּצְעַק: מָה לִּי, וְחַיַּי הַיָּקָרִים",
        "אָבְדוּ וּבָעוֹלָם אֵין תִּקְוָתִי",
        "אָבַד הַמָּמוֹן וְאָבְדוּ הַחַיִּים",
        "וְאֵין לִי תִּקְוָה"
      ]
    },
    {
      "label": "2",
      "lines": [
        "הוֹי יְדִידִי, כַּמָּה לִבּוֹת",
        "בְּכִסּוּפִים לַמָּשִׁיחַ",
        "אַל תֵּחָלֵשׁ, קוּם וְהִתְמַסַּר",
        "אוֹ לְיֵשׁוּעַ תּוֹסִיף חֶרְפָּה",
        "אָבַד הָעֵת וְאָבַד הָעָמָל",
        "דַּי לָנוּ חֲנֵפָה"
      ]
    }
  ]
}
