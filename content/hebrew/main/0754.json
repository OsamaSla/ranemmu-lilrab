    {
      "label": "2",
      "lines": [
        "כָּל־אֲשֶׁר יִהְיֶה מֵעֲמַל הַמַּסָּע",
        "מִשְּׁמָמָה וּמַאֲבָק רַב",
        "יֵשׁוּעַ אֲדֹנִי הוּא הָרֵעַ",
        "תַּכְלִיתִי הַמָּשִׁיחַ"
      ]
    },
    {
      "label": "3",
      "lines": [
        "אֶשְׁכַּח הַנִּסְיוֹנוֹת וְהֶעָמָל",
        "מְבַזֶּה כָּל־אֲשֶׁר פֹּה",
        "זֶה הַקִּיּוּם אֶל הַכְּלָיָה",
        "תַּכְלִיתִי הַמָּשִׁיחַ"
      ]
    },
    {
      "label": "4",
      "lines": [
        "אַךְ אֲנִי הִנֵּה לְפָנַי הַשָּׁמַיִם",
        "אֲשֶׁר עָלָה אֲדֹנִי וְכַאֲשֶׁר",
        "הָלַךְ פֹּה אֵלֵךְ אָנִי",
        "תַּכְלִיתִי הַמָּשִׁיחַ"
      ]
    },
    {
      "label": "5",
      "lines": [
        "הִנּוֹ תִּקְוָתִי בִּמְגוּרַי",
        "גּוֹרָלִי חֶלְקִי שִׂמְחָתִי",
        "נֶחָמָתִי וְדַיִּי",
        "תַּכְלִיתִי הַמָּשִׁיחַ"
      ]
    },
    {
      "label": "6",
      "lines": [
        "יֵשׁוּעַ מִשְׁאֲלָתִי לְבַדּוֹ",
        "הִנֵּה אָשְׁרִי אֶצְלוֹ",
        "עוֹד מְעַט אֶרְאֶה כְּבוֹדוֹ",
        "תַּכְלִיתִי הַמָּשִׁיחַ"
