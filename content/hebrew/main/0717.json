{
  "book": "main",
  "number": 717,
  "title_he": "הִנֵּה כְּבָר הָיָה לַיְלָה",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "הִנֵּה כְּבָר הָיָה לַיְלָה",
        "חָשׁוּךְ חֲצִי הַיּוֹם",
        "וְהַסְּלָעִים הַחֵרְשִׁים נִבְקְעוּ",
        "וְלָמָּה זֶה הָיָה",
        "טָעַם אֲדוֹן הַכָּבוֹד מָוֶת",
        "אַחַר צְלִיבָה וְזִלְזוּל",
        "נֶהְפָּךְ לַעַג וּקְלָלָה",
        "נוֹשֵׂא עָוֺן וְחֶרְפָּה"
      ]
    },
    {
      "label": "2",
      "lines": [
        "הַבִּיטוּ אֵיךְ יָדָיו",
        "מֻסְמְרוּ עַל הָעֵץ",
        "וְלוֹ עֲטֶרֶת קוֹצִים",
        "מִלְּאָה מְקוֹם כֶּתֶר הַזָּהָב",
        "הַבִּיטוּ דָּם וָמַיִם",
        "יָצְאוּ מִצִּדּוֹ",
        "וְשִׁמְעוּ קוֹל אֲנָחָה",
        "עוֹלֶה מִלִּבּוֹ"
      ]
    },
    {
      "label": "3",
      "lines": [
        "הָיָה שִׁלְטוֹן גָּדוֹל",
        "וַיְוַתֵּר עַל עָלוֹ",
        "לִפְדוּת עַם חַטָּאִים",
        "בָּא מִמְּרוֹם שָׁמָיו",
        "אֲנַחְנוּ בֶּעָוֺן יֻלַּדְנוּ",
        "זַכָּאִים הָעֹנֶשׁ",
        "וַיָּבֹא אֵלֵינוּ וַיִּפְדֵּנוּ",
        "מֵאֲבַדּוֹן וְעִנּוּי"
      ]
    },
    {
      "label": "4",
      "lines": [
        "הוֹי בַּעֲלֵי הָעֲוֺנוֹת הַאֲזִינוּ",
        "וּדְעוּ שְׁבִילֵי הַהַדְרָכָה",
        "וְהָרִימוּ הַיָּדַיִם וְהִתְפַּלְּלוּ",
        "וְהוֹדוּ אֲדוֹן הַפְּדוּת",
        "וּבַקְּשׁוּ הַסְּלִיחָה וְהִשָּׁאֲרוּ",
        "אוֹמְרִים סוֹגְדִים",
        "כְּבָר קִבַּלְתָּ הַמָּוֶת בְּרָצוֹן",
        "מַצִּיל אַנְשֵׁי הָאֲבַדּוֹן"
      ]
    }
  ]
}
