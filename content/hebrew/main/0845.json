  "verses_he": [
    {
      "label": "1",
      "lines": [
        "הָיִיתִי לְבַדִּי חַי",
        "בְּלִי מַשְׁמָעוּת לְקִיּוּמִי",
        "הָיָה שְׁבִילִי שׁוֹמֵם",
        "הִכְבִּיד הַיֵּאוּשׁ כְּבָלַי"
      ]
    },
    {
      "label": "1",
      "lines": [
        "וַיָּבוֹא לְעֶבְרִי יֵשׁוּעַ",
        "מַחֲלִיף טַעַם הַחַיִּים",
        "הָפַךְ הַלַּיְלָה נֵרוֹת",
        "נָטָה לִי גַּלְגַּל הַיְשׁוּעָה"
      ],
      "chorus": true
    },
    {
      "label": "2",
      "lines": [
        "הָיִיתִי יָרֵא אוֹתוֹ מָחָרִי",
        "חֲרוֹן הָאֵל הַגָּדוֹל",
        "הָיִיתִי כְּבוּל הַיָּד",
        "טְמֵא הַלֵּב הָאָשֵׁם"
      ]
    },
    {
      "label": "3",
      "lines": [
        "לֹא הָיָה מִי יָחוּס",
        "אוֹ זְרוֹעַ לַיְשׁוּעָה",
        "לֹא הָיָה מִי יְחַפֵּשׁ",
        "מִפְּסַק בָּעֹנֶשׁ"
      ]
    },
    {
      "label": "4",
      "lines": [
        "וַאֲנִי לוּלֵא יֵשׁוּעַ",
        "אֹבֵד בְּלִי תִּקְוָה",
        "לִי כּוֹס מִן־דְּמָעוֹת",
        "בְּבָקְרִי וּבְעַרְבִּי"
      ]
    }
  ],
