{
  "book": "main",
  "number": 830,
  "title_he": "בְּיָגוֹן גָּדוֹל וּבְשִׁבְרוֹן וַדָּאי",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "בְּיָגוֹן גָּדוֹל",
        "וּבְשִׁבְרוֹן וַדָּאי",
        "רָאִיתִי הַדּוֹד",
        "עַל עֵץ הַצְּלָב",
        "וָאֶשְׁאַל בְּפֶלֶא",
        "לָמָּה כָּל־זֶה הֶעָמָל",
        "וַיִּתְגַּשֵּׁם הַטַּעַם",
        "עֲוֺנִי יֵרָאֶה אָיֹם",
        "אֲשֶׁר עַל הַצְּלָב",
        "מְחֵה עֲוֺנִי דּוֹד"
      ]
    },
    {
      "label": "2",
      "lines": [
        "בְּעֵת הַתְּנוּמָה",
        "וְכִבּוּי הַנֵּרוֹת",
        "רָאִיתִי יֵשׁוּעַ",
        "בּוֹכֶה בַּדְּמָעוֹת",
        "כָּל־קוֹץ בּוֹ",
        "כְּבָר נָעַצְתִּיהָ אָנִי",
        "וָאֲמַהֵר לְעֶבְרוֹ",
        "וָאֶצְעַק אוֹמֵר",
        "אֲשֶׁר עַל הַצְּלָב",
        "מְחֵה עֲוֺנִי דּוֹד"
      ]
    },
    {
      "label": "3",
      "lines": [
        "אֲדֹנִי הַדּוֹד",
        "הִנְנִי מוֹדֶה",
        "עֲוֺנִי עָשָׂה",
        "צִדְּךָ יָזוּב",
        "לְךָ בְּרִיתִי יֵשׁוּעַ",
        "כִּי לֹא אֲעַצִּיבְךָ",
        "קוֹלִי בְּכָל־הַנְּווֹת",
        "יִקְרָא אוֹמֵר",
        "אֲשֶׁר עַל הַצְּלָב",
        "אַתָּה לִי טוֹב הַחֵלֶק"
      ]
    }
  ]
}
