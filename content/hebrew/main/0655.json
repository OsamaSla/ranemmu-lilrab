  "title_he": "לְךָ יָאֶה הַשֶּׁבַח",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "עִטַּרְתָּ הַשָּׁנָה בְּטוּבְךָ",
        "וּמַעְגָּלֶיךָ יִרְעֲפוּ דָּשֶׁן",
        "כָּל־הַלֵּב יָשִׁיר הַלֶּלְךָ",
        "וְתָרִיעַ נַפְשִׁי רְנָנָה"
      ],
      "chorus": true
    },
    {
      "label": "1",
      "lines": [
        "לְךָ יָאֶה הַשֶּׁבַח",
        "מוֹשִׁיעִי הַמָּשִׁיחַ",
        "וּלְךָ תַּקְדִּישׁ הַלְּבָבוֹת",
        "אַהֲבָתָהּ הָאֲמִתִּית הַבְּרוּרָה",
        "וְתָשִׁיר לְשִׁמְךָ",
        "וְתַשְׁמִיעַ צִדְקְךָ",
        "וְתַגְבִּיהַּ כְּבוֹדְךָ",
        "בְּתוֹךְ זֶה הַיְּקוּם הָרָחָב"
      ]
    },
    {
      "label": "2",
      "lines": [
        "אַשְׁרֵי אֲשֶׁר תִּבְחַר",
        "לְמַעַן יִשְׁכֹּן הַחֲצֵרוֹת",
        "אֲשֶׁר תִּרְוֶינָה הַנְּפָשׁוֹת",
        "מִמַּעְיָנוֹת שׁוֹפְעִים",
        "הוֹי תִּקְוַת הַמִּתְיָאֲשִׁים",
        "הוֹי נֶחָמַת הָאֻמְלָלִים",
        "הוֹי מַצִּיל הַנּוֹפְלִים",
        "מִמַּהְמֹרוֹת הַכְּלִמָּה"
      ]
    },
    {
      "label": "3",
      "lines": [
        "הוֹי מַשְׁקִיט הַיַּמִּים",
        "כַּאֲשֶׁר הַגַּל יִסְעַר",
        "וְתִירָא הָאָרֶץ מִן",
        "אוֹת הָאָדוֹן הָאַמִּיץ",
        "הוֹי מְכוֹנֵן הֶהָרִים",
        "בְּכֹחֲךָ בַּעַל הַגָּאוֹן",
        "הוֹי מְקַיֵּם הַתִּקְווֹת",
        "כַּאֲשֶׁר הַלֵּב יִכְשַׁל"
      ]
    },
    {
      "label": "4",
      "lines": [
        "יִרְעֲפוּ הַמִּרְעִים מָן",
        "וְהַגְּבָעוֹת תִּשְׂמַחְנָה",
        "וְהַכָּרִים יִלְבְּשׁוּ",
        "טוּבְךָ וְיָרִיעוּ",
        "יִכָּנְעוּ הָעַמִּים לָךְ",
        "הוֹי הָאָדוֹן הַמֶּלֶךְ",
        "וְהָאֲרָצוֹת וְהַשָּׁמַיִם",
        "יָרִיעוּ יְשַׁבֵּחוּ"
      ]
    }
  ],
