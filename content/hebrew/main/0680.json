{
  "book": "main",
  "number": 680,
  "title_he": "לַמְּדֵנִי כִּי אֶהְיֶה שׁוֹתֵק כַּאֲשֶׁר",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "לַמְּדֵנִי כִּי אֶהְיֶה שׁוֹתֵק כַּאֲשֶׁר",
        "הָיִיתָ אֲדֹנִי מוֹרִי תַּעֲמֹד לִפְנֵי הַמַּכְאוֹבִים",
        "אַלְּפֵנִי תָּמִיד לְמַעַן אֶהְיֶה מְאַחֵר",
        "חוֹשֵׁב בְּלִי פְּזִיזוּת בַּדִּבּוּר"
      ]
    },
    {
      "label": "2",
      "lines": [
        "הִנַּחְתָּ לִי רָם מוֹפֵת כַּאֲשֶׁר",
        "הָיִיתָ מִתְהַלֵּךְ קוֹרֵא אֶל הַשָּׁלוֹם",
        "מְנַחֵם מְחַזֵּק וּמְרַפֵּא",
        "בְּלִי רַעַשׁ זוּלַת שְׁאָר הָאָדָם"
      ]
    },
    {
      "label": "3",
      "lines": [
        "כַּמָּה פַעַם רְאִיתִיךָ בְּרֹךְ",
        "מְנַחֵם חוֹטֵא וְסוֹלֵחַ הָעֲוֺנוֹת",
        "וְכַמָּה שְׁמַעְתִּיךָ תִּקְרָא קוֹרֵא",
        "הָבָה הַחוּצָה לְמֵת וַיָּקָם"
      ]
    },
    {
      "label": "4",
      "lines": [
        "אֶחְפֹּץ אֲדֹנִי שׁוֹמֵר עַל פִּי",
        "לְמַעַן אוּכַל כִּי אֶחְיֶה בְּאַחְדוּת",
        "וְלֹא אֶהְיֶה מַכְשִׁיל לְאֶחָי",
        "בְּאִמְרִי אַךְ אַנְחֵם אֶל קֶדֶם"
      ]
    }
  ]
}
