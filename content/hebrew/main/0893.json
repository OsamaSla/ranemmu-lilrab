{
  "book": "main",
  "number": 893,
  "title_he": "לַמְרוֹת אֹבֶד הָאַהֲבָה וּדְמוּתָהּ",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "לַמְרוֹת אֹבֶד הָאַהֲבָה וּדְמוּתָהּ",
        "מִלֵּב הָאָדָם",
        "רוֹאֲךָ אַהֲבָה אֲמִתִּית קוֹרֵאת",
        "עַל־לֵב הַצָּמֵא",
        "אַהֲבָה וּבָהּ סְלִיחָה",
        "בַּחֶסֶד וֶאֱמוּנָה",
        "כִּי צְלָבְךָ בּוֹ הַצֶּדֶק",
        "וּבוֹ הָרַחֲמִים גַּם־יָחַד"
      ]
    },
    {
      "label": "2",
      "lines": [
        "לַמְרוֹת מַאֲבַק הַנֶּפֶשׁ הַטָּמוּן",
        "בְּתוֹךְ מַעְגְּלֵי הָאֲנִי",
        "מַגַּע יָדְךָ יְרַפֵּא הַנֶּפֶשׁ",
        "וִיחַיֶּה הַלֵּב אִם מֵת",
        "חֵרוּת וְשִׁחְרוּר",
        "וְהָרוּחַ בַּשִּׁנּוּי",
        "תַּכְרִיז צֶדֶק אֱלֹהִים וּשְׁלוֹמוֹ",
        "וְתַכְרִיז בְּזִילַת הָאֲנִי"
      ]
    },
    {
      "label": "3",
      "lines": [
        "לַמְרוֹת מְצוֹר הָרָע וְעִקְּשׁוּתוֹ",
        "וְשַׁאֲגַת הַשָּׂטָן",
        "רוֹאֲךָ עוֹמֵד לְצִדִּי וְרוֹאֶה",
        "בְּיָדֶיךָ הַשִּׁלְטוֹן",
        "בְּגְדֹל הַמִּלְחָמָה",
        "אֲנִי בַּצּוּר חָזָק",
        "חֶרֶב הָרוּחַ הַדָּבָר הַחַי",
        "מַבְטִיחָה נִצְחוֹנִי עַתָּה"
      ]
    },
    {
      "label": "4",
      "lines": [
        "לַמְרוֹת צִלְצוּל הַחֹמֶר וְעֹז",
        "נְטִיּוֹת הַגַּשְׁמִיּוּת",
        "יָבוֹא וְיָרִים לִבִּי הַחֶסֶד",
        "וְיִתֵּן לְרוּחִי יַצִּיבוּת",
        "כָּל־עוֹד אֲנִי נָכוֹן בְּךָ",
        "וּבְאַהֲבָתְךָ וּבְיָדֶיךָ",
        "אֶשָּׁאֵר אָשִׁיר הַמַּסָּע כֻּלּוֹ",
        "מְתוּקוֹת הַזְּמִירוֹת"
      ]
    }
  ]
}
