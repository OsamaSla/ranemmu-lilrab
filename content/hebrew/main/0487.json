{
  "book": "main",
  "number": 487,
  "title_he": "לְךָ הַכָּבוֹד לָעַד",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "לְךָ הַכָּבוֹד לָעַד",
        "יֵשׁוּעַ אֲדֹנֵינוּ",
        "נָשָׂאתָ בַּבָּשָׂר",
        "אֶת־עָוֺנֵינוּ וְאֶת־מִשְׁפָּטֵינוּ"
      ]
    },
    {
      "label": "2",
      "lines": [
        "נָשָׂא מֵעָלֵינוּ יְדִיד",
        "נוֹשֵׂא הַמִּשְׁפָּט הַנּוֹרָא",
        "הוּא מִשְׁפָּטֵנוּ וּכְבָר",
        "כִּלָּהוּ עַל־הַצְּלָב"
      ]
    },
    {
      "label": "3",
      "lines": [
        "אַהֲבָתְךָ הָאַהֲבָה הַנִּפְלָאָה",
        "עָבְרָה מֵהַשָּׂגַת הַשְּׂכָלִים",
        "לֹא הָיְתָה אֵימַת הַצְּלָב",
        "לְהָזִיז אֶת־הָאַהֲבָה הַזֹּאת"
      ]
    },
    {
      "label": "4",
      "lines": [
        "כִּי עַזָּה כַּמָּוֶת הִיא",
        "אִשָּׁהּ שַׁלְהֶבֶת אֱלֹהִים",
        "לֹא בְּנַחַל תִּכָּבֶה",
        "וְלֹא בְּמַיִם רַבִּים"
      ]
    },
    {
      "label": "5",
      "lines": [
        "אֵין גְּבוּל לָהּ",
        "וְלֹא מִדָּה וְלֹא גְּזֵרָה",
        "כָּל־מַחְשֶׁבֶת בְּנֵי אָדָם",
        "לִפְנֵי הָאַהֲבָה הַזֹּאת נִבְהֶלֶת"
      ]
    },
    {
      "label": "6",
      "lines": [
        "וּלְךָ כָּל־הַשֶּׁבַח",
        "יֵשׁוּעַ הַגֹּאֵל",
        "כִּי נָתַתָּ לָנוּ אֶת־הַתִּקְוָה",
        "וְאֶת־הַיְשׁוּעָה הַנִּצְחִית"
      ]
    }
  ],
  "review": [
