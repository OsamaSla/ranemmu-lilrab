{
  "book": "main",
  "number": 774,
  "title_he": "הוֹי הָאָב הֶעָשִׁיר",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "הוֹי הָאָב הֶעָשִׁיר",
        "בְּבִנְךָ כְּבָר בְּחַרְתָּנוּ",
        "אֲהַבְתָּנוּ מִנִּי נֶצַח",
        "וּבוֹ כְּבָר בֵּרַכְתָּנוּ"
      ]
    },
    {
      "label": "2",
      "lines": [
        "אַתָּה אָבִינוּ עֻזֵּנוּ",
        "וַאֲנַחְנוּ בָּנִים לָךְ",
        "בְּבִנְךָ אִמַּצְתָּנוּ",
        "לִתְהִלַּת כְּבוֹד חַסְדֶּךָ"
      ]
    },
    {
      "label": "3",
      "lines": [
        "וּבוֹ כְּבָר הָיָה לָנוּ",
        "בְּךָ דְּבֵקוּת לָעַד",
        "וּבוֹ כְּבָר שִׂמַּחְתָּנוּ",
        "הוֹי הָאָב הַצּוּר"
      ]
    },
    {
      "label": "4",
      "lines": [
        "בּוֹ לָנוּ כָּל־הַשָּׂשׂוֹן",
        "בּוֹ הַחֹשֶׁךְ הָיָה אוֹר",
        "הִנֵּה הוּא מַעְיַן הַשִּׂמְחָה",
        "לָנוּ אֶל דּוֹר הַדּוֹרוֹת"
      ]
    }
  ]
}
