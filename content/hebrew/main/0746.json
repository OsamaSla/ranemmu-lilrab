{
  "book": "main",
  "number": 746,
  "title_he": "אַהֲבַת הָאֵל רָמָה",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "אַהֲבַת הָאֵל רָמָה",
        "לֹא מְדָדָהּ שֵׂכֶל נָבוֹן",
        "מֵעַל הַכּוֹכָבִים עָלְתָה",
        "וְיָרְדָה לָאוֹבְדִים",
        "כִּי חָטָא כָּל־הָאָדָם",
        "בָּא אֲלֵיהֶם הָרַחוּם",
        "יַנְחֵם יִפְדֵּם",
        "בְּדָמוֹ הַנָּדִיב"
      ]
    },
    {
      "label": "1",
      "lines": [
        "אוֹדֶה מִי אֲהֵבַנִי",
        "אַהֲבָה רָמָה נִפְלָאָה",
        "טָהַרְתִּי כִּי רְחָצַנִי",
        "דַּם אוֹתוֹ הַדּוֹד"
      ],
      "chorus": true
    },
    {
      "label": "2",
      "lines": [
        "לוּ הָיָה דְּיוֹ כָּל־יָם",
        "וּנְיָר כָּל־הַשָּׁמַיִם",
        "וְכָל־עֵשֶׂב קֻלְמוֹס",
        "וְהַכֹּל בַּהַעְתָּקָה הִשְׁתַּתֵּף",
        "לֹא כָּתְבוּ לֹא תֵּאֲרוּ",
        "אַהֲבַת הַדּוֹד",
        "עָלְתָה רָמָה שָׁפְעָה הֵצִיפָה",
        "שִׁעוּרָהּ נִפְלָא"
      ]
    }
  ],
  "chorus_he": "1 אוֹדֶה מִי אֲהֵבַנִי · 2 אַהֲבָה רָמָה נִפְלָאָה · 3 טָהַרְתִּי כִּי רְחָצַנִי · 4 דַּם אוֹתוֹ הַדּוֹד"
