{
  "book": "main",
  "number": 876,
  "title_he": "הַאִם עָזַבְתָּ לַמָּשִׁיחַ",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "הַאִם עָזַבְתָּ לַמָּשִׁיחַ",
        "מָקוֹם בְּלִבֶּךָ",
        "הִנֵּה הוּא עַתָּה קוֹרֵא",
        "לוֹחֵשׁ בְּאָזְנֶךָ"
      ]
    },
    {
      "label": "1",
      "lines": [
        "מַהֵר־נָא מַהֵר־נָא",
        "וּפְתַח הַלֵּב לוֹ",
        "יָבוֹא־נָא יִמְלֹךְ־נָא",
        "יִהְיֶה הַכֹּל לוֹ"
      ],
      "chorus": true
    },
    {
      "label": "2",
      "lines": [
        "תּוּכַל כִּי תְּכַלְכֵּל",
        "מָקוֹם לְכָל־דָּבָר",
        "לֹא יִהְיֶה אַחַר זֹאת",
        "לַמָּשִׁיחַ כָּל־דָּבָר"
      ]
    },
    {
      "label": "3",
      "lines": [
        "הֲיֵשׁ לַאֲדוֹנְךָ מָקוֹם",
        "מִי בַּשַּׁעַר יִדְפֹּק",
        "וְאִם חָלְפָה הָעֵת",
        "קוֹלְךָ לֹא יִשָּׁמַע"
      ]
    }
  ],
  "chorus_he": "פְּזָמוֹן"
}
