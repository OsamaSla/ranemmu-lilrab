{
  "book": "main",
  "number": 641,
  "title_he": "הַאִם יָדַעְתָּ אֵיךְ חָיָה",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "הַאִם יָדַעְתָּ אֵיךְ חָיָה",
        "אֵיךְ סָבַל מִמַּכְאוֹבִים",
        "בְּאֵשׁ הַצֶּדֶק עָבַר",
        "מַעֲנִיק לְךָ הַשָּׁלוֹם"
      ]
    },
    {
      "label": "1",
      "lines": [
        "הִנֵּה יִקְרָא לֹא יֶחְדַּל",
        "יְקַוֶּה מִמְּךָ תְּשׁוּבָה",
        "מַהֵר מַהֵר",
        "לְעֶבְרִי וְתִחְיֶה"
      ],
      "chorus": true
    },
    {
      "label": "2",
      "lines": [
        "הַאִם דַּרְכְּךָ חֹשֶׁךְ",
        "הַאִם חַיֶּיךָ הֲרִיסוֹת",
        "אַל־תִּירָא כִּי הִנֵּה יֵשׁוּעַ",
        "יָכוֹל יִתֵּן הַשָּׁלוֹם"
      ]
    },
    {
      "label": "3",
      "lines": [
        "הַאִם תָּעִיתָ בִּצְעָדֶיךָ",
        "מְמַהֵר לְעֵבֶר הָאֲבַדּוֹן",
        "תִּתְלוֹנֵן מֵאֵימַת הֶעָמָל",
        "צוֹעֵק אַיֵּה הַהַצָּלָה"
      ]
    }
  ],
  "chorus_he": "פְּזָמוֹן"
}
