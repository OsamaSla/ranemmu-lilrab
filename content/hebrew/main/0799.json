  "title_he": "יֵשׁוּעַ אַתָּה יוֹדֵעַ כִּי",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "יֵשׁוּעַ אַתָּה יוֹדֵעַ כִּי",
        "תַּאֲווֹת הָעוֹלָם יַטְעוּנִי",
        "טַהֵר לִבִּי טַהֵר מַחְשַׁבְתִּי",
        "שְׁמַע צַעֲקָתִי וְרַחֲמֵנִי"
      ]
    },
    {
      "label": "1",
      "lines": [
        "טַהֲרֵנִי",
        "יֵשׁוּעַ אַתָּה יוֹדֵעַ כִּי אֹהַב אוֹתָךְ",
        "מִלִּבִּי"
      ],
      "chorus": true
    },
    {
      "label": "2",
      "lines": [
        "טִמֵּאתִי לִבִּי טִמֵּאתִי מַחְשַׁבְתִּי",
        "צְלַבְתִּיךָ בְּפִשְׁעִי",
        "הִרְחַקְתִּיךָ שְׁכַחְתִּיךָ",
        "לֹא שַׁבְתָּ אַתָּה הַכֹּל לִי"
      ]
    },
    {
      "label": "3",
      "lines": [
        "קַדֵּשׁ שִׁמְעִי צַנֵּעַ מַבָּטִי",
        "שְׁמֹר עִתּוֹתַי וְאַהֲבָתִי",
        "אֶשְׁמֹר הַבְטָחָתְךָ אֵלֵךְ אַחֲרֶיךָ",
        "כָּל־אֲשֶׁר הֵפַרְתִּי בְּהַבְטָחָתִי"
      ]
    },
    {
      "label": "4",
      "lines": [
        "אַךְ מָתַי הַפּוֹדֶה הַמֵּנִיחַ",
        "הִבִּיט אֵלַי בְּחִיּוּךְ",
        "תִּזְכֶּינָה חַיַּי וְתָנוּחַ",
        "אֶחְיֶה תָּמִיד בְּשָׁלוֹם"
      ]
    },
    {
      "label": "5",
      "lines": [
        "יֵשׁוּעַ עַתָּה תֵּדַע כִּי אֲנִי",
        "שָׂמֵחַ בְּנֹכְחוּתְךָ בְּלִבִּי",
        "הַלְלִי נַפְשִׁי רַנְּנִי רוּחִי",
        "הִנֵּה יֵשׁוּעַ דּוֹדִי טִהֲרַנִי"
      ]
    },
    {
      "label": "6",
      "lines": [
        "מִצָּרַת נַפְשִׁי הִצַּלְתַּנִי",
        "כַּאֲשֶׁר רָאִיתָ הַשְׁפָּלָתִי",
        "בְּחֵיקְךָ חִבַּקְתַּנִי",
        "וְלִבְּךָ כְּבָר רַךְ לִי"
      ]
    },
    {
      "label": "7",
      "lines": [
        "טֻמְאַת עַצְמִי לָקְחָה כִּתְרִי",
        "אִבְּדָה שִׂמְחַת יְשׁוּעָתִי",
        "מֶלֶךְ חַיַּי לָקַח בְּגָדַי",
        "גָּרַם מַכְאוֹבַי וִיגוֹנַי"
      ]
    },
    {
      "label": "8",
      "lines": [
        "הֶעָמָל כְּבָר הֶעֱיֵף לִבִּי",
        "וִיגוֹן נַפְשִׁי יַהַרְגֵנִי",
        "וְהַבּוּשָׁה כְּבָר כִּסְּתָה פָנַי",
        "וְהַבֵּט אֵלַי וְהַצִּילֵנִי"
      ]
    },
    {
      "label": "9",
      "lines": [
        "אִם לֹא אֶרְאֶה פְּנֵי הַדּוֹד",
        "הָאוֹר אֶצְלִי כַּחֹשֶׁךְ",
        "אִם הָלַכְתִּי בְּמִרְעֶה פֹּרֶה",
        "יֵרָאֶה כַּחֲלוֹם בַּתְּנוּמָה"
      ]
    }
  ],
  "chorus_he": "טַהֲרֵנִי · יֵשׁוּעַ אַתָּה יוֹדֵעַ כִּי אֹהַב אוֹתָךְ · מִלִּבִּי"
