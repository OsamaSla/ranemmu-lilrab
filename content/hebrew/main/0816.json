{
  "book": "main",
  "number": 816,
  "title_he": "בִּדְמוּת עֶבֶד",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "בִּדְמוּת עֶבֶד לָקַח",
        "וְהָיָה כִּדְמוּתֵנוּ",
        "כָּכָה בֶּן הָאֱלֹהִים הֵרִיק",
        "עַצְמוֹ בַּעֲדֵנוּ",
        "עוֹזֵב כְּבוֹד הַשָּׁמַיִם",
        "שׁוֹכֵן אֶרֶץ הָעֳנִי",
        "מַשְׁפִּיל עַצְמוֹ בְּרָצוֹן",
        "לִפְדוּת הַקִּנְיָן"
      ]
    },
    {
      "label": "1",
      "lines": [
        "זֶה אִישׁ מַכְאֹבוֹת",
        "וִידוּעַ חֹלִי",
        "כָּבוֹד לוֹ נִרְאֶה",
        "מֻכְתָּר בַּכָּבוֹד",
        "עַל שִׂיאֵי הָעוֹלָמוֹת",
        "יֵשׁוּעַ"
      ],
      "chorus": true
    },
    {
      "label": "2",
      "lines": [
        "הָיָה מַרְאֵהוּ נוֹרָא",
        "מָשְׁחָת מֵאִישׁ",
        "וְהוּא כַּפּוֹשֵׁעַ מוּבָל",
        "אַחַר מַלְקוֹת וּבוּז",
        "אָז נְקוּב הַיָּדַיִם",
        "דָּמוֹ הַיָּקָר נָזַל",
        "רוֹחֵץ מֵעָלֵינוּ הַחֲטָאִים",
        "מַעֲנִיק כְּבוֹד הַמְּרוֹמִים"
      ]
    },
    {
      "label": "3",
      "lines": [
        "אֵיךְ מֻשְׁפָּל וּמְבֻזֶּה",
        "בֵּינֵינוּ הָאָדוֹן נִרְאָה",
        "בְּעֵינֵי הָעוֹבְרִים",
        "רָאוּי לָאֲבַדּוֹן",
        "וְהוּא מְחֹלָל מִפְּשָׁעִי",
        "מְקַבֵּל חֶרְפַּת הַפְּדוּת",
        "מַפְגִּיעַ בַּאֲשֶׁר אָהַב",
        "בִּישׁוּעָה לָעַד"
      ]
    }
  ],
  "chorus_he": "זֶה אִישׁ מַכְאֹבוֹת · וִידוּעַ חֹלִי · כָּבוֹד לוֹ נִרְאֶה · מֻכְתָּר בַּכָּבוֹד · עַל שִׂיאֵי הָעוֹלָמוֹת · יֵשׁוּעַ"
