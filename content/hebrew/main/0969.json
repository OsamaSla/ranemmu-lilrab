  "title_he": "אֱלֹהַי בְּקָרְבָּתְךָ",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "אֱלֹהַי בְּקָרְבָּתְךָ",
        "אֶשְׂמַח כָּל־הַיָּמִים",
        "אֱלֹהַי בְּעֶזְרָתְךָ",
        "אַכְרִיעַ גְּדוּדֵי אוֹיְבִים"
      ]
    },
    {
      "label": "1",
      "lines": [
        "אֱלֹהַי וְדוֹדִי",
        "תַּכְלִית הָאַהֲבָה",
        "פָּנֶיךָ הַמְּאִירִים אֲבַקֵּשׁ",
        "מַשְׂבִּיעַ הַלֵּב"
      ],
      "chorus": true
    },
    {
      "label": "2",
      "lines": [
        "אֱלֹהַי בְּאַהֲבָתְךָ",
        "תִּמְחֶה לִי דִּמְעָתִי",
        "מְשִׁיחִי בִּצְלָבְךָ",
        "סָלַחְתָּ לִמְעִילָתִי"
      ]
    },
    {
      "label": "3",
      "lines": [
        "דּוֹדִי וּמְנוּחָתִי",
        "אֶפֹּל בְּחֵיקֶךָ",
        "בְּחֶמְלָה וּבְשָׁלוֹם",
        "תִּתֶּן־לִי מֵאַהֲבָתֶךָ"
      ]
    }
  ],
  "chorus_he": "פְּזָמוֹן"
