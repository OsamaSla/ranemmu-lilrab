{
  "book": "main",
  "number": 936,
  "title_he": "לִבִּי דּוֹפֵק מֵחָדָשׁ",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "לִבִּי דּוֹפֵק מֵחָדָשׁ",
        "קוֹרֵא לְךָ אֲדֹנִי הַנֶּהְדָּר",
        "יוֹדֵעַ אֲנִי כִּי נָדַדְתִּי",
        "עַד אַהֲבָתְךָ עָזַבְתִּי",
        "וְנִסְמַכְתִּי וּבָטַחְתִּי",
        "עַל אַהֲבַת הָאֲחֵרִים",
        "וְיָגַעְתִּי כִּי מָצָאתִי",
        "כִּי אֵין רֵעַ",
        "וְשַׁבְתִּי כִּי יָדַעְתִּי",
        "כִּי אַתָּה הָאַהֲבָה הַיְחִידָה",
        "תּוּכַל לְהָצִיף",
        "גַּם בְּלִבִּי הַקָּטָן",
        "לְמַעַן אָשׁוּב מֵרָחוֹק",
        "בְּהֶגְיוֹן הָאַהֲבָה הַחֲדָשָׁה",
        "וְאֹהַב הָאֲחֵרִים",
        "אֹהַב כָּל־הָאֲחֵרִים"
      ]
    }
  ]
}
