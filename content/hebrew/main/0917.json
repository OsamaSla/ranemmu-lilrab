  "title_he": "גְּבוּרַת רוּחֲךָ תַּכְרִיעַ תִּשְׁחַק",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "בּוֹא בְּרוּחֲךָ חַזְּקֵנוּ",
        "וְאַמֵּץ בַּקְּשָׁיִים",
        "וְהַצֵּת אֵשׁ רוּחֲךָ בָּנוּ",
        "וְהַכְרֵז נִצְחוֹנוֹת"
      ],
      "chorus": true
    },
    {
      "label": "1",
      "lines": [
        "גְּבוּרַת רוּחֲךָ תַּכְרִיעַ תִּשְׁחַק",
        "כָּל־מַכְאוֹב וַאֲנָחוֹת",
        "גְּבוּרָה תְּשַׁחְרֵר תִּמְשַׁח תַּתִּיר",
        "תְּשַׁבֵּר כָּל־מִבְצָרִים"
      ]
    },
    {
      "label": "2",
      "lines": [
        "גְּבוּרַת רוּחֲךָ תְּמַלֵּא הֲוָיָתֵנוּ",
        "וְתִתֵּן לַלֵּב שָׁלוֹם",
        "גְּבוּרָה תָּכִין בָּנוּ אֱמוּנָתֵנוּ",
        "וְתִתְגָּרֶה בַּדִּמְיוֹנוֹת"
      ]
    },
    {
      "label": "3",
      "lines": [
        "גְּבוּרַת רוּחֲךָ תַּכְרִיז בָּנוּ",
        "תָּמִיד מְנַצְּחִים",
        "נְרַנֵּן הִנֵּה הַהַבְטָחָה מְלֵאָה אוֹתָנוּ",
        "וּבְךָ אֲנַחְנוּ מְנַצְּחִים"
      ]
