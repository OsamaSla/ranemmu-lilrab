  "verses_he": [
    {
      "label": "1",
      "lines": [
        "הוֹי הַחוֹטֵא הָעֵר",
        "עַד מָתַי תֻּטְעֶה",
        "הַבֵּט יֵשׁוּעַ עוֹמֵד",
        "וּשְׁמָעֵהוּ כִּי יִדְפֹּק"
      ]
    },
    {
      "label": "1",
      "lines": [
        "הָאָדוֹן יִקְרָאֲךָ הָעֵר",
        "וְאֵיךְ לֹא תִּשְׁמַע",
        "וְהַמָּוֶת בָּא מַהֵר",
        "וְהַמָּוֶת לֹא יֵהָדֵף"
      ],
      "chorus": true
    },
    {
      "label": "2",
      "lines": [
        "תִּדָּחֶה אִם דְּחִיתוֹ",
        "תִּקְרָא וְלֹא יִשְׁמַע",
        "לֹא הַמָּמוֹן לֹא הַמִּשְׁפָּחָה וְלֹא",
        "דָּבָר מָחָר יוֹעִיל"
      ]
    },
    {
      "label": "3",
      "lines": [
        "תֻּשְׁלַךְ אֲשֶׁר הָאֵשׁ לֹא",
        "תְּכֻבֶּה וְלֹא תִּשְׁקֹט",
        "וְהַתּוֹלַעַת לֹא תָּמוּת וְהַ",
        "חֹשֶׁךְ לֹא יִתְפַּזֵּר"
      ]
    },
    {
      "label": "4",
      "lines": [
        "וְקַבְּלֵהוּ תְּקֻבַּל בַּשָּׁמַיִם",
        "בִּכְבוֹדוֹ הָרָם",
        "תִּשָּׁאֵר שָׂמֵחַ תָּמִיד",
        "עִם עַמּוֹ כֻּלָּם"
      ]
    }
