  "title_he": "עִמִּי בַּדֶּרֶךְ, יָדִידִי הַיָּקָר",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "עִמִּי בַּדֶּרֶךְ, יָדִידִי הַיָּקָר",
        "וּבְתוֹךְ הַצָּרָה תּוֹשִׁיעֵנִי",
        "כִּי אֶקְרָא אֵלֶיךָ, מִיָּד אֶמְצָאֲךָ",
        "נְטֵה אֵלַי יָדֶיךָ וְתִסְמְכֵנִי"
      ]
    },
    {
      "label": "1",
      "lines": [
        "וְאַתָּה אוֹמֵר לִי: הִנְנִי עִמְּךָ",
        "בִּימִינִי אֹחֵז בְּךָ וַאֲרִימְךָ",
        "אֲנִי רֹעֲךָ תָּמִיד אֶרְעֶךָ",
        "וְעֵינַי עָלֶיךָ כָּל־הַיָּמִים, בְּנִי"
      ],
      "chorus": true
    },
    {
      "label": "2",
      "lines": [
        "אֶקְרָא אֵלֶיךָ, אֲדֹנָי, אֶמְצָאֲךָ לְצִדִּי",
        "מַרְגִּיעַ אֶת־לִבִּי וּמְרוֹמְמֵנִי",
        "בְּעֵת הַיִּסּוּרִים תָּבוֹא מִיָּד",
        "תִּתֵּן לִי שָׁלוֹם וְתַחֲזִיקֵנִי"
      ]
    },
    {
      "label": "3",
      "lines": [
        "אֶקְרָא אֵלֶיךָ דּוֹדִי, נַחֲלָתִי הַיְקָרָה",
        "הֱיֵה לִי עוֹנֶה בְּעֵת תְּפִלָּתִי",
        "אֶתְחַנֵּן אֵלֶיךָ שְׁמָעֵנִי, וּבְחֻלְשָׁתִי הָרִימֵנִי",
        "אֱלֹהַי, חַזֵּקְנִי בְּתוֹךְ צָרוֹתַי"
      ]
    },
    {
      "label": "4",
      "lines": [
        "בְּךָ אֲנִי גּוֹבֵר עַל כָּל־הַנִּסְיוֹנוֹת",
        "עִם הַצָּרוֹת, וְהָאוֹיֵב נִכְנַע",
        "כָּל־הַיָּמִים וְתָמִיד",
        "אֶחְסֶה בַּדָּם, הוֹי מְצֻלָּב"
