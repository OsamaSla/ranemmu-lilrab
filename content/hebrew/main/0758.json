{
  "book": "main",
  "number": 758,
  "title_he": "אֱלֹהַי אֲשֶׁר בְּמוֹתְךָ",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "אֱלֹהַי אֲשֶׁר בְּמוֹתְךָ",
        "בַּעֲדִי עָשִׂיתָ לִי פְּדוּת",
        "וּבְדָם יָרוּץ מִצִּדְּךָ",
        "בַּעֲדִי כִּסִּיתָ לִי הַחֹלִי",
        "אֲנִי חָפֵץ אוֹדֶה",
        "אֲנִי חָפֵץ אוֹדֶה",
        "אֲנִי חָפֵץ אֹמַר כִּי הַמַּשָּׂאוֹת",
        "הָיוּ מוֹטְטִים הֲוָיָתִי",
        "אַךְ אַתָּה בְּמוֹתְךָ בַּעֲדִי",
        "נָשָׂאתָ הַמַּשָּׂאוֹת מֵעָלַי יָקָר",
        "וְשָׁבַרְתָּ כְּבָלִים וְהֶעֱנַקְתָּ תְּרוּפָה",
        "וְנָתַתָּ מַרְפֵּא זוּלַת כָּל־מַרְפֵּא",
        "וְהִלְבַּשְׁתַּנִי אַדֶּרֶת הַצֶּדֶק",
        "תַּחַת הַבֶּגֶד הַבָּלֶה",
        "הָיִיתִי הַבֵּן הֶחָפְשִׁי",
        "כַּאֲשֶׁר נִשְׁתַּנָּה מַצָּבִי",
        "וְהִבְטַחְתָּ הַבְטָחוֹת",
        "הִבְטַחְתָּ שֵׁנִית תָּשׁוּב",
        "אָמֵן דּוֹדֵנוּ תָּבוֹא לָנוּ",
        "וּמִפְגָּשֵׁנוּ עִמָּךְ עַל הַנָּמֵל",
        "יְפַצֶּה סַבְלָנוּת שָׁנִים",
        "יְפַצֶּה אֹרֶךְ לֵילוֹתֵינוּ",
        "אֲנִי חָפֵץ אוֹדֶה",
        "אֲנִי חָפֵץ אוֹדֶה",
        "אֲנִי חָפֵץ אֹמַר אַהֲבָתְךָ",
        "לָנוּ הָיְתָה הוּא הַנִּצָּחוֹן",
        "עַל רַע רַב וְדֶרֶךְ מַשָּׂאוֹת",
        "הָיִיתָ אַתָּה הַגְּבוּרָה צַדִּיק",
        "תּוֹדָה דּוֹדִי יֵשׁוּעַ",
        "תּוֹדָה דּוֹדִי יֵשׁוּעַ"
      ]
    }
  ]
}
