{
  "book": "main",
  "number": 911,
  "title_he": "לַמְרוֹת הַכְּבָלִים הָיִיתָ הַהֲוָיָה",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "לַמְרוֹת הַכְּבָלִים הָיִיתָ הַהֲוָיָה",
        "אֲשֶׁר תְּשַׁנֶּה מַשְׁמָעוּת חַיָּי",
        "הַבְטָחָתְךָ זֹאת סִתְרִי אַהֲבָתְךָ רָצָה",
        "בְּלִבִּי וְדוֹפֶקֶת בְּתוֹךְ מוֹתִי",
        "וְתִבְקַע הָאֲפֵלָה וְתִשְׁבֵּנִי",
        "תָּסִיר דִּמְיוֹנוֹתַי וְתִשְׁמְרֵנִי",
        "תִּשְׁמְרֵנִי בְּאוֹרְךָ אֶתְאַמֵּץ",
        "וְיַחֲלֹף הַיָּגוֹן בְּבוֹאֲךָ אֵלָי"
      ]
    },
    {
      "label": "2",
      "lines": [
        "וּבְתוֹךְ חַיַּי הָיִיתָ מְצוּלָתִי",
        "מַעְיָנִי אֲשֶׁר יִשְׁפֹּעַ חֶמְלָה",
        "בְּתוֹךְ אֲנָחָתִי הָיִיתָ עוֹזְרִי",
        "תַּשְׁקֶה לִי קִרְבִּי הַצָּמֵא",
        "וְתַתִּיר הַמְּבוּכָה מֵרוּחִי",
        "תִּגַּע בִּי בִּגְבוּרָה בִּפְצָעַי",
        "תְּמַלְּאֵנִי בְּנִצָּחוֹן וְתַעֲשִׁירֵנִי",
        "תְּרִימֵנִי בְּיָדְךָ מִנְּהִיָּתִי"
      ]
    }
  ]
}
