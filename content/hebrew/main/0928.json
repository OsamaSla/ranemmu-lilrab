  "title_he": "אֲנִי כְּלִי שָׁחֹר שָׁבוּר חוֹלֶה",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "אֲנִי כְּלִי שָׁחֹר שָׁבוּר חוֹלֶה",
        "מְצָאַתְנִי יַד יוֹצֵר אֵין לוֹ דּוֹמֶה",
        "הָיִיתִי בְּיָדוֹ כְּלִי לָבָן יָפֶה"
      ]
    },
    {
      "label": "1",
      "lines": [
        "אֲנִי יָקָר בְּךָ יְקַר מִכָּל־אֲשֶׁר בְּחַיַּי",
        "כָּל־אֲשֶׁר הַשָּׂטָן הוֹזִיל בְּעֵינַי דְּבָרִי",
        "וְחֻלְשָׁתִי הָיְתָה מְבוּכָה וּשְׁתִיקָה וּדְמָמָה",
        "אֶזְכֹּר הִנֵּה דָּמְךָ הוּא מְחִירִי וְעֶרְכִּי"
      ],
      "chorus": true
    },
    {
      "label": "2",
      "lines": [
        "אֲנִי חַי בְּךָ נִשְׁמָתִי וּשְׁאִיפָתִי",
        "תַּנְחֵנִי יָדֶיךָ וְתָאִיר לִי דַּרְכִּי",
        "תָּמִיד אֶמְצָאֲךָ לְבַדְּךָ דּוֹדִי וְרֵעִי"
      ]
    },
    {
      "label": "3",
      "lines": [
        "אֲנִי מְחַכֶּה לְךָ בְּכָל־יוֹם רֹעִי",
        "אָרוּץ אֲסַפֵּר עִמְּךָ וְאֶשְׁמַע תְּשׁוּבָתְךָ עָלַי",
        "וּתְחַבְּקֵנִי אֵלֶיךָ אָבִי וּפוֹדִי"
      ]
    }
  ],
  "chorus_he": "פְּזָמוֹן"
