{
  "book": "main",
  "number": 661,
  "title_he": "נוֹתֵן הַשִּׁירִים בְּלֵיל מַכְאוֹבַי",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "נוֹתֵן הַשִּׁירִים",
        "בְּלֵיל מַכְאוֹבַי",
        "יִמְחֶה דִּמְעוֹתַי",
        "אֲדֹנִי שְׁלוֹמִי"
      ]
    },
    {
      "label": "2",
      "lines": [
        "חִדֵּשׁ שִׂכְלִי",
        "נִגֵּב דִּמְעִי",
        "הֵאִיר עֵינִי",
        "טִהֵר שָׁמְעִי"
      ]
    },
    {
      "label": "3",
      "lines": [
        "נְגִינוֹת נִבְלִי",
        "לַשִּׁיר שׁוּבִי",
        "לָאָדוֹן אַקְדִּישׁ",
        "תּוֹדָתִי וּסְגִידָתִי"
      ]
    },
    {
      "label": "4",
      "lines": [
        "מִזּוּלָתוֹ תִּשָּׁאֵר",
        "הַמְּתוּקָה מָרָה",
        "וְעִם יֵשׁוּעִי",
        "הַמָּרָה מְתוּקָה"
      ]
    }
  ]
}
