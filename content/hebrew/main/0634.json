        "הָאָדוֹן תָּמִיד רִאשׁוֹן",
        "כִּי הוּא אֲדֹנִי וֵאלֹהַי",
        "אַכְרִיז לוֹ אֶת־הַנֶּאֱמָנוּת"
      ],
      "chorus": true
    },
    {
      "label": "1",
      "lines": [
        "כְּבָר לָבַשׁ בָּשָׂר בַּעֲדִי",
        "וּפְדָנִי בַּצְּלָב",
        "מַכְרִיז לַכֹּל אַהֲבָה",
        "נַעֲלָה בֶּאֱמֶת וּמֻפְלָאָה"
      ]
    },
    {
      "label": "2",
      "lines": [
        "בְּדָמָיו כְּבָר קָנַנִי",
        "מֵרִים מֵעָלַי אֶת־הָעֹנֶשׁ",
        "וּבְרוּחוֹ הִנְחַנִי",
        "אֶל מַעְיְנוֹת הַיְשׁוּעָה"
      ]
    },
    {
      "label": "3",
      "lines": [
        "הִנּוֹ רֹעֶה חַיַּי",
        "מַנְהִיגִי וּמוֹרִי",
        "וּמוֹפְתִי בַּהֲלִיכָתִי",
        "מִי אֲשֶׁר בּוֹ אֶלְךְ בְּעִקְּבוֹתָיו"
      ]
    },
    {
      "label": "4",
      "lines": [
        "לֹא אֲנִי אֶלָּא הַמָּשִׁיחַ",
        "זֹאת סִיסְמָתִי הוֹי קָהָל",
        "בְּחַיַּי, בְּדִבּוּרִי",
        "יִשָּׁאֵר תָּמִיד רִאשׁוֹן"
      ]
    }
  ],
  "chorus_he": "פְּזָמוֹן"
