{
  "book": "main",
  "number": 730,
  "title_he": "אֵיזוֹ שִׂמְחָה לָנוּ",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "אֵיזוֹ שִׂמְחָה לָנוּ",
        "וְשָׂשׂוֹן וְנֶחָמָה",
        "בַּאֲשֶׁר בַּעֲדֵנוּ כִּלָּה",
        "וְעָלָה אֶל הַשָּׁמַיִם"
      ]
    },
    {
      "label": "2",
      "lines": [
        "מַרְאֵה הָאָדוֹן הַמַּזְהִיר",
        "בּוֹ שִׂמְחַת הַלְּבָבוֹת",
        "זוּלָתוֹ לֹא נִתְאַוֶּה",
        "וּבוֹ הַנֶּפֶשׁ תִּיטַב"
      ]
    },
    {
      "label": "3",
      "lines": [
        "וּבוֹ נְבַקֵּשׁ מָה",
        "מֵעַל אֲשֶׁר כְּבָר יָשַׁב",
        "אֲשֶׁר נַחֲלָתֵנוּ שָׁם",
        "לֹא יְטַמְּאֶנָּה טֻמְאָה"
      ]
    },
    {
      "label": "4",
      "lines": [
        "כִּי אֲשֶׁר בִּכְבוֹדוֹ",
        "בְּהוֹדוֹ נִמָּלֵא",
        "עוֹזְבִים מָה אַחַר",
        "כִּי בּוֹ לֹא נֻתְעֶה"
      ]
    },
    {
      "label": "5",
      "lines": [
        "אֵיךְ נְבַקֵּשׁ זוּלָתוֹ",
        "וְהוּא תַּכְלִית הַמִּשְׁאֵלָה",
        "הִנְנוּ נִכְסֹף לוֹ",
        "אַהֲבָתוֹ תְּכַתְּרֵנוּ"
      ]
    }
  ]
}
