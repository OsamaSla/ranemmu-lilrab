{
  "book": "main",
  "number": 953,
  "title_he": "חַיֶּיךָ אֵינָם מֻבְטָחִים בְּיָדֶיךָ",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "חַיֶּיךָ אֵינָם מֻבְטָחִים בְּיָדֶיךָ",
        "וּבִרְגָעִים הָעָם יָמוּתוּ",
        "קוֹל הָאָדוֹן יִקְרָא עָלֶיךָ",
        "וְכָל־פַּעַם הַהִזְדַּמְּנוּת תַּעֲבֹר"
      ]
    },
    {
      "label": "1",
      "lines": [
        "אֱמֹר לוֹ: רַחֲמֵנִי דַּי רִחוּק",
        "מְסֹר כָּל־חַיֶּיךָ לוֹ",
        "לָמָּה תִּשָּׁאֵר חַי בְּעִקְּשׁוּת",
        "הִנֵּה הַחַיִּים הַמֻּבְטָחִים בְּיָדָיו"
      ],
      "chorus": true
    },
    {
      "label": "2",
      "lines": [
        "לָמָּה תִּנָּחֵם עַל־חַיִּים יְקָרִים",
        "נֶחָמָתְךָ לֹא יִהְיוּ לָהּ גְּבוּלוֹת",
        "תִּצְעַק בַּנֶּצַח לְמִי",
        "הִזְדַּמְּנוּת וְאָבְדָה לֹא תָשׁוּב"
      ]
    },
    {
      "label": "3",
      "lines": [
        "מָה בָּעוֹלָם זוּלַת הַצָּרָה",
        "לָמָּה מְמָאֵן תִּשְׁמַע לַקּוֹל",
        "גְּדוֹל אָח וְנֶאֱמַן רֵעַ",
        "לֹא יוֹעִילְךָ אַחַר הַמָּוֶת"
      ]
    }
  ],
  "chorus_he": "פְּזָמוֹן"
}
