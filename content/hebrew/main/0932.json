  "number": 932,
  "title_he": "חַיֵּי הַמְּשִׁיחִיּוּת מְשִׁיחַ הַחַיִּים",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "חַיֵּי הַמְּשִׁיחִיּוּת מְשִׁיחַ הַחַיִּים",
        "דָּתִי הָאֲמִתִּית אִגֶּרֶת הַשָּׁמַיִם",
        "לְפָנֶיךָ לֹא אֵל אַחֲרֶיךָ לֹא אֵל",
        "מֶלֶךְ הַמְּלָכִים וַאֲדוֹן הָאֲדוֹנִים",
        "אֲדֹנִי וּמַלְכִּי יֵשׁוּעַ הַמָּשִׁיחַ"
      ]
    },
    {
      "label": "2",
      "lines": [
        "מְנוֹרַת הַמְּשִׁיחִיּוּת מְשִׁיחַ הַצְּלָב",
        "זֹאת הָאַהֲבָה הָאֱלֹהִית וְהַיְשׁוּעָה הַנִּפְלָאָה",
        "לֹא סְלִיחַת חֵטְא לֹא הֲלִיכַת שָׁמַיִם",
        "בִּלְתִּי אִם בְּדָמְךָ בִּלְתִּי אִם בִּפְדוּתֶךָ",
        "אֲדֹנִי וּמַלְכִּי יֵשׁוּעַ הַמָּשִׁיחַ"
      ]
    }
  ]
}
