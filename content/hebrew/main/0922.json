  "verses_he": [
    {
      "label": "1",
      "lines": [
        "אֲדֹנָי בָּנֶיךָ צְמֵאִים",
        "וְהַמַּיִם כָּלוּ מִן־הַנְּהָרוֹת",
        "הַמָּטָר מֵאִתְּךָ מְבַקְּשִׁים",
        "אַרְצֵנוּ נִכְסֶפֶת לַגְּשָׁמִים",
        "בּוֹטְחִים בְּהַבְטָחָתְךָ הַנֶּאֱמָנָה",
        "תִּשְׁפֹּךְ שִׁטְפוֹנוֹת עַל הַיְשִׁימוֹן",
        "תָּבוֹא וּתְשַׁלֵּם שָׁנִים",
        "אֲשֶׁר בָּהֶן הָאַרְבֶּה אָכַל הַיֶּרֶק"
      ]
    },
    {
      "label": "1",
      "lines": [
        "מְלֹךְ וְשִׁלֹּט נֶהְדָּר בְּתוֹכֵנוּ",
        "כְּבוֹדְךָ יָשׁוּב מֵחָדָשׁ יְכַסֵּנוּ",
        "וּלְעַמֵּנוּ שׁוּב וֶהְיֵה שֵׁנִית אֵל",
        "וּלְאַרְצֵנוּ תָּשׁוּב תָּשִׁיב הַחַיִּים"
      ],
      "chorus": true
    },
    {
      "label": "2",
      "lines": [
        "יָגַעְנוּ מֵרֹב הַדִּבּוּר",
        "וְזִכְרוֹנוֹת עֵת הַכָּבוֹד",
        "רַבּוּ סְבִיבֵנוּ הָעֲצָמוֹת",
        "וְהָרוּחַ נִפְרָד מִן־הַגְּוִיּוֹת",
        "לְבַדְּךָ אֲדוֹן הַיְּקוּם",
        "תֵּדַע תְּחַיֵּנוּ מִן־הַקְּבָרִים",
        "רוּחֲךָ יְקַיֵּם הַחֲלוֹמוֹת",
        "וְיָשׁוּב עַמְּךָ הַמְּנֻצָּח"
      ]
