{
  "book": "main",
  "number": 753,
  "title_he": "הַקְדִּישׁוּ לָאָדוֹן שֶׁבַח",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "הַקְדִּישׁוּ לָאָדוֹן שֶׁבַח",
        "וּסְגִידָה כְּבָר חָבָה",
        "כִּי בְדָמוֹ פְּדָנוּ",
        "נוֹשֵׂא מֵעָלֵינוּ הַזַּעַם"
      ]
    },
    {
      "label": "2",
      "lines": [
        "הַקְדִּישׁוּ הַלֵּל וְתוֹדָה",
        "לַאֲשֶׁר כְּבָר עָלָה",
        "מִמַּעֲמַקֵּי הַקֶּבֶר קָם",
        "עוֹלֶה אֶל הַשָּׁמַיִם"
      ]
    },
    {
      "label": "3",
      "lines": [
        "פָּאֲרוּהוּ בָּרְכוּהוּ",
        "וּלְנַגֵּדֵל חַסְדּוֹ",
        "עִבְדוּהוּ כַּבְּדוּהוּ",
        "וּלְנַעֲרִיךְ פָּעֳלוֹ"
      ]
    },
    {
      "label": "4",
      "lines": [
        "מֵת בַּעֲדֵנוּ עֵת הָיִינוּ הַ",
        "כֹּל מֵתִים חַטָּאִים",
        "וּבְמוֹתוֹ הֶעֱנִיק אֲשֶׁר",
        "הָיָה מֵת הַחַיִּים"
      ]
    },
    {
      "label": "5",
      "lines": [
        "מַעֲנִיק לָנוּ מָקוֹם",
        "עִמּוֹ בְּתוֹךְ הַפָּרֹכֶת",
        "וְלָנוּ יָבוֹא מַהֵר",
        "לַיְשׁוּעָה הַמְּשֻׁבַּחַת"
      ]
    }
  ]
}
