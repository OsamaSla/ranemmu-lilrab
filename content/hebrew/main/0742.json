{
  "book": "main",
  "number": 742,
  "title_he": "כָּל־הַבְּרִיאָה אֲשֶׁר",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "כָּל־הַבְּרִיאָה אֲשֶׁר",
        "בָּאָרֶץ וּבַשָּׁמַיִם יַחְדָּו",
        "תַּכְרִיז חָכְמָה לָךְ",
        "וּגְבוּרָה רְחָבָה",
        "תּוֹדֶה כִּי הִנְּךָ",
        "אֶהְיֶה הַגָּדוֹל הָרָם"
      ]
    },
    {
      "label": "2",
      "lines": [
        "הוֹי לוֹ מֵאַהֲבָה נִפְלָאָה",
        "וְרַחֲמִים בְּלִי גְּבוּלוֹת",
        "הֵרַקְתָּ עַצְמְךָ וּבָא",
        "תָּ שֶׂה יִפְדֶּה הָעֲבָדִים",
        "שֵׂה הָאֱלֹהִים כְּבָר",
        "שָׁבָנוּ זֹאת הָאַהֲבָה הַחֲזָקָה"
      ]
    },
    {
      "label": "3",
      "lines": [
        "וְכַאֲשֶׁר נִרְאֲךָ בַּגָּן",
        "תִּטֹּף בַּיָּגוֹן דָּם",
        "נִתְפַּלֵּא מֵחֶסֶד",
        "בּוֹ סָבַלְתָּ הַמַּכְאוֹב",
        "תֵּן לָנוּ לָכֵן נְנַשֵּׁק",
        "בָּאַהֲבָה אֲדֹנִי הָרֶגֶל"
      ]
    },
    {
      "label": "4",
      "lines": [
        "אַךְ לִפְנֵי מוֹתְךָ",
        "בַּצְּלָב וְהַחֶרְפָּה הַמַּשְׁפִּילָה",
        "לֹא יַשְׁלִימְךָ שִׁבְחֵנוּ",
        "לוּ הֻקְדַּשׁ אֹרֶךְ הַשָּׁנִים",
        "וְקַבֵּל שְׁפִיכַת אַהֲבָתֵנוּ",
        "וְנִרְדֵּנוּ הַיָּקָר"
      ]
    }
  ]
}
