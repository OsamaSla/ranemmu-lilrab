      "lines": [
        "בְּאֵבוּס שָׁפָל",
        "בְּבַיִת קָטָן",
        "בָּא בֶּן־הָאָדָם",
        "כִּי אֵין בַּבַּיִת מָקוֹם"
      ]
    },
    {
      "label": "1",
      "lines": [
        "מִי יִתֵּן אֲדֹנִי",
        "לֹא תִשְׁכֹּן לִבִּי",
        "תָּסִיר מֵעָלַי הָעֲוֺנוֹת",
        "תַּעֲנִיק לִי הַשָּׁלוֹם",
        "וְתִקַּח מִלִּבִּי",
        "כַּר לְרֹאשְׁךָ",
        "נַפְשִׁי לֹא תִשְׁקֹט בִּלְתִּי אִם",
        "בְּחֵיקְךָ אֲדֹנִי בְּחֵיקְךָ"
      ],
      "chorus": true
    },
    {
      "label": "2",
      "lines": [
        "מַעֲנִיק הַצִּפֳּרִים",
        "קֵן וּמָקוֹם",
        "לֹא הָיָה לוֹ",
        "בְּאַרְצוֹ כָּל־מָקוֹם"
      ]
    },
    {
      "label": "3",
      "lines": [
        "פּוֹדִי אַתָּה",
        "מְקוֹר הָאֹשֶׁר",
        "לוּלֵא אַהֲבָתְךָ",
        "לֹא הָיְתָה לִי כָּל־תִּקְוָה"
      ]
    },
    {
      "label": "4",
      "lines": [
        "אֲדוֹן הַשָּׁמַיִם",
        "אֲדֹנִי הַמָּשִׁיחַ",
        "לְשִׁמְךָ יָאֶה",
        "כָּל־פְּאֵר וּתְהִלָּה"
      ]
    }
