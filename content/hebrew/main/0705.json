{
  "book": "main",
  "number": 705,
  "title_he": "אֵיזֶה מַשָּׂא כְּבָר קִבַּלְתָּ",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "אֵיזֶה מַשָּׂא כְּבָר קִבַּלְתָּ",
        "אֲדֹנֵנוּ הַפּוֹדֶה הַגָּדוֹל",
        "בִּבְחִירָה כְּבָר צִיַּתָּ",
        "וַיִּט הָרֹאשׁ הַנָּדִיב"
      ]
    },
    {
      "label": "2",
      "lines": [
        "פָּנֶיךָ מַזְהִירֵי הַיֹּפִי",
        "עֲלֵיהֶם הַדָּם הַשּׁוֹפֵעַ",
        "מָשְׁחָת הָיָה בַּעֲדִי",
        "וְהוּא צֶלֶם הַגִּבּוֹר"
      ]
    },
    {
      "label": "3",
      "lines": [
        "זִרְמֵי הָאֵל סָעֲרוּ",
        "עַל רֹאשְׁךָ הַנִּכְבָּד",
        "זַעַם הַצֶּדֶק נָשָׂאתָ",
        "כִּי נֶחְשַׁבְתָּ כַּתְּמוּרָה"
      ]
    },
    {
      "label": "4",
      "lines": [
        "מֵהָאֵל כְּבָר נֶעֱזַבְתָּ",
        "בְּתוֹךְ שְׁעוֹת הַחֹשֶׁךְ",
        "כָּל־חוֹבֵנוּ שִׁלַּמְתָּ",
        "וְהֶעֱנַקְתָּ לָנוּ הַשָּׁלוֹם"
      ]
    },
    {
      "label": "5",
      "lines": [
        "הוֹי דּוֹד הַלֵּב הַלֵּל",
        "לַיְשׁוּעָה וְלַתִּקְוָה",
        "עוֹד מְעַט נִהְיֶה",
        "עִמְּךָ בִּכְבוֹד הַשָּׁמַיִם"
      ]
    }
  ]
}
