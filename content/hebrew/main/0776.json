{
  "book": "main",
  "number": 776,
  "title_he": "הָיִיתִי בְּאִוַּלְתִּי עִקֵּשׁ",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "פְּתַח לִבִּי הַקָּשֶׁה",
        "וּמְלֹךְ בּוֹ יֵשׁוּעַ",
        "הָיִיתִי חַי וַאֲנִי שׁוֹכֵחַ",
        "בְּלִי כָּל־שִׁיבָה"
      ],
      "chorus": true
    },
    {
      "label": "1",
      "lines": [
        "הָיִיתִי בְּאִוַּלְתִּי עִקֵּשׁ",
        "דּוֹחֶה קוֹלְךָ לִי",
        "וְאַתָּה מוֹשִׁיט לִי הַיָּד",
        "בְּרַחֲמִים שְׁמֵימִיִּים"
      ]
    },
    {
      "label": "2",
      "lines": [
        "רַבּוֹת שָׁמַעְתִּי הַרְבֵּה",
        "וְנִשְׁאַרְתִּי בַּחֲטָאַי",
        "וְדָחִיתִי הַשִּׁנּוּי",
        "וְחָיִיתִי לְעוֹלָמִי"
      ]
    },
    {
      "label": "3",
      "lines": [
        "הַשָּׂטָן קוֹשֵׁר יָדִי",
        "בְּשַׁלְשְׁלָאוֹת וּכְבָלִים",
        "נַפְשׁוֹ יִשָּׁאֵר אֲדוֹנִי",
        "אֵינֶנּוּ רוֹצֶה אָשׁוּב"
      ]
    },
    {
      "label": "4",
      "lines": [
        "וְהִנֵּה דִּמְעוֹת הַתְּשׁוּבָה",
        "מֵאָדָם נִזְקָק",
        "כִּי תָבוֹא וּתְרַפֵּא",
        "וְתִשָּׁאֵר לְנַפְשִׁי מַרְפֵּא"
      ]
    }
  ],
  "chorus_he": "פְּזָמוֹן"
}
