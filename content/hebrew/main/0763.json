{
  "book": "main",
  "number": 763,
  "title_he": "הָבָה זִכְרוּ כַּמָּה הִנְחָנוּ",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "הָבָה זִכְרוּ כַּמָּה הִנְחָנוּ",
        "בְּאוֹר עֲנָנִים אוֹ בְּאֵשׁ",
        "כַּמָּה הָיָה מוֹרֶה לָנוּ",
        "וְהַמָּן נָתַן בַּיְשִׁימוֹן",
        "הָבָה עִבְדוּ אָדוֹן לָכֶם",
        "הָבָה עִבְדוּהוּ בְּהִתְפָּאֲרוּת",
        "אִם הָיָה זֶה יָרַע לָכֶם",
        "הַשְׂכִּילוּ בַּבְּחִירָה",
        "וְאָנֹכִי וּבֵיתִי נַעֲבֹד אֶת־הָאָדוֹן",
        "עֲבוֹדָתִי אֶל אֱלֹהַי תּוֹסִיף לִי קִרְבָה"
      ]
    },
    {
      "label": "2",
      "lines": [
        "הַקְדָּשַׁת נַפְשִׁי תַּעֲנוּגִי",
        "כִּי הָאָדוֹן אוֹרִי לֹא זוּלָתוֹ",
        "מִשְׁתַּמֵּשׁ בִּרְצוֹנִי",
        "שִׂכְלִי וְלִבִּי בִּרְצוֹנוֹ",
        "הָבָה עִבְדוּ עִמִּי הָאֵל",
        "הָבָה שַׁאֲבוּ מֵי הַחַיִּים",
        "אוֹ בִּבְחִירַתְכֶם זוּלָתוֹ",
        "כִּי הָרַע לֹא נֵדַע שִׂיאוֹ",
        "וְאָנֹכִי וּבֵיתִי נַעֲבֹד אֶת־הָאָדוֹן",
        "מַקְדִּישׁ לוֹ חַיַּי וְיִרְצֶה אַהֲבָה"
      ]
    }
  ]
}
