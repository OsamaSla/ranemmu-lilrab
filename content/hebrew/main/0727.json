{
  "book": "main",
  "number": 727,
  "title_he": "נַפְשִׁי תָּמִיד חִשְׁבִי",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "נַפְשִׁי תָּמִיד חִשְׁבִי",
        "בַּאֲדֹנֵנוּ הַפּוֹדֶה הַיְּדִידוּתִי",
        "וְלוֹ תָּמִיד הַבִּיטִי",
        "כָּל־עוֹד הֱיוֹתֵךְ בְּזֶה הַקִּיּוּם"
      ]
    },
    {
      "label": "2",
      "lines": [
        "מַה־טּוֹב פּוֹדִי הַנָּדִיב",
        "כֵּן וּמַה־יִּיטַב",
        "וְכָל־לֵב יָשָׁר",
        "מִטּוּבוֹ יַשְׂבִּיעַ"
      ]
    },
    {
      "label": "3",
      "lines": [
        "אָדוֹן מְלֹךְ אַתָּה עַל",
        "רִגְשִׁי וּרְגָשׁוֹתַי",
        "וְתַבִּיטְנָה עֵינַי אֵלֶיךָ",
        "בִּמְצוּקֵי הַמַּעֲמַדִּים"
      ]
    },
    {
      "label": "4",
      "lines": [
        "אָדוֹן הַחֲלֵף מַבָּטִי",
        "מִכָּל־מַרְאֶה פֹּה",
        "כִּי כָּל־מַרְאֶה זוּלָתְךָ",
        "בּוֹ הַמְּרִירוּת וְהֶעָמָל"
      ]
    },
    {
      "label": "5",
      "lines": [
        "כָּל־עוֹד אַתָּה מִשְׁאֲלָתִי",
        "כִּי בְךָ תָּמִיד אֶשְׂמַח",
        "כָּל־עוֹד אַתָּה מַטָּרָתִי",
        "כִּי כָּל־כֹּבֶד אַשְׁלִיךְ"
      ]
    },
    {
      "label": "6",
      "lines": [
        "עָזְרֵנִי אֶחְיֶה בִּרְצוֹנֶךָ",
        "מְמַהֵר בְּזֶה הַמַּאֲבָק",
        "עֵינִי אֵלֶיךָ לֹא זוּלָתֶךָ",
        "עַד אֶזְכֶּה בַּמְּבֻקָּשׁ"
      ]
    },
    {
      "label": "7",
      "lines": [
        "הִנֵּה חַיַּי הַמְּעַיְּפִים",
        "יִכְלוּ אַחַר הַמְּעַט",
        "נַפְשִׁי הֱיִי מוֹדָה",
        "וְסַבְלָנוּתֵךְ הַסַּבְלָנוּת הַיָּפָה"
      ]
    },
    {
      "label": "8",
      "lines": [
        "וְעוֹד מְעַט תִּרְאִי",
        "בֶּעָנָן פּוֹדֵךְ הַיְּדִידוּתִי",
        "וְלוֹ תָּמִיד תּוֹדִי",
        "שָׁם בְּבֵית הַנֶּצַח"
      ]
    }
  ]
}
