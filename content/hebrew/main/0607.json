{
  "book": "main",
  "number": 607,
  "title_he": "כַּאֲשֶׁר אֵשֵׁב עִמָּךְ",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "כַּאֲשֶׁר אֵשֵׁב עִמָּךְ",
        "לָמָּה מַחְשַׁבְתִּי תֵּלֵךְ לְמֵרָחוֹק?",
        "וּבִמְקוֹם לְהִתְפַּלֵּל אֵלֶיךָ",
        "רוּחִי נִשְׁאֶרֶת תּוֹעָה?",
        "הֲלֹא יָקָר אַתָּה עַל לִבִּי",
        "מְקוֹר תִּקְוָתִי, נוֹשֵׂא עֲוֺנִי?"
      ]
    },
    {
      "label": "1",
      "lines": [
        "חַיָּב אַתָּה לִיקַר בְּעֵינַי יוֹתֵר וְיוֹתֵר",
        "וְאַהֲבָתְךָ בְּקֶרֶב לִבִּי תְּמַלֵּא וְתִגְדַּל",
        "חַיָּב אַתָּה לִהְיוֹת יָקָר",
        "וְאַהֲבָתִי אֵלֶיךָ תּוֹסִיף"
      ],
      "chorus": true
    },
    {
      "label": "2",
      "lines": [
        "כַּאֲשֶׁר אֵשֵׁב עִמָּךְ",
        "לָמָּה לֹא אֶמְצָא דִּבּוּר?",
        "בְּחֻלְשָׁתִי אֲחַכֶּה לָךְ",
        "אַךְ אֵין שָׁלוֹם בְּקִרְבִּי?",
        "הֲלֹא אָמַרְתָּ \"שְׁלוֹמִי לָךְ\"",
        "וְאַתָּה הַנּוֹשֵׂא מַשָּׂאִי עָלֶיךָ?"
      ]
    },
    {
      "label": "3",
      "lines": [
        "כַּאֲשֶׁר אֵשֵׁב עִמָּךְ",
        "אֵיפֹה יִהְיֶה הָרוּחַ?",
        "הַאִם הוּא אֲשֶׁר יְדַבֵּר אֵלֶיךָ",
        "אוֹ הַפְּצָעִים הֵם הַזּוֹעֲקִים?",
        "הֲלֹא הִבְטַחְתָּ רוּחֲךָ לָנוּ",
        "לְהַנְחוֹת, לַעֲזֹר וּלְחַזֵּק אוֹתָנוּ?"
      ]
    },
    {
      "label": "4",
      "lines": [
        "כַּאֲשֶׁר אֵשֵׁב עִמָּךְ",
        "לָמָּה אֶשְׁכַּח חֲסָדֶיךָ?",
        "מַלֵּא לִבִּי בִּשְׁמֵי מְרוֹמֶךָ",
        "וְאֶחְיֶה לְמַעַנְךָ?",
        "הֲלֹא שָׁב אַתָּה אֵלֵינוּ שֵׁנִית",
        "וְנַעֲזֹב מַכְאוֹבֵי עוֹלָם חוֹלֵף?"
      ]
    }
  ],
  "chorus_he": "פְּזָמוֹן"
}
