  "verses_he": [
    {
      "label": "1",
      "lines": [
        "כְּשֶׁקָּרָאנִי רִבּוֹנִי",
        "אָמַר לִי: בֹּא וָנוּחַ",
        "אִתִּי שָׁלוֹמְךָ",
        "אִתִּי לְךָ שְׂמָחוֹת",
        "מַדּוּעַ הַדְּאָגָה שׁוֹלֶטֶת בָּךְ",
        "מַדּוּעַ גַּבְּךָ כָּפוּף",
        "הַנִּיחֵנִי אֶחֱזֹה בְּיָדְךָ",
        "וְאוֹלִיכְךָ בְּשַׁלְוָה"
      ]
    },
    {
      "label": "2",
      "lines": [
        "כְּשָׁמַעְתִּי אֶת־קוֹלוֹ",
        "אָמַרְתִּי לוֹ: אֲדֹנִי",
        "אֵיךְ תִּקְרָא אֵלַי",
        "וַאֲנִי לֹא אֶכֹּל לָשֵׂאת חַטָּאתִי",
        "אָמַר לִי: דָּמִי מְטַהֵר",
        "מִכָּל הָרָעוֹת",
        "אֲנִי אוֹהֵב אֶת־הַחוֹטֵא",
        "וּמוֹצִיאוֹ אֶל־הָאוֹר"
      ]
    },
    {
      "label": "3",
      "lines": [
        "לִבִּי בַּשָּׁעָה הַהִיא שָׂמַח",
        "וְנִמְלָא מֵהָרוּחַ",
        "כְּשָׁמַעְתִּי אֶת־דְּבָרוֹ",
        "וְרָאִיתִי אֶת־הַפָּצוּעַ",
        "אֲדֹנִי בְּאַהֲבָתְךָ",
        "וְאֶחְיֶה לְךָ כָּל־יְמֵי חַיָּי",
        "טוֹב לִי לָשִׁיר וּלְהַרִיעַ",
        "וְאֶמְסֹר לְךָ אֶת־עִנְיָנִי"
      ]
    }
