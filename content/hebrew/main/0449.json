  "verses_he": [
    {
      "label": "1",
      "lines": [
        "אֲשׁוּב אֶל־מוֹלַדְתִּי",
        "מְדִינַת רִבּוֹן הַחַיִּים",
        "וְאֶקְרָא בְּשֵׁם הֶעָשִׁיר",
        "מַחֲסִי וּמִבְצָר הַיְשׁוּעָה"
      ]
    },
    {
      "label": "1",
      "lines": [
