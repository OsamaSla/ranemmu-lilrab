{
  "book": "main",
  "number": 823,
  "title_he": "יָבוֹא בְּעָנָן",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "יָבוֹא בְּעָנָן",
        "הַפּוֹדֶה הַנֶּאֱמָן הַהוּא",
        "סְבִיבוֹ הַמַּלְאָכִים גַּם",
        "עִם שׁוּרוֹת הַמְּנַצְּחִים",
        "שַׁבְּחוּהוּ שַׁבְּחוּהוּ",
        "הוֹי כָּל־הַמַּאֲמִינִים"
      ]
    },
    {
      "label": "2",
      "lines": [
        "יָבוֹא בְּעָנָן",
        "מִשִּׂיאֵי הַכָּבוֹד הַגָּדוֹל",
        "וְתִרְאֶנּוּ כָּל־עַיִן",
        "מֵאֹהֵב וּמִשּׂוֹנֵא",
        "כַּבְּדוּהוּ כַּבְּדוּהוּ",
        "הִנֵּה הוּא הָאָדוֹן הַנָּדִיב"
      ]
    },
    {
      "label": "3",
      "lines": [
        "יָבוֹא מִמְּרוֹמָיו",
        "לְמַעַן יָדִין הָעוֹלָמִים",
        "וְתִרְאֶה הַחַיִּים מִיָּד",
        "יִדְחֲקוּ הַיְּשֵׁנִים",
        "אֱלֹהַי אֱלֹהַי",
        "מִשְׁפָּטְךָ הַצֶּדֶק הַמְּבֹרָר"
      ]
    },
    {
      "label": "4",
      "lines": [
        "אָהּ מַה־טּוֹב יוֹם",
        "בּוֹ נִרְאֶה הַדּוֹד",
        "אֲשֶׁר פְּדָנוּ בְּדָמוֹ",
        "מְקַבֵּל חֶרְפַּת הַצְּלָב",
        "עוֹזֵר עוֹזֵר",
        "אַתָּה לִי טוֹב הַחֵלֶק"
      ]
    }
  ]
}
