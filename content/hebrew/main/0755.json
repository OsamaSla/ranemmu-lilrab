  "title_he": "אֶדְחֶה וּבִנְחִישׁוּת כָּל־שִׂיחַ",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "אֶדְחֶה וּבִנְחִישׁוּת כָּל־שִׂיחַ עִם",
        "הַשָּׂטָן וְאַכְרִיז דְּחִיָּתִי בְּלִי",
        "וְאֶדְחֶה כָּל־רְמִיָּה וַאֲנִי בְּמַאֲבָק",
        "לַקְּדֻשָּׁה וְאֶחֱסֶה בְּבֶן־הָאֱלֹהִים",
        "וְאָשִׁיב עָלָיו בַּכָּתוּב אָמַר הָאֵל",
        "וֶאֱמוּנָתִי וַדָּאִית כִּי הַנִּצְלָב הוּא הָאֵל",
        "וְהַדָּם מָגִנִּי וַאֲנַצֵּחַ בּוֹ",
        "וַאֲנִי מֵרִים דִּגְלִי אֲרַנֵּן לוֹ"
      ]
    },
    {
      "label": "1",
      "lines": [
        "וְהַמִּלְחָמָה תּוֹסִיף וְהַחֶרֶב בַּ",
        "יָּד חֶרֶב הָרוּחַ",
        "בַּסֶּלַע בֶּטַח וַאֲנִי",
        "בֶּאֱמוּנָה אַחַר הַפָּצוּעַ"
      ],
      "chorus": true
    },
    {
      "label": "2",
      "lines": [
        "אֶדְחֶה וּבִנְחִישׁוּת כָּל־מַסְלוּל עִם",
        "רְשָׁעִים לֹא לָעוֹלָם לֹא",
        "אֶדְחֶה בְּדִיּוּק שׂוֹם הַיָּד",
        "עִם יְלִידֵי עוֹלָם דָּחָה הָאֵל",
        "וַאֲנִי חַי בּוֹ אָעִיד לְאֵל אָהַב חַטָּאִים",
        "וּבִצְלִיבָתוֹ וּמוֹתוֹ נָתַן לִי חַיִּים נַעֲלִים חַיִּים",
        "וְהַהַבְטָחָה וַדָּאִית וַאֲנִי בּוֹטֵחַ בָּהּ",
        "כִּי הָעוֹלָם הַזֶּה מְנֻצָּח לוֹ"
      ]
