{
  "book": "main",
  "number": 704,
  "title_he": "מַעְיַן נְדִיבוּת מִדָּם זַךְ רָץ",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "מַעְיַן נְדִיבוּת מִדָּם זַךְ רָץ",
        "מִגּוּף פּוֹדֵנוּ אֲשֶׁר הֶחֱיָה הַיְּקוּם",
        "מְטַהֵר אֲשֶׁר רָחַץ",
        "בּוֹ לָבַשׁ צֶדֶק הַשֶּׂה"
      ]
    },
    {
      "label": "2",
      "lines": [
        "הוֹי שֶׂה כְּבָר מֵת בְּעַד מִין הָאָדָם",
        "זֶה הַדָּם הַיָּקָר תְּמִידִי הָרֹשֶׁם",
        "עַד יַצִּיל בַּשָּׁלוֹם",
        "קְהִלָּתוֹ עַל הַתֹּם"
      ]
    },
    {
      "label": "3",
      "lines": [
        "כַּאֲשֶׁר רָאִיתִי זֶרֶם הֵן הַדָּמִים",
        "בְּעֵין אֱמוּנָה בּוֹ יִשָּׁלֵל הָעִוָּרוֹן",
        "כְּבָר הָיָה אַהֲבַת מִי פָּדָה",
        "נוֹשֵׂא תּוֹדָתִי לָעַד"
      ]
    },
    {
      "label": "4",
      "lines": [
        "אִם הָיָה זֶה הַלָּשׁוֹן הָאִלֵּם",
        "בְּקִבְרוֹ חֵרֵשׁ לֹא יְדַבֵּר",
        "יָשִׁיר בְּהַלֵּל גָּדוֹל",
        "נַפְשִׁי לִנְדִיבוּת הַמַּעֲנִיק"
      ]
    }
  ]
}
