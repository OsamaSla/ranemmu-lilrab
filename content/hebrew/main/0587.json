{
  "book": "main",
  "number": 587,
  "title_he": "אֵין דָּבָר נִשְׁאָר לִי לְמַעַן אֶעֱשֶׂה",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "הָיִיתִי בַּעַל חוֹב לָעֶלְיוֹן",
        "בּוֹרֵא הַכֹּל",
        "וּפָרַע חוֹבִי אֲשֶׁר",
        "מֵת בַּעֲדִי"
      ]
    },
    {
      "label": "1",
      "lines": [
        "כְּבָר פָּרַע חוֹבִי",
        "כֻּלּוֹ הַשֶּׂה",
        "כַּאֲשֶׁר מֵת לָכֵן",
        "אָמַר כְּבָר נִשְׁלַם"
      ],
      "chorus": true
    },
    {
      "label": "2",
      "lines": [
        "כַּאֲשֶׁר בָּא מִכִּסְאוֹ",
        "לִפְדוּת הָאָדָם",
        "נִשְׁלַם מַאֲמַצּוֹ הֵנָּה",
        "בִּשְׁלֵמוּת הַמְּלָאכָה"
      ]
    },
    {
      "label": "3",
      "lines": [
        "הוֹי הַחוֹתֵר לְמַעַן",
        "יַשִּׂיג הַצֶּדֶק",
        "בְּטַח כִּי פּוֹדֶה הָאֲנָשִׁים כְּבָר",
        "הִשְׁלִים הַדָּבָר"
      ]
    },
    {
      "label": "4",
      "lines": [
        "טוֹבֵי הַמַּעֲשִׂים הִנָּם",
        "פְּרִי הָאֱמוּנָה",
        "הֶכְרֵחִיִים אַךְ הֵם",
        "אֵין בָּהֶם סְלִיחָה"
      ]
    },
    {
      "label": "5",
      "lines": [
        "אֶל הַפּוֹדֶה בְּרַחוּ",
        "הוֹי הַחַטָּאִים",
        "תִּלְבְּשׁוּ מִצִּדְקוֹ",
        "מְעִיל הַחַיִּים"
      ]
    }
  ],
  "chorus_he": "פְּזָמוֹן"
}
