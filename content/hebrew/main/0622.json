{
  "book": "main",
  "number": 622,
  "title_he": "הִכַּרְתִּי קוֹל אֲדֹנִי מִכָּל־הַקּוֹלוֹת",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "הִכַּרְתִּי קוֹל אֲדֹנִי",
        "מִכָּל־הַקּוֹלוֹת",
        "קוֹרֵא בְּנִגּוּן הָאַהֲבָה",
        "וּמֵעִיר אֶת־הַמֵּתִים",
        "שְׁמַעְתִּיו קוֹרֵא לִי",
        "בְּקוֹלוֹ הָרַחוּם",
        "הָלַכְתִּי אַחֲרָיו הֶחֱיַנִי",
        "וּפִזֵּר אֶת־הַיְּגוֹנוֹת"
      ]
    },
    {
      "label": "2",
      "lines": [
        "וְכַאֲשֶׁר בָּאתִי",
        "מִדַּחַף הָאַהֲבָה",
        "הִשְׁקַנִי וְרָוִיתִי",
        "מִטּוּבוֹ שֶׁל אֲדֹנִי",
        "וְכַאֲשֶׁר הִגַּעְתִּי",
        "לְתַחְתִּית הַצְּלָב",
        "בֶּאֱמֶת נִדְהַמְתִּי",
        "מִמַּרְאֵה הַדּוֹד"
      ]
    },
    {
      "label": "3",
      "lines": [
        "סָבַלְתָּ אֵימַת הַצְּלִיבָה",
        "יָדַעְתִּי מָה הַסִּבּוֹת",
        "אוֹי לִי בַּעֲבוּר חֶטְאִי",
        "טָעַמְתָּ זֶה הָעִנּוּי",
        "שָׁם רַךְ לִבִּי",
        "וְנָזְלוּ הַדְּמָעוֹת",
        "זָעַקְתִּי: אֲדֹנִי .. אֲדֹנִי",
        "דּוֹדִי יֵשׁוּעַ"
      ]
    }
  ]
}
