  "title_he": "כָּל־אֲשֶׁר רָאִיתִי דָּבָר מִיָּפְיֶךָ",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "כָּל־אֲשֶׁר רָאִיתִי דָּבָר מִיָּפְיֶךָ",
        "צָעַק לִבִּי הַלְלוּיָהּ",
        "כָּל־אֲשֶׁר הִשַּׂגְתִּי מִקְצָת מִשְּׁלֵמוּתֶךָ",
        "צָלַל קוֹלִי הַלְלוּיָהּ",
        "כָּל־אֲשֶׁר הִרְגַּשְׁתִּי דָּבָר מִגְּאוֹנֶךָ",
        "אָמַרְתִּי גַּם הַלְלוּיָהּ",
        "כָּל־אֲשֶׁר הַחֶסֶד שָׁפַע דַּרְכֶּךָ",
        "לְךָ כָּל־הַהַלְלוּיָהּ",
        "הַלְלוּיָהּ הַלְלוּיָהּ",
        "הַלְלוּיָהּ הַלְלוּיָהּ"
      ]
    },
    {
      "label": "2",
      "lines": [
        "כַּאֲשֶׁר יְצִיפֵנִי אַהֲבָתְךָ הֲצָפָה",
        "צָעַק לִבִּי לְךָ כָּבוֹד",
        "כַּאֲשֶׁר תִּהְיֶינָה סוֹדוֹתֶיךָ בְּגָלוּי",
        "צָלַל קוֹלִי לְךָ כָּבוֹד",
        "כַּאֲשֶׁר אָבִין מִמַּטְּרָתְךָ דָּבָר",
        "אָמַרְתִּי גַּם לְךָ כָּבוֹד",
        "הִנְּךָ הַמְּנַצֵּחַ וְהָעוֹשֶׂה נִצָּחוֹן",
        "לְךָ כָּבוֹד לְךָ כָּבוֹד",
        "הַלְלוּיָהּ הַלְלוּיָהּ",
        "הַלְלוּיָהּ הַלְלוּיָהּ"
      ]
    }
