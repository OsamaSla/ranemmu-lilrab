{
  "book": "main",
  "number": 918,
  "title_he": "אֶכְתֹּב לְךָ יָמַי אִגֶּרֶת",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "אֶכְתֹּב לְךָ יָמַי אִגֶּרֶת",
        "אַהֲבָה אַקְדִּישֶׁנָּה אֲדֹנִי אֵלֶיךָ",
        "וַאֲצַיֵּר לְךָ שִׁבְחִי סִפּוּר",
        "אֶשָּׁאֵר אָשִׁיר אוֹתוֹ מֶלֶךְ",
        "וַאֲנִי כָּל־אֲשֶׁר הִקְרַבְתִּי אֲדֹנִי",
        "אֶשָּׁאֵר תָּמִיד לְךָ חַיָּב",
        "הִנֵּה אַתָּה הִתְגַּשַּׁמְתָּ בַּעֲדִי",
        "וְנָשָׂאתָ כָּל־הַדְּאָגוֹת",
        "הִנֵּה הַחַיִּים מְאִירִים בְּךָ",
        "וְהַטּוֹב יְמַלֵּא וְיִשְׁפֹּעַ",
        "וְשָׂשׂוֹן בַּלֵּב וַדָּאי",
        "מִטְרוֹת הַבְּרָכָה יוֹסִיפוּ"
      ]
    },
    {
      "label": "2",
      "lines": [
        "כּוֹכַב הַשַּׁחַר הַנִּשְׂגָּב",
        "אֶעֱבֹד אוֹתְךָ וְאֶשְׁתַּחֲוֶה לָךְ",
        "וַאֲשַׁבֵּחַ שִׁמְךָ יָקָר",
        "הִנֵּה הַנִּצָּחוֹן מֻבְטָח בָּךְ",
        "נוֹתֵן לַצִּיץ עֲטָרוֹת",
        "וְהַצִּפּוֹר תָּמִיד שְׂבֵעָה",
        "כָּל־סוֹדוֹת הַתֵּבֵל בְּיָדֶיךָ",
        "יָרִיעַ לְךָ לִבִּי שָׂמֵחַ",
        "נוֹרָא אֲנִי נִכְנָע לָךְ",
        "יֵשׁוּעַ אֲנִי אַהֲבָתִי אֵלֶיךָ",
        "מַרְוֵנִי בִּמְצוּלַת עֵינֶיךָ",
        "כָּל־הָדָר וְכָבוֹד אֵלֶיךָ"
      ]
    },
    {
      "label": "3",
      "lines": [
        "יָמִים סְפוּרִים וְאֶפְגָּשְׁךָ",
        "עֵת הַמְּגוּרִים כְּבָר יֵעָלֵם",
        "רוּחִי תִּתְעַנֵּג וַאֲנִי קָרוֹב אֵלֶיךָ",
        "וַאֲנִי רוֹאֶה דְּמוּתְךָ דּוֹד",
        "אֲנִי מַבְטִיחַ בִּשְׁמֶיךָ מָקוֹם",
        "בֵּיתְךָ הָיָה לִי כְּתֹבֶת",
        "תַּעֲנִיק לִי עֲטָרוֹת וּכְתָרִים",
        "וְאֶתְעַנֵּג בַּאֲדוֹן הָעוֹלָמוֹת",
        "אֲנִי אֶשָּׁאֵר מְחַכֶּה לָךְ",
        "הִנֵּה בּוֹאֲךָ לִי קָרוֹב",
        "וְעֵינַי תִּהְיֶינָה בְּעֵינֶיךָ",
        "הוֹי לְשִׂמְחַת לִבִּי בָּךְ"
      ]
    }
  ]
}
