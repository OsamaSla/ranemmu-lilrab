  "title_he": "יִשְׂמַח לוּ תִּקְרָא לוֹ",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "יֵשׁ אֶחָד אֹהֵב אוֹתָךְ",
        "דּוֹפֵק עַל לִבֶּךָ",
        "הַנַּח לוֹ יִמְלֹךְ חַיֶּיךָ",
        "וּפְתַח לִבְּךָ לוֹ",
        "דַּבֵּר אֵלָיו תִּמְצָאֵהוּ שׁוֹמַעֲךָ",
        "מַרְגִּישׁ בְּךָ וּבְחֻלְשָׁתְךָ",
        "הוּא הַבּוֹרֵא אֲדוֹנְךָ",
        "נוֹשֵׂא אוֹתְךָ בְּתוֹךְ עֵינָיו"
      ],
      "chorus": true
    },
    {
      "label": "1",
      "lines": [
        "יִשְׂמַח לוּ תִּקְרָא לוֹ",
        "לוּ תִּקְרָא בְּשׂוֹרָתוֹ",
        "מִלִּבְּךָ הִתְפַּלֵּל לוֹ",
        "וְהַשְׁלֵךְ הַמַּשָּׂא עָלָיו",
        "לוּ הִרְגַּשְׁתָּ בַּבְּדִידוּת",
        "וְהִתְעַנֵּיתָ בְּחֹזֶק",
        "אֲדוֹנְךָ קוֹלוֹ קוֹרֵא",
        "לֵךְ הִתְוַדַּע בּוֹ"
      ]
    },
    {
      "label": "2",
      "lines": [
        "אֲדוֹנֵנוּ הַבְטָחָתוֹ וַדָּאִית",
        "לוּ יִהְיֶה לְךָ אָדוֹן",
        "יִתֵּן לְךָ חַיִּים חֲדָשִׁים",
        "וְהָרָע יִמְחֶה",
        "לָמָּה תּוֹעֶה מִתְנַכֵּר",
        "לָמָּה מֵאַהֲבָתוֹ תִּבְרַח",
        "לָמָּה מִן־הָעוֹלָם תִּשְׁתֶּה",
        "שָׂבְעֲךָ נִמְצָא בּוֹ"
      ]
    },
    {
      "label": "3",
      "lines": [
        "תָּבוֹךְ לָמָּה וְתִתְפַּלֵּא",
        "נַסֵּה רַק וּבְחַן",
        "לֵךְ לַפּוֹדֶה וּקְרַב",
        "פִּצְעֲךָ יְרַפֵּא",
        "לֵךְ תָּאֵר לוֹ מַצָּבֶיךָ",
        "אֶזְלַת יָדְךָ וּשְׁנוֹת פַּחְדֶּךָ",
        "בְּתוֹךְ הָאֲפֵלָה יִרְאֲךָ",
        "וְיִשָּׂאֲךָ בְּיָדָיו"
      ]
