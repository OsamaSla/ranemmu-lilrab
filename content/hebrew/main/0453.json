{
  "book": "main",
  "number": 453,
  "title_he": "בְּכֹחַ לְשֵׁם יֵשׁוּעַ שִׁירוּ וְרַנְּנוּ",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "בְּכֹחַ לְשֵׁם יֵשׁוּעַ",
        "שִׁירוּ וְרַנְּנוּ",
        "קִרְאוּ אֶת־הַמַּלְאָכִים אֵלָיו",
        "יִכְרְעוּ וְיִשְׁתַּחֲווּ"
      ]
    },
    {
      "label": "2",
      "lines": [
        "הָבִיאוּ לוֹ אֶת־הַכֶּתֶר אֲשֶׁר",
        "אֵין כָּמוֹהוּ",
        "וְהַכְתִּירוּ אֹתוֹ לְבַדּוֹ",
        "אָדוֹן עַל־הַכֹּל"
      ]
    },
    {
      "label": "3",
      "lines": [
        "לְפָנָיו כְּתָרֵיכֶם",
        "הַשְׁלִיכוּ בְּלִי תֵּחָה",
        "וְהַכְתִּירוּ אֹתוֹ לְבַדּוֹ",
        "אָדוֹן עַל־הַכֹּל"
      ]
    },
    {
      "label": "4",
      "lines": [
        "וְאַהֲבָתוֹ לָכֶם, הוֹי",
        "חַטָּאִים, מַקִּיפָתְכֶם",
        "לָכֵן אֵלָיו כֻּלְּכֶם",
        "לְכוּ וּמַהֲרוּ"
      ]
    },
    {
      "label": "5",
      "lines": [
        "מִי יִתֵּן לָנוּ עִם־עֲדַת",
        "הַקְּדוֹשִׁים שֻׁתָּפוּת שְׁלֵמָה",
        "וְעַל־אַדְמַת רַגְלָיו",
        "נִכְרַע בְּיִרְאָה וָכָבוֹד"
      ]
    },
    {
      "label": "6",
      "lines": [
        "נָשִׁיר אֶת־הַשִּׁיר",
        "מִקֶּדֶם שָׁרְשָׁהּ",
        "וְנַחְפֹּץ לְכַתֵּר אֶת־יֵשׁוּעַ",
        "אָדוֹן עַל־הַכֹּל"
      ]
    }
  ]
}
