  "title_he": "הַגּוּרִים · אוּלַי יַחְסְרוּ",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "הַגּוּרִים · אוּלַי יִרְעֲבוּ",
        "וְהָאֲרָיוֹת · מֵתוֹת מֵרָעָב",
        "וַאֲדֹנָי · הַמָּתֹק לֹא יוּכַל",
        "לַעֲזֹב אֶת בְּנוֹ · לְהִרְגִּישׁ רָעָב"
      ]
    },
    {
      "label": "1",
      "lines": [
        "לָמָּה תִּדְאַג · וְלָמָּה תִּפְחָד",
        "וְעִמְּךָ · רֹעֶה הַצֹּאן",
        "אֲשֶׁר הִבְטִיחַ · בְּחַסְדּוֹ לִשְּׂאֵם",
        "כָּל צֹאנוֹ · עַל הַכְּתֵפִים"
      ],
      "chorus": true
    },
    {
      "label": "2",
      "lines": [
        "בְּתוֹךְ דִּמְעוֹתֶיךָ · בְּתוֹךְ אֲנָחוֹתֶיךָ",
        "לִבִּי רַךְ · מִתְאַנֵּחַ עִמְּךָ",
        "אָפְצַע וַאֶחֱבֹשׁ · אָדַכֵּא וַאֲרַפֵּא",
        "אַל תִּפְחָד · אֲנִי לֹא אֶשְׁכָּחֲךָ"
      ]
    },
    {
      "label": "3",
      "lines": [
        "פּוֹתֵחַ יָדוֹ · וְשׁוֹפֵךְ אֶת נַפְשׁוֹ",
        "יִשְׂנָא · שֶׁיִּהְיֶה בְּנוֹ חָסֵר",
        "נוֹתֵן · בְּעֹשֶׁר וְאַהֲבָה וְחָכְמָה",
        "נוֹתֵן · לִידִידוֹ עֵת שֵׁנָה"
      ]
