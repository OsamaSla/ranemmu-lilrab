{
  "book": "main",
  "number": 825,
  "title_he": "שָׁמַעְתִּי קוֹלְךָ קוֹרֵא",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "שָׁמַעְתִּי קוֹלְךָ קוֹרֵא",
        "עָיֵף בּוֹא",
        "אֲנִי אֲנִיחֲךָ בְּנִי",
        "מִכֹּבֶד הַמַּשָּׂאוֹת",
        "אָבוֹא וְכֻלִּי חוֹבוֹת",
        "פֵּרְעוֹנָם נִמְנָע",
        "אָבוֹא וְלֹא אֶזְכֶּה",
        "דָּבָר זוּלַת הַכְּלָיָה"
      ]
    },
    {
      "label": "1",
      "lines": [
        "אֵלֶיךָ נִצְלָב",
        "מָסַרְתִּי קִצִּי",
        "כִּי אַתָּה נִצְלָב",
        "נָשָׂאתָ מַשָּׂאוֹתַי",
        "נָשְׂאוּ יָדֶיךָ",
        "שָׁם חֳלָיַי",
        "וְרָחֲצוּ דָּמֶיךָ",
        "כָּל־עֲוֺנוֹתַי",
        "מוֹשִׁיעִי יֵשׁוּעַ"
      ],
      "chorus": true
    },
    {
      "label": "2",
      "lines": [
        "כְּבָר הֵאַרְתָּ עֵינַי",
        "בְּחֹשֶׁךְ הַתְּעִיָּה",
        "וּכְבָר דָּלִיתָ חַיַּי",
        "מִמַּהֲמוֹרוֹת הָאֵימוֹת",
        "לֹא שַׁבְתִּי אֲבַקֵּשׁ אַרְמוֹנוֹת",
        "תִּפֹּלְנָה עַל הַחוֹל",
        "כִּי בְּךָ צוּר בֵּיתִי",
        "לִי שְׁלֵמוּת הַהַשָּׂגָה"
      ]
    },
    {
      "label": "3",
      "lines": [
        "הִלְבַּשְׁתַּנִי בַּצְּלָב",
        "בֶּגֶד מִן־הַשְּׁלֵמוּת",
        "וּבָחַרְתָּ בִּי בֵּן דּוֹד",
        "תַּרְוֵהוּ בַּטּוֹבוֹת",
        "אָז דָּאֲגוּ לִי יָדֶיךָ",
        "בַּחֲנִיָּה וּבַמַּסָּע",
        "וְעֵין אַהֲבָה עָלַי",
        "בַּיּוֹם וּבַלֵּילוֹת"
      ]
    },
    {
      "label": "4",
      "lines": [
        "יִכְלֶה הַקִּיּוּם וְיַעֲבֹר",
        "עָשְׁרוֹ וְהַיֹּפִי",
        "תִּשָּׁאַרְנָה פִּצְעֵי יָדַיִם",
        "לָעַד לֹא תָּמוּשׁ",
        "תְּסַפֵּר אַהֲבַת אָב",
        "עָלְתָה עַל שִׂיא הַדִּמְיוֹן",
        "יוֹם קְרָאַתְנִי בְּרֹךְ",
        "עָיֵף בּוֹא"
      ]
    }
  ],
  "chorus_he": "פְּזָמוֹן"
