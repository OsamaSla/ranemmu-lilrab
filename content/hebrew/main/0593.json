{
  "book": "main",
  "number": 593,
  "title_he": "כָּזְבוּ אֲשֶׁר אָמְרוּ הִנְנִי יָחִיד",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "כָּזְבוּ אֲשֶׁר אָמְרוּ הִנְנִי יָחִיד",
        "בָּאָרֶץ בְּלִי מִשְׁעָן",
        "אֲשֶׁר לָעֲגוּ מֵאֱמוּנָתִי",
        "בַּאֲדֹנִי הַנִּכְבָּד",
        "כָּזְבוּ אֲשֶׁר זִיְּפוּ הַדְּבָרִים",
        "וְנִכְנְעוּ לָעַצְמִיּוּת",
        "וְהֵפִיצוּ כִּי הָאֵל רָחוֹק רָחוֹק",
        "כְּמוֹ הַשָּׁמַיִם",
        "כָּזְבוּ כִּי הָאֵל יִרְעֵנִי כַּאֲשֶׁר",
        "יִרְעֶה הָאָב הַיְלָדִים",
        "וְהָאֵל יִשְׁמְרֵנִי אִם",
        "הֵרֵעוּ בִּי הַמַּצָּבִים",
        "וֵאלֹהַי בְּקָרְבִּי",
        "יַשְׂבִּיעֵנִי בָּאַהֲבָה",
        "וְיָאִיר לִי דַּרְכִּי",
        "וְיַגְשִׁים הַתִּקְווֹת, כָּזְבוּ"
      ]
    }
  ]
}
