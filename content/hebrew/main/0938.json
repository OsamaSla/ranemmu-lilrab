{
  "book": "main",
  "number": 938,
  "title_he": "אֲסָפָנוּ כִּסּוּף אֶחָד אֵלֶיךָ",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "אֲסָפָנוּ כִּסּוּף אֶחָד אֵלֶיךָ",
        "נִרְאֶה יָפְיְךָ מֶלֶךְ",
        "גַּע בְּמַרְאֶךָ בְּלִבֵּנוּ",
        "הַצָּמֵא וְשׁוֹקֵד קוֹרֵא לָךְ",
        "נְשַׁבֵּחַ הַשֵּׁם הַיָּפֶה",
        "וּתְרוּעָתֵנוּ לְךָ כָּל־הַשְּׁבִיל",
        "וְאִם עָבַר לַיְלָה אוֹ אָרְכָה אֲפֵלָה",
        "אוֹרְךָ יָאִיר כָּל־לָיְלָה",
        "נִכְסַפְנוּ לַשִּׂמְחָה עִמָּךְ",
        "וְנִכְסַפְנוּ נִתְעַנֵּג בִּרְצוֹנֶךָ",
        "הָסֵר הֶעָנָן וּמְחֵה הַדְּאָגוֹת",
        "נָרִים כַּנְפוֹתֵינוּ בִּשְׁמֶיךָ",
        "אָהּ אֲדוֹנִי אַהֲבָתְךָ",
        "תְּשַׂמַּח הַלֵּב הַקּוֹדֵר",
        "אָהּ אֲדוֹנִי חֶמְלָתְךָ",
        "מְנוּחַת הַבַּיִת לַגֵּר",
        "הָסֵר הֶעָנָן וּמְחֵה הַדְּאָגוֹת",
        "נָרִים כַּנְפוֹתֵינוּ בִּשְׁמֶיךָ"
      ]
    }
  ]
}
