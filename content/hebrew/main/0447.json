  "verses_he": [
    {
      "label": "1",
      "lines": [
        "הָאֱלֹהִים אֲשֶׁר לָנוּ",
        "הוּא לֹא יִטְּשֵׁנוּ",
        "כִּי אִם יַנְחֵנוּ וְיִשְׁמְרֵנוּ",
        "יָרַחֵם עָלֵינוּ"
      ]
    },
    {
      "label": "1",
      "lines": [
        "אֲדֹנֵינוּ לֹא יִשְׁכָּחֵנוּ",
        "וְהוּא תָּמִיד עִמָּנוּ",
        "בְּדֶרֶךְ הַחַיִּים הַזֹּאת",
        "מַנְהִיג לָנוּ"
      ],
      "chorus": true
    },
    {
      "label": "2",
      "lines": [
        "עִמָּנוּ בְּאֶמְצַע דַּרְכֵּנוּ",
        "מְשַׂמֵּחַ אֶת־לִבּוֹתֵינוּ",
        "וּבְצָרָתֵנוּ יְמַלֵּא",
        "כָּל־חֶסְרוֹנֵנוּ"
      ]
    },
    {
      "label": "3",
      "lines": [
