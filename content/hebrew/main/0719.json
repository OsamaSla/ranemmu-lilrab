{
  "book": "main",
  "number": 719,
  "title_he": "סְבִיבְךָ אֲנַחְנוּ נִתְאַסֵּף",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "סְבִיבְךָ אֲנַחְנוּ נִתְאַסֵּף",
        "אֲדֹנֵנוּ הַדּוֹד",
        "נִזְכֹּר גֹּדֶל אַהֲבָתְךָ",
        "לָנוּ עַל הַצְּלָב"
      ]
    },
    {
      "label": "2",
      "lines": [
        "הוֹי לוֹ אַהֲבָה שׁוֹפַעַת",
        "מִלִּבְּךָ תָּרוּץ",
        "בַּעֲדֵנוּ נֶחְשַׁבְתָּ אָשֵׁם",
        "עִם כִּי אַתָּה הַזַּכַּאי"
      ]
    },
    {
      "label": "3",
      "lines": [
        "וְכָכָה בַּעֲדֵנוּ",
        "כְּבָר מַתָּ בִּבְחִירָה",
        "כֵּן וּכְבָר צִוִּיתָנוּ",
        "כִּי נַעֲשֶׂה הַזִּכָּרוֹן"
      ]
    },
    {
      "label": "4",
      "lines": [
        "וְאַתָּה בַּעַל הַסְּעֻדָּה",
        "וְהָאָדוֹן לָנוּ",
        "מִיָּדְךָ נְחַכֶּה",
        "הַחֲלֻקָּה כֻּלָּנוּ"
      ]
    },
    {
      "label": "5",
      "lines": [
        "וְנֹאכַל וְנִשְׁתֶּה",
        "בַּתּוֹדָה הוֹי עָשִׁיר",
        "וְהַנֶּפֶשׁ בְּךָ תִּשְׂבַּע",
        "וּמִמְּךָ תִּרְוֶה"
      ]
    },
    {
      "label": "6",
      "lines": [
        "נִזְכֹּר תָּמִיד אַהֲבָתְךָ",
        "נִשְׂמַח גַּם בָּךְ",
        "וְנַגִּיד בְּמוֹתְךָ",
        "פֹּה עַד בּוֹאֲךָ"
      ]
    }
  ]
}
