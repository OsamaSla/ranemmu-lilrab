{
  "book": "main",
  "number": 690,
  "title_he": "הָאֵל אַהֲבָה וְאַהֲבָתוֹ",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "עַם הַמָּשִׁיחַ יְרַנֵּן",
        "וְיַגְבִּיהַּ תְּרוּעָתוֹ",
        "בְּעָשְׁרוֹ הָאָדוֹן מְכֻבָּד",
        "בִּשְׁלֵמוּתוֹ וְתֹאַרָיו"
      ],
      "chorus": true
    },
    {
      "label": "1",
      "lines": [
        "הָאֵל אַהֲבָה וְאַהֲבָתוֹ",
        "תְּרַפֵּא הֶחָלְיָן",
        "וֶאֱמוּנָתוֹ נְכוֹנָה וַאֲמִתּוֹ",
        "דּוֹר אַחַר דּוֹר",
        "יִשְׁלַח בַּקַּיִץ עֲנָנוֹ",
        "וּבַחֹרֶף מַחְסֶה לַאֲהוּבָיו",
        "וְדָמוֹ אֲשֶׁר רָץ בַּעֲדֵנוּ",
        "גְּדוֹל אוֹת"
      ]
    },
    {
      "label": "2",
      "lines": [
        "הָאֵל גָּדוֹל וּכְבוֹדוֹ",
        "כִּסָּה הֶעָנָן",
        "שְׁמוֹ נוֹרָא וּשְׁמוֹ",
        "אֲדוֹן הָאֲדוֹנִים",
        "יֶאֱסֹף עַמּוֹ יָשִׁירוּ",
        "יִשְׂמְחוּ בַּקִּרְבָה מִמֶּנּוּ",
        "וְכָל־עוֹד הוּא בְּקִרְבָּם",
        "תָּפִיחַ הַבְּשָׂמִים"
      ]
    },
    {
      "label": "3",
      "lines": [
        "הָאֵל בַּמִּשְׁפָּט צוֹדֵק",
        "יַצְדִּיק הֶעָשׁוּק",
        "וְעֵינָיו מְגַלּוֹת הָאֲמִתּוֹת",
        "וְהַכֹּל יָדוּעַ",
        "אֶשָּׁאֵר מֵרִיעַ וְשָׁר",
        "גַּם מִלֵּב כִּלְאִי",
        "אֱלֹהַי חַי וְיִשְׁמָעֵנִי",
        "וְיָסִיר הָעֲנָנִים"
      ]
    }
  ],
  "chorus_he": "פְּזָמוֹן"
}
