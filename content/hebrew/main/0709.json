  "verses_he": [
    {
      "label": "1",
      "lines": [
        "קוּם וְנַגֵּן הוֹי מְרַנֵּן",
        "בְּשֵׁם פּוֹדֵנוּ הַדּוֹד",
        "בְּרֹךְ הַנִּגּוּן גַּדֵּל",
        "אוֹתוֹ הָאִישׁ הַנִּפְלָא",
        "אוֹתוֹ הָרָם הַמִּדּוֹת",
        "בַּעַל הַכָּבוֹד הָרָם",
        "בּוֹרֵא כָּל־הַבְּרִיּוֹת",
        "הַלְלוּיָהּ הַלְלוּיָהּ נֹעַם חַסְדּוֹ מְחַיֶּה הַכֹּל",
        "נִצְחִי קַדְמוֹן",
        "הָיָה מִלִּפְנֵי הֶהָרִים",
        "וְהוּא וְהוּא קָדוֹשׁ זַךְ",
        "לוֹבֵשׁ לוֹבֵשׁ בֶּגֶד הַגָּאוֹן",
        "הוֹשַׁע נָא הוֹשַׁע נָא"
      ]
    },
    {
      "label": "2",
      "lines": [
        "שֶׁמֶשׁ צֶדֶק בַּעַל יֹפִי",
        "כּוֹכַב הַשַּׁחַר הַמֵּאִיר",
        "לְבַדּוֹ מֵכִיל הַשְּׁלֵמוּת",
        "אֵין לוֹ כְּלָל דּוֹמֶה",
        "מְנַצֵּחַ יָחִיד גִּבּוֹר",
        "כִּנּוּהוּ בָּאַרְיֵה",
        "מַחְסֶה פּוֹדֶה עוֹזֵר",
        "הַלְלוּיָהּ הַלְלוּיָהּ סַלְעֵנוּ הַחַי הַצּוּר",
        "שֹׁרֶשׁ דָּוִד הָרַחוּם",
        "צֶאֱצָאוֹ הַצַּדִּיק הַנֶּאֱמָן",
        "כֹּהֵן כֹּהֲנֵנוּ הָרָם הַנָּדִיב",
        "אוֹר אוֹר כָּל־הָעוֹלָמִים",
        "הוֹשַׁע נָא הוֹשַׁע נָא"
      ]
