  "title_he": "הָאָדוֹן רֹעִי, לֹא אֶחְסָר דָּבָר",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "הָאָדוֹן לִי רֹעֶה",
        "וְלֹא אֶחְסָר דָּבָר",
        "וְגַם אִם אֵלֵךְ בְּגֵיא",
        "גֵּיא צַלְמָוֶת",
        "לֹא אִירָא לְעוֹלָם, כָּל־עוֹד שֶׁלִּי רֹעֶה",
        "וְלֹא אִירָא לְעוֹלָם, כָּל־עוֹד אֲנִי עִם יֵשׁוּעַ"
      ],
      "chorus": true
    },
    {
      "label": "1",
      "lines": [
        "מֵרוּחֲךָ מַלֵּא אוֹתִי שִׂמְחָה",
        "עָזְרֵנִי לָלֶכֶת בָּאוֹר",
        "שְׁמֹרֵנִי מִכָּל־רָעוֹת",
        "הַצֵּל נַפְשִׁי, יֵשׁוּעַ",
        "כִּי אָנֹכִי בּוֹטֵחַ בַּאֲדֹנָי, בְּתוֹךְ צָרָתִי הוּא מְנַחֲמֵנִי",
        "וְאִם בְּיוֹם אֶחָד תֶּחֱלַשׁ נַפְשִׁי, הוּא תָּמִיד מְחַזֵּקֵנִי"
      ]
    }
  ],
  "chorus_he": "פְּזָמוֹן"
