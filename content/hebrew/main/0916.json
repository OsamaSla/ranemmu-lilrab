{
  "book": "main",
  "number": 916,
  "title_he": "חֲפֵצִים אֲדֹנָי נִהְיֶה",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "חֲפֵצִים אֲדֹנָי נִהְיֶה",
        "חַיִּים כְּפִי חֶפְצֶךָ",
        "חֲפֵצִים חַיֵּינוּ יִהְיוּ",
        "בִּטּוּי נָכוֹן עָלֶיךָ",
        "וְיִהְיוּ מַרְאוֹתֵינוּ",
        "חֲקוּקִים עַל־רִשְׁמֶךָ"
      ]
    },
    {
      "label": "2",
      "lines": [
        "וְתִמְצָא בָּנוּ כְּנִיעָה",
        "וְתִמְצָא בָּנוּ עֲנָוָה",
        "וְתִמְצָא בָּנוּ אַהֲבָתֶךָ",
        "וְתִמְצָא לֵב יֵשׁוּעַ"
      ]
    },
    {
      "label": "3",
      "lines": [
        "יֵשׁוּעַ מָלֵא בְּאַהֲבַת הָעָם",
        "וּבְהֶרְגֵּשׁ וּבְחִיּוּךְ",
        "וְטוּבוֹ יֵרָאֶה בְּכָל־מָקוֹם",
        "עִם הַחֶסֶד וּבַחֵן"
      ]
    },
    {
      "label": "4",
      "lines": [
        "וְלוֹ שִׁלְטוֹן עַל־הָעוֹלָמוֹת",
        "בְּפֹעַל הָרוּחַ וּבַדָּבָר",
        "שָׁלוֹם יוֹסִיף וּבְרִית חֲדָשָׁה",
        "עָלֵינוּ תִּשְׁפֹּעַ עֹשֶׁר וְרַחֲמִים"
      ]
    }
  ]
}
