  "title_he": "מִי זוּלָתְךָ יוֹדֵעַ נַפְשִׁי",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "מִי זוּלָתְךָ יוֹדֵעַ נַפְשִׁי",
        "כָּל־אֲשֶׁר בָּהּ בִּשְׁלֵמוּת",
        "יוֹדֵעַ מַחְשַׁבְתִּי וַאֲשֶׁר בְּלִבִּי",
        "אֵינֶנִּי נִזְקָק לְדִבּוּר",
        "מִי זוּלָתְךָ יוּכַל יַגִּיעַ",
        "לַחֹלִי בְּמַעֲמַקַּי",
        "תְּרַפֵּא וְתַרְפֵּא וְתַחְבֹּשׁ",
        "וְתָשִׁיב שְׂמָחוֹתַי"
      ]
    },
    {
      "label": "1",
      "lines": [
        "הָעָם נִזְקָק רְאִיָּה",
        "וּרְאָיוֹת עִם הוֹכָחָה",
        "אַךְ אַתָּה דּוֹדִי",
        "אֵינְךָ נִזְקָק לְבֵאוּר"
      ],
      "chorus": true
    },
    {
      "label": "2",
      "lines": [
        "וְאִם רָאִיתִי הָעֹשֶׁק בְּיוֹם",
        "אֶמְצָא הַחֵיק הַיָּקָר",
        "שָׂבְעִי וּמְנוּחָתִי וְתִקְוָתִי וְתַכְלִיתִי",
        "בְּכָל־מַצָּבַי",
        "לִי בְּךָ הַתַּגְמוּל",
        "וְהַשִּׂמְחָה וְהַשָּׁלוֹם",
        "גַּם לוּ הַתֵּבֵל חֹשֶׁךְ",
        "אוֹרְךָ מָלֵא הַיָּמִים"
      ]
    }
  ],
