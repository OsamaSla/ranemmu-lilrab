  "title_he": "נְבָרֶכְךָ מֶלֶךְ הַכָּבוֹד",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "נְבָרֶכְךָ מֶלֶךְ הַכָּבוֹד",
        "אֲדֹנֵינוּ וְגֹאֲלֵנוּ לָעַד",
        "נִשֵּׂאתָ רֹאשׁ עַל־כֹּל",
        "לְךָ אֲדֹנָי הַגְּבוּרָה וְהַשִּׁלְטוֹן",
        "יֵשׁוּעַ נָרִים שִׁמְךָ עָל",
        "יֵשׁוּעַ נָרִים שִׁמְךָ עַל־כָּל־שֵׁם",
        "כִּי הַהָדָר וְהַגָּאוֹן לְךָ לְבַדֶּךָ",
        "יֵשׁוּעַ נְבָרֵךְ שִׁמְךָ"
      ]
    }
  ]
