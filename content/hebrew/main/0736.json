  "title_he": "בְּתוֹךְ קוֹצֵי הַמַּכָּה",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "בְּתוֹךְ קוֹצֵי הַמַּכָּה",
        "תִּזַּבְנָה רַגְלַי דָּמִים",
        "וְהַהַבְטָחָה מַעְיַן הַתִּקְוָה",
        "אֲנִי לֹא אֶשְׁכָּחֵךְ"
      ]
    },
    {
      "label": "1",
      "lines": [
        "אֲנִי לֹא אֶשְׁכָּחֵךְ",
        "אֲנִי לֹא אֶשְׁכָּחֵךְ",
        "וּמִי יַפְחִיד אָמַר יֵשׁוּעַ",
        "אֲנִי לֹא אֶשְׁכָּחֵךְ"
      ],
      "chorus": true
    },
    {
      "label": "2",
      "lines": [
        "אִם הִקִּיף בִּי יָגוֹן מַכְאִיב",
        "אוֹ חָל בִּי אָסוֹן גָּדוֹל",
        "וּמַחְזָרִי הָאֹמֶר הַנָּדִיב",
        "אֲנִי לֹא אֶשְׁכָּחֵךְ"
      ]
    },
    {
      "label": "3",
      "lines": [
        "וְאִם הֶחְשִׁיךְ לֵיל הֶעָמָל",
        "סְבִיבִי וְאֵין מִנֶּחָמָה",
        "וְהָאָב הַבְטָחָתוֹ מִלּוּי",
        "אֲנִי לֹא אֶשְׁכָּחֵךְ"
      ]
    },
    {
      "label": "4",
      "lines": [
        "כִּי בַּעֲדִי בְּנוֹ הִקְרִיב",
        "וְהַטּוֹב מִמֶּנּוּ לִי נִשְׁלַם",
        "וְהַהַבְטָחָה יַצִּיבָה כָּהָר",
        "אֲנִי לֹא אֶשְׁכָּחֵךְ"
      ]
    }
  ],
  "chorus_he": "פְּזָמוֹן"
