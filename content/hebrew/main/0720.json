{
  "book": "main",
  "number": 720,
  "title_he": "סוֹד גָּדוֹל כְּבָר נִרְאָה",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "סוֹד גָּדוֹל כְּבָר נִרְאָה",
        "הָאֵל בָּא בַּבָּשָׂר",
        "בְּמוֹתוֹ נִשְׁלַם הַפְּדוּת",
        "וְעַתָּה חַי לָעַד"
      ]
    },
    {
      "label": "2",
      "lines": [
        "כִּי הִנּוֹ וְהוּא הֶעָשִׁיר",
        "בַּעֲדֵנוּ כְּבָר הִתְעַנָּה",
        "וּמְלֹא אַהֲבָה נִצְחִית",
        "עַל הַצְּלָב כְּבָר נִרְאָה"
      ]
    },
    {
      "label": "3",
      "lines": [
        "וּכְבוֹדוֹ מִי יֵדַע",
        "כִּי הִנּוֹ רָם וְעָלָה",
        "וְאַהֲבָתוֹ מִי יְתָאֵר",
        "כִּי לִשְׁמוֹ הַמְּדִיחַ יָאֶה"
      ]
    },
    {
      "label": "4",
      "lines": [
        "אֵיזֶה דּוֹד אֵפוֹא",
        "דּוֹמֶה לוֹ בֵּין הַיְּקוּם",
        "כִּי דָמוֹ הַזַּךְ רָץ",
        "מִגּוּפוֹ מְטַהֵר"
      ]
    },
    {
      "label": "5",
      "lines": [
        "כִּי הַמָּוֶת לֹא יָכֹל כִּי",
        "יְכַבֶּה לַהַב אַהֲבָתוֹ",
        "וְאַךְ הֶרְאָה מָה",
        "הָיָה לָנוּ בְּלִבּוֹ"
      ]
    },
    {
      "label": "6",
      "lines": [
        "הוֹי פֶּלֶא מֵאַהֲבָתוֹ",
        "לֹא נִרְאָה כְּלָל בְּאֶחָד",
        "כְּבָר פְּדָנוּ וְהָאָב",
        "כָּל־שִׂמְחָתוֹ מָצָא"
      ]
    },
    {
      "label": "7",
      "lines": [
        "וּבוֹ מְנוּחָה לָנוּ",
        "בְּצִלּוֹ יִיטַב הַיְּשִׁיבָה",
        "פֵּרוֹתָיו תַּעֲנוּגֵנוּ",
        "נֹכְחוּתוֹ תַּרְוֶה הַנְּפָשׁוֹת"
      ]
    },
    {
      "label": "8",
      "lines": [
        "וְכָל־אֲשֶׁר הָעַיִן תִּרְאֶה",
        "זִכָּרוֹן מַכְאוֹבֵי הַדּוֹד",
        "וְהַנֶּפֶשׁ תְּקַוֶּה כִּי יָבוֹא",
        "עַד נִרְאֵהוּ עוֹד מְעַט"
      ]
    }
  ]
}
