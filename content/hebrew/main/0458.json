  "verses_he": [
    {
      "label": "1",
      "lines": [
        "אַל תְּאַחֵר וְתֹאמַר: מָחָר",
        "וּמָחָר יַעֲבֹר כְּאֶתְמוֹל",
        "יוֹם אַחַר יוֹם חַיֵּינוּ רָצִים",
        "וְדַעְתְּךָ תָּמִיד תּוֹעָה וְסוֹרַחַת"
      ]
    },
    {
      "label": "1",
      "lines": [
        "רִאשׁוֹנָה",
        "בְּחֹן נַפְשְׁךָ וּשְׁאַל פַּעַם",
        "לָמָּה בָּאתִי מִן־הַשָּׁמַיִם בִּגְלָלְךָ",
        "לָמָּה הִכּוּנִי וְלָמָּה צָלְבוּנִי",
        "וְאֶת־מִשְׁפַּט הַמָּוֶת בִּצַעְתִּי בִּמְקוֹמְךָ"
      ],
      "chorus": true
    },
    {
      "label": "2",
      "lines": [
        "כָּל מַה שֶּׁהָעוֹלָם יִתֵּן לְךָ הֶבֶל",
        "וְהַשָּׂטָן הָעָרוּם מְנַסֵּךָ",
        "הוֹלֵךְ אַחֲרָיו וְעֵינֶיךָ עֻוֵּרוּ",
        "גּוֹרֵר יָדְךָ, וְאַתָּה הַמַּפְסִיד"
      ]
    },
    {
      "label": "3",
      "lines": [
        "אָהַבְתִּי אוֹתְךָ, אַתָּה, הוֹי חוֹטֵא",
        "בְּדָמִי פָּדִיתִיךָ וְאַתָּה הַפּוֹשֵׁעַ",
        "לֹא קָשָׁה עָלַי לְהַשְׁקוֹתְךָ אֶת־כּוֹסִי",
        "וְעוֹד בְּעִוְּתְךָ לִבְּךָ קָשֶׁה"
      ]
    },
    {
      "label": "3",
      "lines": [
        "שֵׁנִית",
        "בְּחֹן נַפְשְׁךָ וּשְׁאַל פַּעַם",
        "אָז תֵּדַע לָמָּה הִכּוּנִי",
        "בְּחֹן נַפְשְׁךָ וּשְׁאַל פַּעַם",
