{
  "book": "main",
  "number": 757,
  "title_he": "לוּ יוֹם אָחוּשׁ כִּי אַתָּה רָחוֹק",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "לוּ יוֹם אָחוּשׁ כִּי אַתָּה רָחוֹק",
        "מִמֶּנִּי שָׁם בַּשָּׁמַיִם",
        "וְאֶשְׁכַּח דְּבָרְךָ הַוַּדַּאי",
        "כִּי אַתָּה עִמָּדִי אֲדֹנִי פֹּה",
        "אֶמְצָאֲךָ תָּבוֹא אֶצְלִי קָרוֹב",
        "תְּמַלֵּא כָּל־חַיַּי אֹשֶׁר"
      ]
    },
    {
      "label": "2",
      "lines": [
        "וְתִשָּׁאֵר אַתָּה כַּאֲשֶׁר אַתָּה",
        "נֶאֱמָן בְּהַבְטָחוֹתֶיךָ",
        "תִּשְׁמֹר וְתָרִים וְתִשְׁפֹּעַ עָלַי",
        "בְּטוּבְךָ וּנְדִיבוּתֶךָ",
        "חָשׁ חֶמְלָתְךָ רוֹאֶה רַעְיָתְךָ",
        "נוֹגֵעַ נֹכְחוּתֶךָ"
      ]
    },
    {
      "label": "3",
      "lines": [
        "לוּ יוֹם יְמַלֵּא חַיַּי הַפַּחַד",
        "וְיֹאבַד מִלִּבִּי הַשָּׁלוֹם",
        "וְאֶשְׁכַּח דְּבָרְךָ הָרַחוּם",
        "כִּי אַתָּה עִמָּדִי אֹרֶךְ הַיָּמִים",
        "אֶמְצָאֲךָ לְצִדִּי תַּרְגִּיעַ לִבִּי",
        "וְעַל זְרוֹעֲךָ אֲדֹנִי אִישַׁן"
      ]
    },
    {
      "label": "4",
      "lines": [
        "לוּ יוֹם אָחוּשׁ בִּבְגִידַת חָבֵר",
        "יִזַּב לִבִּי פְּצָעִים",
        "וְאֶשְׁכַּח דְּבָרְךָ כִּי אַתָּה דֶּרֶךְ",
        "טוֹב וְחַיִּים וּשְׂמָחוֹת",
        "תָּבוֹא וּתְרַפֵּא הַלֵּב וְתַחְבֹּשׁ",
        "תְּגָרֵשׁ מִלִּבִּי הַיְּגוֹנוֹת"
      ]
    }
  ]
}
