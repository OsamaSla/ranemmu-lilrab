  "title_he": "עַל הָאֵל אֵפוֹא בְּטַח",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "עַל הָאֵל אֵפוֹא בְּטַח",
        "לַטּוֹב עוֹשֶׂה",
        "וֶהְיֵה נֶאֱמָן תָּמִיד",
        "לָאֱמֶת הוֹלֵךְ אַחֲרֶיהָ"
      ]
    },
    {
      "label": "1",
      "lines": [
        "הִתְעַנֵּג נָא בַּאֲדֹנֵנוּ",
        "יִתֵּן לְךָ אֲשֶׁר תַּחְפֹּץ",
        "מְסֹר דְּבָרֶיךָ לוֹ",
        "וְאַתָּה לֹא תִּיגַע"
      ],
      "chorus": true
    },
    {
      "label": "2",
      "lines": [
        "עָלָיו הֱיֵה בּוֹטֵחַ",
        "וְהוּא אֲשֶׁר יָרִיץ",
        "יוֹצִיא כָּאוֹר הַמַּזְהִיר",
        "אֲשֶׁר זָכִיתָ מִצֶּדֶק"
      ]
    },
    {
      "label": "3",
      "lines": [
        "כַּצָּהֳרַיִם צִדְקְךָ הַנִּסְתָּר",
        "יְשִׂימֵהוּ נִרְאֶה",
        "חַכֵּה הָאָדוֹן הָעֶלְיוֹן",
        "וֶהְיֵה לוֹ סַבְלָן"
      ]
    }
  ],
