  "title_he": "מָסַרְתִּי נַפְשִׁי בְּיָדֶיךָ",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "מָסַרְתִּי נַפְשִׁי בְּיָדֶיךָ",
        "רִבּוֹנִי יֵשׁוּעַ",
        "נְהֵגֵנִי וְאֶשָּׁעֵן עָלֶיךָ",
        "לְמַעַן אֲשָׂרֵת הֲמוֹנִים",
        "הֱיֵה שׁוֹמְרִי מִן־הַתּוֹעָה",
        "וּמַדְרִיכִי בְּכָל־מָצָב",
        "וְאֶת־לִבִּי קַדֵּשׁ וְאֶת־מַעֲשָׂי",
        "עַד אֶרְאֶה אֶת־יֵשׁוּעַ"
      ]
    },
    {
      "label": "1",
      "lines": [
        "כְּבָר דִּבַּרְתָּ מִקֹּדֶם",
        "מַעְיָן הַחֶסֶד",
        "הוֹי מוּטְרָף הַלֵּב בֹּא",
        "שְׁכֹן עִמִּי עַד תַּשִּׂיג",
        "הִנֵּה בְּקִרְבִי מַשָּׂג",
        "לַטּוֹב בְּיֵשׁוּעַ"
      ],
      "chorus": true
    },
    {
      "label": "2",
      "lines": [
        "אִם עִכְּרוּ חַיַּי הַדְּאָגוֹת",
        "אִם נִגַּשׁ הַחֹשֶׁךְ",
        "תִּמָּחֶינָה כָּל־הַעֲנָנִים",
        "מֵאֵת נוֹתֵן הַשָּׁלוֹם",
        "אֲדֹנָי מָגִנִּי וְתִקְוָתִי",
        "אֲדֹנָי אִם אָמַר עָשָׂה",
        "וְהָאַהֲבָה בּוֹ מוּשְׁלֶמֶת",
        "לָכֵן אֶרְאֶה אֶת־יֵשׁוּעַ"
      ]
    },
    {
      "label": "3",
      "lines": [
        "רִבּוֹנִי אֱחֹז בִּי וְנַהֵלְנִי",
        "לַטּוֹב, הוֹי מַשְׁפִּיעַ",
        "אֶקְרְאָה אֵלֶיךָ, רַחֵם וְהַרְאֵנִי",
        "מִמַּעְיָנְךָ הַמָּלֵא",
        "לְמַעַן אָשׁוּב מֵחָדָשׁ",
        "אֶשְׁתַּדֵּל וְאֶבְקֵשׁ עוֹד",
        "מֵחֶסֶד הַבְּרִית הַחֲדָשָׁה",
        "עַד אֶרְאֶה אֶת־יֵשׁוּעַ"
      ]
