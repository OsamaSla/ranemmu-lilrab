{
  "book": "main",
  "number": 706,
  "title_he": "הוֹי זֹהַר הַכָּבוֹד צֶלֶם הָעֶצֶם",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "הוֹי זֹהַר הַכָּבוֹד צֶלֶם הָעֶצֶם",
        "אַתָּה בֶּן־הָאֱלֹהִים אֲדוֹן הַחֶסֶד",
        "בִּפְנֵיךָ נִרְאֶה אַהֲבַת הָעֶלְיוֹן",
        "בִּפְנֵיךָ הַיָּפִים הַנֶּהְדָּרִים"
      ]
    },
    {
      "label": "2",
      "lines": [
        "הוֹי יְחִיד הָאָב הוֹי בֶּן־חֵיקוֹ",
        "מִי זוּלָתְךָ יַגִּיד עַל אַהֲבָתוֹ",
        "אַתָּה אֲשֶׁר הֶרְאֵיתָ אַהֲבָה בַּפְּדוּת",
        "לְאָשֵׁם מֵת בַּעֲוֺנוֹ"
      ]
    },
    {
      "label": "3",
      "lines": [
        "אַתָּה אֲשֶׁר תִּשָּׂא בַּגְּבוּרָה",
        "כָּל־דָּבָר אַף בָּרָאתָ הָעוֹלָמִים",
        "אַף כְּבָר תִּקַּנְתָּם בַּחָכְמָה",
        "כִּי הֵם יַרְאוּ כְּבוֹדְךָ בְּכָל־עֵת"
      ]
    },
    {
      "label": "4",
      "lines": [
        "הָיִיתָ תָּמִיד תַּעֲנוּג הָאֵל הָעֶלְיוֹן",
        "אֶחָד בָּעֶצֶם אַתָּה הַמָּשִׁיחַ",
        "הַאִם לָקַחְתָּ דְּמוּת הָעֶבֶד אֵפוֹא",
        "לְמַעַן תִּהְיֶה שֵׂה הָאֱלֹהִים הַזָּבוּחַ"
      ]
    },
    {
      "label": "5",
      "lines": [
        "הַאִם נָשָׂאתָ פִּשְׁעֵנוּ עַל הַצְּלָב",
        "זַעַם הַצֶּדֶק הָאֱלֹהִי הַנּוֹרָא",
        "מָה נְסַפֵּר אֲדֹנֵנוּ הַפּוֹדֶה הַנִּפְלָא",
        "לְךָ נִכְרַע בִּכְנִיעָה הוֹי דּוֹד"
      ]
    }
  ]
}
