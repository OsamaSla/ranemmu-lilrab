  "verses_he": [
    {
      "label": "1",
      "lines": [
        "אֲנִי הוֹלֵךְ וְאִתִּי אַתָּה",
        "שִׂמְחָה וְחֶבְרָה, שַׂשֹׂן שָׁמָיךָ",
        "כָּל דַּקָּה אֲנִי מַמְתִּין לְךָ",
        "אַתָּה מַנְחֵנִי לַעֲשׂוֹת רְצוֹנְךָ"
      ]
