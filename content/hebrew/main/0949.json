{
  "book": "main",
  "number": 949,
  "title_he": "שָׁאַלְתִּי נַפְשִׁי אֲנִי הָאֻמְלָל",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "שָׁאַלְתִּי נַפְשִׁי אֲנִי הָאֻמְלָל",
        "הֲיֵשׁ מוֹשִׁיעַ הֲיֵשׁ רַחוּם",
        "הָיִיתִי הוֹלֵךְ בַּיָּגוֹן לְבַדִּי",
        "צְעָדַי חוֹתְרִים לְעֵבֶר הַשְּׁאוֹל",
        "מַשָּׂאִי כָּבֵד חוֹבִי גָּדוֹל",
        "אָהּ מִי יִשָּׂא בַּעֲדִי הָעֹנֶשׁ",
        "אַיֵּה הַדֶּרֶךְ אַיֵּה הַשָּׁלוֹם",
        "אַיֵּה הַחַיִּים הֲיֵשׁ מַעֲנֶה",
        "קְרָא קְרָא בֵּין הַהֲמוֹנִים",
        "הָבָה בֹּאוּ לְיֵשׁוּעַ"
      ]
    },
    {
      "label": "2",
      "lines": [
        "נָזְלוּ דָּמָיו רָצִים בְּאַהֲבָה",
        "לְהַתִּיר שְׁבִי הָעֶבֶד הָאָשֵׁם",
        "גָּלְגָּלְתָּא הָיְתָה אוֹת נִצָּחוֹן",
        "קָם יֵשׁוּעַ בְּכָבוֹד גָּדוֹל",
        "עַצְמוֹ הָיָה כֹּפֶר רוּחִי",
        "זָכָה בְּעָנְשִׁי הַדּוֹד הַהוּא",
        "בּוֹ יְשׁוּעָתִי מְרַפֵּא פְּצָעַי",
        "הָיִיתִי מְחַפֵּשׂ וְהוּא הָרוֹפֵא",
        "קְרָא קְרָא בֵּין הַהֲמוֹנִים",
        "הָבָה בֹּאוּ לְיֵשׁוּעַ"
      ]
    },
    {
      "label": "3",
      "lines": [
        "כַּאֲשֶׁר מִהַרְתִּי לְעֵבֶר יֵשׁוּעַ",
        "בִּקַּשְׁתִּי מִמֶּנּוּ הַסְּלִיחָה הַוַּדָּאִית",
        "קָרַב אֵלַי בְּכָל־נֹעַם",
        "חֲנָנַנִי גַּם לֵב חָדָשׁ",
        "מֵת דּוֹדִי עַל־הַצְּלָב",
        "לְמַעַן יִפְדֶּה נַפְשִׁי מִן־הָעִנּוּי",
        "הָיָה חֵלֶק וְעוֹד מְעַט",
        "אֶרְאֶנּוּ עַל־הֶעָנָן",
        "קְרָא קְרָא בֵּין הַהֲמוֹנִים",
        "הָבָה בֹּאוּ לְיֵשׁוּעַ"
      ]
    }
  ]
}
