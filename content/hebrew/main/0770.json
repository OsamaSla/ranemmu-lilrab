{
  "book": "main",
  "number": 770,
  "title_he": "זִכְרוּ לִי שֵׁם יֵשׁוּעַ",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "זִכְרוּ לִי שֵׁם יֵשׁוּעַ",
        "הֶבֶל כָּל־זוּלָתוֹ",
        "שְׁמוֹ מָתוֹק יָקָר",
        "אֵינֶנִּי מַסִּיחַ דַּעַת מֵאַהֲבָתוֹ"
      ]
    },
    {
      "label": "2",
      "lines": [
        "זִכְרוּ לִי שֵׁם יֵשׁוּעַ",
        "הוֹי שָׁמַיִם הוֹי כּוֹכָבִים",
        "הוֹי צִבְאוֹת הָאָרֶץ כֻּלָּם",
        "הוֹי יַמִּים הוֹי מִדְבָּרִים"
      ]
    },
    {
      "label": "3",
      "lines": [
        "זִכְרוּ לִי שֵׁם יֵשׁוּעַ",
        "בָּאֲסוֹנוֹת וּבַצָּרוֹת",
        "כִּי הוּא יַסְפִּיק לִי נֶחָמָה",
        "בְּקָשׁוֹת הַפְּגָעִים"
      ]
    },
    {
      "label": "4",
      "lines": [
        "הוּא אָדָם וְיָחוּס",
        "לִבּוֹ עַל חֻלְשָׁתֵנוּ",
        "וֵאלֹהִים וְיַצִּיל",
        "יָכֹל בַּסְּלִיחָה מֵעָלֵינוּ"
      ]
    },
    {
      "label": "5",
      "lines": [
        "זִכְרוּ מוֹת אֲשֶׁר מִן",
        "בַּעֲדֵנוּ חַי וָמֵת",
        "אָמַר כְּבָר נִשְׁלַם כַּאֲשֶׁר",
        "מָסַר הָרוּחַ וּמֵת"
      ]
    },
    {
      "label": "6",
      "lines": [
        "זִכְרוּ לִי שֵׁם יֵשׁוּעַ",
        "כָּל־אֲשֶׁר נִרְאָה לִי שְׁמֹעַ קוֹל",
        "כִּי הוּא יִתֵּן יְשׁוּעָה",
        "וִינַחֵם בְּעֵת מוֹתִי"
      ]
    }
  ]
}
