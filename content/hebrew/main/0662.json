{
  "book": "main",
  "number": 662,
  "title_he": "לִי מָקוֹם נֶהְדָּר רָם",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "לִי מָקוֹם נֶהְדָּר נֹגַהּ",
        "כְּבוֹדוֹ עָלָה עַל אוֹר הַיּוֹם",
        "בַּמָּרוֹם אֲשֶׁר פּוֹדֶה הַיְּקוּם",
        "פָּנָיו כַּשֶּׁמֶשׁ הֵאִירוּ"
      ]
    },
    {
      "label": "1",
      "lines": [
        "נִפָּגֵשׁ עוֹד מְעַט",
        "סְבִיב כִּסֵּא הַנִּכְבָּד הַדּוֹד"
      ],
      "chorus": true
    },
    {
      "label": "2",
      "lines": [
        "נָשִׁיר אֵצֶל הַמִּפְגָּשׁ",
        "מְתֹק הַלֵּל פּוֹדֶה סַלָּח",
        "כִּי בוֹ זָכָה אוֹתוֹ הַמְּלוֹא",
        "מְנוּחָה עִם שְׁלֵמוּת הַשָּׂשׂוֹן"
      ]
    },
    {
      "label": "3",
      "lines": [
        "נַקְדִּישׁ אֶל אֲדֹנֵנוּ",
        "רֹב הַלֵּל תּוֹדָה נְפוֹצָה",
        "כִּי חֲנָנָנוּ בְּנוֹ פּוֹדֶה",
        "כְּשֶׂה לְמָוֶת מַכְאִיב"
      ]
    },
    {
      "label": "4",
      "lines": [
        "נִפָּגֵשׁ בַּמָּרוֹם אַחֲרֵי אֲשֶׁר",
        "יִכְלֶה מַסָּעֵנוּ מִפֹּה",
        "אֲשֶׁר יָגוֹן הָאֲבַדּוֹן יִכְלֶה",
        "אָז נִשְׁכַּח הֶעָמָל וְהַטֹּרַח"
      ]
    },
    {
      "label": "5",
      "lines": [
        "אֲשֶׁר נֻתַּן עֲטָרוֹתֵינוּ",
        "לִבְעָלוּת עִם הַמְנַצֵּחַ",
        "אוֹתוֹ אֲדוֹן הַמְּלָכִים הָעֶלְיוֹן",
        "אַרְיֵה מְנַצֵּחַ גִּבּוֹר"
      ]
    }
  ],
  "chorus_he": "1 נִפָּגֵשׁ עוֹד מְעַט · 2 סְבִיב כִּסֵּא הַנִּכְבָּד הַדּוֹד"
