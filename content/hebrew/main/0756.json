{
  "book": "main",
  "number": 756,
  "title_he": "הִנֵּה סִפּוּרִי עִם הָאֵל",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "הִנֵּה סִפּוּרִי עִם הָאֵל",
        "אֲשֶׁר כְּבָר בָּא אֵלַי מִמְּרוֹמָיו",
        "בָּא אֵלַי מְבַקֵּשׁ",
        "לִבִּי אֲשֶׁר בָּרַע תָּעָה",
        "טָעַם הַמַּכְאוֹבִים עַד־הַתֹּם",
        "בַּעֲדֵנוּ אֲנַחְנוּ הַחַטָּאִים",
        "נִדְכָּא בַּעֲדִי",
        "וְהוּא הָאֵל מַעֲנִיק הַחַיִּים"
      ]
    },
    {
      "label": "2",
      "lines": [
        "אָמַרְתִּי לְנַפְשִׁי הִנְנִי",
        "אֵינֶנִּי רָאוּי זֹאת הַפְּדוּת",
        "אַךְ הִנְנִי זַכַּאי",
        "כָּל־עֹנֶשׁ וּמִשְׁפָּט",
        "אַךְ הוּא אֲהֵבַנִי",
        "וְהִקְרִיב בַּעֲדִי הַדָּמִים",
        "מְתַקֵּן לִבִּי הַשָּׁבוּר",
        "וּמַעֲנִיק לִי הַנֶּחָמָה"
      ]
    },
    {
      "label": "3",
      "lines": [
        "לֹא סָבַלְתִּי כִּי אֶעֱמֹד",
        "לְעֻמַּת זֶה שׁוֹתֵק",
        "מִיָּד מִהַרְתִּי לְעֶבְרוֹ",
        "וְהָיָה קוֹלִי חָלוּשׁ",
        "וַיְחַבְּקֵנִי לְחָזֵהוּ",
        "עַד אֲשֶׁר שָׁקַטְתִּי דּוֹמֵם",
        "וַיָּצֵף אוֹתִי כָּל־הַשָּׁלוֹם",
        "וַיִּשָּׁאֵר אַהֲבָתִי נְכוֹנָה"
      ]
    }
  ]
}
