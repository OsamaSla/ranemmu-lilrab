{
  "book": "main",
  "number": 621,
  "title_he": "הוֹדוּ לַפּוֹדֶה כֻּלְּכֶם",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "הוֹדוּ לַפּוֹדֶה כֻּלְּכֶם",
        "וּנְרַנֵּן כֻּלָּנוּ",
        "שָׁכַן בָּאָרֶץ בְּשִׁפְלוּת",
        "וְכִלָּה אַהֲבָה בָּנוּ"
      ]
    },
    {
      "label": "2",
      "lines": [
        "קְרָאַנִי וְאֶעֱנֶה",
        "לִקְרִיאַת הָאַהֲבָה הַנֶּאֱמָנָה",
        "קוֹלוֹ עָרֵב לְלִבִּי",
        "וּבְעִקְּבוֹתָיו אֵלֵךְ"
      ]
    },
    {
      "label": "3",
      "lines": [
        "אַתָּה עָשְׁרִי וְאָשְׁרִי",
        "מִמְּךָ נַפְשִׁי תִּמָּלֵא",
        "אַתָּה עֲטַרְתִּי וּכְבוֹדִי",
        "בְּיָדֶיךָ מוֹעֲדִי"
      ]
    }
  ]
}
