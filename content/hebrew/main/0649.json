{
  "book": "main",
  "number": 649,
  "title_he": "הִנֵּה שָׁנָה מִן־הַשָּׁנִים",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "הִנֵּה שָׁנָה מִן־הַשָּׁנִים",
        "עָבְרָה וַאֲנִי כֻּלִּי אֲנָחָה",
        "וְהָאָדוֹן בָּא אֵלַי וְהֵטָה יָדוֹ",
        "אָמַר לִי קְרַב תֵּלֵךְ לְמִי",
        "אֶסְלַח לְךָ עֲוֺנְךָ וַאֲשַׂמַּח לִבְּךָ",
        "וְאֶשָּׁאֵר לְצִדְּךָ אֹרֶךְ הַשָּׁנִים"
      ]
    },
    {
      "label": "2",
      "lines": [
        "וְלָמָּה לֹא אֶחְיֶה יָמִים שְׂמֵחִים",
        "וְאָחֵל חַיַּי חַיִּים חֲדָשִׁים",
        "וּשְׁנוֹתַי אֲשֶׁר עָבְרוּ אֶשְׁכָּחֵן",
        "אֶשְׁכַּח עֲבָרָן וְכָל־אֲשֶׁר בָּהֶן",
        "וְאֶחְיֶה לַאֲדֹנִי מִכָּל־לִבִּי",
        "יִשָּׁאֵר לְצִדִּי אֹרֶךְ הַשָּׁנִים"
      ]
    },
    {
      "label": "3",
      "lines": [
        "מִי יִתֵּן וְאֶתְחָרֵט עַל אֲשֶׁר עָשִׂיתִי",
        "מִמַּחְשָׁבָה וּמַעֲשֶׂה וְדִבּוּר אָמַרְתִּי",
        "אַבִּיט לַאֲדֹנִי אֶצְעַק מִלִּבִּי",
        "לֹא הָיִיתִי יוֹדְעוֹ עַתָּה יְדַעְתִּיו",
        "יִסְלַח לִי עֲוֺנִי וִיטַהֵר לִבִּי",
        "יִשָּׁאֵר לְצִדִּי אֹרֶךְ הַשָּׁנִים"
      ]
    }
  ]
}
