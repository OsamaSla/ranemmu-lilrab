  "title_he": "יֵשׁוּעַ כְּבָר אֲהַבְתָּנוּ",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "יֵשׁוּעַ כְּבָר אֲהַבְתָּנוּ",
        "עַד הַמָּוֶת רַחוּם",
        "בַּחֻלְשָׁה כְּבָר דָּרַכְתָּ הַגִּבּוֹר",
        "בְּחָזְקֵי הַמִּבְצָרִים"
      ]
    },
    {
      "label": "1",
      "lines": [
        "בְּאַהֲבָתוֹ הַמְּרַפְּאָה",
        "בְּאַהֲבָתוֹ הַמַּסְפִּיקָה",
        "בְּאַהֲבָתוֹ הַמַּשְׁלִימָה",
        "אֲהֵבָנוּ יֵשׁוּעַ"
      ],
      "chorus": true
    },
    {
      "label": "2",
      "lines": [
        "סָבַלְתָּ אֵימַת הַמָּוֶת כִּי",
        "מֻסְּמַרְתָּ בַּצְּלָב",
        "גַּלָּיו סָעֲרוּ עַל",
        "רֹאשְׁךָ דּוֹד"
      ]
    },
    {
      "label": "3",
      "lines": [
        "וְכָל־זֹאת סָבַלְתָּ מִן",
        "בִּגְלַל חַטֹּאתֵינוּ",
        "וְאִם שְׁכַחְנוּךָ וּמָה",
        "הָיִיתָ לִשְׁכֹּחַ אוֹתָנוּ"
      ]
    },
    {
      "label": "4",
      "lines": [
        "וְכָכָה הִשְׁלַמְתָּ אֲשֶׁר",
        "אֲנַחְנוּ בּוֹ נַעֲשִׁיר",
        "בַּמְּנוּחָה הַגְּדוֹלָה אֲשֶׁר",
        "בִּכְבוֹדְךָ הַנִּשְׂגָּב"
      ]
    }
