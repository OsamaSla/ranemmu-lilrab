{
  "book": "main",
  "number": 833,
  "title_he": "לְעוֹלָמֵנוּ כְּבָר בָּאתָ",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "לְעוֹלָמֵנוּ כְּבָר בָּאתָ",
        "יֶלֶד בִּכְבוֹדְךָ הִקְרַבְתָּ",
        "לֹא בָּאתָ כָּל־תְּשֹׁרַת",
        "בְּמוֹתְךָ הַכֹּל פָּדִיתָ"
      ]
    },
    {
      "label": "1",
      "lines": [
        "אֱלֹהֵינוּ מְשִׁיחֵנוּ",
        "מַלְכֵּנוּ קוֹרֵא לָנוּ עַתָּה",
        "נַקְדִּישׁ לוֹ חַיֵּינוּ",
        "זֶבַח בְּכָל־עֵת"
      ],
      "chorus": true
    },
    {
      "label": "2",
      "lines": [
        "שָׁם בְּגַת־שְׁמָנִים",
        "נָשָׂא חַטָּאתִי",
        "אָמַר רְצוֹנְךָ",
        "יְהִי לֹא רְצוֹנִי"
      ]
    },
    {
      "label": "3",
      "lines": [
        "הִתְבּוֹנְנוּ צְלִיבָתוֹ",
        "הִתְבּוֹנְנוּ פְּצָעָיו",
        "מֻסְּמְרָה יַד אֲשֶׁר",
        "כְּבָר בָּרְאָה גַּלְגַּלָּיו"
      ]
    },
    {
      "label": "4",
      "lines": [
        "וְנֵלֵךְ בְּעִקְּבוֹת הַדּוֹד",
        "בַּעֲבוֹדַת אֲדוֹן הַפְּדוּת",
        "וְהַכְתִּירוּהוּ עַל",
        "לְבַבְכֶם אֹרֶךְ הַזְּמַן"
      ]
    }
  ],
  "chorus_he": "פְּזָמוֹן"
}
