{
  "book": "main",
  "number": 665,
  "title_he": "פּוֹדֶה הַיְּקוּם יִקְרָאֲךָ אֱמֹר הִנְנִי",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "פּוֹדֶה הַיְּקוּם יִקְרָאֲךָ",
        "אֱמֹר הִנְנִי",
        "וְאוֹרוֹ יַנְחֶךָ",
        "נֹגַהּ הַזֹּהַר",
        "הַגִּיל כַּדִּמְיוֹן",
        "כִּי יַעֲבֹר",
        "וְאַתָּה בִּתְעִיָּה",
        "לֹא תִרְאֶה"
      ]
    },
    {
      "label": "2",
      "lines": [
        "הוֹי מַזְנִיחַ הַיְשׁוּעָה",
        "הֵעָנֵה לַשֶּׂה",
        "אוֹי לְךָ מֵעֹנֶשׁ",
        "לֹא יִסָּבֵל",
        "כִּי מוֹעֵד הַחֶשְׁבּוֹן",
        "קָרֵב קָרוֹב",
        "וּבְרַח מִן־הָעֹנֶשׁ",
        "אֶל הַדּוֹד"
      ]
    },
    {
      "label": "3",
      "lines": [
        "כָּבוֹד לוֹ יִתְעַלֶּה",
        "אָדוֹן סַלָּח",
        "כַּמָּה שָׁב כְּבָר זָכָה",
        "מְחִיַּת הָרָעוֹת",
        "אַתָּה טָבוּעַ הַיֵּאוּשׁ",
        "תְּקַוֶּה הַהַצָּלָה",
        "מַהֵר כִּי רוּחַ הַקֹּדֶשׁ",
        "יִקְרָא הַחַטָּאִים"
      ]
    }
  ]
}
