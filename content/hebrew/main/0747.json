{
  "book": "main",
  "number": 747,
  "title_he": "אֲשֶׁר תִּחְיֶה לְבַדְּךָ",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "אֲשֶׁר תִּחְיֶה לְבַדְּךָ",
        "תְּבַקֵּשׁ חֶמְלַת זוּלָתֶךָ",
        "לֹא תִּרְאֶה דַּרְכֶּךָ",
        "יֵשׁוּעַ קָרֵב לָךְ"
      ]
    },
    {
      "label": "1",
      "lines": [
        "בְּטַח קוּם בּוֹא אֶל יֵשׁוּעַ",
        "כִּי הוּא יִקְרָא אוֹמֵר",
        "בְּטַח קוּם בּוֹא מְמַהֵר"
      ],
      "chorus": true
    },
    {
      "label": "2",
      "lines": [
        "יֵשׁוּעַ עַתָּה יַעֲבֹר",
        "לְצִדְּךָ וְיַבִּיט",
        "וְהַאִם אֵלָיו תִּצְעַק",
        "אֶרְצֶה אֲדֹנִי אֶרְאֶה"
      ]
    },
    {
      "label": "3",
      "lines": [
        "יַשְׁתִּיק כָּל־הַהֲמוֹנִים",
        "אִם רָאָה מִמְּךָ הַדְּמָעוֹת",
        "רַחֲמֵנִי אֲדֹנִי יֵשׁוּעַ",
        "אֵלֶיךָ אֶקְרַב בִּכְנִיעָה"
      ]
    }
  ],
  "chorus_he": "פְּזָמוֹן"
}
