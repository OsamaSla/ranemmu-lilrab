  "title_he": "הַפְנֵה מַבָּטִי הוֹי דּוֹד",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "אֲנִי אֲנִי אֲנִי לָאָדוֹן",
        "אָרִיעַ לוֹ מִכָּל־הַלֵּב",
        "עַל־חֶשְׁבּוֹן הַחֶסֶד",
        "כִּסִּיתָ חַטָּאתִי",
        "עַל־חֶשְׁבּוֹן הַחֶסֶד",
        "הָיִיתִי לוֹ וְהוּא לִי"
      ],
      "chorus": true
    },
    {
      "label": "1",
      "lines": [
        "הַפְנֵה מַבָּטִי הוֹי דּוֹד",
        "אֶל יָפְיְךָ הַנִּפְלָא",
        "וְהַגְבִּילֵנִי בְּךָ",
        "לְמַעַן אַבִּיט־נָא לַצְּלָב"
      ]
    },
    {
      "label": "2",
      "lines": [
        "כָּל־עוֹד קַמְתִּי עִם יֵשׁוּעַ",
        "אֲבַקֵּשׁ אֲשֶׁר מֵעַל הַנְּווֹת",
        "אֶל הַשָּׁמַיִם אֶל הַשָּׁמַיִם",
        "יֵשׁוּעַ לִי כָּל־הַמִּשְׁאֲלוֹת"
      ]
    },
    {
      "label": "3",
      "lines": [
        "וְנַשְׁלִיךְ עֲטָרוֹתֵינוּ",
        "לְיַד רַגְלֶיךָ בַּשָּׁמַיִם",
        "לֹא לָנוּ לֹא לָנוּ",
        "הַכֹּל נָתַתָּ לָנוּ"
      ]
    },
    {
      "label": "4",
      "lines": [
        "אֲהַלֵּל וַאֲזַמֵּר",
        "לְךָ אֲדֹנִי אֶשְׁתַּחֲוֶה",
        "מוֹדֶה וְעוֹבֵד",
        "כָּל־חַיַּי אֲכַבֵּד"
      ]
    },
    {
      "label": "5",
      "lines": [
        "וְאִם אֹבַד אֲהוּבַי",
        "וְאִם יַעַזְבוּנִי רֵעַי",
        "וְאִם אַפְסִיד הוֹנִי",
        "יִשָּׁאֵר יֵשׁוּעַ הַכֹּל לִי"
      ]
    }
  ],
  "chorus_he": "פְּזָמוֹן"
