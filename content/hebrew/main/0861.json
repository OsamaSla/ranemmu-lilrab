{
  "book": "main",
  "number": 861,
  "title_he": "אֲדֹנִי מָשְׁכֵנִי אַחֲרֶיךָ וְאָרוּץ",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "אֲדֹנִי מָשְׁכֵנִי",
        "אַחֲרֶיךָ וְאָרוּץ",
        "קַדֵּשׁ חַיַּי חַיַּי",
        "לִבִּי וּמַחְשַׁבְתִּי"
      ]
    },
    {
      "label": "2",
      "lines": [
        "שֶׁמֶשׁ הַנִּסְיוֹנוֹת",
        "כְּבָר שְׁזָפַתְנִי",
        "אַךְ יֵשׁוּעִי יֵשׁוּעִי",
        "לְעוֹלָם לֹא עֲזָבַנִי"
      ]
    },
    {
      "label": "3",
      "lines": [
        "כַּאֲשֶׁר רָאָנוּ",
        "תָּמִיד עֲצוּבִים",
        "חִפֵּשׂ עָלֵינוּ עָלֵינוּ",
        "מֵת וְהֶחֱיָנוּ"
      ]
    },
    {
      "label": "4",
      "lines": [
        "יֵשׁוּעַ בְּקִרְבָּתִי",
        "יֵשׁוּעַ לְצִדִּי",
        "הוֹי לִשְׂשׂוֹנִי שְׂשׂוֹנִי",
        "בְּיֵשׁוּעִי אֲדֹנִי"
      ]
    }
  ]
}
