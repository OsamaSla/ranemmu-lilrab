{
  "book": "main",
  "number": 855,
  "title_he": "הַאֶרְאֶה כְּבָר שָׁמַעְתִּי",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "הַאֶרְאֶה כְּבָר שָׁמַעְתִּי",
        "קוֹל אֲדֹנִי שׁוֹאֵל",
        "הִנֵּה יְשׁוּעָתִי כְּבָר לָקַחְתָּ",
        "אֵיךְ אֵינְךָ פּוֹעֵל",
        "מַלְאֲכֵי הַשָּׁמַיִם",
        "אֵינָם מְבַשְּׂרִים",
        "לָכֵן קְרָאתִיךָ",
        "הָבָה וֶהְיֵה נֶאֱמָן"
      ]
    },
    {
      "label": "2",
      "lines": [
        "כַּמָּה אֲנָשִׁים מְחַפְּשִׂים",
        "עַל דֶּרֶךְ לַיְשׁוּעָה",
        "מֵרָעוֹת מַשְׁמִידוֹת",
        "תַּהֲרֹסְנָה הַחַיִּים",
        "הֲיֵשׁ בְּךָ רָצוֹן",
        "כִּי יִפָּגְשׁוּ בִּי",
        "אֵלֶיךָ חַסְדִּי",
        "וַהֲבִיאֵם לִי"
      ]
    },
    {
      "label": "3",
      "lines": [
        "כַּמָּה אֲנָשִׁים מְבַקְּשִׁים",
        "חִיּוּךְ לֹא זָהָב",
        "וּנְפָשׁוֹת בִּכְפִיפָה",
        "תַּחַת כֹּבֶד הֶעָמָל",
        "צְרִיכוֹת מִלָּה",
        "תָּקֵל הַמַּכְאוֹבִים",
        "כֵּן אַהֲבָה",
        "וְלֹא לַתּוֹכֵחָה"
      ]
    },
    {
      "label": "4",
      "lines": [
        "אַתָּה אִם נָתַתָּ אַהֲבָה",
        "תִּפָּתַחְנָה אֲרֻבּוֹת הַשָּׁמַיִם",
        "לְמַעַן תִּשְׁפֹּעַ בְּמַתָּנוֹת",
        "כֶּפֶל כִּפְלֵי הַנְּתִינָה",
        "כִּי הָאָדוֹן כָּרַת",
        "הַבְטָחָה לַנְּדִיבִים",
        "בַּטּוֹב יָצִיף",
        "וּבַפֹּרִיּוּת וּבַצְּמִיחָה"
      ]
    }
  ]
}
