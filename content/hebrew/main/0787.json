  "title_he": "אֲדֹנִי אַתָּה יוֹדֵעַ",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "אֲדֹנִי אַתָּה יוֹדֵעַ",
        "כִּי אֲנִי נִזְקָק אֵלֶיךָ",
        "וְלִבִּי אַתָּה גּוֹלֶה",
        "כֻּלּוֹ לִפְנֵי עֵינֶיךָ",
        "תּוּכַל תָּחוּס לְחֻלְשָׁתִי",
        "תּוּכַל תִּמְחֶה הָעֲוֺנוֹת",
        "וּלְפֶצַע לִבִּי תְּרַפֵּא",
        "וַאֲנִי תּוֹעֶה בַּשְּׁבִילִים"
      ]
    },
    {
      "label": "1",
      "lines": [
        "חֵיקֶיךָ יְחַכּוּ לִי",
        "לִבְּךָ מָלֵא חֶמְלָה",
        "וְיָדֶיךָ תִּדְלֶינָה אוֹתִי",
        "מִן־הַחֻלְשָׁה וּמִן־הַקָּלוֹן"
      ],
      "chorus": true
    },
    {
      "label": "2",
      "lines": [
        "אֲדֹנִי אַתָּה יוֹדֵעַ",
        "כִּי אֲנִי לְבַדִּי חַלָּשׁ",
        "וְאֶזְלַת יָדִי אַתָּה רוֹאֶה",
        "וּמַשָּׂאִי אֵינֶנּוּ קַל",
        "וּבְאַהֲבָתְךָ תְּכַתְּרֵנִי",
        "כָּל־אֲשֶׁר נִסִּיתִי הַבְּרִיחָה",
        "עַצְמְךָ תָּמִיד זוֹכְרֵנִי",
        "מְחַכֶּה אָשׁוּב וְאָשׁוּב בִּתְשׁוּבָה"
      ]
    }
  ],
