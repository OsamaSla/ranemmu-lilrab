{
  "book": "main",
  "number": 806,
  "title_he": "אֲשֶׁר עָיַפְתָּ מִן־הַיְּגוֹנוֹת",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "אֲשֶׁר עָיַפְתָּ מִן־הַיְּגוֹנוֹת",
        "שׁוּב לְיֵשׁוּעַ הָרַחוּם",
        "בּוֹא אֵלָיו בְּכָל־אֱמוּנָה",
        "תִּמְצָא אֶצְלוֹ כָּל־בֶּטַח"
      ]
    },
    {
      "label": "1",
      "lines": [
        "הִנֵּה יֵשׁוּעַ עוֹמֵד מְחַכֶּה לָךְ",
        "עַל שַׁעַר לִבְּךָ עוֹמֵד לָךְ",
        "פְּתַח לִבְּךָ יִשְׁכֹּן בָּךְ",
        "תִּשְׂמַח בּוֹ וְיִשְׂמַח בָּךְ"
      ],
      "chorus": true
    },
    {
      "label": "2",
      "lines": [
        "גַּם אִם הָיָה הֶעָוֺן גָּדוֹל",
        "גַּם אִם הָיָה לִבְּךָ רָשָׁע",
        "אוֹ אִם הָיָה הַפֶּשַׁע מְסֻכָּן",
        "בּוֹא יֵשׁוּעַ אֶצְלוֹ הַצִּדּוּק"
      ]
    },
    {
      "label": "3",
      "lines": [
        "אַל־תְּאַחֵר לְמָחָר יָקָר",
        "מָחָר בְּיָדְךָ אֵינֶנּוּ מֻבְטָח",
        "בּוֹא הַיּוֹם לַאֲדוֹן הַיְּקוּם",
        "וְהוּא יְשַׁלֵּם כָּל־חוֹבוֹת"
      ]
    }
  ],
  "chorus_he": "פְּזָמוֹן"
}
