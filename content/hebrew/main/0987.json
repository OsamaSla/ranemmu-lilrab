  "title_he": "שִׂמְחָתֵנוּ עִמְּךָ תִּתְמַיֵּד",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "שִׁבְחֲךָ יְמַלֵּא הַתֵּבֵל",
        "שִׁירִים יַעֲלוּ וּתְרוּעָה",
        "הַבְטָחָתְךָ נֶאֱמָנָה וּבְטוּחָה",
        "בָּזוּז יָשׁוּב כִּפְלַיִם"
      ],
      "chorus": true
    },
    {
      "label": "1",
      "lines": [
        "שִׂמְחָתֵנוּ עִמְּךָ תִּתְמַיֵּד",
        "וּבְלֵב הָאֵשׁ עוֹבְרִים",
        "הַבְטָחָתְךָ נִרְאֶה הַיּוֹם",
        "מְשַׁלֶּמֶת אֶת־הַשָּׁנִים"
      ]
    },
    {
      "label": "2",
      "lines": [
        "לְבַדְּךָ בַּעֲדֵנוּ תִּלָּחֵם",
        "בַּחֻלְשָׁה וּבַמְּצוּקוֹת",
        "עִמְּךָ מַרְפֵּא וּפְלָאוֹת",
        "וְיָדֶיךָ עוֹשׂוֹת אוֹתוֹת"
      ]
    },
    {
      "label": "3",
      "lines": [
        "הָרוּחַ אִם קָשָׁה וְעִקֵּשׁ",
        "בָּהּ בְּשִׁלְטוֹן תִּמְלֹךְ",
        "תָּבוֹא בְּשַׁחַר חָדָשׁ",
        "וּתְשַׁבֵּר הַכְּבָלִים"
      ]
    }
  ],
  "chorus_he": "פְּזָמוֹן"
