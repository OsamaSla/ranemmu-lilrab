  "title_he": "אוֹדֶה כִּי הַזִּלְזוּל וְהָעַצְלוּת גּוֹבְרִים עָלַי",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "אוֹדֶה כִּי הַזִּלְזוּל וְהָעַצְלוּת גּוֹבְרִים עָלַי",
        "וְכִי יְפֵה מָה בְּחַיַּי אָבַד מִיָּדִי",
        "טָהֳרָתִי וְהָעַיִן הַפְּשׁוּטָה וְהַמִּלָּה הַיְּרֵאָה",
        "אוֹדֶה בַּתַּאֲוָה וְהַנְּטִיָּה לַחֵטְא"
      ]
    },
    {
      "label": "2",
      "lines": [
        "אוֹדֶה וְלֹא שָׁב יִמְנָעֵנִי כִּסּוּפִי",
        "אוֹדֶה בְּמַאֲבָקִי עִם עַצְמִי וּפַחְדִּי",
        "הָיָה חוֹבָתִי בַּשְּׂמָחוֹת אֲהַלֵּל אַךְ",
        "שָׁבַרְתִּי אֲנִי בְּיָדִי כִּנּוֹרוֹתַי וְתֻפַּי"
      ]
    },
    {
      "label": "3",
      "lines": [
        "וַאֲנִי בָּא וְכֻלִּי תִּקְוָה תִּסְלַח לִי אָדוֹן",
        "תִּבְרָא לִי לֵב טָהוֹר וּבְרוּחַ נֶאֱמָן כּוֹנֵן",
        "מְקַוֶּה אָשׁוּב שָׂמֵחַ וְהַלֵּב יִתְאַחֵד",
        "הֲשִׁיבֵנִי לְךָ וְאָשׁוּב וּבְרַחֲמֶיךָ אָעִיד"
      ]
    }
  ]
