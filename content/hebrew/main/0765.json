{
  "book": "main",
  "number": 765,
  "title_he": "אֲנִי בָּא לְךָ לִבִּי שָׁפֵל",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "אֲנִי בָּא לְךָ לִבִּי שָׁפֵל",
        "מֵעָלַי מַשְּׂאוֹתַי תִּשָּׂא",
        "וּבְצִדְּךָ חָזָק מוֹרֶה",
        "תְּשִׁיבֵנִי לַהַלֵּל",
        "אֲנִי מַבְטִיחַ בְּךָ חֲלוֹמוֹתַי",
        "הוֹי מַה־טּוֹבִים כָּל־יָמַי",
        "אַהֲבָתְךָ לֹא תֵּעָלֵם מִמַּחְשַׁבְתִּי",
        "תָּאִיר לֵב הַלַּיְלָה"
      ]
    },
    {
      "label": "2",
      "lines": [
        "תָּשִׁיב כָּל־אֲבֵדָה",
        "וְתַשְׂבִּיעַ אֲשֶׁר רָעֵב",
        "חֵיקְךָ רָחָב יָכִיל",
        "וְיֹאמַר לַיָּגוֹן שָׁלוֹם",
        "אָהַבְתָּ אָדָם לְעַצְמוֹ",
        "הָיִיתָ לוֹ סִירָה לְהַצָּלָתוֹ",
        "הֶחֱיִיתוֹ אַחַר מוֹתוֹ",
        "וַתְּהִי לוֹ רֹעֶה בְּמִרְעִים"
      ]
    },
    {
      "label": "3",
      "lines": [
        "הַכְנִיסֵנִי הָעֹמֶק עִמָּךְ",
        "אֶתְעַנֵּג בִּרְאִיָּתֶךָ",
        "תִּמָּלֶאנָה עֵינַי הוֹדֶךָ",
        "עַד אֲשֶׁר אֶפְגְּשֶׁךָ",
        "מְחַכֶּה בִּמְגוּרִים יָקָר",
        "תָּבוֹא תַּחֲלִיף מַצָּבַי",
        "תִּקָּחֵנִי הַשָּׁמַיִם מִיָּד",
        "וְתַעֲמֹדְנָה שְׂמָחוֹתַי עִמָּךְ"
      ]
    }
  ]
}
