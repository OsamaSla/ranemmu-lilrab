  "title_he": "חֵרְרֵנִי יֵשׁוּעַ הַצַּדִּיק",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "חֵרְרֵנִי · יֵשׁוּעַ הַצַּדִּיק",
        "שָׂמֵחַ תָּמִיד · בְּכָל רֶגַע",
        "הוּא לִמְּדַנִי · אֶת הַבִּטָּחוֹן",
        "כִּי הִבְטִיחַנִי · וְאָמַר"
      ]
    },
    {
      "label": "1",
      "lines": [
        "הִנְּךָ בְּנִי · רָחוּץ בַּדָּם",
        "וְלֹא תִּשָּׂא · שׁוּם דְּאָגָה"
      ],
      "chorus": true
    },
    {
      "label": "2",
      "lines": [
        "בָּא הַשָּׂטָן · לְהִלָּחֵם בִּי",
        "יֵשׁוּעַ אוֹמֵר לוֹ · זֶה בְּנִי",
        "וַאֲנִי הִבְטַחְתִּי · לִשְׁמֹר אוֹתוֹ",
        "תָּמִיד · עֵינִי עָלָיו"
      ]
    },
    {
      "label": "3",
      "lines": [
        "מִן הַיּוֹם אֲשֶׁר · הָאָדוֹן הִצִּילַנִי",
        "חַיֵּי עוֹלָם · נָתַן לִי",
        "וְהַחַיִּים עִמּוֹ · נָעִים לִי",
        "הָיִיתִי אֲנִי · בְּנוֹ הַיָּקָר"
      ]
    }
  ],
  "chorus_he": "פְּזָמוֹן"
