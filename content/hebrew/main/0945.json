    {
      "label": "2",
      "lines": [
        "אֲנִי צָרִיךְ תָּמִיד לְיָדֶיךָ",
        "תְּרִימֵנִי מֵעֹמֶק הַיֵּאוּשׁ",
        "גַּם בְּחֻלְשָׁתִי וּבְכִשְׁלוֹנִי אֶמְצָאֲךָ",
        "תַּעֲשֶׂה הַיָּרֵא גִּבּוֹר חָיִל"
      ]
    },
    {
      "label": "3",
      "lines": [
        "אֲנִי בּוֹטֵחַ תָּמִיד בִּגְאוֹנֶךָ",
        "בּוֹטֵחַ הִנֵּה חַיַּי בְּיָדֶיךָ",
        "תְּסוֹבְבֵנִי תִּקָּחֵנִי בְּחֵיקֶךָ",
        "בְּרוּצִי וְאֶפֹּל עָלֶיךָ"
