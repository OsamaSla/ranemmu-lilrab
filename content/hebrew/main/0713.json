{
  "book": "main",
  "number": 713,
  "title_he": "לְךָ הַסְּגִידָה וְהַשֶּׁבַח",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "לְךָ הַסְּגִידָה וְהַשֶּׁבַח",
        "אֲשֶׁר כִּלָּה אַהֲבָה בָּנוּ",
        "וְעַתָּה חַי לָעַד",
        "בַּכָּבוֹד מִמְּרוֹם הַשָּׁמַיִם"
      ]
    },
    {
      "label": "2",
      "lines": [
        "לְךָ הַיְקָר אֲשֶׁר",
        "בְּךָ יָאֶה לָעַד",
        "כִּי אַתָּה הָאָדוֹן הָעֶלְיוֹן",
        "אֱלֹהֵינוּ הַחַי הַצּוּר"
      ]
    },
    {
      "label": "3",
      "lines": [
        "וְהַתּוֹדָה וְהַהַלֵּל לְמִי",
        "רְחָצָנוּ בְּדָמוֹ",
        "הָיִינוּ מְלָכִים כֹּהֲנִים",
        "כְּפִי רְצוֹן לִבּוֹ"
      ]
    },
    {
      "label": "4",
      "lines": [
        "וְהַכָּבוֹד וְהַיְכֹלֶת וְהַ",
        "חָכְמָה לַפּוֹדֶה הַסַּלָּח",
        "וְהַגְּבוּרָה הַשִּׁלְטוֹן וְהַ",
        "שֶּׁבַח אֶל דּוֹר הַדּוֹרוֹת"
      ]
    }
  ]
}
