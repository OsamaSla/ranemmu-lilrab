  "number": 642,
  "title_he": "גָּבוֹהַּ לְמַעְלָה אֲנִי מֵרִים יָדִי",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "גָּבוֹהַּ לְמַעְלָה אֲנִי מֵרִים יָדִי",
        "אֶצְלְךָ מַלְכִּי וְעֻזִּי וַאֲדֹנִי",
        "וּבְגָאוֹן אֲנִי אֵינֶנִּי חָפֵץ דָּבָר",
        "אִם הָיָה לֹא יְרַצֶּךָ",
        "לְעוֹלָם לְעוֹלָם וְלֹא יַעֲשִׁירֵנִי",
        "וְלֹא יַשְׂבִּיעַ לִבִּי וְיַרְוֵנִי",
        "וְלֹא יְמַלֵּא עֵינִי וְיַסְפִּיקֵנִי",
        "זוּלַת רַק אֲשֶׁר תִּנְדַּב בּוֹ יָדֶיךָ"
      ]
    },
    {
      "label": "2",
      "lines": [
        "מֵרִים יָדִי בִּפְאֵר וּמַכְרִיז",
        "אַתָּה בַּעַל הַהַבְטָחָה תַּעֲרֹב",
        "כִּי תַעֲשֶׂה לַאֲשֶׁר בְּפֹעַל",
        "שָׂם תִּקְוַת יָמָיו בָּךְ",
        "לְעוֹלָם לְעוֹלָם אֵינֶנִּי מְחַכֶּה",
        "אִישׁ מִן־הָעוֹלָם יַרְגִּיעֵנִי",
        "אוֹ נִשְׁעָן עַל זוּלָתְךָ אַךְ",
        "מִשְׁעַנִּי יִהְיֶה כֻּלּוֹ עָלֶיךָ"
      ]
    },
    {
      "label": "3",
      "lines": [
        "מֵרִים יָדִי בְּנִצָּחוֹן וּמֵרִיעַ",
        "עָף כַּנֶּשֶׁר מְרַחֵף",
        "גָּבוֹהַּ גָּבוֹהַּ וּמָלֵא גְּבוּרָה",
        "אַתָּה נֶאֱמָן וַאֲנִי אָעִיד לָךְ",
        "לְעוֹלָם לְעוֹלָם אֵינֶנִּי נֶעֱזָב",
        "לְבַדִּי פֹּה בְּעוֹלַם הֶעָמָל",
        "מָלֵא לִבִּי שָׁלוֹם מֵהַבְטָחָתְךָ",
        "אֲדוֹן הַכָּבוֹד בְּעַצְמוֹ שׁוֹמֶרְךָ"
      ]
    }
  ]
}
