  "verses_he": [
    {
      "label": "1",
      "lines": [
        "כְּבָר לִמְּדַתְנִי הַחֶסֶד אֶחְיֶה",
        "אֶחְיֶה חַיֵּי הַהַשְׂכָּלָה",
        "אֶחְיֶה בְּרִיא הָאֱמוּנָה תָּמִיד",
        "בַּסַּבְלָנוּת אֶצְמַח לַטּוֹב"
      ]
    },
    {
      "label": "1",
      "lines": [
        "אֶחְיֶה שֵׂכֶל צֶדֶק וְיִרְאָה",
        "בְּעוֹלַם הָרַע וְהַדְּמָעוֹת",
        "הַשְׂכָּלָתִי שְׁמִירָה לְחַיַּי",
        "בַּצֶּדֶק אֶחְיֶה בֵּין הַהֲמוֹנִים",
        "אֶחְיֶה טְהוֹר הַלֵּב נֶאֱמָן",
        "בָּרוּחַ יִחְיֶה בִּי יֵשׁוּעַ"
      ],
      "chorus": true
    },
    {
      "label": "2",
      "lines": [
        "יִרְאַת אֱלֹהַי מִכָּל־לִבִּי",
        "פַּחַד אֱלֹהַי מִבְצַר הַבֶּטַח",
        "אֶחְיֶה מְצַיֵּת גַּם נֶאֱמָן",
        "לַטּוֹב אֶחְתֹּר בְּכָל־עֵת"
