{
  "book": "main",
  "number": 957,
  "title_he": "הָעוֹלָם מַתְּנוֹתָיו זְמַנִּיּוֹת",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "הָעוֹלָם מַתְּנוֹתָיו זְמַנִּיּוֹת",
        "וּבְשַׁעֲשׁוּעֵי הַתֵּבֵל יִקָּחֲךָ",
        "תַּעֲבֹד בְּהֵיכָלוֹת אֲחֵרִים",
        "לְצַלְמֵי הָאָרֶץ בְּלִבֶּךָ",
        "וְיִמְשָׁכְךָ וִיחַיֶּה נַפְשְׁךָ בְּעִנּוּי",
        "וְיִגְרָרְךָ תָּרוּץ וְתִתְחָרֶה לְשָׁרָב",
        "וִיסוֹבֶבְךָ בְּתוֹךְ מְעַרְבֹּלֶת עֲמָלִים",
        "וִישִׁיבְךָ רֵיקָם וְאֵין עִמְּךָ בִּלְתִּי אִם עָפָר"
      ]
    },
    {
      "label": "2",
      "lines": [
        "וֵאלֹהֶיךָ מַתְּנוֹתָיו נִצְחִיּוֹת",
        "וּבְרַחֲמֵי לִבּוֹ יִקָּחֲךָ",
        "תִּתְעַנֵּג בְּחַיִּים שְׁמֵימִיִּים",
        "וְשִׂמְחוֹת הַכָּבוֹד בְּלִבֶּךָ",
        "וְיַאַסְפְךָ לְעֶדְרוֹ בְּחֶסֶד וֶאֱמוּנָה",
        "וְיֹאמַר לְךָ דָּמִי מַבְטִיחַ לְךָ סְלִיחָה",
        "הִנֵּה לְמַעַנְךָ טָעַם הַצְּלָב וְכָל־קָלוֹן",
        "הָבָא לִבְּךָ הָבָא חַיֶּיךָ בְּיָדָיו בְּבֶטַח"
      ]
    }
  ]
}
