{
  "book": "main",
  "number": 619,
  "title_he": "בּוֹא אֲדֹנִי בְּרוּחֲךָ",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "בּוֹא אֲדֹנִי בְּרוּחֲךָ",
        "גַּע בְּאַדְמוֹתֵינוּ",
        "אַרְצִי צְמֵאָה לְרוּחֲךָ",
        "הוֹי אֱלֹהֵינוּ הַרְוֵנוּ",
        "וְנִרְאֶה אֲמִתְּךָ",
        "וְאַרְצֵנוּ תְּבָרֶכְךָ",
        "וְשָׁלוֹם יַתְמִיד וִימַלֵּא",
        "יְמַלֵּא אַדְמוֹתֵינוּ"
      ]
    },
    {
      "label": "2",
      "lines": [
        "מַלֵּא אַדְמוֹתֵינוּ בְּאוֹרְךָ",
        "פַּזֵּר אוֹצָרוֹת חוֹלְפִים",
        "וְאַרְצֵנוּ תִּהְיֶה בְּהַבְטָחוֹתֶיךָ",
        "שְׁמוּרָה וּמְבֹרֶכֶת",
        "תְּהִלּוֹתֵינוּ תְּרוֹמַמְנָה אוֹתְךָ",
        "וְאַרְצֵנוּ תִּהְיֶה אוֹר לָךְ",
        "שְׂמָחוֹת תְּצִיפֵנוּ וְגִיל",
        "וְלִבּוֹתֵינוּ יָשִׁירוּ לָךְ"
      ]
    },
    {
      "label": "3",
      "lines": [
        "שַׁנֵּה צוּרַת כֵּלֵינוּ",
        "בְּחַיֵּינוּ נִהְיֶה בְּשׂוֹרָה",
        "נָעִיד וְהָאֱמֶת מְמַלֵּאת אוֹתָנוּ",
        "וּנְבָרֶכְךָ דּוֹר אַחַר דּוֹר",
        "וְנִרְאֶה אֲמִתְּךָ",
        "וְאַרְצֵנוּ תְּבָרֶכְךָ",
        "וְשָׁלוֹם יַתְמִיד וִימַלֵּא",
        "יְמַלֵּא אַדְמוֹתֵינוּ"
      ]
    }
  ]
}
