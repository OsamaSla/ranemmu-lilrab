{
  "book": "main",
  "number": 942,
  "title_he": "בִּרְאוֹתִי צְלַב אֲשֶׁר",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "בִּרְאוֹתִי צְלַב אֲשֶׁר",
        "שָׁפַט וַיִּזְכֶּה בַּנִּצָּחוֹן",
        "רִוְחִי אֶרְאֶה הֶפְסֵד",
        "וְכָל־כְּבוֹד הַתֵּבֵל קָלוֹן"
      ]
    },
    {
      "label": "2",
      "lines": [
        "אֲדֹנָי אַל־תַּנַּח כִּי",
        "אֶתְהַלֵּל בִּלְתִּי אִם בַּצְּלָב",
        "מַקְדִּישׁ נַפְשִׁי וַאֲשֶׁר",
        "אֶמְלֹךְ לַפּוֹדֶה הַדּוֹד"
      ]
    },
    {
      "label": "3",
      "lines": [
        "מֵרֹאשׁוֹ וְכַפּוֹ",
        "וְצִדּוֹ וְרַגְלוֹ",
        "נָזְלוּ מַעְיְנוֹת הַמַּרְפֵּא",
        "וְהָאַהֲבָה גַּם עִם דָּמוֹ"
      ]
    },
    {
      "label": "4",
      "lines": [
        "אֵיזֶה דָם זַךְ רָץ",
        "כְּדָמוֹ הַזַּךְ הַיָּקָר",
        "וְאֵיזוֹ עֲטֶרֶת כַּעֲטֶרֶת",
        "הַקּוֹצִים הֶחֱיָתָה הָעוֹלָמִים"
      ]
    },
    {
      "label": "5",
      "lines": [
        "בַּמָּה אֲגַמֵּל מוֹשִׁיעִי",
        "מִשִּׁלְטוֹן הַחַטָּאת",
        "בִּלְתִּי אִם בְּהַקְדָּשָׁתִי לוֹ",
        "נַפְשִׁי וְכָל־כֹּחִי"
      ]
    }
  ]
}
