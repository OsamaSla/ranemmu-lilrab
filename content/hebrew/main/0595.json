{
  "book": "main",
  "number": 595,
  "title_he": "נִכְרַע לְךָ הוֹי אֲדֹנֵנוּ",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "נִכְרַע לְךָ הוֹי אֲדֹנֵנוּ",
        "וְנָרִים שִׁמְךָ הַגָּדוֹל",
        "נַקְדִּישׁ לְךָ יְקָרֵנוּ",
        "וּנְשַׁבֵּחַ שִׁמְךָ הַנָּדִיב",
        "יֵשׁוּעַ אַתָּה יְשׁוּעָתֵנוּ",
        "בָּאתָ לְמַעַן תִּפְדֶּה הַחַטָּאִים",
        "נִצְלַבְתָּ פִּדְיוֹן נַפְשׁוֹתֵינוּ",
        "לְמַעַן תַּקְדִּישׁ לַמֵּתִים הַחַיִּים",
        "יֵשׁוּעַ אַתָּה מַלְכֵּנוּ",
        "אַתָּה אֲדוֹן אֵלֶּה הַחַיִּים",
        "נַקְדִּישׁ לְךָ תּוֹדַת לִבּוֹתֵינוּ",
        "לְךָ תִּכָּנַעְנָה הַמְּצָחוֹת"
      ]
    }
  ]
}
