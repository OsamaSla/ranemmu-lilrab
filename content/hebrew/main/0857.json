  "book": "main",
  "number": 857,
  "title_he": "כַּאֲשֶׁר נִתְפַּלֵּל לְךָ אֲדוֹנֵנוּ",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "כַּאֲשֶׁר נִתְפַּלֵּל לְךָ אֲדוֹנֵנוּ",
        "בְּשִׁמְךָ הָעֶלְיוֹן אַחֵד־נָא אוֹתָנוּ",
        "כְּבָר הִבְטַחְתָּנוּ וֶהְיֵה בְּתוֹכֵנוּ",
        "לְמַחְבֹּאֲךָ אֲדֹנִי הַכְנִיסֵנוּ",
        "לְמַעַן יָחוּל אֵשׁ רוּחֲךָ בָּנוּ",
        "לְמַעַן יִשְׁפֹּעַ נָהָר מִלִּבּוֹתֵינוּ",
        "כַּאֲשֶׁר נִתְפַּלֵּל אַלְּפֵנוּ",
        "כִּי נִהְיֶה תָּמִיד בִּתְפִלָּתֵנוּ",
        "מַתְמִידִים שׁוֹקְדִים",
        "וְכָל־עֵת מוֹדִים"
      ]
    }
  ]
}
