  "title_he": "אָדוֹן מִי זוּלָתְךָ יוּכַל יְנַחֲמֵנִי",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "אָדוֹן מִי זוּלָתְךָ יוּכַל יְנַחֲמֵנִי",
        "אָדוֹן מִי זוּלָתְךָ בָּאַהֲבָה יְרַפְּאֵנִי",
        "וְלוּ בְּאַהֲבָתְךָ וּבְגֹדֶל חָכְמָתְךָ",
        "תַּרְשֶׁה בִּפְצָעִים וּמְצוּקָה וּדְמָעוֹת תְּמַלֵּאנָה עֵינַי",
        "תִּפְצַע וְאַתָּה אֲשֶׁר תַּחְבֹּשׁ",
        "תִּשְׁחַק וְיָדֶיךָ תְּרַפֵּאנָה",
        "וְתִשְׁמֹר אֹרֶךְ הַשְּׁבִיל",
        "וּשְׁלוֹמִי בְּךָ מֻבְטָח"
      ]
    },
    {
      "label": "2",
      "lines": [
        "אָדוֹן מִי זוּלָתְךָ מִפַּחְדִּי שִׁחְרְרַנִי",
        "אָדוֹן מִי זוּלָתְךָ עַל מָחָר הִרְגִּיעַנִי",
        "בְּךָ לְבַדְּךָ נִצְּחוֹנִי לֹא צִדְקִי וְלֹא יְכָלְתִּי",
        "אַךְ רוּחֲךָ אֲדֹנִי יְחַדֵּשׁ גְּבוּרָתִי",
        "וְנֹכְחוּת בְּלִי גְּבוּלוֹת",
        "לְמַעַן תְּחַיֶּה הַהַבְטָחוֹת",
        "צוֹדֵק וְלֹא יוֹם תִּבְגֹּד",
        "בְּרִיתְךָ אֹרֶךְ הַשָּׁנִים"
      ]
    }
  ]
}
