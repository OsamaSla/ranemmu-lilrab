{
  "book": "main",
  "number": 448,
  "title_he": "לִבִּי כָּמַהּ, אֲדֹנָי",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "לִבִּי כָּמַהּ, אֲדֹנָי",
        "בְּרִית אֱמֶת לְךָ",
        "בְּרִית שֶׁלִּבִּי חוֹבֵק",
        "לְךָ כָּל־הַשָּׁנִים",
        "הוֹסֵף, אֲדֹנָי, אֶת־קִרְבָתִי אֵלֶיךָ",
        "בִּבְרִית לֹא אֶשְׁכָּחֶנָּה",
        "עַד אֶמָּס בְּךָ",
        "כָּל־עוֹד אֲנִי בַּחַיִּים",
        "יַחֵד אֶת־לִבִּי לְיִרְאָתְךָ",
        "לַמְּדֵנִי, אֱלֹהִים",
        "כּוֹנֵן בְּרִיתִי אֶל־אִישׁוּתְךָ",
        "שׁוֹמֵעַ הַתְּפִלָּה"
      ]
    }
  ]
}
