{
  "book": "main",
  "number": 631,
  "title_he": "הוֹי מִי אֲשֶׁר יָדַעְתָּ אֶת־הָאָדוֹן יֵשׁוּעַ",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "הוֹי מִי אֲשֶׁר יָדַעְתָּ אֶת־הָאָדוֹן יֵשׁוּעַ",
        "וְהִתְעַנַּגְתָּ בְּאוֹר בְּשׂוֹרָתוֹ",
        "עוֹלָם כֻּלּוֹ אֲנָחָה וּדְמָעוֹת",
        "לָמָּה נִכְסַפְתָּ לְחָשְׁכּוֹ וּלְלֵילוֹ"
      ]
    },
    {
      "label": "2",
      "lines": [
        "לָמָּה חִפַּשְׂתָּ אֶת־הֶחָרוּבִים",
        "וְכָל־הַטּוּב הִנּוֹ בְּבֵית הָאָב",
        "חֲשֹׁב, הֲרֵי אַתָּה בְּנוֹ הָאָהוּב",
        "וְשׁוּב אֶל הַבַּיִת וְהָאֲהוּבִים"
      ]
    },
    {
      "label": "3",
      "lines": [
        "אֲהֵבְךָ, הִקְרִיב אֶת־נַפְשׁוֹ בַּעֲדֶךָ",
        "טָעַם אֶת־הַמָּוֶת בִּצְלָב הַחֶרְפָּה",
        "חֵיק הָאָדוֹן הִנּוֹ מְקוֹמֶךָ",
        "הַנַּח מִמְּךָ הֲלִיכַת הָרְשָׁעִים"
      ]
    },
    {
      "label": "4",
      "lines": [
        "וּבְמַעֲשֶׂיךָ הָיִיתָ מַעֲצִיב",
        "אֶת־רוּחַ הָאֵל הַשּׁוֹכֵן בְּקִרְבֶּךָ",
        "תָּמִיד אַתָּה שׁוֹכֵחַ כִּי מַאֲמִין אַתָּה",
        "לַמְרוֹת כָּל־זֹאת עֵינוֹ עָלֶיךָ"
      ]
    },
    {
      "label": "5",
      "lines": [
        "דְּבַשׁ הָעוֹלָם לְעוֹלָם לֹא יוֹעִיל",
        "מָה יִקְרֶה אִם תִּדְרֹךְ עָלָיו",
        "רַק דְּבַר הָאָדוֹן הוּא הַמַּשְׂבִּיעַ",
        "שׁוּב אֶל אֱלֹהֶיךָ וּשְׂבַע בּוֹ"
      ]
    },
    {
      "label": "6",
      "lines": [
        "שִׂמְחַת הָעוֹלָם לֹא תַּאֲרִיךְ יָמִים",
        "הֶבֶל הַכֹּל וּרְעוּת רוּחַ",
        "אַךְ מָחָר יָבוֹא הַיּוֹם",
        "וְנִתְעַנֵּג עִם הַמָּשִׁיחַ"
      ]
    }
  ]
}
