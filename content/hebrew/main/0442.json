{
  "book": "main",
  "number": 442,
  "title_he": "אוּלַי שָׁגִיתִי אֶתְמוֹל",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "אוּלַי שָׁגִיתִי אֶתְמוֹל",
        "וְנֶאֶבְדָה כָל־חַיָּתִי לְתֹהוּ",
        "אַךְ בִּטְחוֹנִי שֶׁאַתָּה תִּסְלַח",
        "וּתְיַשֵּׁר בִּי אֶת־הַמַּצָּבִים"
      ]
    },
    {
      "label": "1",
      "lines": [
        "אֲדֹנָי, בְּחָנֵנִי",
        "וְגַלֵּה לִי אֶת־אֲשֶׁר בְּלִבִּי",
        "אָשׁוּב אֵלֶיךָ וְתַרְגִּיעֵנִי",
        "בְּעָמְדְךָ תָּמִיד לְצַדִּי"
      ],
      "chorus": true
    },
    {
      "label": "2",
      "lines": [
        "אוּלַי אֲנִי חַלָּשׁ בְּקִרְבִּי",
        "וּמוּמַי מַתִּישִׁים אוֹתִי מְאֹד",
        "וְלֹא יוֹעִילֵנִי לִמְצֹא לָהֶם קֵץ",
        "כִּי אִם אֶחְסֶה אֵלֶיךָ, אֵל שַׁדַּי"
      ]
    },
    {
      "label": "3",
      "lines": [
        "אוּלַי אֵינִי יָכוֹל לִשְׁכֹּחַ",
        "אֶת־חַטֹּאותַי וְחַטֹּאות אֲחֵרִים",
        "אֶרְצֶה לִלְמֹד אֵיךְ אֶשְׁכָּחַ",
        "אֶת־רָעַת אֶחָי וְאָשִׁיב לָהֶם טוֹבָה"
      ]
    },
    {
      "label": "4",
      "lines": [
        "אוּלַי אֲנִי צָרִיךְ בִּטָּחוֹן",
        "אֶרְצֶה לְהַרְגִּישׁוֹ, וְלוּ לִרְגָעִים",
        "וְאֶשְׁכַּח פְּחָדַי וְיָגוֹנִי מִקֶּדֶם",
        "וּכְאִלּוּ הָלַךְ מִמֶּנִּי וָמֵת"
      ]
    }
  ],
  "chorus_he": "פְּזָמוֹן"
}
