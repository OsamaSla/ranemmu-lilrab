  "verses_he": [
    {
      "label": "1",
      "lines": [
        "הוֹי לְסוֹד עוֹלֶה עַל כָּל־שֶׁבַח",
        "רָם בַּשְּׁלֵמוּת",
        "הַקְּהִלָּה כַּלָּה לַמָּשִׁיחַ",
        "בַּעַל הַגָּאוֹן"
      ]
    },
    {
      "label": "1",
      "lines": [
        "הִנֵּה הֶחָתָן בָּא",
        "מִשְּׁמֵי הַשָּׁמַיִם",
        "לַמּוּכָנִים וְלַמּוּכָנוֹת",
        "בְּקוֹל שׁוֹפָר יָקִים הַיְּשֵׁנִים",
        "וִישַׁנֶּה הַחַיִּים",
        "וְנִפְגְּשֶׁנּוּ כֻּלָּנוּ בָּאֲוִיר"
      ],
      "chorus": true
    },
    {
      "label": "2",
      "lines": [
        "וְהַכַּלָּה תּוּבַל לֶחָתָן",
        "בְּכָבוֹד מַזְהִיר",
        "בַּחֲגִיגָה נִפְלָאָה רָמָה יְקָרָה",
        "מַבְרִיקָה מְאִירָה"
      ]
    },
    {
      "label": "3",
      "lines": [
        "וְסוֹף נְקַוֶּה כֻּלָּנוּ",
        "שְׁלֵמוּת הַטֹּהַר",
        "כַּאֲשֶׁר יָבוֹא חֲתָנֵנוּ הַגָּדוֹל",
        "מִשִּׂיא הַשָּׁמַיִם"
      ]
    }
  ],
  "chorus_he": "הִנֵּה הֶחָתָן בָּא · מִשְּׁמֵי הַשָּׁמַיִם · לַמּוּכָנִים וְלַמּוּכָנוֹת · בְּקוֹל שׁוֹפָר יָקִים הַיְּשֵׁנִים · וִישַׁנֶּה הַחַיִּים · וְנִפְגְּשֶׁנּוּ כֻּלָּנוּ בָּאֲוִיר"
