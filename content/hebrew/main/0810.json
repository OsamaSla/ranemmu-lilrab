{
  "book": "main",
  "number": 810,
  "title_he": "אֲנִי בָּא לְךָ בְּכָל־מוּמַי",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "אֲנִי בָּא לְךָ בְּכָל־מוּמַי",
        "הַסְתִּירֵנִי בְּסֵתֶר דָּמֶיךָ",
        "טַהֲרֵנִי מִכָּל־עֲוֺנוֹתַי",
        "הַעֲשִׁירֵנִי מִשֶּׁפַע עָשְׁרֶךָ"
      ]
    },
    {
      "label": "1",
      "lines": [
        "לִבִּי בָּא אֵלֶיךָ נִכְסָף",
        "אוֹמֵר לְךָ הוֹדִיעֵנִי בָּךְ",
        "עַנְּגֵנִי בְּאַהֲבָתְךָ וּפְדוּתֶךָ",
        "חְיֵה בִּי וְאֶחְיֶה בָּךְ"
      ],
      "chorus": true
    },
    {
      "label": "2",
      "lines": [
        "אֲנִי בָּא לְךָ בּוֹא בְּקִרְבִּי",
        "וּמַלְּאֵנִי בְּרוּחֲךָ וּרְצוֹנֶךָ",
        "רַחֲצֵנִי וּסְלַח חֲטָאַי",
        "עַנְּגֵנִי בַּחֶבְרָה עִמָּךְ"
      ]
    },
    {
      "label": "3",
      "lines": [
        "אֲנִי בָּא לְךָ הַחֲלֵף מַבָּטַי",
        "מִן־הַחֻלְשָׁה וּמִן־הָאָדָם",
        "אֶשָּׁאֵר אֹרֶךְ הַמַּסָּע יוֹם יוֹם",
        "מַבִּיט לְךָ בְּכָל־אֱמוּנָה"
      ]
    }
  ],
  "chorus_he": "פְּזָמוֹן"
