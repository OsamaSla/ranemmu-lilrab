{
  "book": "main",
  "number": 592,
  "title_he": "מְשִׁיחִי לָאָרֶץ בָּאתָ וּבֵינֵינוּ הָלַכְתָּ",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "מְשִׁיחִי לָאָרֶץ בָּאתָ",
        "וּבֵינֵינוּ הָלַכְתָּ",
        "מִי חָיָה חַיֶּיךָ",
        "מִי אָמַר דְּבָרֶיךָ",
        "אֵיךְ אַסֵּב עֵינַי מִמֶּךָּ",
        "דּוֹדִי רֹאשְׁךָ הִרְכַּנְתָּ",
        "בִּדְמָעוֹתֶיךָ בָּכִיתָ",
        "מִי נָשָׂא צְלָבְךָ",
        "מִי טָעַם עִנּוּיְךָ",
        "אֵיךְ אַסֵּב עֵינַי מִמֶּךָּ"
      ]
    },
    {
      "label": "2",
      "lines": [
        "מְשִׁיחִי בַּעֲדִי בָּאתָ",
        "וְאָמַרְתָּ וְקָרָאתָ:",
        "\"מִי מֵת תַּחְתֶּיךָ מִי דָמוֹ כִּסְּךָ\"",
        "אֵיךְ אַסֵּב עֵינַי מִמֶּךָּ",
        "דּוֹדִי לִבִּי שָׁבִיתָ",
        "כַּאֲשֶׁר אֵלֶיךָ רַצְתִּי",
        "מִי אֲדֹנִי זוּלָתֶךָ",
        "הֲרֵי בֵּיתִי חֵיקֶךָ",
        "אֵיךְ אַסֵּב עֵינַי מִמֶּךָּ"
      ]
    }
  ]
}
