    {
      "label": "1",
      "lines": [
        "אֵיךְ אֲדֹנָי חֶמְלָתֶךָ",
        "תָּכִיל כָּל־הָאֱנוֹשׁוּת",
        "וְכָל־אִישׁ הַבָּא אֵלֶיךָ",
        "תְּרִימֵהוּ מִן־הָעַבְדוּת"
      ]
    },
    {
      "label": "1",
      "lines": [
        "דַּלְתוֹתֶיךָ פְּתוּחוֹת לִי",
        "כָּל־אֲשֶׁר יִהְיֶה בִּי חַטָּאת",
        "בְּאַהֲבָה תְּכַסֶּה מוּמַי",
        "וְעַל צוּר תָּכִין רַגְלָי"
      ],
      "chorus": true
    },
    {
      "label": "2",
      "lines": [
        "שַׂמְתָּ בְּלִבִּי זְמִירָה",
        "תָּרִים הַכָּבוֹד לָךְ",
        "גַּם בְּמִדְבָּר מַכְאִיב",
        "אֶחְיֶה חַיַּי אֲבַקֵּשׁ כְּבוֹדֶךָ"
      ]
    },
    {
      "label": "3",
      "lines": [
        "כָּל־הָעֲמֵלִים בֹּאוּ",
        "יֵשׁוּעַ קָרָא לָכֶם אֵלָיו",
        "הַכֹּל יַשְׁלִיךְ מַשָּׂאוֹתָיו",
        "בֶּאֱמוּנָה לְרַגְלָיו"
      ]
    }
  ],
