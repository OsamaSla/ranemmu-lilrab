    {
      "label": "2",
      "lines": [
        "עֵדוּתִי אֶחְיֶה לוֹ",
        "אֵינֶנִּי אֲנִי אַךְ חַסְדּוֹ",
        "שְׁלִיחוּתִי בְּשׂוֹרָתִי",
        "כִּי אֶשָּׁאֵר תָּמִיד לְצִדּוֹ"
      ]
    },
    {
      "label": "3",
      "lines": [
