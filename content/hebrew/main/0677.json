    {
      "label": "1",
      "lines": [
        "בָּא אֵלֵינוּ מִכִּסֵּא הַשָּׁמַיִם",
        "לְמַעַן יִהְיֶה לִי חַיִּים",
        "כִּי לוּלֵי נֹעַם אֲדֹנִי מוֹרִי",
        "לֹא הָיָה לִי כְּלָל תִּקְוָה"
      ]
    },
    {
      "label": "1",
      "lines": [
        "אֶל חַיִּים טוֹבִים יוֹתֵר",
        "כְּבָר הִנְחָנִי הַמָּשִׁיחַ",
        "הָאַהֲבָה הָיְתָה בֵּינֵינוּ",
        "אָשִׁיר בַּשֶּׁבַח"
