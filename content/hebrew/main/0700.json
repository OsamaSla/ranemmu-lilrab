{
  "book": "main",
  "number": 700,
  "title_he": "מִי יִתֵּן לִי אֶלֶף לָשׁוֹן",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "מִי יִתֵּן לִי אֶלֶף לָשׁוֹן",
        "לְמַעַן אֲשַׁבֵּחַ הַפּוֹדֶה",
        "אֲשַׁבֵּחַ אֲדֹנִי הַמְּבֻקָּשׁ לְעֶזְרָה",
        "וְחַסְדּוֹ הַנִּרְאֶה"
      ]
    },
    {
      "label": "2",
      "lines": [
        "אוֹתוֹ אֲשֶׁר יַשְׁקִיט",
        "פַּחְדִּי וִיגוֹנוֹתַי",
        "וְזִכְרוֹ יִיטַב",
        "בְּשֶׁמַע אָזְנַי"
      ]
    },
    {
      "label": "3",
      "lines": [
        "יִשְׁבֹּר עֹקֶץ הַחֲטָאִים",
        "וִישַׁחְרֵר הַשָּׁבוּי",
        "וְדָמוֹ הַמַּשְׁלִים הַמַּתָּן",
        "מְטַהֵר לִבִּי"
      ]
    },
    {
      "label": "4",
      "lines": [
        "הַלֵּל לְבַעַל הָאֱמֶת הַנֶּאֱמָן",
        "וְהַמּוֹרֶה הַגָּדוֹל",
        "וְהַתּוֹדָה תֻּקְדַּשׁ כָּל־עֵת",
        "לַאֲדֹנֵנוּ הַנָּדִיב"
      ]
    },
    {
      "label": "5",
      "lines": [
        "הָבָה הָרִימוּ קוֹל הַשֶּׁבַח",
        "לְאוֹתוֹ הַפּוֹדֶה",
        "לְמִי הִנְחָנוּ כֻּלָּנוּ",
        "בְּאוֹרוֹ הַמַּנְחֶה"
      ]
    }
  ]
}
