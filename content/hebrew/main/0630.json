{
  "book": "main",
  "number": 630,
  "title_he": "נִלְאֵיתִי מִלְּבַטֵּא",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "נִלְאֵיתִי מִלְּבַטֵּא",
        "כַּאֲשֶׁר נָתַתִּי דַּעְתִּי לְתָאֵר אֶת־יֵשׁוּעַ",
        "נִסִּיתִי לְהַגְבִּיהַּ בַּמַּחְשָׁבָה",
        "דִּבֵּר לִבִּי וְאָמַר: הוֹי הֲמוֹנִים",
        "מִי יִתֵּן וְאוּכַל לוֹמַר וּלְבַטֵּא",
        "אֶת־תָּאֳרֵי הָאָדוֹן יֵשׁוּעַ"
      ]
    },
    {
      "label": "2",
      "lines": [
        "בְּרֶגַע אֶחָד, בְּהֶרֶף עַיִן",
        "טִהֲרַנִי דָּמוֹ וְהָיִיתִי מְאֻשָּׁר",
        "אַשְׁרֶיךָ לִבִּי הָיִיתָ שָׂמֵחַ",
        "שִׂמְחָה לֹא יְדֻבַּר בָּהּ וּמְכֻבֶּדֶת",
        "מִי יִתֵּן וְאוּכַל לוֹמַר וּלְבַטֵּא",
        "אֶת־יְשׁוּעַת הָאָדוֹן יֵשׁוּעַ"
      ]
    },
    {
      "label": "3",
      "lines": [
        "כַּאֲשֶׁר חָלַשְׁתִּי בַּדֶּרֶךְ",
        "וְהָאוֹיֵב לְקָחַנִי בַּמַּחְשַׁכִּים",
        "מָצָאתִי אֶת־יֵשׁוּעַ הַיָּקָר בָּרֵעִים",
        "מָחַץ אֶת־אוֹיְבִי וְאָמַר: הֶהָ!",
        "מִי יִתֵּן וְאוּכַל לוֹמַר וּלְבַטֵּא",
        "אֶת־שִׁלְטוֹן הָאָדוֹן יֵשׁוּעַ"
      ]
    },
    {
      "label": "4",
      "lines": [
        "קָדוֹשׁ אֱלֹהַי יֵשׁוּעַ הַצַּדִּיק",
        "כָּבוֹד לְבַעַל הַתִּפְאֶרֶת",
        "אַשְׁרֶיךָ מַאֲמִין, הוֹי בָּחִיר",
        "תִּחְיֶה בְּצִלּוֹ לְעוֹלָם וָעֶד",
        "מִי יִתֵּן וְאוּכַל לוֹמַר וּלְבַטֵּא",
        "אֶת־כְּבוֹד הָאָדוֹן יֵשׁוּעַ"
      ]
    }
  ]
}
