{
  "book": "main",
  "number": 726,
  "title_he": "הוֹי הָרֹעֶה הַגָּדוֹל",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "הוֹי הָרֹעֶה הַגָּדוֹל",
        "אֲדֹנֵנוּ יֵשׁוּעַ הַמָּשִׁיחַ",
        "נַקְדִּישְׁךָ הַלֵּל רָאוּי",
        "עִם הַסְּגִידָה וְהַמְּדִיחַ"
      ]
    },
    {
      "label": "2",
      "lines": [
        "טִהַרְתָּנוּ קִדַּשְׁתָּנוּ",
        "הִצַּלְתָּנוּ מִשִּׁפְלוּתֵנוּ",
        "כִּבַּדְתָּנוּ הֲנִחוֹתָנוּ",
        "אַחַר הַקָּלוֹן וְהֶעָמָל"
      ]
    },
    {
      "label": "3",
      "lines": [
        "בְּעַצְמְךָ עִמָּנוּ תֵּלֵךְ",
        "וְהָאֲפֵלָה לָנוּ תָּאִיר",
        "וְהַתּוֹדָה נַקְדִּישׁ גִּבּוֹר",
        "כִּי אַתָּה טוֹב הָעוֹזֵר"
      ]
    },
    {
      "label": "4",
      "lines": [
        "מַחְשְׁבוֹתֶיךָ טוֹבוֹת",
        "מִנֶּגְדֵּנוּ תָּמִיד",
        "מַעֲשֶׂיךָ נִפְלָאִים",
        "יְשַׂמְּחוּ אֶל הַתֹּם"
      ]
    },
    {
      "label": "5",
      "lines": [
        "מִמְּךָ הָאֹכֶל נְחַכֶּה",
        "וְהַבְּרָכוֹת תִּמְטַרְנָה",
        "עַל הָאוֹיְבִים נְנַצֵּחַ",
        "וּבְךָ תָּמִיד נִתְפָּאֵר"
      ]
    },
    {
      "label": "6",
      "lines": [
        "וְעוֹד מְעַט דּוֹד",
        "נִפָּרֵד מִבֵּית הַקִּינָה",
        "וְתִמְחֶה דִּמְעוֹתֵינוּ",
        "לִבּוֹתֵינוּ בְּךָ יִיטְבוּ"
      ]
    }
  ]
}
