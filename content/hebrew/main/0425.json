  "title_he": "נוֹדֶה בְּכָל־עֵת לֵאלֹהֵינוּ הַנֶּאֱמָן",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "נוֹדֶה בְּכָל־עֵת",
        "לֵאלֹהֵינוּ הַנֶּאֱמָן",
        "מִי שֶׁחָנָנוּ בִּפְדוּת יְקָרָה"
      ]
    },
    {
      "label": "1",
      "lines": [
        "הִנֵּה הַלְּלוּיָהּ, הִנֵּה הַלְּלוּיָהּ",
        "נִשְׁתַּחֲוֶה לְשֵׁם הַמָּשִׁיחַ הַגָּדוֹל"
      ],
      "chorus": true
    },
    {
      "label": "2",
      "lines": [
        "נַעֲבֹד בִּכְנִיעָה",
        "יֵשׁוּעַ, יְדִידֵנוּ",
        "כִּי הוּא מְנַגֵּב כָּל־הַדְּמָעוֹת"
      ]
    },
    {
      "label": "3",
      "lines": [
        "נָעִיד לְכָל־אָדָם",
        "עַל אַהֲבָתוֹ הַנִּפְלָאָה",
        "כִּי הוּא סוֹלֵחַ וְתָמִיד שׁוֹמֵעַ"
      ]
    },
    {
      "label": "4",
      "lines": [
        "נֵלֵךְ בְּעִקְּבוֹתָיו",
        "נִתְנַהֵג עַל־פִּי הַדְרָכָתוֹ",
        "כִּי הוּא הַמּוֹרֶה וַאֲדֹנֵי הַחַיִּים"
      ]
    }
  ],
  "chorus_he": "פְּזָמוֹן"
