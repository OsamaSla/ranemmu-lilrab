{
  "book": "main",
  "number": 971,
  "title_he": "בְּתוֹעִי וּבְחָשְׁכִּי",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "בְּתוֹעִי וּבְחָשְׁכִּי",
        "דָּלָה אוֹתִי הָאֵל",
        "פָּקַח עֵינַי וְהִתִּיר",
        "כַּבְלִי מִשְּׁבִי אֲבַדּוֹן",
        "הוֹי אַהֲבָה נִשְׂגַּב זָהֳרָהּ",
        "מֵת אֲדוֹנֵנוּ בְּעַד הַחַטָּאִים",
        "יוֹם יָבוֹא וְאֶפְגְּשֶׁנּוּ בִּשְׁמָיו",
        "יַעֲלֶה פֹּה שִׁירִי",
        "וּבַשָּׁמַיִם הֲוָיָתִי",
        "מַה־גָּדְלָה אַהֲבַת הָאֵל"
      ]
    },
    {
      "label": "2",
      "lines": [
        "אֲדֹנָי מַה־רַּמְתָּ אָמְנָם",
        "אֱלֹהֵי הַחַיִּים הָאֵלֶּה",
        "אֲשֶׁר לְךָ מַלְאָכִים יִכְרְעוּ",
        "יָרַדְתָּ אֶל הַחַטָּאִים",
        "הוֹי אַהֲבָה נִשְׂגַּב זָהֳרָהּ",
        "וְהוֹי גֹּדֶל חֶסֶד הָאֵל",
        "בְּיָמַי פֹּה וּבַשָּׁמַיִם",
        "לֹא יֶחֱשֶׁה לְשׁוֹנִי",
        "מֵהוֹדוֹת וּמִתּוֹדָתִי",
        "שֶׁבַח לְךָ כָּל־הַחַיִּים",
        "וְתִפְאֶרֶת שִׁירִי",
        "מִלִּבִּי וּמֵהִשְׁתַּחֲוָיָתִי",
        "מַה־גָּדְלָה אַהֲבַת הָאֵל"
      ]
    }
  ]
}
