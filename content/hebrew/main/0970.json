{
  "book": "main",
  "number": 970,
  "title_he": "לִבִּי הַפּוֹעֵם הָיָה מִשְׁכָּבְךָ",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "לִבִּי הַפּוֹעֵם הָיָה מִשְׁכָּבְךָ",
        "בְּחַדְרֵי הֶחָזֶה אַסְתִּיר מְקוֹמֶךָ",
        "עָזַבְתִּי הַתֵּבֵל בַּהֲמוֹנָהּ",
        "וְנִבְדַּלְתִּי מִכֹּל לִחְיוֹת עִמָּךְ",
        "אֵין־לִי מַחֲשָׁבָה וְלֹא דֵּעָה וְלֹא",
        "תַּאֲוָה אַחֶרֶת בִּלְתִּי לָלֶכֶת אַחֲרֶיךָ",
        "וְאָבִי יַעֲקֹב יָדַעְתִּי סוֹדוֹ",
        "הִנֵּה יָדַעְתִּי אֵיךְ נֶאֱבַק עִמָּךְ",
        "יְדִיד הַלֵּב מַה־מָּתוֹק אַתָּה אַף",
        "רָם אַתָּה וְנוֹרָא מַה־נֶּהְדָּר אַתָּה",
        "גִּבּוֹר הָאוֹחֵז בַּשּׁוֹט בְּכַפּוֹ",
        "וְהָאַהֲבָה מְדַמֶּמֶת דִּמְעָתֶךָ",
        "לֹא יְכַלְכֶּלְךָ הַתֵּבֵל מַה־צַּר הוּא",
        "אֵיךְ אֵפוֹא יְכַלְכֶּלְךָ הַלֵּב",
        "עָזַבְתִּי הַתֵּבֵל בַּהֲמוֹנָהּ",
        "וְנִבְדַּלְתִּי מִכֹּל לִחְיוֹת עִמָּךְ",
        "עָזַבְתִּי הַכֹּל אֲדֹנָי בִּלְעָדֶיךָ",
        "אֵין־לִי בִּמְגוּרֵי חַיַּי זוּלָתֶךָ",
        "וּמָנַעְתִּי הַמַּחֲשָׁבָה מִשּׁוּט",
        "בַּאֲשֶׁר אַתָּה שָׁם מַחְשְׁבוֹתַי",
        "שָׁכַחְתִּי מִשְׁפָּחָה וְרֵעִים אַף",
        "שָׁכַחְתִּי נַפְשִׁי גַּם־הִיא בְּאַהֲבָתֶךָ",
        "שָׁכַחְתִּי הַכֹּל בְּאַהֲבָתְךָ",
        "שַׁעֲשֻׁעֵי הַלֵּב אַל־תִּשְׁכַּח עַבְדֶּךָ",
        "לֹא רָחוֹק אַתָּה אָמְנָם כִּי אִם",
        "בִּדְמָמָה חֲרִישִׁית יִשָּׁמַע טַלֶּךָ",
        "בַּשָּׁמַיִם אַתָּה אָמְנָם כִּי אִם",
        "כָּל־לֵב שֶׁחַי בְּאַהֲבָה הוּא שְׁמֶיךָ",
        "הִנֵּה הָעַיִן וּכְבָר עָצַמְתִּיהָ",
        "מֵרְאוֹת דְּבָרִים לְמַעַן אֶרְאֶךָּ",
        "וְכֵן הָאֹזֶן כְּבָר פִּנִּיתִיהָ",
        "מִשִּׂיחַת אָדָם לְמַעַן אֶשְׁמָעֶךָּ",
        "לִבִּי הַפּוֹעֵם הָיָה מִשְׁכָּבְךָ",
        "בְּחַדְרֵי הֶחָזֶה אַסְתִּיר מְקוֹמֶךָ"
      ]
    }
  ]
}
