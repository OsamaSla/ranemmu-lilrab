  "title_he": "נָבוֹא אֵלֶיךָ מֶלֶךְ הַמְּלָכִים",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "נָבוֹא אֵלֶיךָ מֶלֶךְ הַמְּלָכִים",
        "נָבוֹא וְנִכְרַע וְנִשְׁתַּחֲוֶה לָךְ",
        "בְּרוּחַ מִפִּיךָ תִּבְרָא חַיֵּינוּ",
        "בְּגַחֶלֶת מִזְבַּחֲךָ תְּטַהֵר שְׂפָתֵינוּ",
        "בְּמַגַּע מִיָּדְךָ תְּחַדֵּשׁ גְּבוּרָתֵנוּ",
        "וְקַבֵּל שִׁבְחֵנוּ וְהִשְׁתַּחֲוָיָתֵנוּ"
      ]
    }
  ]
