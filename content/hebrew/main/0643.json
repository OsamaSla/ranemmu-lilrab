  "title_he": "נִתֵּן לְמִי נָתַן בְּנוֹ",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "נִתֵּן לְמִי נָתַן בְּנוֹ",
        "לָנוּ בְּאַהֲבָה שְׁלֵמָה",
        "כָּל־אֲשֶׁר נִמְלֹךְ בְּ",
        "זֶה הַקִּיּוּם הַחוֹלֵף"
      ]
    },
    {
      "label": "1",
      "lines": [
        "נָתַן לָנוּ בְּנוֹ הַיָּחִיד",
        "הֲלֹא נַקְרִיב בַּמּוּעָט"
      ],
      "chorus": true
    },
    {
      "label": "2",
      "lines": [
        "הִפְקִידָנוּ הָאָדוֹן עַל",
        "חַסְדּוֹ וְהֶאֱמִין בָּנוּ",
        "נִזָּהֵר נָא מֵהַגֶּזֶל וְלֹא",
        "נִרְצֶה בַּאֲשֶׁר אֵינוֹ לָנוּ"
      ]
    },
    {
      "label": "3",
      "lines": [
        "נִתֵּן וְנֻתַּן הָאָדוֹן אָמַר",
        "בַּחֵיק מִדָּה לְחוּצָה",
        "וְשׁוֹפַעַת בְּכָל־מַצָּב",
        "וְנֻתַּן זֵכֶר נִצְחִי"
      ]
    },
    {
      "label": "4",
      "lines": [
        "נִתֵּן לוֹ מַעֲשַׂר אֲשֶׁר לָנוּ",
        "בְּאַהֲבַת פּוֹדֵנוּ הַנִּכְבָּד",
        "מִיָּדוֹ נִתֵּן מִן",
        "לֵב יָחוּשׁ בַּיֹּפִי"
      ]
    },
    {
      "label": "5",
      "lines": [
        "נִתֵּן כַּאֲשֶׁר אֲבוֹתֵינוּ",
        "נָתְנוּ בְּהַקְרָבָה וּמִלּוּי",
        "וְתָמִיד סִיסְמָתֵנוּ",
        "לָאָדוֹן נִתֵּן בִּנְדִיבוּת"
      ]
    }
  ],
