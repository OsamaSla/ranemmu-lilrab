{
  "book": "main",
  "number": 862,
  "title_he": "אִם לֹא תִבְנֶה אַתָּה הַבַּיִת",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "אִם לֹא תִבְנֶה אַתָּה הַבַּיִת",
        "יֹאבְדוּ מַאֲמַצֵּי הַבּוֹנִים",
        "אִם לֹא תִטַּע אַתָּה הַכֶּרֶם",
        "יִכְזַב תִּקְוַת הַכּוֹרְמִים",
        "וְתוֹאִיל אַתָּה וְתִבְנֶה",
        "בֵּיתְךָ זֶה וְתָרִימֵהוּ",
        "וּזְכֹר הָעָם הַזֶּה הַמִּשְׁתַּחֲוֶה",
        "לְמַעַן תִּשְׁמְרֵהוּ וּתְטַהֲרֵהוּ",
        "וְשִׂים הַבַּיִת הַזֶּה מְנוֹרָה",
        "יַנְחֶה וְיַדְרִיךְ מִי יְבוֹאֵהוּ",
        "וּמַלֵּא בֵּיתְךָ זֶה שְׁפִיכָה",
        "תַּכְרִיז כְּבוֹד גְּאוֹנְךָ בּוֹ"
      ]
    }
  ]
}
