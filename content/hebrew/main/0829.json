{
  "book": "main",
  "number": 829,
  "title_he": "הִנְנִי נוֹשֵׂא עֵינִי אֶל הַשָּׁמַיִם",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "הִנְנִי נוֹשֵׂא",
        "עֵינַי אֶל הַשָּׁמַיִם",
        "וְיָדַי פְּרוּשׂוֹת",
        "אֵלֶיךָ אֲדוֹן הַמָּרוֹם",
        "שְׁמַע תְּפִלָּתִי",
        "וַעֲנֵה תְּחִנָּתִי"
      ]
    },
    {
      "label": "2",
      "lines": [
        "בְּעֵת צָרָתִי",
        "חִפַּשְׂתִּי עַל הַיְשׁוּעָה",
        "וָאָבוֹא אֵלֶיךָ",
        "מִתְחַנֵּן אֲדוֹן הַחַיִּים",
        "שְׁמַע תְּפִלָּתִי",
        "וַעֲנֵה תְּחִנָּתִי"
      ]
    },
    {
      "label": "3",
      "lines": [
        "אָבוֹא אֵלֶיךָ",
        "בְּהֵיכַל קָדְשֶׁךָ",
        "וְאֶכְרַע יָרֵא",
        "לִפְנֵי כִּסֵּא כְּבוֹדֶךָ",
        "שְׁמַע תְּפִלָּתִי",
        "וַעֲנֵה תְּחִנָּתִי"
      ]
    },
    {
      "label": "4",
      "lines": [
        "אֲדֹנִי יֵשׁוּעִי",
        "אָדוֹן צוּרִי",
        "עֻזִּי וּמָגִנִּי",
        "עָלֶיךָ בָּטַח לִבִּי",
        "שְׁמַע תְּפִלָּתִי",
        "וַעֲנֵה תְּחִנָּתִי"
      ]
    }
  ]
}
