{
  "book": "main",
  "number": 908,
  "title_he": "הִנֵּה תָּכְנִית חַיַּי מַבְטִיחָהּ בְּיָדֶיךָ",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "הִנֵּה תָּכְנִית חַיַּי מַבְטִיחָהּ בְּיָדֶיךָ",
        "רוֹאֶה אוֹתָהּ יוֹם יוֹם יָקְרִי עָלֶיךָ",
        "מַרְגִּישָׁהּ בְּבִטְחוֹנִי שְׁלוֹמִי וְהַבְטָחָתִי",
        "בְּכָל־הַמַּשְׁמָעֻיּוֹת הַמְּתוּקוֹת אֲשֶׁר בָּךְ"
      ]
    },
    {
      "label": "2",
      "lines": [
        "בְּיוֹם יִתְקְפוּנִי רוּחוֹת הַחַיִּים",
        "וּבְלַחַץ יְעַרְבְּלוּנִי וְאֵין גַּלְגַּל יְשׁוּעָה",
        "אֶרְאֲךָ קָרוֹב רַחוּם וְטוֹב",
        "וְרוּחִי יִיטַב מְתוּק מִכָּל־אֵל"
      ]
    },
    {
      "label": "3",
      "lines": [
        "אֵין דָּבָר יְאַיֵּם עַל־עַמְּךָ בַּמִּרְעֶה",
        "וְלֹא דָּבָר יְפַזֵּר כְּבָשֶׂיךָ רֹעֶה",
        "מְגַדֵּר סְבִיבִי וְהַבְטָחָתְךָ זֹאת לִי",
        "כִּי בְּתוֹךְ יָדְךָ לִבִּי וּמִפְרָשִׂי"
      ]
    }
  ]
}
