{
  "book": "main",
  "number": 695,
  "title_he": "אַהֲבַת יֵשׁוּעַ הַפּוֹדֶה תְּבַלְבֵּל הַשְּׂכָלִים",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "אַהֲבַת יֵשׁוּעַ הַפּוֹדֶה",
        "תְּבַלְבֵּל הַשְּׂכָלִים",
        "לְפָנֶיהָ לֹא אֵדַע",
        "מָה אֲנִי אֹמַר",
        "אָהַב חוֹטֵא כָּמוֹנִי",
        "וְעָזַב הַשָּׁמַיִם",
        "לְמַעַן יִחְיֶה כָּמוֹנִי",
        "בְּעוֹלַם הֶעָמָל"
      ]
    },
    {
      "label": "2",
      "lines": [
        "בְּטֹרַח וָעֹנִי",
        "כְּבָר חָיָה זֶה הַדּוֹד",
        "בְּמַכְאוֹב וְיָגוֹן",
        "סָבַל הַצְּלָב",
        "וְכָל־זֶה בַּעֲדִי",
        "לְמַעַן יִפְתַּח הַדֶּרֶךְ",
        "וְאֶכָּנֵס בֶּאֱמֶת",
        "בִּבְרִיתוֹ הַנֶּאֱמָנָה"
      ]
    },
    {
      "label": "3",
      "lines": [
        "בְּדָמוֹ פְּדָנִי",
        "מוֹשִׁיעִי הַנִּכְבָּד",
        "בְּמוֹתוֹ הֶחֱיַנִי",
        "אַקְדִּישׁ לוֹ הַשִּׁיר",
        "יִיטַב לוֹ שִׁירִי",
        "בָּאַהֲבָה וּבַפְּאֵר",
        "כָּבוֹד כָּבוֹד לַאֲדֹנִי",
        "כָּבוֹד אֲנִי שָׂמֵחַ",
        "כָּבוֹד אֲנִי שָׂמֵחַ"
      ]
    }
  ]
