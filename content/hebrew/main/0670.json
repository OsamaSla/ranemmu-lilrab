  "title_he": "מֵעַל כָּל־גְּבוּרָה וְרֹאשׁוּת",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "מֵעַל כָּל־גְּבוּרָה וְרֹאשׁוּת",
        "מֵעַל כָּל־שֵׁם וַאֲדוֹנוּת",
        "אַתָּה קָם יוֹשֵׁב בַּשָּׁמַיִם",
        "תִּכָּנַע לְךָ כָּל־הַדְּבָרִים",
        "רָאוּי כִּי תִקַּח הַכָּבוֹד",
        "הַיְכֹלֶת וְהַיְקָר",
        "כְּבָר זֻבַּחְתָּ וּקְנִיתָנוּ",
        "פְּדִיתָנוּ בְּדָמְךָ נֹאהֲבֶךָ"
      ]
    }
  ]
}
