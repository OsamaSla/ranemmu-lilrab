{
  "book": "main",
  "number": 818,
  "title_he": "מוֹשִׁיעִי נִשְׁחַטְתָּ עַל הַצְּלָב",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "מוֹשִׁיעִי נִשְׁחַטְתָּ",
        "עַל הַצְּלָב הוּרַמְתָּ",
        "נָשָׂאתָ הַקְּלָלָה",
        "הַמַּעֲשֶׂה הִשְׁלַמְתָּ",
        "הַשָּׂטָן שָׁחַקְתָּ",
        "כָּבוֹד לְךָ כָּבוֹד לְךָ"
      ]
    },
    {
      "label": "1",
      "lines": [
        "כָּבוֹד הוֹשַׁעְתָּנוּ",
        "וְתוֹשִׁיעַ בִּשְׁלֵמוּת"
      ],
      "chorus": true
    },
    {
      "label": "2",
      "lines": [
        "תְּשַׁחְרֵר כֵּן",
        "תְּרַפֵּא כֵּן כֵּן",
        "נַכְרִיז אֱמוּנָתֵנוּ",
        "לֹא תִּשְׁתַּנֶּה",
        "לֹא תְּאַחֵר",
        "נַאֲמִין בְּךָ נַאֲמִין בָּךְ"
      ]
    },
    {
      "label": "3",
      "lines": [
        "אֲנַחְנוּ מְרִימִים אוֹתְךָ",
        "וּמְשַׁבְּחִים אוֹתְךָ",
        "בְּךָ בִּטְחוֹנֵנוּ",
        "עַל חַיֵּינוּ",
        "עַל פְּתָחֵינוּ",
        "דָּמֶיךָ דָּמֶיךָ"
      ]
    }
  ],
  "chorus_he": "פְּזָמוֹן"
}
