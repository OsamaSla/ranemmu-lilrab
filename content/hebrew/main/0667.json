{
  "book": "main",
  "number": 667,
  "title_he": "אֲדֹנִי מוֹרִי הִנֵּה בִּטְחוֹנִי",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "אֲדֹנִי מוֹרִי הִנֵּה בִּטְחוֹנִי",
        "בְּכִי אַתָּה תִּפְעַל",
        "כַּאֲשֶׁר הֵחַלְתָּ בְּקִרְבִּי",
        "בִּגְבוּרָה תַּשְׁלִים",
        "כִּי כַמָּה בְּלִבְּךָ הַיּוֹתֵר",
        "מִנְּדִיבוּתְךָ יְחַכֶּה",
        "וְכַמָּה בְּלִבִּי גַּעְגּוּעַ",
        "לְחֶסֶד יִמְטַר",
        "וְהַנַּח לִי כִּי לֹא אֶסְתַּפֵּק",
        "בְּכָל־אֲשֶׁר נָתַתָּ לִי",
        "אַךְ שׁוֹאֵל מִיָּדְךָ",
        "כִּי אַתָּה תִּתְּנֵנִי",
        "כִּי כָל־אֲשֶׁר נָתַתָּ לִי",
        "וּמִפֵּרוֹת אַהֲבָתֶךָ",
        "וְקַדְּשֵׁנִי אֲדֹנִי מוֹרִי",
        "לְמַעַן יִהְיֶה הַכֹּל לָךְ",
        "וּפְעַל נָא לִכְבוֹדְךָ",
        "מַפְרֶה בְּעַבְדְּךָ",
        "אֲדֹנִי כְּפִי הַבְטָחָתְךָ",
        "זֶה כִּי אַתָּה הַנֶּאֱמָן",
        "דּוֹד אָמֵן"
      ]
    }
  ]
}
