  "verses_he": [
    {
      "label": "1",
      "lines": [
        "אַהֲבָה עָלְתָה עַל כָּל־אַהֲבָה",
        "אַהֲבָה קָרְבָה אֵלַי וַתִּשְׁפֹּךְ",
        "הֲיֵשׁ, אָנָּא, אַהֲבָה",
        "גְּדוֹלָה מֵאֵל אֲשֶׁר אָהַב"
      ]
    },
    {
      "label": "1",
      "lines": [
        "אָהַבְנִי וַאֲנִי חוֹטֵא · אָהַבְנִי וַאֲנִי פּוֹשֵׁעַ",
        "אָהַבְנִי בְּמוֹתִי · אָהַבְנִי לְמַעַן נַפְשִׁי"
      ],
      "chorus": true
    },
    {
      "label": "2",
      "lines": [
        "בְּאַהֲבָה יוּבַל הָאָדוֹן הַחָבִיב",
        "לִמַּלְקוֹת וּלְסְטִירוֹת וּלְלַעַג נִפְלָא",
        "אַהֲבָה הִפִּילָה אֶת־אִישׁוּת הַחָבִיב",
        "לָשֵׂאת הַחַטָּאת וְחֶרְפַּת הַצְּלָב"
      ]
    },
    {
      "label": "3",
      "lines": [
        "בְּנַהַר הָאַהֲבָה יַצִּיפֵנִי",
        "בְּעֹמֶק הָאַהֲבָה יַקִּיפֵנִי",
        "שְׂמֹאלוֹ תַּחְתַּי תִּסְעָדֵנִי",
        "יְמִינוֹ רַחוּמָה תַּחְבְּקֵנִי"
      ]
    },
    {
      "label": "4",
      "lines": [
        "לְיוֹם הַבִּיאָה תִּרְבֶּה כְּמִיהָתִי",
        "עִם אִישׁוּת הֶחָתָן פְּגִישָׁתִי בְּטוּחָה",
        "אֶשְׁקֹד וְאֶשְׁקֹד עַד יָבוֹא",
        "אֶתְפַּלֵּל וַאֲזַמֵּר בְּלֵב שָׂמֵחַ"
      ]
    }
