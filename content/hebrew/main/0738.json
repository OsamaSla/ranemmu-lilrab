{
  "book": "main",
  "number": 738,
  "title_he": "כְּבַד הַמַּשָּׂא קְרַב",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "כְּבַד הַמַּשָּׂא קְרַב",
        "לְעֵבֶר פּוֹדְךָ הַדּוֹד",
        "וְהַשְׁלֵךְ הָעֲוֺנוֹת מִיָּד",
        "אֵצֶל רַגְלֵי הַצְּלָב"
      ]
    },
    {
      "label": "2",
      "lines": [
        "וְתִרְאֶה מַעְיַן נְדִיבוּת",
        "נָזַל מִצַּד הַשֶּׂה",
        "אֲשֶׁר הֵמִית הַמָּוֶת בַּמָּוֶ",
        "ת אֲשֶׁר בַּעֲדֵנוּ סָבַל"
      ]
    },
    {
      "label": "3",
      "lines": [
        "שְׁמַע הַפּוֹדֶה יִקְרָא",
        "כָּל־קְטוּעַ הַתִּקְוָה",
        "פְּנֵה לְעֶבְרִי וְתִחְיֶה",
        "וְתִזְכֶּה בָּרְוָחָה"
      ]
    },
    {
      "label": "4",
      "lines": [
        "קִרְבוּ לְעֶבְרִי כִּי הִנְנִי",
        "בָּאתִי בַּעֲבוּר הַחַטָּאִים",
        "הִנְנִי הַלֶּחֶם הַשְּׁמֵימִי",
        "וַאֲנִי מֵי הַחַיִּים"
      ]
    },
    {
      "label": "5",
      "lines": [
        "וְהָבוּ עַתָּה אֲשֶׁר",
        "לָן בְּשֶׁבִי הָאֲבַדּוֹן",
        "וּבַקֵּשׁ הַסְּלִיחָה וְקַבֵּל",
        "מַתָּנָה מִמִּי פְּדָךְ"
      ]
    },
    {
      "label": "6",
      "lines": [
        "אַל־תְּקַשֶּׁה הַלֵּב וּשְׁמַע",
        "קוֹל פּוֹדְךָ הָרַחוּם",
        "וְהָעֵר וּקְרַב מַהֵר",
        "לִפְנֵי בּוֹא הַמָּוֶת"
      ]
    }
  ]
}
