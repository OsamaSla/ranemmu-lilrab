  "title_he": "לֵב טָהוֹר וְנָקִי",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "לֵב טָהוֹר וְנָקִי",
        "בְּרָא לִי אֱלֹהִים",
        "וְהָצֵף בְּרוּחֲךָ בְּקִרְבִּי",
        "חַדֵּשׁ שְׁבִילֵי הַחַיִּים",
        "טַהֲרֵנִי מֵחַטֹּאתַי",
        "וּנְחֵה אַתָּה צְעָדַי",
        "וְיִהְיֶה הֶגְיוֹן לִבִּי",
        "לְרָצוֹן לְפָנֶיךָ אֱלֹהִים"
      ]
    }
  ]
}
