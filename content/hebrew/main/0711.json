{
  "book": "main",
  "number": 711,
  "title_he": "אֲנִי נִזְקָק נְגִיעַת רוּחֲךָ תְּשַׁנֵּנִי",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "אֲנִי נִזְקָק נְגִיעַת רוּחֲךָ תְּשַׁנֵּנִי",
        "אֲנִי נִזְקָק יֵשׁוּעַ דָּמְךָ יְטַהֲרֵנִי",
        "וַאֲנִי כַּאֲשֶׁר אָבוֹא וְאֶרְאֲךָ",
        "וְאֶרְאֶה שְׁמִי עַל כַּפֶּיךָ",
        "תַּתִּיר הָאֲסוּרִים וַאֲמִתְּךָ",
        "תְּשַׁחְרְרֵנִי",
        "אִם הָיִיתִי חַלָּשׁ חַזְּקֵנִי",
        "אִם הָיִיתִי עָצוּב נַחֲמֵנִי",
        "אִם הָיִיתִי חוֹטֵא רַפְּאֵנִי",
        "וְרַפְּאֵנִי",
        "גַּע בִּי בְּשִׁלְטוֹנֶךָ",
        "הַרְאֵנִי כְּבוֹד גְּאוֹנֶךָ",
        "הָצֵף לִבִּי בְּחֶמְלָתֶךָ",
        "וְהַרְוֵנִי"
      ]
    }
  ]
}
