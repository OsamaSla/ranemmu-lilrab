  "title_he": "מֶלֶךְ הַכָּבוֹד בִּמְלֹא הַזְּמַן",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "מֶלֶךְ הַכָּבוֹד בִּמְלֹא הַזְּמַן",
        "בְּךָ נִרְאֲתָה הָאַהֲבָה בַּבָּרוּר הַבֵּאוּר",
        "אֵיךְ חָיִיתָ כָּעָנִי וְהַמֻּשְׁפָּל",
        "אֵין לְךָ כְּלָל מָעוֹן אוֹ מָקוֹם",
        "עוֹשֶׂה הַטּוֹב וּמַרְאֶה הַחֶמְלָה"
      ]
    },
    {
      "label": "1",
      "lines": [
        "הוֹי כָּל־הַמַּאֲמִינִים הַלְּלוּהוּ",
        "בְּשִׂמְחַת הַלֵּב תָּמִיד וְעִבְדוּהוּ",
        "וְזִכְרוּ חֶסֶד לַאֲדֹנִי שְׁנוּהוּ",
        "מְרִיעִים כָּל־עֵת פָּאֲרוּהוּ",
        "בַּמָּשִׁיחַ יִגְדַּל נִצְּחוֹנֵנוּ"
      ],
      "chorus": true
    },
    {
      "label": "2",
      "lines": [
        "כְּבָר נָשָׂאתָ אֲדֹנֵנוּ הַחֶרְפָּה הַמְּמִסָּה",
        "וְסָבַלְתָּ זַעַם הַצֶּדֶק הַנּוֹרָא",
        "יוֹם טָעַמְתָּ הַמָּוֶת בַּעֲדִי בַּצְּלָב",
        "מַרְאֶה אַהֲבָה וְחֶמְלָה הוֹי דּוֹד",
        "וְחָטַפְתָּ הַנֶּפֶשׁ מִמְּעֵי הַלַּהַב"
      ]
    }
  ],
  "chorus_he": "פְּזָמוֹן"
