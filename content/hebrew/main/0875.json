{
  "book": "main",
  "number": 875,
  "title_he": "אֲנִי בַּנִּצְלָב אֶחְיֶה",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "אֲנִי בַּנִּצְלָב אֶחְיֶה",
        "וְהוּא בְּמַעֲמַקֵּי עַצְמִי",
        "מְלֹא לִבִּי מְלֹא רוּחִי",
        "מְלֹא מַחְשַׁבְתִּי וְחַיַּי",
        "וְהוּא עֶזְרִי וְהַתִּקְוָה",
        "וְהוּא עֶזְרִי וְהַתִּקְוָה"
      ]
    },
    {
      "label": "2",
      "lines": [
        "כַּאֲשֶׁר הָיִיתִי לְבַדִּי",
        "בְּצִלְלֵי הַמָּוֶת אֵלֵךְ",
        "וְדַרְכִּי הָיָה רָחָב",
        "אַךְ לַמָּוֶת יוֹבִיל",
        "הָיָה עֶזְרִי וְהַתִּקְוָה",
        "הָיָה עֶזְרִי וְהַתִּקְוָה"
      ]
    },
    {
      "label": "3",
      "lines": [
        "שְׂכָרִי הָיָה אֲבַדּוֹנִי",
        "שְׂכַר הַחוֹטֵא הָאָשֵׁם",
        "וְהוּא אֲשֶׁר הִתִּיר מוֹסְרוֹתַי",
        "וְעָלָה בִּי לַנֹּעַם",
        "אָז נָתַן לִי הַתִּקְוָה",
        "אָז נָתַן לִי הַתִּקְוָה"
      ]
    },
    {
      "label": "4",
      "lines": [
        "לֹא שַׁבְתִּי אִירָא אוֹיְבִי",
        "אִם הִרְבָּה בָּרָעוֹת",
        "כִּי שְׁלוֹם הָאָדוֹן מִבְצָרִי",
        "וּדְבַר הָאָדוֹן אוֹרִי",
        "וְהוּא לִי נִגּוּן הַתִּקְוָה",
        "וְהוּא לִי נִגּוּן הַתִּקְוָה"
      ]
    }
  ]
}
