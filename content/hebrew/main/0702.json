{
  "book": "main",
  "number": 702,
  "title_he": "שֵׁם יָקָר כְּבָר רָם",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "שֵׁם יָקָר כְּבָר רָם",
        "עַל הַשֵּׁמוֹת הָרָמִים",
        "יֵשׁוּעַ יִפְדֶּה הָעַמִּים",
        "מְחַיֶּה הַנְּפָשׁוֹת הַבָּלוֹת"
      ]
    },
    {
      "label": "2",
      "lines": [
        "מִי יוּכַל בַּיְּקוּם",
        "כֻּלָּם עַקְשָׁנוּת אַהֲבָתוֹ",
        "אוֹ יָקֵל אֵפוֹא",
        "בְּמוֹתוֹ וּצְלִיבָתוֹ"
      ]
    },
    {
      "label": "3",
      "lines": [
        "יִרְצֶה עָלֵינוּ הָאָב מִן",
        "בַּעֲבוּר בְּנוֹ וְיָשׁוּב",
        "וְהָרוּחַ עִמּוֹ יִתְחַבֵּר",
        "כִּי הָיָה בָּנוּ יַפְגִּיעַ"
      ]
    },
    {
      "label": "4",
      "lines": [
        "אִם נִרְאָה פְּנֵי הַמָּשִׁיחַ",
        "תֵּרָאֶה תִּקְוָתִי וְהַשָּׂשׂוֹן",
        "הִנֵּה שְׁמוֹ פַּחְדִּי יָסִיר",
        "נֹכְחוּתוֹ תִּמְחֶה הָרָעוֹת"
      ]
    }
  ]
}
