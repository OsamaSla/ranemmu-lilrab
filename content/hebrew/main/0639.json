{
  "book": "main",
  "number": 639,
  "title_he": "הִלְבִּישַׁנִי מְעִיל הַחֲתֻנָּה",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "הִלְבִּישַׁנִי מְעִיל הַחֲתֻנָּה",
        "וּקְרָאַנִי רָם הָרֹאשׁ",
        "וְהָיוּ עֲלֵי עֵץ",
        "מְחִישִׁים אוֹתִי הָעֵירֹם בַּחוּשׁ",
        "וְכַמָּה זְבָחִים זָבַחְתִּי",
        "לֹא טִהֲרוּ לֹא פָּדוּ נַפְשִׁי",
        "כִּי דָמוֹ הַשָּׁפוּךְ בַּעֲדִי",
        "כְּבָר מָחָה עֲוֺנִי כָּכָה טֻמְאָתִי"
      ]
    },
    {
      "label": "2",
      "lines": [
        "כָּל־חֶטְאִי כֻּסָּה",
        "כֵּן נֶהְפַּךְ עָבָר נִשְׁכָּח",
        "וְהַדְּאָגָה כְּבָר סָרָה מִלִּבִּי",
        "בִּישׁוּעַת הָרוּחַ וְהַנֶּפֶשׁ",
        "וְהֵקַלּוּ עֲמָלֵי זֶה הַמִּדְבָּר",
        "לְמַעַן יַעֲבֹר חָשְׁכוֹ הָאָפֵל",
        "וְשָׁפְעָה נַפְשִׁי שִׂמְחָה",
        "וְטָעַמְתִּי יֵשׁוּעַ נַפְשִׁי"
      ]
    },
    {
      "label": "3",
      "lines": [
        "נִפְנֵף דֶּגֶל הַנִּצָּחוֹן",
        "וְהַתֵּבָה לְחוֹפָהּ תַּעֲגֹן",
        "וְלָנָה עֵינִי מְחַכָּה",
        "פְּנֵי דוֹדִי בַּעַל הַקֹּדֶשׁ",
        "בָּטוּחַ לִבִּי מָלֵא",
        "בְּאוֹר וַדָּאוּת כַּשֶּׁמֶשׁ",
        "עָרֵב כִּי אֲנִי נִשְׁעָן",
        "בְּחֵיקוֹ בְּתוֹךְ הַחֲתֻנָּה"
      ]
    }
  ]
}
