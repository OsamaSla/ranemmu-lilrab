  "verses_he": [
    {
      "label": "1",
      "lines": [
        "אַתָּה הַמֶּלֶךְ הַיָּחִיד",
        "הַכְרָזַת מַלְכוּתְךָ לָנוּ תּוֹסִיף",
        "וְעַל חֶשְׁבּוֹן דַּם הַצְּלָב",
        "עַל הַשָּׂטָן הַנִּצָּחוֹן וַדַּאי"
      ]
    },
    {
      "label": "1",
      "lines": [
        "בַּתְּרוּעוֹת וּבַתְּהִלּוֹת",
