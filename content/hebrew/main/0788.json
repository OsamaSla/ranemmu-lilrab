  "verses_he": [
    {
      "label": "1",
      "lines": [
        "אַתָּה לְךָ מַטָּרָה בְּחַיַּי",
        "לִי עָרֵב כִּי תִּשְׁלַם",
        "אַתָּה מְצַיֵּר לִי שְׁבִיל",
        "וְתָכְנִית טוֹבָה לֹא תִּכָּשֵׁל"
      ],
      "chorus": true
    },
    {
      "label": "1",
      "lines": [
        "יוֹם בְּיוֹם חָפֵץ אֵלֵךְ בָּהּ",
        "וְאֶשָּׁאֵר כָּנוּעַ בֵּין יָדֶיךָ",
        "נַפְשִׁי אֶלְמַד אֲצַיֵּת לָךְ",
        "יִשָּׁאֵר כָּל־הַגִּיל לָךְ",
        "חָפֵץ אֶשְׁמַע לַחַשׁ קוֹלֶךָ",
        "וְאֶשָּׁאֵר מַבִּיט רַק לָךְ",
        "תַּנְחֶה רַגְלַי בְּדַרְכֶּךָ",
        "וְאַתָּה תְּיַעֲצֵנִי בְּעֵינֶיךָ"
      ]
    },
    {
      "label": "2",
      "lines": [
        "כָּל־יוֹם אֶשָּׁאֵר לְצִדֶּךָ",
        "וְאֶפֹּל בְּחֵיקְךָ וְאָמֵס",
        "רֹאשִׁי אֶסְמֹךְ לְיַד לִבֶּךָ",
        "וְעַל חֲטָאַי אָשׁוּב",
        "מִמְּךָ אַתָּה הַחָכְמָה יוֹרֶדֶת",
        "תִּתְּנֶנָּה בְּלִי גְּבוּלוֹת",
        "כִּי אַתָּה תִּתֵּן לַאֲשֶׁר",
        "יִשְׁאַלְךָ וְעָלָיו תָּחוֹן"
      ]
    }
  ],
  "chorus_he": "פְּזָמוֹן"
