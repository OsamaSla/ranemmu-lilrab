  "verses_he": [
    {
      "label": "1",
      "lines": [
        "מִי זֶה אֲשֶׁר בָּנָה הַשָּׁמַיִם",
        "בַּעֲלֵי הַכּוֹכָבִים הַמַּזְהִירִים",
        "מִי רָקַע הָאָרֶץ וּמִי",
        "הִגְבִּיהַּ הֶהָרִים הָרָמִים"
      ]
    },
    {
      "label": "1",
      "lines": [
        "הָאֵל כְּבָר הִמְצִיאָם",
        "כֻּלָּם בַּיְכֹלֶת",
        "יִשְׁתַּבַּח כִּי הִנּוֹ",
        "הִפְלִיאָם בַּחָכְמָה"
      ],
      "chorus": true
    },
    {
      "label": "2",
      "lines": [
        "מִי בָּרָא הַיַּמִּים וְהַ",
        "דָּגִים בָּהֶם יִשְׂחוּ",
        "מִי הִמְצִיא חַיַּת הַמָּרוֹם",
        "וְכָל־עוֹף יְרַנֵּן"
      ]
    },
    {
      "label": "3",
      "lines": [
        "מִי הִצְמִיחַ הָעֵשֶׂב וּמִי",
        "נֵי הַפְּרָחִים וְהָעֵצִים",
        "וְשָׂם הָעֵצִים בְּ",
        "עִתָּם יִתְּנוּ הַפְּרִי"
      ]
    },
    {
      "label": "4",
      "lines": [
        "מִי בָּרָא הָאָדָם בַּעַל",
        "שֵׂכֶל בּוֹ הִצְטַיֵּן",
        "מַשְׁלִיט אוֹתוֹ בָּ",
        "אָרֶץ עַל אֲשֶׁר בָּרָא"
      ]
    }
  ],
