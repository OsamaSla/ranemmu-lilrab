{
  "book": "main",
  "number": 924,
  "title_he": "פּוֹדִי אֲנִי בָּא אֵלֶיךָ",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "פּוֹדִי אֲנִי בָּא אֵלֶיךָ",
        "מַשְׁלִיךְ כָּל־עֲוֺנוֹתַי עָלֶיךָ",
        "בְּלִבְּךָ הַסְתִּירֵנִי בִּסְלִיחָתְךָ קַבְּלֵנִי",
        "אָבוֹא שָׁב אֲדֹנִי לְפָנֶיךָ",
        "כִּי בַּחֲבוּרָתְךָ אֲנִי נִרְפֵּאתִי",
        "וּבִצְלָבְךָ נִפְדֵּיתִי",
        "לְךָ אָבוֹא בַּעֲוֺנִי",
        "לְמַעַן תְּטַהֲרֵנִי וְקַבְּלֵנִי יֵשׁוּעַ"
      ]
    }
  ]
}
