{
  "book": "main",
  "number": 999,
  "title_he": "שַׁחְרֵר־נָא לִבִּי הָאָסִיר",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "שַׁחְרֵר־נָא לִבִּי הָאָסִיר",
        "כִּי הוּא בָּרָע הוֹלֵךְ",
        "וּנְדִידָתוֹ מִמְּךָ אֲדֹנָי",
        "אֵינֶנָּה דָּבָר קַל"
      ]
    },
    {
      "label": "1",
      "lines": [
        "אֱלֹהַי שַׁחְרְרֵנִי",
        "בְּדָמְךָ רַחֲצֵנִי",
        "מֵרָעוֹתַי טַהֲרֵנִי",
        "אֲדֹנָי אֲשֶׁר מַתָּ בַּעֲדִי"
      ],
      "chorus": true
    },
    {
      "label": "2",
      "lines": [
        "אֵלֶיךָ אָבוֹא יֵשׁוּעַ",
        "בַּעֲנָוָה וּבְהַכְנָעָה",
        "אָבוֹא וְאֶזַּל דְּמָעוֹת",
        "מִמְּךָ לֹא אֲבַקֵּשׁ שׁוּב"
      ]
    },
    {
      "label": "3",
      "lines": [
        "לֹא אָשׁוּב אָחוֹר",
        "אֲשֶׁר הָיִיתִי בָּעֳנִי",
        "בְּךָ לִי כָּל־הַנַּחַת",
        "אַתָּה מְקוֹר הַפְּדוּת"
      ]
    }
  ],
  "chorus_he": "פְּזָמוֹן"
}
