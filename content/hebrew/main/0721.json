{
  "book": "main",
  "number": 721,
  "title_he": "אַהֲבַת הַבֵּן הַדּוֹד",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "אַהֲבַת הַבֵּן הַדּוֹד",
        "נִרְאֲתָה בְּמַרְאֶה זָר",
        "נִרְאֲתָה בִּמְלוֹאָהּ הַנִּפְלָא",
        "בְּמוֹתוֹ עַל הַצְּלָב"
      ]
    },
    {
      "label": "2",
      "lines": [
        "אֵין דּוֹד זוּלָתוֹ",
        "בּוֹ תָּמִיד אָנוּחַ",
        "כִּי הוּא דּוֹדִי לְבַדּוֹ",
        "וְלוֹ כְּבָר יָאֶה הַמְּדִיחַ"
      ]
    },
    {
      "label": "3",
      "lines": [
        "כָּל־עוֹד בְּמוֹשָׁבוֹ",
        "כִּי נִרְדִּי כְּבָר הֵפִיחַ",
        "רֵיחַ טָהוֹר",
        "לַאֲדֹנִי מַעְיַן הַטּוֹב"
      ]
    },
    {
      "label": "4",
      "lines": [
        "הוֹי פֶּלֶא מִזֶּה הַדּוֹד",
        "אֲשֶׁר אָמַר בְּנֹעַם נֶהְדָּר",
        "אִם הוּרַמְתִּי בַּצְּלָב",
        "אֶמְשֹׁךְ אֵלַי הַכֹּל"
      ]
    },
    {
      "label": "5",
      "lines": [
        "אֲדֹנֵנוּ הַפּוֹדֶה הַדּוֹד",
        "מָשְׁכֵנִי וְנָרוּץ אַחֲרֶיךָ",
        "כִּי אַתָּה לִי טוֹב הַחֵלֶק",
        "וְאֵינֶנִּי מִתְאַוֶּה זוּלָתֶךָ"
      ]
    },
    {
      "label": "6",
      "lines": [
        "כִּי אַהֲבָתְךָ תְּכַתְּרֵנִי",
        "תָּמִיד כִּי אֶחְיֶה לָךְ",
        "וְלִי כִּסּוּף כִּי אֲנִי",
        "אֶרְאֲךָ וְאֶשָּׁאֵר עִמָּךְ"
      ]
    }
  ]
}
