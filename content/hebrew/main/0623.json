{
  "book": "main",
  "number": 623,
  "title_he": "הִנֵּה לִבִּי אֲשֶׁר הִתְרַגֵּל לִשְׁכֹּחַ",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "הִנֵּה לִבִּי אֲשֶׁר הִתְרַגֵּל לִשְׁכֹּחַ",
        "שָׁב אֶל הַחֵיק",
        "שָׁב אֲנִי מִן־הַפַּחַד וְהָאַכְזָרִיּוּת",
        "לִבִּי אֵלֶיךָ צָמֵא"
      ]
    },
    {
      "label": "1",
      "lines": [
        "קַבְּלֵנִי רַחֲמֵנִי הֲרִימֵנִי אֵלֶיךָ",
        "הֲשִׁיבֵנִי לַמְּדֵנִי סְמָכֵנִי בְּיָדֶיךָ"
      ],
      "chorus": true
    },
    {
      "label": "2",
      "lines": [
        "אַהֲבָתְךָ לִי אַהֲבָה אֲמִתִּית",
        "לִבְּךָ בָּהּ מָלֵא",
        "רַבּוֹת סָלַחְתָּ לִי וַאֲנִי בְּדַרְכִּי",
        "כָּל־אֲשֶׁר אֶהְיֶה אָשֵׁם"
      ]
    },
    {
      "label": "3",
      "lines": [
        "חַיַּי בִּלִּיתִי רַבּוֹת בְּמַכְאוֹבִים",
        "יְסַפְּרוּ אוֹתָם הַדְּמָעוֹת",
        "אַךְ שַׁבְתִּי אֶל נַפְשִׁי וְשָׁב אֲנִי",
        "זָקוּק לְךָ יֵשׁוּעַ"
      ]
    },
    {
      "label": "4",
      "lines": [
        "וַאֲנִי בְּרִחוּקִי אָבַד הַמַּעֲגָן",
        "וְלִבִּי לֹא רָוָה",
        "וּמָה בָּעוֹלָם יָכוֹל לִשְׁווֹת",
        "רֶגַע עִמְּךָ שֶׁיֵּחָיֶה"
      ]
    }
  ],
  "chorus_he": "פְּזָמוֹן"
}
