{
  "book": "main",
  "number": 798,
  "title_he": "לֹא יִפָּלֵא מִמֶּנּוּ דָּבָר",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "לֹא יִפָּלֵא מִמֶּנּוּ דָּבָר",
        "הוּא הַיָּכֹל אֲדֹנִי הַחַי",
        "אֲרָיוֹת כִּבְשָׁן לֹא יְדַאֲגוּנִי",
        "כָּל־עוֹד בּוֹטֵחַ כִּי הוּא חַי"
      ]
    },
    {
      "label": "1",
      "lines": [
        "מִמָּה אֶפְחַד וְלֹא אִירָא",
        "וַאֲנִי בְּיַד רֹעֶה הַכְּבָשִׂים",
        "אֲשֶׁר בְּיָדוֹ אוֹחֵז הַהֶגֶה",
        "וְיַגִּיעֵנִי לַגָּדוֹת"
      ],
      "chorus": true
    },
    {
      "label": "2",
      "lines": [
        "עֵינוֹ עָלַי אֹרֶךְ הַשָּׁנִים",
        "אוֹחֵז תָּמִיד יָדִי הַיָּמִין",
        "מַנְחֶה לִי בִּמְגוּרַי",
        "וִינַגֵּב לִי דִּמְעַת הָעַיִן"
      ]
    },
    {
      "label": "3",
      "lines": [
        "אָרִים רֹאשִׁי בַּקָּשׁוֹת",
        "אֶרְאֶה דּוֹדִי אַחַר הָעֲרָפֶל",
        "מִיָּד יְמַלֵּא לִבִּי שָׁלוֹם",
        "וְאָרִיעַ וְאָשִׁיר דּוֹדִים"
      ]
    }
  ],
  "chorus_he": "פְּזָמוֹן"
}
