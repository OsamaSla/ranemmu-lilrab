{
  "book": "main",
  "number": 759,
  "title_he": "צֶדֶק שָׁלוֹם עִם שָׂשׂוֹן",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "צֶדֶק שָׁלוֹם עִם שָׂשׂוֹן",
        "מִדּוֹת מַלְכוּת הַבּוֹרֵא",
        "תִּשָּׁאַרְנָה עַד דּוֹר הַדּוֹרוֹת",
        "לַמַּאֲמִין הַנִּבְחָר"
      ]
    },
    {
      "label": "1",
      "lines": [
        "זֶה שְׁלוֹם הַמַּאֲמִינִים",
        "מֵאֲדוֹנָם מָתוֹק יָקָר",
        "שָׁלוֹם שָׁלוֹם",
        "שָׁלוֹם בְּכָל־עֵת"
      ],
      "chorus": true
    },
    {
      "label": "2",
      "lines": [
        "לֹא תוּכַל הַתֵּבֵל תַּנְחִיל",
        "הַשָּׁלוֹם הַזֶּה הַנִּשְׂגָּב",
        "אַף לֹא מֵעָלֵינוּ תָּסִיר",
        "אוֹתָן הַמַּתָּנוֹת הַגְּדוֹלוֹת"
      ]
    },
    {
      "label": "3",
      "lines": [
        "זֶה שָׁלוֹם לִי קָנָהוּ",
        "אֲדוֹן הַפְּדוּת בַּצְּלָב",
        "כַּנָּהָר יָרוּץ בְּזַכּוּתוֹ",
        "יַרְוֶה צְמָאוֹן הַלֵּב"
      ]
    },
    {
      "label": "4",
      "lines": [
        "הַבֶּטַח בּוֹ וְהַתְּנוּמָה",
        "זֶה הַשָּׁלוֹם הַנּוֹתָר",
        "כִּי אַךְ הַנּוֹתֵן יֵשׁוּעַ",
        "נוֹתָר עַל הַבְּרִית"
      ]
    },
    {
      "label": "5",
      "lines": [
        "אִם יָצִיפוּ סְבִיבִי הָאֲסוֹנוֹת",
        "כַּמְּצוּלָה בְּתוֹךְ הַיָּם",
        "יַעֲמֹד שְׁלוֹמִי בְּיַצִּיבוּת",
        "יְסוֹדוֹ בַּסֶּלַע"
      ]
    }
  ],
