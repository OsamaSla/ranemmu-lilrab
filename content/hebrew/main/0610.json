{
  "book": "main",
  "number": 610,
  "title_he": "הוֹי אֱלֹהֵי הַיְקוּם מֶלֶךְ הַדּוֹרוֹת",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "הוֹי אֱלֹהֵי הַיְקוּם מֶלֶךְ הַדּוֹרוֹת",
        "אַתָּה לִי פְּאֵרִי וְצִדְקִי",
        "אַתָּה עֻזִּי מַחְסִי בְּתוֹךְ הָרָעוֹת",
        "אַתָּה צוּרִי וּמְצוּדָתִי",
        "הִצַּלְתַּנִי, הִרְוֵיתָ נַפְשִׁי",
        "הִשְׂבַּעְתַּנִי, הֵרַמְתָּ רֹאשִׁי",
        "אַתָּה כְּבוֹדִי מֵרִים רֹאשִׁי וְלִבִּי",
        "אַתָּה אֲדֹנִי מוֹרִי מָגִנִּי וְעֶזְרִי",
        "אַתָּה אוֹרִי גְּבוּרָתִי וְאֵין זוּלָתֶךָ",
        "אֶחְיֶה בְּגָלוּתִי אוֹ בִּשְׁמֵי מְרוֹמֶךָ",
        "מַבִּיט אֶל זֹהַר כְּבוֹדֶךָ"
      ]
    },
    {
      "label": "2",
      "lines": [
        "הוֹי מוֹרִי אָבוֹא אֶל קָדְשֶׁךָ",
        "אַקְרִיב לִבִּי לְאִישִׁיּוּתֶךָ",
        "מְלֹךְ עָלָיו לְמַעַן יִחְיֶה בְּפַעֲמֶיךָ",
        "וּמַלְּאֵהוּ לְמַעַן יִרְוֶה בְּאַהֲבָתֶךָ",
        "וּשְׁבֵהוּ לְמַעַן יִשָּׁאֵר בִּרְצוֹנֶךָ",
        "בִּלְעָדֶיךָ אֲדֹנִי וּבְלִי רְאוֹתֶךָ",
        "אֶחְיֶה בְּמַחְסוֹר וּבְמָוֶת"
      ]
    }
  ]
}
