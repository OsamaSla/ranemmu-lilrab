{
  "book": "main",
  "number": 981,
  "title_he": "הִשָּׁמֵר פֶּן־תִּהְיֶה טָרוּד",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "הִשָּׁמֵר פֶּן־תִּהְיֶה טָרוּד",
        "יָמֵינוּ לֹא יַאֲרִיכוּ",
        "עוֹלָם חוֹלֵף וְכָלֶה"
      ]
    },
    {
      "label": "1",
      "lines": [
        "מַה־שִּׂמְחָתֵנוּ בְּיֵשׁוּעַ הַחַי",
        "מַה־גִּילֵנוּ כִּי הַבְטָחָתֵנוּ בָּאָה"
      ],
      "chorus": true
    },
    {
      "label": "2",
      "lines": [
        "מָחָר נִשְׁכַּח הַדְּאָגוֹת",
        "בְּבוֹא אֵלֵינוּ הַיּוֹם",
        "גּוּרֵנוּ לֹא יִתְמַיֵּד"
      ]
    },
    {
      "label": "3",
      "lines": [
        "נַעֲזֹב דַּאֲגַת הָרְשָׁעִים",
        "וּנְזַמֵּר עַל־הַכִּנּוֹר",
        "לְיַד יֵשׁוּעַ הַצַּדִּיק"
      ]
    },
    {
      "label": "4",
      "lines": [
        "קָרוֹב יָבוֹא יֵשׁוּעַ",
        "וְיִמְחֶה הַדְּמָעוֹת",
        "לֹא יִהְיֶה צָמָא וְלֹא רָעָב"
      ]
    },
    {
      "label": "5",
      "lines": [
        "הַחוֹטֵא בַּשְּׁאוֹל",
        "וְהַמַּאֲמִין בַּנַּחַת",
        "וְשִׂמְחָתֵנוּ נִצְחִית"
      ]
    },
    {
      "label": "6",
      "lines": [
        "נַעֲזֹב מַשָּׂא הַצְּלָב",
        "בְּבוֹא הַדּוֹד",
        "לִבֵּנוּ בּוֹ יִיטַב"
      ]
    },
    {
      "label": "7",
      "lines": [
        "תִּשְׁתַּנֶּינָה הַגְּוִיּוֹת",
        "וְנָבוֹא אֶל הַכָּבוֹד",
        "נִהְיֶה מוּכָנִים"
      ]
    },
    {
      "label": "8",
      "lines": [
        "יִקַּח אֶת־הַמַּאֲמִינִים",
        "וְיַעֲזֹב אֶת־הָרְחוֹקִים",
        "וַאֲנַחְנוּ מִן־הַפְּדוּיִם"
      ]
    },
    {
      "label": "9",
      "lines": [
        "נָבוֹא אֶל חֲתֻנַּת הַשֶּׂה",
        "וּנְזַמֵּר עַל־הַתֻּפִּים",
        "כִּי שִׂמְחָה כָּזֹאת לֹא נִרְאֶה"
      ]
    }
  ],
  "chorus_he": "פְּזָמוֹן"
}
