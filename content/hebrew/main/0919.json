{
  "book": "main",
  "number": 919,
  "title_he": "בּוֹא וְהִתְנַשֵּׂא בְּתוֹכֵנוּ",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "בּוֹא וְהִתְנַשֵּׂא בְּתוֹכֵנוּ",
        "נִשְׂמַח בְּךָ וְתִשְׂמַח בָּנוּ",
        "וַאֲנַחְנוּ כַּאֲשֶׁר נִרְאֶה כְּבוֹדֶךָ",
        "לְךָ נָרִים שִׁירֵינוּ"
      ]
    },
    {
      "label": "1",
      "lines": [
        "כְּפִי הָאַהֲבָה אֲשֶׁר אֲהַבְתָּ לָנוּ",
        "כְּפִי הַכָּבוֹד אֲשֶׁר עָשִׂיתָ בָּנוּ",
        "חַיֵּינוּ יָעִידוּ וּלְבָבוֹתֵינוּ יַעַבְדוּ",
        "וְנִתֵּן לְךָ יֵשׁוּעַ הַכָּבוֹד הָרָאוּי לָךְ"
      ],
      "chorus": true
    },
    {
      "label": "2",
      "lines": [
        "וְגַם לוּ מָשׁוּ הֶהָרִים",
        "חַסְדְּךָ מֵאִתָּנוּ לֹא יָמוּשׁ",
        "לָנוּ רַחֲמִים כָּל־הַדּוֹרוֹת",
        "בְּרִית שְׁלוֹמְךָ לָנוּ תָּמִיד"
      ]
    },
    {
      "label": "3",
      "lines": [
        "מֶלֶךְ הַמְּלָכִים בַּעַל הַשִּׁלְטוֹן",
        "נוֹתֵן הַתִּקְוָה מַעְיַן הַחֶמְלָה",
        "אַתָּה הַקָּדוֹשׁ רֹעֵנוּ",
        "אֲדוֹן הַגְּדוּדִים פּוֹדֵנוּ"
      ]
    }
  ],
  "chorus_he": "פְּזָמוֹן"
}
