{
  "book": "main",
  "number": 594,
  "title_he": "לְשִׁמְךָ הוֹי פּוֹדֵנוּ בֶּאֱמֶת",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "לְשִׁמְךָ הוֹי פּוֹדֵנוּ בֶּאֱמֶת בָּאנוּ",
        "וְכִסּוּף הַלֵּב אֵלֶיךָ",
        "וְנָשָׂאנוּ עֵינֵינוּ אֵלֶיךָ תֶּן־לָנוּ",
        "נִרְאֲךָ נִשְׂמַח בָּךְ"
      ]
    },
    {
      "label": "1",
      "lines": [
        "עַמְּךָ מְקַוֶּה לָךְ",
        "לַמְּדֵנוּ נִחְיֶה בִּרְצוֹנֶךָ",
        "הַרְוֵה אַהֲבָתֵנוּ וְהוֹסֵף אַחְדוּתֵנוּ",
        "וְעַנְּגֵנוּ בְּשִׁבְתֶּךָ"
      ],
      "chorus": true
    },
    {
      "label": "2",
      "lines": [
        "אוּלַי צְעָדֵינוּ יִתְעוּ, יַחְפִּירֵנוּ",
        "עֲבָרֵנוּ וְחֻלְשַׁת הָרוּחַ",
        "אַךְ תַּנְחֵנוּ וְרוּחֲךָ בָּנוּ",
        "יְרַפֵּא כָּל־פְּצָעִים"
      ]
    },
    {
      "label": "3",
      "lines": [
        "אָסַפְנוּ מַשָּׂאוֹתֵינוּ וְכָל־תִּקְווֹתֵינוּ",
        "וּבָאִים נִדְכָּאִים",
        "אוֹמְרִים לְךָ נְחֵנוּ אַתָּה וְאַמְּצֵנוּ",
        "בְּרוּחֲךָ הַנֶּאֱמָן"
      ]
    }
  ],
  "chorus_he": "פְּזָמוֹן"
}
