{
  "book": "main",
  "number": 885,
  "title_he": "אַתָּה הַמַּבְטִיחַ חֲלוֹמִי עִמָּךְ",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "אַתָּה הַמַּבְטִיחַ חֲלוֹמִי עִמָּךְ",
        "אָבוֹא אֵלֶיךָ בִּכְנִיעָה",
        "קַדֵּשׁ חֲלוֹמוֹתַי בִּרְצוֹנֶךָ",
        "אֲדֹנִי יֵשׁוּעַ"
      ]
    },
    {
      "label": "1",
      "lines": [
        "אֲנִי מְחַכֶּה לְךָ לְבַדְּךָ יֵשׁוּעַ",
        "וְעֵינִי עָלֶיךָ בְּצָמָא וּבְרָעָב"
      ],
      "chorus": true
    },
    {
      "label": "2",
      "lines": [
        "קַוֹּה קִוִּיתִי",
        "הַבְטָחוֹתֶיךָ לִי",
        "וּבוֹא כַּאֲשֶׁר חָפַצְתָּ",
        "בְּתַחְיָה בִּי"
      ]
    },
    {
      "label": "3",
      "lines": [
        "הוֹי מְמַלֵּא נַפְשִׁי שָׁלוֹם",
        "כָּל־אֲשֶׁר הָאוֹיֵב יֹאמַר",
        "נִצְחוֹנִי בְּךָ תָּמִיד",
        "נָכוֹן לֹא יָמוּשׁ"
      ]
    },
    {
      "label": "4",
      "lines": [
        "עַנֵּג נַפְשִׁי מֵעָשְׁרֶךָ",
        "בָּעֹמֶק אֲדֹנִי",
        "הַשְׂבַּע לִבִּי וּמַחְשַׁבְתִּי עִמָּךְ",
        "וְכִסּוּפִי וְאַהֲבָתִי"
      ]
    }
  ],
  "chorus_he": "פְּזָמוֹן"
}
