    {
      "label": "1",
      "lines": [
        "נִשְׁכַּח אֵפוֹא אֲשֶׁר בָּאָחוֹר",
        "וְנַבִּיט לְעֵבֶר יֵשׁוּעַ הַתִּקְוָה",
        "וְנַשְׁלִיךְ מַשְּׂאוֹתֵינוּ אֵצֶל מִי",
        "וִתֵּר עַל הַכָּבוֹד עֵת הַפְּדוּת"
      ]
    },
    {
      "label": "2",
      "lines": [
        "הֲלֹא אֲנַחְנוּ עֵדֶר קָטָן לוֹ",
        "לָמָּה נִירָא הֶתְקֵף הָאוֹיְבִים",
        "כִּי עֵין הָאֵל עַל עַמּוֹ",
        "מִן־הַהַתְחָלָה גַּם וְאֹרֶךְ הַזְּמַן"
      ]
    },
    {
      "label": "3",
      "lines": [
        "הִקָּשֵׁר בַּאֲדוֹן הַיְשׁוּעָה לְמַעַן",
        "יַצִּילְךָ מִמִּכְשׁוֹלֵי הַדֶּרֶךְ",
        "כִּי אִם כְּבָר יָדַעְתָּ שְׁמוֹ אַל־תִּירָא",
        "יָרִים נַפְשְׁךָ מִכָּל־צָרָה"
      ]
    },
    {
      "label": "4",
      "lines": [
        "כִּי אֲנַחְנוּ עַל פֶּתַח שָׁנָה חֲדָשָׁה",
        "נִחְיֶה בְּשֶׁפַע הַתִּקְוָה וְהַמִּשְׁאֵלָה",
        "דַּיֵּנוּ פְּתִירוּת דַּיֵּנוּ רָזוֹן",
        "דַּיֵּנוּ יְשִׁיבָה בָּהָר הַזֶּה"
      ]
    }
