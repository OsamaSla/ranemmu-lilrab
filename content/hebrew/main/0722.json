  "title_he": "אָרִים זִבְחִי בְּשִׂמְחָה מְלֵאָה בַּשֶּׁבַח",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "אָרִים זִבְחִי בְּשִׂמְחָה מְלֵאָה בַּשֶּׁבַח",
        "בֶּאֱמוּנָה תִּרְאֶה הַהַבְטָחָה מֵעַל הַמֶּרְחָק",
        "אָרִים זִבְחִי בְּשִׂמְחָה וְאִם הָיָה בְּתוֹךְ הַמְּצוּקָה",
        "כִּי בַּעַל הַהַבְטָחָה אֲדוֹן הַכָּבוֹד",
        "אָרִים זִבְחִי בְּשִׂמְחָה"
      ]
    },
    {
      "label": "2",
      "lines": [
        "שֶׁבַח וְהַלֵּל אֱלֹהַי לָךְ",
        "תּוֹדָתִי וְהַלֵּלִי וְשִׂמְחָתִי אַקְדִּישׁ לָךְ",
        "עַל כָּל־דָּבָר לֹא אֲחַזְתִּיו בַּיָּד",
        "עַל כָּל־מָה תַּגִּישׁ לַמָּחָר",
        "שֶׁבַח וְכָבוֹד לָךְ"
      ]
    }
  ]
}
