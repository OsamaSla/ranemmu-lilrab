  "title_he": "יִיטַב לִי בַּחַיִּים הָאֵלֶּה",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "יִיטַב לִי בַּחַיִּים הָאֵלֶּה",
        "לְשָׁרֵת אֶת־הַהֲמוֹנִים",
        "כִּי הִנְנִי בַּעֲבוֹדָתִי",
        "צִירְךָ יֵשׁוּעַ",
        "אֶשְׂמַח בְּנַהֲגִי אוֹתָם",
        "אֵלֶיךָ תִּמְחֶה הַדְּמָעוֹת",
        "לָהֶם אָאִיר בְּעוֹד",
        "אֶמַּס הַנֵּרוֹת"
      ]
    },
    {
      "label": "1",
      "lines": [
        "רַב הַקָּצִיר",
        "וְהִלְבִּינוּ הַשָּׂדוֹת",
        "וְחַזְּקֵנִי לְמַעַן",
        "אֵלֵךְ אֶל הַשָּׂדוֹת"
      ],
      "chorus": true
    },
    {
      "label": "2",
      "lines": [
        "וּלְמַעַן תִּהְיֶה עֲבוֹדָתִי",
        "עֲשִׁירַת הַפֵּרוֹת",
        "הֱיֵה אַתָּה תָּמִיד קְצִינִי",
        "וֶהְיֵה לִי הַמְּנוֹרָה",
        "הֲנִיחֵנִי אָשִׁיב הַכָּבוֹד לָךְ",
        "כָּל־עוֹד אֲנִי בַּמִּשְׁכְּנוֹת הָאֵלֶּה",
        "שָׁם יוֹם אֶזְכֶּה",
        "בְּכָבוֹד לַמְּצוּלוֹת"
      ]
    },
    {
      "label": "3",
      "lines": [
        "מִיְּצוּר תַּחַת הָעֹנֶשׁ",
        "חַי בְּאֵין תִּקְוָה",
        "חֶמְלָתְךָ הֲפָכַתְנִי",
        "לְיוֹרֵשׁ הַשָּׁמַיִם",
        "וְאֵיךְ לֹא אֲדֹנִי",
        "אֶתֶּן־לְךָ תַּכְלִית הַנֶּאֱמָנוּת",
        "אֲשָׁרֵת אֹרֶךְ הַחַיִּים",
        "בְּסַבְלָנוּת וּבֶאֱמוּנָה"
      ]
    }
  ],
