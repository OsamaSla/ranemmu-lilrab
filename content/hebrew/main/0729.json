  "title_he": "תִּשְׁאָלֵנִי אָשׁוּב לִשְׁבִיל הַחֵטְא",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "תִּשְׁאָלֵנִי אָשׁוּב לִשְׁבִיל הַחֵטְא",
        "תִּשְׁאָלֵנִי אָשׁוּב לְקֶבֶר הַחֹשֶׁךְ",
        "וְתַצִּיעַ לְלִבִּי שִׁפְלוּת וְעוֹלָם",
        "שְׁרַב הָאֹשֶׁר וְצֵל הַשָּׁלוֹם",
        "וְתַרְאֶה כִּי אַתָּה תָּחוּס עָלָיו",
        "וְאַתָּה תִּרְגְּמֵהוּ בְּאֵלֶּה הַחִצִּים",
        "אוֹיְבִי הַאֲזֵן לִי אֶשְׁאַל לִבִּי",
        "וְיָשִׁיבְךָ בְּצֶדֶק הַדִּבּוּר"
      ]
    },
    {
      "label": "2",
      "lines": [
        "הוֹי לִבִּי הֶחָדָשׁ בַּמֶּה תָּשִׁיב",
        "הֲתִרְצֶה תָּשׁוּב לְעוֹלַם הָעֲוֺנוֹת",
        "בִּפְעִימָה וְדֹפֶק וְעֹמֶק גַּעְגּוּעַ",
        "עָנָה לְבָבִי לְמַעַן יַבְהִיר הָעֲרָפֶל"
      ]
    },
    {
      "label": "3",
      "lines": [
        "לָמָּה אָשׁוּב וְאֶדְחֶה אֲדֹנִי",
        "וְחִכּוֹ מָתוֹק וּבוֹ הַחֶמְלָה",
        "וְיָפֶה יֹפִי עַל כָּל־בְּרִיאָה",
        "וּבוֹ דַּיִּי וּבוֹ הַבֶּטַח",
        "הַאֶשְׁכַּח דָּמָיו תְּרוּפַת הַחֵטְא",
        "מַרְפֵּא פְּצָעַי יְשׁוּעַת הַנִּדּוֹן",
        "הַאֶשְׁכַּח כּוֹסוֹת הַחֵטְא הָאֲרוּרוֹת",
        "תַּפֵּלְנָה בְּשִׂכְלִי וְתַדְמֵינָה הַהֲוָיָה"
      ]
    },
    {
      "label": "4",
      "lines": [
        "עֲנִיתִיךָ אוֹיְבִי בְּלִי מְהוּמָה",
        "כִּי הִנֵּה שְׁלוֹמִי בְּלִי גְּבוּלוֹת",
        "כִּי לוּ כְּבָר עֲזָבַנִי אֱלֹהַי לְעַצְמִי",
        "הָיִיתָ מַהֵר עָלַי תִּמְלֹךְ",
        "אַךְ הִנְנִי בְּיַד יֵשׁוּעַ אֲדֹנִי",
        "וּבְסִפְרוֹ שְׁמִי לְיוֹם הַנֶּצַח",
        "כִּי לוּ כְּבָר הָעֳנַקְתִּי זֶה הָעוֹלָם מַלְכוּת",
        "אֲנִי לֹא אָשׁוּב אֲנִי לֹא אָשׁוּב"
      ]
    }
  ]
