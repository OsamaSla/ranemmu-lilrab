{
  "book": "main",
  "number": 716,
  "title_he": "בּוֹרֵא הַמְּלוֹא שׁוֹכֵן הָעָל",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "בּוֹרֵא הַמְּלוֹא",
        "שׁוֹכֵן הָעָל",
        "מָתַי הַפְּגִישָׁה",
        "צוֹדֵק הַהַבְטָחוֹת",
        "כִּי אֵינֶנּוּ מִפֹּה",
        "אֵין לָנוּ פֹּה",
        "אֲנַחְנוּ הַנִּבְזֶה",
        "אֵין לָנוּ קִיּוּם"
      ]
    },
    {
      "label": "2",
      "lines": [
        "גֵּרִים בַּבָּתִּים",
        "וְנִחְיֶה בַּסֵּתֶר",
        "אֵין לָנוּ פִּרְסוּם",
        "אֵין לָנוּ הֲנָחָה",
        "הִנְנוּ בְּצִפִּיָּה",
        "הַלַּיְלָה וְהַיּוֹם",
        "נְקַוֶּה בּוֹאֲךָ",
        "כּוֹכַב הַשַּׁחַר"
      ]
    },
    {
      "label": "3",
      "lines": [
        "נֵדַע כִּסּוּפֶךָ",
        "מִנֶּגֶד עַמֶּךָ",
        "וּזְכֹר כַּלָּתֶךָ",
        "בְּגֵיא זֹאת הַדְּמָעוֹת",
        "כְּבָר אָמַרְתָּ הִנְנִי",
        "בָּא לָכֶם מַהֵר",
        "אָמֵן וּבוֹא",
        "אֲדֹנֵנוּ יֵשׁוּעַ"
      ]
    },
    {
      "label": "4",
      "lines": [
        "נִכְסְפָה לְךָ הַכַּלָּה",
        "גַּעְגְּעוּ לְךָ הַנְּפָשׁוֹת",
        "אָרַךְ גָּלוּתֵנוּ",
        "צוֹדֵק הַהַבְטָחוֹת",
        "וּזְכֹר קְרִיאָתֵנוּ",
        "וּשְׁמַע תְּחִנָּתֵנוּ",
        "קְרַב חֲתָנֵנוּ",
        "מִמֶּנּוּ לְךָ הַסְּגִידָה"
      ]
    }
  ]
}
