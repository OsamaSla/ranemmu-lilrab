  "title_he": "רוּחֲךָ שׁוֹכֵן בָּנוּ",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "רוּחֲךָ שׁוֹכֵן בָּנוּ",
        "אַהֲבָתְךָ מְחַמֶּמֶת אוֹתָנוּ",
        "קוֹלְךָ מְנַחֵם אוֹתָנוּ",
        "מְלֹךְ בְּתוֹכֵנוּ"
      ]
    },
    {
      "label": "1",
      "lines": [
        "אַתָּה הַמֶּלֶךְ יֵשׁוּעַ",
        "וּמִי זוּלָתְךָ יִמְלֹךְ",
        "אַתָּה הַמַּרְפֵּא יֵשׁוּעַ",
        "וּמִי זוּלָתְךָ יְרַפֵּא"
      ],
      "chorus": true
    },
    {
      "label": "2",
      "lines": [
        "אוֹרְךָ הֵאִיר חַיַּי",
        "דָּמְךָ טִהֵר לִבִּי",
        "שִׂמְחָתְךָ שָׁפְעָה וּמִלְּאַתְנִי",
        "עָשְׂתָה חַיַּי יָשִׁירוּ"
      ]
    }
  ],
  "chorus_he": "פְּזָמוֹן"
}
