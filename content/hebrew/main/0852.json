    {
      "label": "1",
      "lines": [
        "אֶרְאֶה פְּנֵי יֵשׁוּעַ",
        "הוֹי לוֹ מַרְאֶה נִפְלָא",
        "כִּי אֶרְאֶה מִי מֵת בַּעֲדִי",
        "וּפְדָנִי בַּצְּלָב"
      ]
    },
    {
      "label": "1",
      "lines": [
        "אֶרְאֶה פָּנִים אֶל פָּנִים",
        "הַפּוֹדֶה הַיָּדִיד הַהוּא",
        "אֶפְגְּשֶׁנּוּ אַחַר עֵת",
        "מֵעַל בְּבֵית הַנֶּצַח"
      ],
      "chorus": true
    },
    {
      "label": "2",
      "lines": [
        "הָיִיתִי מֵאַחֲרֵי מָסָךְ",
        "מַבִּיט מַלְכוּת הַשָּׁלוֹם",
        "וּמָחָר יָבוֹא יוֹם",
        "יִגָּלֶה בּוֹ הַחֹשֶׁךְ"
      ]
    },
    {
      "label": "3",
      "lines": [
        "אָהּ מַה־שָּׂמֵחַ יוֹם",
        "בּוֹ אֶהֱנֶה בַּדּוֹד",
        "הִנֵּה הָעֵת הַהִיא קְרוֹבָה",
        "וְתָבוֹא עוֹד מְעַט"
      ]
    },
    {
      "label": "4",
      "lines": [
        "הוֹי שְׂשׂוֹנִי כַּאֲשֶׁר אֶפְגֹּשׁ",
        "הָאָדוֹן בְּבֵית הַבֶּטַח",
        "וּפְנֵי מִי פְּדָנִי",
        "אֶרְאֶנּוּ בָּרְאִיָּה"
      ]
    }
