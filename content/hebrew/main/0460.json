{
  "book": "main",
  "number": 460,
  "title_he": "כַּמָּה אֶחְפֹּץ לְהַלֵּל אֶת־יֵשׁוּעִי",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "כַּמָּה אֶחְפֹּץ לְהַלֵּל אֶת־יֵשׁוּעִי",
        "מֵאָז מָצָאתִיו, יָדִיד נֶאֱמָן מִכֹּל",
        "אֵיךְ פָּעַל בִּי שִׁנּוּי נִפְלָא",
        "וַאֲנִי עָגֵז, וְהוּא רֵעַ חָזָק מִמֶּנִּי"
      ]
    },
    {
      "label": "1",
      "lines": [
        "אֵין מִי שֶׁדּוֹאֵג לִי כַּאֲדֹנָי",
        "אֵין רֵעַ כָּמוֹהוּ",
        "כִּי הוּא מָחָה אֶת־חֲטָאַי וְאֶת־חֶשְׁכִּי",
        "מַה־נִּפְלָא אַהֲבָתוֹ"
      ],
      "chorus": true
    },
    {
      "label": "2",
      "lines": [
        "הָיִיתִי אָסִיר בְּרָעָה וּבְאֵימָה",
        "כְּשֶׁמָּצָא אוֹתִי הַגִּבּוֹר הַהוּא",
        "וַתַּקִּיף אוֹתִי יְמִינוֹ הָרַחוּמָה",
        "וַתַּנְחֵנִי אֶל דַּרְכּוֹ הַמְאִירָה"
      ]
    },
    {
      "label": "3",
      "lines": [
        "הוּא תָּמִיד מַרְבֶּה בִּטְחוֹנִי",
        "וְשִׂמְחָה בִּדְבַר חַסְדּוֹ",
        "אֲבָל אַהֲבָתוֹ לְחוֹטֵא כָּמוֹנִי",
        "הִיא סוֹד שֶׁמֻּכְרָז בִּכְבוֹדוֹ"
      ]
    },
    {
      "label": "4",
      "lines": [
        "וּמִלִּבִּי אֶתֵּן תּוֹדָה וְתִהֲלָה",
        "לְמוֹשִׁיעִי וּלְאוֹרִי בַּחַיִּים",
        "וְתִקְוָתִי, אֲבָל וַדָּאוּתִי וְנֶחָמָתִי",
        "לִפְגֹּשׁ אוֹתוֹ וְלָשֵׁבֶת בִּשְׁמָיו"
      ]
    }
  ],
  "chorus_he": "פְּזָמוֹן"
}
