  "title_he": "אִם הַכְּפִירִים רָשׁוּ",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "אִם הַכְּפִירִים רָשׁוּ",
        "וְאִם רָעֲבוּ הָאֲרָיוֹת",
        "נַפְשִׁי בְּדוֹדִי טוֹבָה",
        "בּוֹ הַשְּׂמָחוֹת שָׁבוֹת"
      ]
    },
    {
      "label": "1",
      "lines": [
        "שִׂמְחָתְךָ מְלֵאָה צַלְעוֹתַי",
        "בַּצָּרָה וּבַמְּצוּקוֹת",
        "הַשְׂבַּע אֲדֹנִי רְעָבוֹנִי",
        "שַׁלֵּם לְנַפְשִׁי אֲשֶׁר חָלַף"
      ],
      "chorus": true
    },
    {
      "label": "2",
      "lines": [
        "כָּל־אֲשֶׁר הַיָּגוֹן יְבוֹאֵנִי",
        "אוֹ בַּצָּרָה בָּכִיתִי",
        "אֵלֵךְ לְמִי יְרַפְּאֵנִי",
        "זוּלָתְךָ אֲדֹנִי לֹא מָצָאתִי"
      ]
    },
    {
      "label": "3",
      "lines": [
        "יְשִׁיבָה בְּנֹכְחוּת דּוֹדִי",
        "כָּל־הַמַּכְאוֹבִים הוֹלְכִים",
        "אֲנָשִׁים הִנֵּה הוּא רוֹפְאִי",
        "מְרַפֵּא כָּל־הַפְּצָעִים"
      ]
    },
    {
      "label": "4",
      "lines": [
        "מַלְּאֵנִי אֲדֹנָי בְּרוּחֲךָ",
        "וְאֶשְׂמַח בְּךָ תָּמִיד",
        "קַדֵּשׁ רוּחִי בִּפְצָעֶיךָ",
        "אֶחְיֶה כְּלַהַב מֵאֵשׁ"
      ]
    }
  ],
