{
  "book": "main",
  "number": 740,
  "title_he": "מִי יְרַפֵּא הַלֵּב הַשָּׁבוּר",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "מִי יְרַפֵּא הַלֵּב הַשָּׁבוּר",
        "זוּלַת לֵב רַחוּם וְסַלָּח",
        "לֵב בַּעֲדִי הִתְיַסֵּר שֶׁקֶר",
        "לֵב נָשָׂא כָּל־גַּאֲוָה",
        "לֵב יִסְלַח כָּל־רָעוֹת",
        "לְמַעַן אֶחְיֶה חַיַּי בְּאוֹר"
      ]
    },
    {
      "label": "2",
      "lines": [
        "רָצָה בְּמַכְאוֹבָיו וִיגוֹנוֹ בַּעֲדִי",
        "דַּם צְלָבוֹ הַיָּקָר פְּדָנִי",
        "אֵיךְ אֶשְׁכַּח גֹּדֶל אַהֲבָתוֹ",
        "וְאֶחְיֶה בְּחֵטְא וְאָשִׁיב צְלִיבָתוֹ",
        "וַאֲבַלֶּה חַיַּי בְּעוֹלָם חוֹלֵף",
        "אַשְׂבִּיעַ נַפְשִׁי וְאַהֲבָתִי לְעַצְמִי"
      ]
    },
    {
      "label": "3",
      "lines": [
        "אֵיךְ אוּכַל אֶשְׁכַּח צְלָבְךָ",
        "בְּתוֹךְ צַעֲקָתְךָ וְעִם דִּמְעוֹתֶיךָ",
        "אֵיךְ אוּכַל אֶשְׁכַּח דּוֹדִי",
        "אֲשֶׁר בְּדָמוֹ יְרַפֵּא פְּצָעַי",
        "אֲשֶׁר בִּנְגִיעָה יַטִּיב רוּחִי",
        "טוּבוֹ בְּגִילִי יַשְׂבִּיעַ רוּחִי"
      ]
    }
  ]
}
