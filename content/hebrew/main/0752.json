  "title_he": "הָאָדוֹן שׁוֹכֵן בְּתוֹךְ לִבִּי",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "הָאָדוֹן שׁוֹכֵן בְּתוֹךְ לִבִּי",
        "הָאָדוֹן יַבְטִיחַ לִי הַבֶּטַח",
        "יַעֲשֶׂה מָה הַשָּׂטָן וּצְבָאוֹ",
        "הִנֵּה הָאָדוֹן נִצְּחוֹ מֵאָז",
        "הוּא הֶחָזָק יוּכַל חָזָק יְגָרֵשׁ אוֹיְבֵנוּ",
        "בִּגְבוּרָתוֹ וּבְשִׁלְטוֹנוֹ נַכְרִיז נִצְּחוֹנֵנוּ"
      ]
    },
    {
      "label": "2",
      "lines": [
        "כָּל־אֲשֶׁר הַשָּׂטָן צִיֵּר הַבְּעָיוֹת",
        "כָּל־אֲשֶׁר הַשָּׂטָן רוֹמֵם הַסְּכָרִים",
        "לַמִּלְחָמָה עִם הַשָּׂטָן סוֹף",
        "וְהָאָדוֹן יָשִׂים הַגְּבוּלוֹת",
        "הוּא הֶחָזָק יוּכַל חָזָק יְגָרֵשׁ אוֹיְבֵנוּ",
        "בִּגְבוּרָתוֹ וּבְשִׁלְטוֹנוֹ נַכְרִיז נִצְּחוֹנֵנוּ"
      ]
    },
    {
      "label": "3",
      "lines": [
        "כַּאֲשֶׁר הַמַּצָּבִים תִּלְחַצְנָה עָלַי",
        "כַּאֲשֶׁר הַכִּשָּׁלוֹן יִהְיֶה דֶּרֶךְ",
        "כַּאֲשֶׁר הַדּוֹד יִרְחַק וְיִבְגֹּד",
        "לְבַדְּךָ תִּהְיֶה אַתָּה הֶחָבֵר",
        "אַתָּה הֶחָזָק יוּכַל חָזָק יְגָרֵשׁ אוֹיְבֵנוּ",
        "בִּגְבוּרָתוֹ וּבְשִׁלְטוֹנוֹ נַכְרִיז נִצְּחוֹנֵנוּ"
      ]
    },
    {
      "label": "4",
      "lines": [
        "בְּתוֹךְ הַבְּעָיוֹת וְהַתְּלָאוֹת",
        "אָרִים דִּגְלֵי הַנִּצָּחוֹן לָךְ",
        "אַשְׁלִיךְ הַהֶפְסֵדִים וְהָרְוָחִים",
        "וְאֶמְכֹּר חַיַּי וְאֶקְנֶה אוֹתָךְ",
        "אַתָּה הֶחָזָק יוּכַל חָזָק יְגָרֵשׁ אוֹיְבֵנוּ",
        "בִּגְבוּרָתוֹ וּבְשִׁלְטוֹנוֹ נַכְרִיז נִצְּחוֹנֵנוּ"
      ]
