{
  "book": "main",
  "number": 903,
  "title_he": "בָּאתִי אֵלֶיךָ שִׁנִּיתָ חַיָּי",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "בָּאתִי אֵלֶיךָ שִׁנִּיתָ חַיָּי",
        "הֶחֱיִיתַנִי אַחַר הַמָּוֶת",
        "מִיּוֹם צָעַקְתִּי: רַחֲמֵנִי",
        "בְּרֶגַע שָׁמַעְתִּי הַקּוֹל"
      ]
    },
    {
      "label": "2",
      "lines": [
        "נִסִּיתִי בְּעַצְמִי הַרְבֵּה",
        "וְהֶעָבָר חָיִיתִיו אָסִיר",
        "אַךְ בָּאתִי אֵלֶיךָ אַתָּה",
        "לָקַחְתִּי גְּבוּרַת שִׁנּוּי"
      ]
    },
    {
      "label": "3",
      "lines": [
        "גְּבוּרָה תְּרַעֲנֵן עַצְמוֹתַי",
        "וְתָאִיר עֵינַי",
        "גְּבוּרָה הוֹלֶכֶת לְפָנַי",
        "וּמְצִלָּה עָלַי"
      ]
    },
    {
      "label": "4",
      "lines": [
        "עָזְרֵנִי אֶחְיֶה לְךָ אַתָּה",
        "וְחַיַּי תִּתְכַּבֵּד בָּהֶם",
        "וּנְחֵנִי בְּכָל־צַעַד",
        "אֲדֹנָי עִמְּךָ אֵלְכֶנּוּ"
      ]
    }
  ]
}
