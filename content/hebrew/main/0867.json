  "title_he": "מָסַרְתִּי לִבִּי יִחַדְתִּי אַהֲבָתִי",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "מָסַרְתִּי לִבִּי יִחַדְתִּי אַהֲבָתִי",
        "הִקְרַבְתִּי עַצְמִי לְךָ אֲדֹנִי",
        "אֲנִי לְךָ כֻּלִּי בְּכֻלִּי",
        "וְאַתָּה לִי פֹּה בִּמְגוּרַי",
        "תַּנְחֵנִי תֵּלֵךְ בְּלִוְיָתִי",
        "בְּרוּחֲךָ תַּנְהִיג צְעָדַי",
        "אָרִיעַ כָּבוֹד לְךָ עַל אֹרֶךְ הַשָּׁנִים",
        "אֶהְגֶּה בְּךָ כִּי אַתָּה לִי הָעוֹזֵר",
        "וְאֶכָּנַע לְקוֹלְךָ תָּמִיד בְּכָל־עֵת",
        "כֵּן אָמֵן אָמֵן",
        "מָסַרְתִּי לִבִּי יִחַדְתִּי אַהֲבָתִי",
        "הִקְרַבְתִּי עַצְמִי לְךָ אֲדֹנִי לְךָ אֲדֹנִי"
      ]
    }
  ]
