{
  "book": "main",
  "number": 714,
  "title_he": "כַּאֲשֶׁר נַבִּיט אֵלֶיךָ בַּכָּבוֹד הָרָם",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "כַּאֲשֶׁר נַבִּיט אֵלֶיךָ בַּכָּבוֹד הָרָם",
        "לִבּוֹתֵינוּ אֲדֹנִי יִכְרְעוּ בִּכְנִיעָה",
        "שָׁם נִקְרָא הַסִּפּוּר אֲשֶׁר",
        "עַל הַצְּלָב יְסַפֵּר אֵימָתוֹ הַנּוֹרָאָה"
      ]
    },
    {
      "label": "2",
      "lines": [
        "כָּל־סִמְלֵי הַחֶרְפָּה בְּשַׁחֲרוּתָם",
        "נִרְאֵם עַל רֹאשְׁךָ נִתְקַיְּמוּ",
        "וְכָל־מַכְאוֹבֶיךָ בְּמַעֲמַקֵּיהֶם",
        "יָשִׁיבוּ עַל כְּבוֹדְךָ אֲשֶׁר רָם"
      ]
    },
    {
      "label": "3",
      "lines": [
        "לְבַדְּךָ עַל הַצְּלָב כְּבָר נֶעֱזַבְתָּ",
        "וְלֹא מָצָאתָ סְבִיבְךָ עַיִן חָמְלָה",
        "וְעַתָּה עַל יְמִין הָאֵל כְּבָר הוּרַמְתָּ",
        "תִּשְׁנֶה הַשָּׁמַיִם תְּהִלַּת מָה עָשִׂיתָ"
      ]
    },
    {
      "label": "4",
      "lines": [
        "וְהַאִם שָׁם הָאֵל כְּבָר עֲזָבֶךָ",
        "וּמִצַּעֲקָתְךָ רָחוֹק כְּבָר הָיָה",
        "וְעַתָּה בַּפָּנִים אֲשֶׁר כְּבָר הָשְׁחֲתוּ",
        "נִקְרָא כְּבוֹד הָאֵל עוֹלֶה נִרְאָה"
      ]
    },
    {
      "label": "5",
      "lines": [
        "לָכֵן כַּאֲשֶׁר נַבִּיטֵהוּ נִכְרַע לָךְ",
        "בָּרוּךְ אַתָּה לָכֵן נְהַלֶּלְךָ",
        "לְבַדְּךָ רָאוּי שֶׂה נָדִיב",
        "זֶה מְדִיחַ הָאָרֶץ וְהַשָּׁמַיִם לָךְ"
      ]
    }
  ]
}
