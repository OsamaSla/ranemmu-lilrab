{
  "book": "main",
  "number": 450,
  "title_he": "מָה תְּבַקֵּשׁ הַנֶּפֶשׁ",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "מָה תְּבַקֵּשׁ הַנֶּפֶשׁ בְּ",
        "בְּקָצֶה שְׁמֵי הַמָּרוֹם",
        "אִם מִלִּבִּי, מִי יֵדַע",
        "יֶאֱהַב בָּעוֹלָם הַזֶּה"
      ]
    },
    {
      "label": "2",
      "lines": [
        "יֵשׁוּעַ חֶלְקִי מַחֲסִי",
        "לֹא אֶבְקֵשׁ זוּלָתוֹ",
        "דּוֹד לִבִּי וּמִשְׁאָלָתִי",
        "אֶכְסֹף לִרְאוֹתוֹ"
      ]
    },
    {
      "label": "3",
      "lines": [
        "אִם הַשָּׁמַיִם לֹא",
        "יִתְּנוּ מָטָר",
        "וְאָבְדוּ הָעֲשָׂבִים",
        "וְהָעֵצִים וְהַפֵּרִים"
      ]
    },
    {
      "label": "4",
      "lines": [
        "אֲבָל לִבִּי עוֹדֶנּוּ",
        "בַּאֲדֹנָי יִשְׂמַח",
        "כֵּן לְשׁוֹנִי מוֹדֶה",
        "אוֹתוֹ יְהַלֵּל"
      ]
    }
  ]
}
