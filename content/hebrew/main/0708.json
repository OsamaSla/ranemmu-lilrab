{
  "book": "main",
  "number": 708,
  "title_he": "דְּבַר הָאֵל הָיָה",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "דְּבַר הָאֵל הָיָה",
        "בָּשָׂר הוֹי לַפֶּלֶא",
        "וּפְדָנוּ כֻּלָּנוּ",
        "שׁוֹתֶה כּוֹס הַזַּעַם"
      ]
    },
    {
      "label": "2",
      "lines": [
        "פֶּלֶא מֵאַהֲבַת מִי",
        "מִלֵּא מְקוֹמֵנוּ בָּרָצוֹן",
        "לָכֵן מֵת וּכְבָר",
        "קָם גַּם וְעָלָה"
      ]
    },
    {
      "label": "3",
      "lines": [
        "מַתְנוּ גַּם עִמּוֹ",
        "וַהֲקִימָנוּ יַחְדָּו",
        "וּבוֹ הוֹשִׁיבָנוּ",
        "וּמְקוֹמֵנוּ רָם"
      ]
    },
    {
      "label": "4",
      "lines": [
        "שִׂמְחוּ אֲשֶׁר בּוֹ",
        "זְכִיתֶם הָאַהֲבָה הַנִּפְלָאָה",
        "וְהוֹדוּ הָאָב עַל",
        "זֶה הַמָּקוֹם בַּדּוֹד"
      ]
    }
  ]
}
