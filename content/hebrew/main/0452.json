{
  "book": "main",
  "number": 452,
  "title_he": "כַּמָּה מְלֵאִים חַיֵּינוּ מִלִּים",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "כַּמָּה מְלֵאִים חַיֵּינוּ מִלִּים",
        "כַּמָּה חֲסֵרִים אֲנַחְנוּ כֹּחַ",
        "כַּמָּה תֶּחְמֹד נַפְשֵׁנוּ חַיִּים",
        "כְּאֲשֶׁר רוֹאֶה הַמָּשִׁיחַ"
      ]
    },
    {
      "label": "2",
      "lines": [
        "חֲיוּ, אִם כֵּן, כַּאֲשֶׁר נָאֶה",
        "חֲיוּ, דַּי לָכֶם מִלִּים",
        "חֲיוּ עַד תִּרְאֶה הַבְּרִיָּה",
        "אֶת־אֱמֶת הַמָּשִׁיחַ"
      ]
    }
  ]
}
