{
  "book": "main",
  "number": 826,
  "title_he": "אֲשֶׁר בָּחַר מוֹת הַצְּלָב",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "אֲשֶׁר בָּחַר מוֹת הַצְּלָב",
        "אַהֲבָה לְמַעַן יַחְפֹּשׁ אֲסִירֵי הָעֲוֺנוֹת",
        "הִנֵּה כְּבָר נָשָׂאתִי אֵלֶיךָ בְּשָׂמַי",
        "וּבַחֲנוּטִים מִלֵּאתִי כִּיסַי"
      ]
    },
    {
      "label": "2",
      "lines": [
        "הַאִם תְּבַקְּשִׁי שַׂר הַחַיִּים",
        "בֵּין הַקְּבָרִים בְּעוֹלַם הַמָּוֶת",
        "כְּבָר קָם אַךְ מַהֵר יָבוֹא",
        "וְתִשְׂמְחִי בּוֹ בִּתִּי"
      ]
    },
    {
      "label": "3",
      "lines": [
        "קֶבֶר מִי גָּלַל הַסֶּלַע מִמְּךָ",
        "וְאַיֵּה אֲדֹנִי הִתְאַבַּלְתִּי מִמְּךָ",
        "וְאַיֵּה יִקּוֹנֵן דּוֹדִי וְיִבְכֶּה",
        "שָׁקְעוּ עֵינַי נְדוּדֵי שֵׁנָה וְצַר"
      ]
    },
    {
      "label": "4",
      "lines": [
        "בַּת אִמְרִי עַל מִי בִּכְיֵךְ",
        "וְאֵיזֶה אָסוֹן מַכְאִיב פְּקָדֵךְ",
        "אִם הָיִית בּוֹכָה אֲשֶׁר פְּדָךְ",
        "הָשִׁיבִי דְּמָעוֹתַיִךְ חַי עַבְדֵּךְ"
      ]
    },
    {
      "label": "5",
      "lines": [
        "הוֹלֵךְ בַּעֲרוּצֵי הַשְּׁבִילִים",
        "רֹךְ בְּחֻלְשָׁתִי וְלִבִּי הַקּוֹדֵר",
        "אִם הָיִיתָ אַתָּה לָקַחְתָּ דּוֹדִי",
        "אֱמֹר לִי שַׂמְתּוֹ בְּאֵיזֶה עֵבֶר"
      ]
    },
    {
      "label": "6",
      "lines": [
        "מִרְיָם הִפָּנִי וּרְאִינִי",
        "עִמְדִי מֵרָחוֹק וְאַל־תִּגְּעִי בִּי",
        "אִמְרִי לְאַחַי כִּי יֵלְכוּ אַחֲרַי",
        "אֶל הַגָּלִיל לְמַעַן יִרְאוּנִי"
      ]
    },
    {
      "label": "7",
      "lines": [
        "אֲדֹנִי מַלְכִּי עוֹזְרִי",
        "מוֹחֶה דְּמָעוֹתַי מֵעַפְעַפַּי",
        "כְּבָר קַמְתָּ אֱמֶת וְשָׁקְטוּ עֵינַי",
        "וְטָב לִבִּי וְהָלְכוּ אֲנָחוֹתַי"
      ]
    }
  ]
}
