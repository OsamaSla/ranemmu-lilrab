  "verses_he": [
    {
      "label": "1",
      "lines": [
        "הִנֵּה כְּמִיהַת הַלֵּב גָּדְלָה",
        "הִנֵּה בְּרַק הָאַהֲבָה שָׁב",
        "וְדִמְעוֹת הַתְּשׁוּבָה מְקַוּוֹת",
        "תָּחוּס בְּרֹךְ יָדֶיךָ"
      ]
    },
    {
      "label": "1",
      "lines": [
        "וְאָשׁוּב תֶּן־לִי בְּאַהֲבָה אֶרְאֲךָ",
        "וְאִמַּס בְּיֹפִי בְּעַבְדֶּךָ"
      ],
      "chorus": true
    },
    {
      "label": "2",
      "lines": [
        "הִנֵּה חַיַּי מַשְׁכּוֹן אַהֲבָה",
        "אֲשֶׁר הִתְגַּשְּׁמָה בִּצְלָב",
        "כָּל־אֲשֶׁר סָטִיתִי מִדַּרְכֶּךָ",
        "לֹא אֶרְאֶה כְּלִבֶּךָ"
      ]
    },
    {
      "label": "3",
      "lines": [
