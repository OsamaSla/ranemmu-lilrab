  "title_he": "שְׁלַחְתִּיךָ לַמַּאֲמָץ לֹא לְשָׂכָר",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "שְׁלַחְתִּיךָ לַמַּאֲמָץ לֹא לְשָׂכָר",
        "וַעֲבֹד וְלוּ בְּעֹנִי וּבְקָלוֹן",
        "וְהִתְאַזֵּר עַל בּוּז הָעָם רָצֶה",
        "שְׁלַחְתִּיךָ תִּמְצָא בִּי הַחֶמְלָה"
      ]
    },
    {
      "label": "2",
      "lines": [
        "שְׁלַחְתִּיךָ לְמַעַן תַּחְבֹּשׁ הַשָּׁבוּר",
        "לְמַעַן תִּבְכֶּה גּוֹרַל הָאֹבְדִים",
        "לְמַעַן תָּרִים מַשְּׂאוֹת הָעֲמֵלִים",
        "שְׁלַחְתִּיךָ אֲנִי לְךָ עוֹזֵר"
      ]
    },
    {
      "label": "3",
      "lines": [
        "שְׁלַחְתִּיךָ וּכְבָר תָּלִין לְבַדְּךָ",
        "נִפְרָד מֵהַיָּדִיד וְהָרֵעַ",
        "מַעֲדִיף עַצְמִי עַל הַכֹּל",
        "שְׁלַחְתִּיךָ לְמַעַן תִּרְצֶה בִּי חָבֵר"
      ]
    },
    {
      "label": "4",
      "lines": [
        "שְׁלַחְתִּיךָ לְמַעַן תְּוַתֵּר בִּרְצוֹן",
        "וְתִזְנַח תַּאֲווֹת הַחַיִּים",
        "נַעֲנֶה לִקְרִיאָתִי לַהֲלִיכָה",
        "שְׁלַחְתִּיךָ אֲנִי לְךָ חַיִּים"
      ]
    },
    {
      "label": "5",
      "lines": [
        "שְׁלַחְתִּיךָ בִּגְלַל הַנּוֹאָשִׁים",
        "לִמְבַקְּשֵׁי הַמַּרְפֵּא וְאֵין רוֹפֵא",
        "לְמַעַן תִּשְׁפֹּךְ דָּם עִם הַדְּמָעוֹת",
        "שְׁלַחְתִּיךָ לְמַעַן תִּשָּׂא הַצְּלָב"
      ]
    }
  ]
