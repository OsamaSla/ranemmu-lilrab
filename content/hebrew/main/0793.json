{
  "book": "main",
  "number": 793,
  "title_he": "עָבְרוּ מִסְּבִיבִי הַזְּרָמִים",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "שְׁמַע צַעֲקָתִי אֲדֹנִי",
        "וְאֶל תְּפִלָּתִי הַט אָזְנֶיךָ",
        "רַחֲמֵנִי וֶאֱחֹז בְּיָדִי",
        "כִּי אֲנִי בְּצֹרֶךְ חָזָק אֵלֶיךָ"
      ],
      "chorus": true
    },
    {
      "label": "1",
      "lines": [
        "עָבְרוּ מִסְּבִיבִי הַזְּרָמִים",
        "וַיַּצִּיפוּנִי הַצָּרוֹת",
        "וְסוּף חָבוּשׁ לְרֹאשִׁי",
        "וּמַיִם בָּאוּ עַד־נָפֶשׁ"
      ]
    },
    {
      "label": "2",
      "lines": [
        "הִתְפַּלֵּל יוֹנָה מִמְּעֵי הַדָּג",
        "הוֹצֵאתָ צַו כִּי לֹא יָמוּת",
        "מִמְּעֵי שְׁאוֹל צָעַק",
        "וּבָרַחֲמִים שָׁמַעְתָּ הַקּוֹל"
      ]
    },
    {
      "label": "3",
      "lines": [
        "בְּקוֹל תּוֹדָה אֲשַׁבְּחֶךָ",
        "וְאָשׁוּב אַבִּיט הֵיכָלֶךָ",
        "כִּי עָנִיתָ לִי",
        "כָּל־אֲשֶׁר בִּי יוֹדֶךָ"
      ]
    }
  ],
  "chorus_he": "פְּזָמוֹן"
}
