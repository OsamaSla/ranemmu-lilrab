{
  "book": "main",
  "number": 583,
  "title_he": "אָבִי תָּעִיתִי כַּאֲשֶׁר עָזַבְתִּי",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "אָבִי תָּעִיתִי כַּאֲשֶׁר עָזַבְתִּי",
        "חֹם הַבֶּטַח בְּחֵיקֶךָ",
        "בֵּיתִי נָטַשְׁתִּי בְּרָצוֹן וּבְסִכְלוּת",
        "וְהָיִיתִי חַי בְּטוּבֶךָ",
        "בְּמָרוּץ אַחַר הַתַּאֲווֹת הָלַכְתִּי",
        "וְהָרַע כָּאֵשׁ הַמַּשְׁמִידָה",
        "וְכַאֲשֶׁר חָזַק בִּי עִנּוּיִי",
        "אָמַרְתִּי אָשׁוּב אֲדֹנִי אֵלֶיךָ"
      ]
    },
    {
      "label": "2",
      "lines": [
        "חֹלִי הַחֵטְא פָּשַׁט בִּי",
        "עַד שָׁתִיתִי הָעָוֺן כַּמַּיִם",
        "הָיָה הַטַּעַם בַּגָּרוֹן מָתוֹק",
        "וּפָעֳלוֹ בַּלֵּב עָמָל",
        "הִתְמַכַּרְתִּי לְרָעָתִי עַד נוֹאַשְׁתִּי",
        "הַאִם מֵהַצָּלָה אַחַר הַיְגִיעָה",
        "אַתָּה תִּקְוָתִי, אַתָּה מַרְפְּאִי",
        "מִכָּל־חָלְיִי אַתָּה הַתְּרוּפָה"
      ]
    },
    {
      "label": "3",
      "lines": [
        "אָרַךְ רִחוּקִי, גָּדַל מִרְיִי",
        "הֲשִׁיבֵנִי אֲדֹנִי וְאָשׁוּבָה",
        "בְּרוּחֲךָ הָסֵר מֵעָלַי הַקְּשִׁיוּת",
        "הוֹכִיחֵנִי וְעַשֵׂה לִבִּי יִמַּס",
        "כָּל־אֲשֶׁר יִהְיֶה עֲוֺנִי גָדוֹל",
        "דַּם הַמָּשִׁיחַ יִמְחֶה הַמּוּמִים",
        "כַּסֵּנִי וּרְחַץ טֻמְאוֹת לִבִּי",
        "וְרַחֲמֵנִי הוֹי סוֹלֵחַ כָּל־הַחֲטָאִים"
      ]
    }
  ]
}
