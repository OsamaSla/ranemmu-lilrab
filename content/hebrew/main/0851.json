  "verses_he": [
    {
      "label": "1",
      "lines": [
        "הַנַּח לִי אַעֲרִיךְ אַבָּהוּתֶךָ",
        "וּפְדוּתְךָ בְּרוּחַ כְּנִיעָה",
        "וְאֶשְׁתַּחֲוֶה בִּתְהִלָּה לְחַסְדֶּךָ",
        "וּלְאַהֲבָתְךָ לָנוּ בְּיֵשׁוּעַ",
        "הַנַּח לִי אֶחְיֶה חַיַּי הַנּוֹתָרִים עַל הָאָרֶץ לָךְ",
        "דַּי אֲשֶׁר אָבַד מִבֵּין יָדַי וַאֲנִי שְׁמִי לָךְ"
      ]
    },
    {
      "label": "1",
      "lines": [
        "אָב יֹאהֲבֵנִי",
        "אַהֲבָה תְּשִׁיבֵנִי",
        "לֵב יְחַבְּקֵנִי",
        "אָדוֹן הֲרִימֵנִי אֵלֶיךָ"
      ],
      "chorus": true
    },
    {
      "label": "2",
      "lines": [
        "הַנַּח לִי אַקְרִיב בְּחֶמְלָתֶךָ",
        "חַיַּי לְךָ וְכָל־דָּבָר",
        "הָכֵן שָׁרָשַׁי בְּכַרְמֶךָ",
        "טַהֲרֵנִי בָּאֱמֶת הַמְּאִירָה",
        "הַנַּח לִי אֶהְיֶה עָנָף בִּמְשִׁיחִי מָלֵא פֵּרוֹת",
        "אָעִיד בְּרוּחֲךָ וּבִדְבָרְךָ עַל נִסָּיוֹן"
      ]
    }
  ],
  "chorus_he": "פְּזָמוֹן"
