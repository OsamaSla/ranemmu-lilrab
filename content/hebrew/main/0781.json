{
  "book": "main",
  "number": 781,
  "title_he": "בְּלֶכְתֵּנוּ בְּדֶרֶךְ הַחַיִּים",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "בְּלֶכְתֵּנוּ בְּדֶרֶךְ הַחַיִּים",
        "נִפְגֹּשׁ אוֹיֵב הַחַיִּים",
        "אַךְ עִמָּנוּ שַׂר הַחַיִּים",
        "יִתֵּן לָנוּ נִצָּחוֹן וַדַּאי",
        "וְהוּא נָתַן לָנוּ הָאֱמוּנָה",
        "נֶשֶׁק וּמָגֵן בּוֹ הָעֲרֻבָּה",
        "וְהוּא יִשְׁחַק הַשָּׂטָן",
        "וְיִשְׁמְרֵנוּ בְּבֶטַח"
      ]
    },
    {
      "label": "2",
      "lines": [
        "אֲשֶׁר יְנַצֵּחַ בְּדֶרֶךְ הַחַיִּים",
        "יֵשֵׁב בַּכִּסֵּא עִמּוֹ שָׁם",
        "אֲשֶׁר יִשָּׁאֵר לַמְרוֹת רָעוֹת הַחַיִּים",
        "נֶאֱמָן לְיוֹם הַמָּוֶת",
        "יֻעֲנַק עֲטֶרֶת הַחַיִּים",
        "וְיָשִׁיר בְּשִׁיר הַנִּצָּחוֹן",
        "יִלְבַּשׁ הַבֶּגֶד הֶחָדָשׁ",
        "וְיִחְיֶה בְּבֵית הַנֹּעַם"
      ]
    }
  ]
}
