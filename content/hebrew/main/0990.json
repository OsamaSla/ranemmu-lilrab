  "title_he": "מִי יַפְרִידֵנוּ מֵאַהֲבַת הַמָּשִׁיחַ",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "מִי יַפְרִידֵנוּ מֵאַהֲבַת הַמָּשִׁיחַ",
        "הֲצָרָה אוֹ מָצוֹק אוֹ רְדִיפָה",
        "אוֹ רָעָב אוֹ עֵירֹם אוֹ סַכָּנָה אוֹ חֶרֶב",
        "כַּכָּתוּב כִּי־עָלֶיךָ",
        "הֹרַגְנוּ כָל־הַיּוֹם"
      ]
    },
    {
      "label": "1",
      "lines": [
        "אֵין דָּבָר יַפְרִידֵנִי",
        "מֵאַהֲבַת הַמָּשִׁיחַ",
        "כִּי חַיַּי אַחַר עָמָל",
        "בְּמַחֲסֵהוּ יָנוּחוּ"
      ],
      "chorus": true
    },
    {
      "label": "1",
      "lines": [
        "אֲהֵבַנִי אֹהֲבֶנּוּ יַחְפֹּץ בִּי אָשִׁיר לוֹ",
        "לֹא זֶה לִי וְזֶה לוֹ כִּי כָל־דָּבָר קִנְיָנוֹ",
        "רוּחִי וְנַפְשִׁי וְחַיַּי",
        "יָעִידוּ עַל־אַהֲבָתוֹ"
      ]
    },
    {
      "label": "2",
      "lines": [
        "וְאֵין שׁוּב אָחוֹר כִּי הֶעָבָר כְּאָיִן",
        "וְאֵין כְּמִיהָה לָעֳנִי כִּי חָלַף עֵת הָעֹשֶׁק",
        "וְכָל־דָּבָר בַּהֲוָיָתִי",
        "יְרַנֵּן בַּחֲסָדִים"
      ]
    }
  ],
  "chorus_he": "פְּזָמוֹן"
