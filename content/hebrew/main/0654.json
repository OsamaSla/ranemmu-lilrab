{
  "book": "main",
  "number": 654,
  "title_he": "כְּבָר עָלָה הָאָדוֹן אֶל",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "כְּבָר עָלָה הָאָדוֹן אֶל",
        "אָבִיו בַּכָּבוֹד",
        "לְמַעַן יָכִין מָעוֹן",
        "לְעַמּוֹ הַפָּדוּי",
        "לְשֵׁם יֵשׁוּעַ אֲדֹנֵנוּ",
        "זִבְחֵי הַכָּבוֹד",
        "מִי כְּבָר כִּלָּה אַהֲבָה בָּנוּ",
        "וְהִמְצִיא הַשָּׁלוֹם"
      ]
    },
    {
      "label": "1",
      "lines": [
        "קוּמוּ בְּנִגּוּנֵי הַשִּׁיר",
        "הוֹי עֲדַת הַצַּדִּיקִים",
        "וְשַׁבְּחוּ הָאָדוֹן הַנִּכְבָּד",
        "בִּנְגִינַת הַמֵּיתָרִים"
      ],
      "chorus": true
    },
    {
      "label": "2",
      "lines": [
        "מַסָּעֵנוּ הוֹי מַאֲמִינִים",
        "בְּאֹרַח הָאֱמוּנָה",
        "זֵכֶר שֵׁם פּוֹדֵנוּ הָרַחוּם",
        "יְפַזֵּר הַיְּגוֹנוֹת",
        "לְכוּ בְּלִי דְּאָגָה וְלֹא",
        "פַּחַד מִן־הָאוֹיְבִים",
        "וּמִי הֵכִין הַמָּעוֹן",
        "יָרִיץ הַהַבְטָחָה"
      ]
    },
    {
      "label": "3",
      "lines": [
        "אִם קָרַב הַיּוֹם הַנּוֹרָא",
        "וְהַזַּעַם נִצַּת",
        "יֵשׁוּעַ פּוֹדֵנוּ הַדּוֹד",
        "יָבוֹא כַּאֲשֶׁר הִבְטִיחַ",
        "יָקִים אֲשֶׁר תַּחַת הֶעָפָר",
        "יְשַׁנֶּה הַחַיִּים",
        "יַחְטְפֵם וְלֹא יֵרָאֶה",
        "מָוֶת וְלֹא בְּלוֹי"
      ]
    }
  ],
  "chorus_he": "פְּזָמוֹן"
}
