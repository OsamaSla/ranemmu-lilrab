{
  "book": "main",
  "number": 954,
  "title_he": "הַשָּׁנִים עוֹבְרוֹת רָצוֹת",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "הַשָּׁנִים עוֹבְרוֹת רָצוֹת",
        "לָמָּה בְּאֶרֶץ הַמָּר תָּרוּץ",
        "לֹא הַשָּׁנִים תַּרְגִּישְׁנָה בָּנוּ",
        "וְלֹא הַקְּבָרִים יָצֵרוּ עָלֵינוּ"
      ]
    },
    {
      "label": "1",
      "lines": [
        "שֶׁמֶשׁ חַיֶּיךָ תָּבוֹא",
        "לָמָּה מִתְעַקֵּשׁ גֵּר",
        "קוּם בּוֹא לַצְּלָב",
        "וּלְיֵשׁוּעַ הִנָּחֵם וָשׁוּב",
        "שַׁחַר חַיֶּיךָ עוֹדוֹ בָּא",
        "כָּל־עוֹד לָנוּ יֵשׁוּעֵנוּ חַי"
      ],
      "chorus": true
    },
    {
      "label": "2",
      "lines": [
        "אַיֵּה שְׁעוֹתֶיךָ אֲשֶׁר חָלְפוּ",
        "עִם רִגְעֵי דְּמָמָה מֵתוּ",
        "לָמָּה שְׁתִיקָתְךָ מַחְשָׁבָה מְפֻזֶּרֶת",
        "הִנֵּה חַיֶּיךָ וְלֹא הוּקַלּוּ"
      ]
    },
    {
      "label": "3",
      "lines": [
        "לָמָּה חַיֶּיךָ אֶרֶץ בּוּר",
        "וְהַתְּעָלוֹת לְצִדְּךָ סוֹבְבוֹת",
        "לָמָּה תָּלִין בֵּין אֶלֶף חוֹמָה",
        "שַׁבֵּר הָאֲפֵלָה בְּאוֹר"
      ]
    },
    {
      "label": "4",
      "lines": [
        "הַחַיִּים כַּקִּיטוֹר",
        "לָמָּה תִּמְכֹּר חַיֶּיךָ בָּאֵשׁ",
        "וְהַשָּׂטָן עוֹשֶׂה לְךָ מָסָךְ",
        "דְּרֹךְ עָלָיו קַח לְךָ הַחְלָטָה"
      ]
    }
  ],
  "chorus_he": "פְּזָמוֹן"
}
