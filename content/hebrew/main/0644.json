{
  "book": "main",
  "number": 644,
  "title_he": "מַה־נִּפְלָא הַחֶסֶד לִי",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "מַה־נִּפְלָא הַחֶסֶד לִי",
        "מִלִּבְּךָ הַגָּדוֹל",
        "אַחַר אֲשֶׁר טָעַמְתִּי הָעִוָּרוֹן",
        "הִנֵּה הִנְנִי רוֹאֶה"
      ]
    },
    {
      "label": "2",
      "lines": [
        "הַחֶסֶד כְּבָר שָׂם",
        "יִרְאָתְךָ בַּלֵּב",
        "וְהַחֶסֶד כְּבָר שִׁחְרֵר",
        "לִבִּי מִן־הָאֵימָה"
      ]
    },
    {
      "label": "3",
      "lines": [
        "כַּמָּה מִנִּסְיוֹנוֹת רָאוּ",
        "עֵינַי בַּחַיִּים",
        "תַּסְפִּיק לָנוּ חַסְדְּךָ",
        "אֲדֹנֵנוּ הָאֵל"
      ]
    },
    {
      "label": "4",
      "lines": [
        "כַּאֲשֶׁר נַעֲלֶה מְעוֹן הַמָּרוֹם",
        "תֵּרָאֶינָה לָנוּ הַשָּׁנִים",
        "עִם אָרְכָּן וְרָחְבָּן",
        "אֵינָן בִּלְתִּי אִם יָמִים"
      ]
    },
    {
      "label": "5",
      "lines": [
        "אָשִׁיר לְךָ מַלְכִּי",
        "שִׁיר הַתּוֹדָה",
        "מִכָּל־לֵב יַעֲלֶה",
        "נִגּוּן מְלֹא הַדּוֹר"
      ]
    }
  ]
}
