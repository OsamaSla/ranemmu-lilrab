{
  "book": "main",
  "number": 789,
  "title_he": "אֲנִי מְחַכֶּה לָךְ תִּפְעַל בְּיָדֶיךָ",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "אֲנִי מְחַכֶּה לָךְ תִּפְעַל בְּיָדֶיךָ",
        "וּבְתוֹךְ מַצָּבַי תְּאַמְּצֵנִי",
        "בָּא לְךָ יֵשׁוּעַ אֲבַקֵּשׁ בִּכְנִיעָה",
        "מִכָּל־דְּאָגוֹתַי תְּרִימֵנִי",
        "אֲנִי מְחַכֶּה לָךְ וְעֵינַי עָלֶיךָ",
        "בּוֹטֵחַ כִּי לֹא תַּעַזְבֵנִי",
        "תֹּאחַז יָדִי תָּרִים לִבִּי",
        "וְאֵין יְגוֹנוֹת יְנַצְּחוּנִי"
      ]
    },
    {
      "label": "2",
      "lines": [
        "אֲנִי מְחַכֶּה לָךְ וַאֲנִי בּוֹטֵחַ בָּךְ",
        "וּבִגְבוּרַת עַצְמְךָ וּבְשִׁלְטוֹנֶךָ",
        "בְּתוֹךְ הָאֲנָחוֹת בְּתוֹךְ הַמְּצוּקוֹת",
        "תְּשׁוּבֶנָה שְׂמָחוֹתַי בְּחַסְדֶּךָ",
        "אֲנִי מְחַכֶּה לָךְ קָשׁוּר בָּךְ",
        "כִּי אַתָּה צוֹדֵק בִּדְבָרֶךָ",
        "כִּי רַחוּם וֵאלֹהִים חוֹנֵן",
        "תַּצִּיל חַיַּי וְאֶרְאֶה יְשׁוּעָתֶךָ"
      ]
    }
  ]
}
