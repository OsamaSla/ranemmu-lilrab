{
  "book": "main",
  "number": 679,
  "title_he": "הוֹי הַחוֹטֵא הַאִם",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "הוֹי הַחוֹטֵא הַאִם",
        "בָּאֲךָ יוֹם כָּרוּחַ קַלָּה",
        "קוֹל נִסְתָּר דּוֹפֵק",
        "שַׁעֲרֵי לִבְּךָ הָאָשֵׁם"
      ]
    },
    {
      "label": "2",
      "lines": [
        "יֹאמַר רוֹמֵז אֶל הַ",
        "מוֹקְשִׁים בִּשְׁבִילֵי הָאֲבַדּוֹן",
        "הִזָּהֵר מֵאַהֲבַת הָעוֹלָם הַ",
        "רַמַּאי אֱהַב מִי פְּדָךְ"
      ]
    },
    {
      "label": "3",
      "lines": [
        "כִּי זֶה קוֹל הָרוּחַ אַל",
        "תִּדְחֵהוּ אִם הָיִיתָ הֶחָכָם",
        "מַזְהִיר אוֹתְךָ כִּי",
        "תִּבְחַר גּוֹרָל בָּעֵדֶן"
      ]
    },
    {
      "label": "4",
      "lines": [
        "הוֹי שׁוֹכֵחַ אַל־תָּבוּז",
        "מִתְעַקֵּשׁ רוּחַ הָאֵל",
        "וְהִזָּהֵר מֵאֲבֹד הִזְדַּמְּנוּת",
        "כָּל־עוֹד הֱיוֹתְךָ בְּאֵלֶּה הַחַיִּים"
      ]
    },
    {
      "label": "5",
      "lines": [
        "וּשְׁמַע אֵפוֹא קוֹל אֲשֶׁר",
        "קָרָאֲךָ וְקוּם לַתְּפִלָּה",
        "מִתְחַנֵּן אֲדוֹן הַבְּרִיּוֹת",
        "פּוֹנֶה לְשִׁבְתּוֹ מְרוֹמָיו"
      ]
    }
  ]
}
