{
  "book": "main",
  "number": 604,
  "title_he": "אֲדֹנִי מִי אֲשֶׁר בָּזַלְתָּ דָּמֶךָ",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "אֲדֹנִי מִי אֲשֶׁר בָּזַלְתָּ דָּמֶךָ",
        "אֲדֹנִי מִי אֲשֶׁר מַתָּ עַל הַצְּלָב",
        "אֵיךְ בָּאתָ הֵנָּה מִמְּרוֹמֶיךָ",
        "וּבָאתָ בַּעֲדִי הוֹי דּוֹד יָקָר",
        "בָּאתָ מַרְפֵּא, מַתָּ פִּדְיוֹן",
        "מַה־נִּפְלְאָה אַהֲבָתְךָ",
        "אֵין זוּלָתְךָ, כִּי בְדָמֶךָ",
        "נִצַּלְתִּי מִמָּוֶת נוֹרָא"
      ]
    },
    {
      "label": "2",
      "lines": [
        "אֲדֹנִי מִי אֲשֶׁר מָחִיתָ עֲוֺנוֹתַי",
        "אֲדֹנִי מִי אֲשֶׁר הִשְׁפַּעְתָּ שָׁלוֹם",
        "אֲדֹנִי מִי אֲשֶׁר הֵאַרְתָּ מַחְשַׁכַּי",
        "אוֹדְךָ אֲדוֹן כָּל־בָּשָׂר",
        "כִּי אַתָּה אוֹרִי, אַתָּה שְׂשׂוֹנִי",
        "וְגִילִי כָּל־הַיָּמִים",
        "אַתָּה אֱלֹהַי תִּשְׁמֹר נַפְשִׁי",
        "וְאֶחְיֶה בְּשָׁלוֹם שָׁלֵם"
      ]
    }
  ]
}
