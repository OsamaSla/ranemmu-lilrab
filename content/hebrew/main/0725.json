{
  "book": "main",
  "number": 725,
  "title_he": "סוֹד הַיִּרְאָה סוֹד גָּדוֹל",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "סוֹד הַיִּרְאָה סוֹד גָּדוֹל",
        "הָאֵל בָּא בַּבָּשָׂר",
        "צִדְּקוֹ הָרוּחַ הֶחָכָם",
        "כִּי כְּבָר הוּקַם וְעָלָה"
      ]
    },
    {
      "label": "2",
      "lines": [
        "כָּל־חֲטָאֵינוּ נָשָׂא",
        "בְּגוּפוֹ עַל הַצְּלָב",
        "מִשְׁפָּט בַּעֲדֵנוּ סָבַל",
        "וּכְבָר שִׁלֵּם הַחוֹב הַנּוֹרָא"
      ]
    },
    {
      "label": "3",
      "lines": [
        "עָבְרוּ עָלָיו הַמְּצוּלוֹת",
        "וְכָל־זֶרֶם הַזַּעַם",
        "גַּלֵּי צֶדֶק מַפְחִיד",
        "וְכוֹס מִשְׁפָּטֵנוּ שָׁתָה"
      ]
    },
    {
      "label": "4",
      "lines": [
        "וְכָל־זֶה כְּפִי רְצוֹ",
        "ן וְכַוָּנָה בַּנֶּצַח",
        "וְכָל־כַּוָּנַת הָאֵל אַף",
        "פֵּרוֹ בּוֹ נִשְׁלַם"
      ]
    },
    {
      "label": "5",
      "lines": [
        "וְהוּא שִׂמְחַת הַגִּבּוֹר",
        "וּבוֹ וְלִבּוֹ רָצָה",
        "לָכֵן רוֹמְמוֹ",
        "וּמֵעַל כָּל־שֵׁם רָם"
      ]
    },
    {
      "label": "6",
      "lines": [
        "לוֹ הַסְּגִידָה וְהַשֶּׁבַח",
        "וְהַכָּבוֹד וְהַתּוֹדָה הַגְּדוֹלָה",
        "בִּגְלַל אַהֲבָתוֹ לָנוּ",
        "וּשְׁפִיכַת דָּמוֹ הַנָּדִיב"
      ]
    }
  ]
}
