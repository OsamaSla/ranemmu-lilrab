  "title_he": "בּוֹרֵא הָעוֹלָמוֹת וְהָאָדָם",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "בּוֹרֵא הָעוֹלָמוֹת וְהָאָדָם",
        "בִּנְשָׁמָה בָּהּ חַיִּים",
        "כָּל־הַבְּרִיאָה וְהַגּוֹיִם",
        "יְשַׁבְּחוּ שֵׁם הָאֵל"
      ]
    },
    {
      "label": "1",
      "lines": [
        "הַלְלוּיָהּ הַלְלוּיָהּ",
        "הַלְלוּיָהּ לְשֵׁם יֵשׁוּעַ"
      ],
      "chorus": true
    },
    {
      "label": "2",
      "lines": [
        "הַמָּן הַיּוֹרֵד מִן־הַשָּׁמַיִם",
        "וּמַשְׂבִּיעַ הָרְעֵבִים",
        "יָדְךָ תַּשְׂבִּיעֵנוּ בְּרָצוֹן",
        "וְתָקֵל הַמַּכְאוֹבִים"
      ]
    },
    {
      "label": "3",
      "lines": [
        "יְפֵהפֶה מִכָּל־הָאָדָם",
        "וּבַחֶסֶד מָלֵא",
        "וַאֲשֶׁר יַבִּיט לְךָ יֵאוֹר",
        "וְאֵינֶנּוּ יִהְיֶה בוֹשׁ"
      ]
    },
    {
      "label": "4",
      "lines": [
        "רַחוּם וְחַנּוּן וְאֶרֶךְ אַפַּיִם",
        "וְסוֹמֵךְ הַנּוֹפְלִים",
        "רוֹפֵא שְׁבוּרֵי הַלְּבָבוֹת",
        "וְזוֹקֵף הַכְּפוּפִים"
      ]
    }
  ],
  "chorus_he": "1 הַלְלוּיָהּ הַלְלוּיָהּ · 2 הַלְלוּיָהּ לְשֵׁם יֵשׁוּעַ"
