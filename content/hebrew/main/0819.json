  "title_he": "הַאִם בָּאתָ אֲדֹנִי מוֹרִי",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "הַאִם בָּאתָ אֲדֹנִי מוֹרִי",
        "בַּחֲבוּרַת הַיְלָדִים",
        "וְאַתָּה אֲדוֹן הַיְּקוּם",
        "וּמֶלֶךְ הַגָּאוֹן"
      ]
    },
    {
      "label": "1",
      "lines": [
        "קַבֵּל מַלְכִּי אֲדֹנִי",
        "אֹרֶךְ הַזְּמַן עֲבוֹדָתִי",
        "אַתָּה הָרָם הַנִּצְחִי",
        "בָּאָרֶץ וּבַשָּׁמַיִם"
      ],
      "chorus": true
    },
    {
      "label": "2",
      "lines": [
        "הַאִם בָּאתָ אֲדֹנִי מוֹרִי",
        "בִּכְמִיהַת הַיּוֹנֵק",
        "מַקְרִיב כְּבוֹדְךָ",
        "וְכִסְאֲךָ הָרָם"
      ]
    },
    {
      "label": "3",
      "lines": [
        "הַאִם בָּכִיתָ אֲדֹנִי",
        "מֵעָמָל אוֹ רָעָב",
        "וְכַמָּה הֶעֱנַקְתָּ בְּרָצוֹן",
        "נֶחָמָה לַכֹּל"
      ]
    },
    {
      "label": "4",
      "lines": [
        "הַאִם בָּאתָ יַלְדֵּנוּ הַדּוֹד",
        "בִּזְרוֹעוֹת הַבְּתוּלָה",
        "וְאַתָּה נוֹשֵׂא הַיְּקוּם",
        "בְּאַהֲבָה וּבְאֹשֶׁר"
      ]
    },
    {
      "label": "5",
      "lines": [
        "הַאִם רָעַדְתָּ אֲדֹנִי",
        "מִקְּשִׁי הַחֹרֶף",
        "וְאַתָּה כַּמָּה הִלְבַּשְׁתָּנוּ",
        "בְּצֶדֶק וּבִנְתִינָה"
      ]
    },
    {
      "label": "6",
      "lines": [
        "וְהַאִם כָּרַעְתָּ יַלְדֵּנוּ",
        "בְּתוֹדָה וּבִתְחִנָּה",
        "וְכַמָּה לְבָבוֹת כְּבָר בָּאוּ",
        "אֵלֶיךָ בְּתִקְוָה"
      ]
    }
  ],
  "chorus_he": "פְּזָמוֹן"
