{
  "book": "main",
  "number": 877,
  "title_he": "מִי יַמְתִּיק הַמְּגוּרִים זוּלָתְךָ",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "מִי יַמְתִּיק הַמְּגוּרִים זוּלָתְךָ",
        "וְיַעֲשֶׂה אוֹתָם גַּן",
        "אֲשֶׁר עִמְּךָ הַנֶּפֶשׁ תִּשְׂמַח",
        "וְהַלֵּב יִתְעַנֵּג",
        "מִי מִי",
        "מִי יַמְתִּיק הַמְּגוּרִים זוּלָתְךָ"
      ]
    },
    {
      "label": "2",
      "lines": [
        "מִי יְטַהֵר לִבִּי זוּלָתְךָ",
        "וְאֶהְיֶה אֲנִי מָה אָנִי",
        "וַאֲבַלֶּה יֶתֶר הַמְּגוּרִים בְּיִרְאָתְךָ",
        "וַאֲנִי מַחְשַׁבְתִּי בַּשָּׁמַיִם",
        "מִי מִי",
        "מִי יַמְתִּיק הַמְּגוּרִים זוּלָתְךָ"
      ]
    },
    {
      "label": "3",
      "lines": [
        "מִי פְּדָנִי בְּדָמוֹ זוּלָתְךָ",
        "נִשְׁחַט וְקָנָנִי",
        "מָנוּ אוֹתְךָ אַתָּה עִם הַפּוֹשְׁעִים",
        "וַאֲנִי נַפְשִׁי הָאֲשֵׁמָה",
        "מִי מִי",
        "מִי יַמְתִּיק הַמְּגוּרִים זוּלָתְךָ"
      ]
    }
  ]
}
