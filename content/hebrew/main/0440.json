{
  "book": "main",
  "number": 440,
  "title_he": "עוֹד מְעַט יִדְוֶה שׁוֹפָר",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "עוֹד מְעַט יִדְוֶה שׁוֹפָר",
        "וְיָרִיעוּ גְּדוּדֵי הַשָּׁמַיִם",
        "יֵשׁוּעַ בָּא בְּהָדָר",
        "לְכוּ, עֲלוּ אֶל־הָאֲוִיר"
      ]
    },
    {
      "label": "1",
      "lines": [
        "מַה־מַרְאֶה נִפְלָא",
        "בּוֹ תִשְׂמַחְנָה נְפָשׁוֹת",
        "יֵשׁוּעַ בָּא בִּתְרוּעָה",
        "לָקַחַת לוֹ אֶת־הַכַּלָּה"
      ],
      "chorus": true
    },
    {
      "label": "2",
      "lines": [
        "נָעוּף בַּחֲטִיפָה",
        "נִפְגֹּשׁ אֶת־רִבּוֹנֵנוּ הַטּוֹב",
        "נַעֲלֶה כֻּלָּנוּ בִּתְרוּעָה",
        "לָשֶׁבֶת בְּכָבוֹד גָּדוֹל"
      ]
    },
    {
      "label": "3",
      "lines": [
        "יֵקוּם בְּכָבוֹד מְפֹאָר",
        "סְעוּדַת חֲתֻנָּה לַכֶּבֶשׂ",
        "וְרִבְבוֹת מַגִּישׁוֹת תּוֹדָה",
        "מִשְׁתַּחֲווֹת לָאָדוֹן הָרַחוּם"
      ]
    },
    {
      "label": "4",
      "lines": [
        "וְסְבִיבָיו נִשָּׁאֵר תָּמִיד",
        "מְהַלְּלִים וּמְרִיעִים",
        "יְשַׂבְּעֵנוּ יַחַד בְּיָפְיוֹ",
        "לְעוֹלְמֵי עוֹלָמִים"
      ]
    }
  ],
  "chorus_he": "פְּזָמוֹן"
}
