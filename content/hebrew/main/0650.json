{
  "book": "main",
  "number": 650,
  "title_he": "שְׁלֵם הַיֹּפִי זָרַח",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "שְׁלֵם הַיֹּפִי זָרַח",
        "כּוֹכַב הַשַּׁחַר הַמֵּאִיר",
        "וּבָחוּר כָּאֶרֶז יֵרָאֶה",
        "אֲדוֹן הַיְקוּם הַגִּבּוֹר"
      ]
    },
    {
      "label": "1",
      "lines": [
        "זֶה דּוֹדִי וְרֵעִי",
        "בֵּין קָהָל דָּגוּל",
        "חִכּוֹ מָתוֹק מְתִיקוּת",
        "וְהַיֹּפִי קַיָּם"
      ],
      "chorus": true
    },
    {
      "label": "2",
      "lines": [
        "כִּי הוּא כַּתַּפּוּחַ בֵּין",
        "כָּל־עֲצֵי הַיַּעַר",
        "חֲבַצֶּלֶת הַשָּׁרוֹן אֲדֹנִי",
        "שׁוֹשַׁנָּה בֵּין הַפְּרָחִים"
      ]
    },
    {
      "label": "3",
      "lines": [
        "שְׁמוֹ שֶׁמֶן תּוּרַק",
        "שִׂמְחָה לִבִּי מִלֵּא",
        "כַּטַּל קוֹלוֹ לִי",
        "אַף כִּרְבִיבִים לַדֶּשֶׁא"
      ]
    },
    {
      "label": "4",
      "lines": [
        "כִּי הִנּוֹ הַחָכְמָה יִקָּרֵא",
        "וְהוּא יִשְׁכֹּן הַבִּינָה",
        "אִמְרוֹ הַצֳּרִי לִי",
        "מַרְפֵּא לָרְפוּאָה"
      ]
    }
  ],
  "chorus_he": "פְּזָמוֹן"
}
