  "title_he": "אֱמֹר לִי חוֹטֵא מָתַי תָּשׁוּב",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "אֱמֹר לִי חוֹטֵא מָתַי תָּשׁוּב",
        "וְתַעֲרִיךְ מַכְאוֹבֵי הַנִּצְלָב",
        "לוּ בָּאתָ תַּסְתִּיר הַמּוּמִים",
        "לוּ חָפַצְתָּ תִּמְחֶה הָעֲוֺנוֹת"
      ]
    },
    {
      "label": "1",
      "lines": [
        "לָמָּה לָמָּה לָמָּה לָמָּה",
        "רָחוֹק מִמְּשִׁיחֲךָ לָמָּה",
        "הַאִם יֵשׁ בָּעוֹלָם מָה",
        "קוּם וּמַהֵר וּבוֹא אֵלָיו"
      ],
      "chorus": true
    },
    {
      "label": "2",
      "lines": [
        "קְרָאֲךָ תַּחַת הַפַּעַם רַבּוֹת",
        "אָמַר לְךָ הִנֵּה הַדֶּרֶךְ מְסֻכָּן",
        "אַחֲרִיתוֹ עִנּוּי וַחֲרָטָה מָרָה",
        "שׁוּב וַעֲזֹב הָרָשָׁע"
      ]
    },
    {
      "label": "3",
      "lines": [
        "יֵשׁוּעַ בְּקוֹלוֹ יִקְרָאֲךָ",
        "וְאוֹמֵר לְךָ אֲנִי מְחַכֶּה לָךְ",
        "בָּאתִי לְךָ מִן־הַשָּׁמַיִם אֶפְדְּךָ",
        "וְהַיְשׁוּעָה הֲכִינוֹתִיהָ לָךְ"
      ]
    },
    {
      "label": "4",
      "lines": [
        "לָמָּה תִּחְיֶה בָּאֶרֶץ רָחוֹק",
        "לָמָּה תִּהְיֶה מִן־הָעֲבָדִים",
        "בּוֹא קַח לֵב חָדָשׁ",
        "וְתִחְיֶה יֶתֶר הַגִּיל שָׂמֵחַ"
      ]
    }
  ],
  "chorus_he": "פְּזָמוֹן"
