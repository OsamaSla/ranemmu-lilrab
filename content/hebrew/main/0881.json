{
  "book": "main",
  "number": 881,
  "title_he": "אִם שָׁפַע לִבִּי בַּשָּׁלוֹם קוֹלִי יְרַנֵּן",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "אִם שָׁפַע לִבִּי בַּשָּׁלוֹם",
        "קוֹלִי יְרַנֵּן",
        "אִם הָלַכְתִּי בְּגֵיא הַמַּכְאוֹבִים",
        "קוֹלִי יְרַנֵּן",
        "לֹא תַּטְרִיד לִבִּי הַדְּאָגוֹת",
        "כִּי הָאָדוֹן עִמָּדִי"
      ]
    },
    {
      "label": "1",
      "lines": [
        "יֵשׁוּעַ פּוֹדֵה נַפְשִׁי",
        "בּוֹ דַּיִּי",
        "יֵלֵךְ עִמָּדִי יַנְחֵנִי",
        "לְחוֹף הַבֶּטַח"
      ],
      "chorus": true
    },
    {
      "label": "2",
      "lines": [
        "אִם מָלֵא לִבִּי בְּךָ",
        "קוֹלִי יְרַנֵּן",
        "אִם עָבַרְתִּי בְּגֵיא הַבָּכָא",
        "קוֹלִי יְרַנֵּן",
        "וְאֵינֶנִּי יָרֵא הָאֲבַדּוֹן",
        "כִּי הָאָדוֹן עִמָּדִי"
      ]
    },
    {
      "label": "3",
      "lines": [
        "אִם שָׁפַע לִבִּי בַּשָּׂשׂוֹן",
        "קוֹלִי יְרַנֵּן",
        "אֶשָּׁאֵר עַד דּוֹר הַדּוֹרוֹת",
        "קוֹלִי יְרַנֵּן",
        "לָכֵן אֶשָּׁאֵר נָכוֹן",
        "כִּי הָאָדוֹן עִמָּדִי"
      ]
    }
  ],
  "chorus_he": "פְּזָמוֹן"
