{
  "book": "main",
  "number": 459,
  "title_he": "שָׁלוֹמְךָ עוֹלֵה עַל כָּל־בִּינָה",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "שָׁלוֹמְךָ עוֹלֵה עַל כָּל־בִּינָה",
        "בְּתוֹכֵנוּ וְלֹא יוּכַל לְהֵעָלֵם",
        "כָּל מַה שֶּׁהָאוֹיֵב יֹאמַר",
        "וּמָה בְּכָךְ, כִּי חַיֵּינוּ שָׁלוֹם"
      ]
    },
    {
      "label": "1",
      "lines": [
        "שָׁלוֹם שָׁלוֹם",
        "לְעַם אֲדֹנָי בְּכָל־מָקוֹם"
      ],
      "chorus": true
    },
    {
      "label": "2",
      "lines": [
        "וְגַם אִם תָּעוּ רַגְלֵינוּ",
        "כִּי רוּחֲךָ בָּנוּ וּסְבִיבָנוּ",
        "מֵשִׁיב נַפְשֹׁתֵינוּ וּמַנְחֵנוּ",
        "וּמְמַלֵּא לְבָבוֹתֵינוּ שָׁלוֹם"
      ]
    },
    {
      "label": "3",
      "lines": [
        "שְׁלוֹם אֱלֹהִים הִנִּיחַתָּ לָנוּ",
        "לֹא כַּאֲשֶׁר הָעוֹלָם נוֹתֵן לָנוּ",
        "כָּל־עוֹד רוּחֲךָ חַי בְּתוֹכֵנוּ",
        "עַמְּךָ תָּמִיד בְּשָׁלוֹם"
      ]
    }
  ],
  "chorus_he": "פְּזָמוֹן"
}
