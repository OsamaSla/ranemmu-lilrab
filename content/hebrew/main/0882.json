{
  "book": "main",
  "number": 882,
  "title_he": "אֲדֹנִי הִנְנִי אָבוֹא אֵלֶיךָ",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "אֲדֹנִי הִנְנִי אָבוֹא אֵלֶיךָ",
        "אֲדֹנִי כּוֹרֵעַ לְיַד רַגְלֶיךָ",
        "אוֹחֵז בִּישׁוּעָתֶךָ",
        "מְבַקֵּשׁ סְלִיחָתֶךָ",
        "כִּי צְלָבִי נָשָׂאתָ אֲדֹנִי",
        "וְעָלָיו הֵרַמְתָּ קְלוֹנִי",
        "וְסָבַלְתָּ הַמָּוֶת בַּעֲדִי",
        "בְּדַרְכְּךָ לַצְּלָב",
        "אֵיךְ אֶדְחֶה הַחַיִּים",
        "אֵיךְ אֶדְחֶה מְשִׁיחִי",
        "אֵיךְ אֶדְחֶה מִי הֱשִׁיבַנִי"
      ]
    }
  ]
}
