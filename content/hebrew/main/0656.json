{
  "book": "main",
  "number": 656,
  "title_he": "אֲשֶׁר הֵחֵל הַמַּסָּע עִמָּדִי",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "אֲשֶׁר הֵחֵל הַמַּסָּע עִמָּדִי",
        "בּוֹטֵחַ בָּךְ כִּי תַשְׁלִים",
        "אַתָּה הַשִּׂמְחָה בְּעֵת בִּכְיִי",
        "וְאַתָּה הַלֵּב אֲשֶׁר יִסְבֹּל"
      ]
    },
    {
      "label": "1",
      "lines": [
        "תּוֹדָה לָךְ אֲשֶׁר תִּרְעֵנִי",
        "אֲשֶׁר יָדֶיךָ תָּמִיד מְרִימוֹת אוֹתִי"
      ],
      "chorus": true
    },
    {
      "label": "2",
      "lines": [
        "לַמְרוֹת כִּי אֲנִי אֶשְׁתַּנֶּה תָּמִיד",
        "אַתָּה נֶאֱמָן לֹא תִּשְׁתַּנֶּה",
        "הַבְטָחָתְךָ צוֹדֶקֶת כַּאֲשֶׁר תַּבְטִיחַ",
        "עַל הַבְטָחָתְךָ אַתָּה לֹא תָּשׁוּב"
      ]
    },
    {
      "label": "3",
      "lines": [
        "תָּכְנִית גְּדוֹלָה מְכֹנֶנֶת לִי",
        "וּמַסַּע גִּילִי אַתָּה מְצַיֵּר לִי",
        "עָזְרֵנִי אָדוֹן אֶחְיֶה לָךְ גָּבוֹהַּ",
        "מֵעַל הָעוֹלָם מֵעַל מַצָּבַי"
      ]
    },
    {
      "label": "4",
      "lines": [
        "כִּסּוּפִי אֲדֹנִי אֹהַב אוֹתְךָ יוֹתֵר",
        "הִנֵּה אֵין אִישׁ יֹאהַב אוֹתִי כְּמִדָּתְךָ",
        "יַחֵד לִבִּי וְהַנַּח לִי אֶשְׁקֹד",
        "אֹרֶךְ יָמַי אָעִיד עַל אַהֲבָתְךָ"
      ]
    }
  ],
  "chorus_he": "פְּזָמוֹן"
}
