{
  "book": "main",
  "number": 814,
  "title_he": "כַּאֲשֶׁר הַחֹשֶׁךְ יְכַסֶּה שְׁבִילִי",
  "verses_he": [
    {
      "label": "1",
      "lines": [
        "כַּאֲשֶׁר הַחֹשֶׁךְ יְכַסֶּה שְׁבִילִי",
        "וְכַאֲשֶׁר אֶהְיֶה בְּלִי מוֹרֶה",
        "תִּשָּׁאֵר לִי כַּמְּנוֹרָה בְּתוֹךְ אֵלֶּה הַיְשִׁימוֹנִים",
        "מַדְרִיךְ לַבָּתִּים לְעֵבֶר הַשָּׁמַיִם"
      ]
    },
    {
      "label": "2",
      "lines": [
        "לוּ הִתְקִיפוּנִי מַר הַנִּסְיוֹנוֹת",
        "אַתָּה הָעוֹזֵר אַתָּה הַלּוֹחֵם",
        "מִמְּךָ עֶזְרִי הֶחָזָק מִמְּךָ נִצְחוֹנִי הַוַּדַּאי",
        "מִמְּךָ הַדְרָכָתִי הַיְשָׁרָה לְעֵבֶר הַשָּׁמַיִם"
      ]
    },
    {
      "label": "3",
      "lines": [
        "יְקֻפַּל הַזְּמַן וְהַגִּיל יַעֲבֹר",
        "לֹא מָנוֹס יוֹם אֶעֱזֹב אַרְצִי",
        "אֵינֶנִּי יָרֵא הַמָּוֶת אַתָּה אֲדוֹן הַחַיִּים",
        "מַנְהִיג בְּיַצִּיבוּת לְעֵבֶר הַשָּׁמַיִם"
      ]
    }
  ]
}
