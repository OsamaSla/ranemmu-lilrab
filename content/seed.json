{
  "$comment": "DEVELOPMENT SEED DATA. Psalm-based placeholders used to exercise every screen before the real book is ingested. Replace with the output of the ingest pipeline (see scripts/README.md) before any public release.",
  "hymns": [
    {
      "number": 1,
      "title": "الرب راعيَّ",
      "meter": "8.7.8.7",
      "chorus": "القرار",
      "verses": [
        {
          "label": "1",
          "chorus": true,
          "lines": [
            "الرب راعيَّ فلا يعوزني شيء",
            "في رَعٍ خُضْرٍ يُربِضُني",
            "يردُّ نفسي إلى السَّبيل"
          ]
        },
        {
          "label": "2",
          "lines": [
            "إني آوي في ظلِّهِ التَّوافِح",
            "ونارٌ في المَنطَقِ تُنوِّرُ لي",
            "يُهيِّئُ لي مائدةً في وجه مُضايِقي"
          ]
        },
        {
          "label": "3",
          "lines": [
            "خيرٌ ورحمةٌ يتبعانني كلَّ يومي",
            "وأُسكنُ في بيتِ الربِّ إلى مَدَى الأيام"
          ]
        }
      ]
    },
    {
      "number": 2,
      "title": "أسبح للرب",
      "meter": "8.8.8.8",
      "chorus": "القرار",
      "verses": [
        {
          "label": "1",
          "chorus": true,
          "lines": [
            "أسبِحْ للربِّ كلَّ حين",
            "ادخُلوا بابهِ بفرَح"
          ]
        },
        {
          "label": "2",
          "lines": [
            "اعلَمُوا أنَّ الربَّ هو الله",
            "هو صَنَعَنا ونحن عملُه",
            "نحن قَعْلُهُ ورَعْيَّتُه"
          ]
        },
        {
          "label": "3",
          "lines": [
            "ادخُلُوا بابه بشكرٍ وبابَه بتسبيح",
            "اشكُروا له وسبِّحوا باسمِه"
          ]
        }
      ]
    },
    {
      "number": 3,
      "title": "إليكم أرفع عيني",
      "meter": "8.7.8.7",
      "chorus": "القرار",
      "verses": [
        {
          "label": "1",
          "chorus": true,
          "lines": [
            "إليكم أرفعُ عيني",
            "إلى الجبالِ من أين يأتي العَوْن"
          ]
        },
        {
          "label": "2",
          "lines": [
            "إلهي يحفظُك من الشرّ",
            "يحفظُ من كلِّ مساوئ"
          ]
        },
        {
          "label": "3",
          "lines": [
            "الشمسُ لا تضرَمك ولا القمرُ",
            "من فوقِك يقعُ الضرُّ",
            "الربُّ يحفظُك من كلِّ شرٍّ"
          ]
        }
      ]
    },
    {
      "number": 4,
      "title": "ارحمني يا الله",
      "meter": "10.6.10.6",
      "chorus": "القرار",
      "verses": [
        {
          "label": "1",
          "chorus": true,
          "lines": [
            "ارحَمْني يا اللهُ حسبَ رحمتِك",
            "حسبَ كثرةِ رأفتِك امحُ معاصيَّ"
          ]
        },
        {
          "label": "2",
          "lines": [
            "أَكْرِمْني يا اللهُ بفمِكَ الصادق",
            "وتُقَطِّرْ ماءَ الرحمةِ على مَشاكي"
          ]
        },
        {
          "label": "3",
          "lines": [
            "أَحْطِفْ بالحقِّ معاصيَّ",
            "وتَطَهَّرْ من كلِّ آثام"
          ]
        }
      ]
    },
    {
      "number": 5,
      "title": "السماوات تروي",
      "meter": "8.8.8.8",
      "chorus": "القرار",
      "verses": [
        {
          "label": "1",
          "chorus": true,
          "lines": [
            "السَّماواتُ تُرْوي",
            "قَصْرَهُ العَدْلَ"
          ]
        },
        {
          "label": "2",
          "lines": [
            "أحكامُهُ على البَرايا",
            "رأسُهُ مَجْدُكَ"
          ]
        },
        {
          "label": "3",
          "lines": [
            "يومَ يُشْرِقُ شمسُهُ تذهبُ وراءَها",
            "وللجادةِ إِغَارٌ"
          ]
        }
      ]
    },
    {
      "number": 6,
      "title": "اللهم اقتدت",
      "meter": "8.7.8.7",
      "chorus": "القرار",
      "verses": [
        {
          "label": "1",
          "chorus": true,
          "lines": [
            "اللَّهُمَّ اقْتَدَمتَ ولن يزولَ",
            "إنَّ صِهْرَ المتقدِّمِ يثبت"
          ]
        },
        {
          "label": "2",
          "lines": [
            "وأنتَ سكنتَ من قَبْلُ",
            "من الأزلِ وإلى الأبد"
          ]
        },
        {
          "label": "3",
          "lines": [
            "فلا تَسَلَّكَ منكَ موتٌ ولا ضَيْع",
            "ولن يرى خَديٌّ عنك وفى"
          ]
        }
      ]
    },
    {
      "number": 7,
      "title": "أنت تعرفني",
      "meter": "8.8.8.8",
      "chorus": "القرار",
      "verses": [
        {
          "label": "1",
          "chorus": true,
          "lines": [
            "أنتَ تعرفُني",
            "تعرفُ مَضْجَعِي"
          ]
        },
        {
          "label": "2",
          "lines": [
            "تعرفُ قِفْلي وفكِّي",
            "تعرفُ طُرُقي كلَّها"
          ]
        },
        {
          "label": "3",
          "lines": [
            "أنتَ تعرفُ كلَّ أفكاري",
            "طُرُقي ليستْ عنكَ خفيَّة"
          ]
        }
      ]
    },
    {
      "number": 8,
      "title": "يا رب سيدنا",
      "meter": "8.7.8.7",
      "chorus": "القرار",
      "verses": [
        {
          "label": "1",
          "chorus": true,
          "lines": [
            "يا ربُّ سيّدُنا",
            "ما أحدَ مثلَك في الجميع"
          ]
        },
        {
          "label": "2",
          "lines": [
            "في الصَّلَواتِ يأخذُ بَرَكَتَهُ",
            "ومنْ بفمِكَ ينالُ القدرة"
          ]
        },
        {
          "label": "3",
          "lines": [
            "ملكٌ لا يُمسَكُ به ملكٌ",
            "يحكمُ بما شاءَ في أجيالِنا"
          ]
        }
      ]
    },
    {
      "number": 9,
      "title": "هللوا الله",
      "meter": "4.4.4.10",
      "chorus": "القرار",
      "verses": [
        {
          "label": "1",
          "chorus": true,
          "lines": [
            "هلِّلُوا اللهَ في تُرْبَتِه",
            "سبِّحُوه في بسطِ قُوَّتِه"
          ]
        },
        {
          "label": "2",
          "lines": [
            "سبِّحُوه لأجلِ عَظائِمِه",
            "لأنَّ عَظائِمَه عظيمةٌ جدًّا"
          ]
        },
        {
          "label": "3",
          "lines": [
            "هلِّلُوا اللهَ كلَّ ما ينفخُ به",
            "كلَّ ما يتنفَّسُ به"
          ]
        }
      ]
    },
    {
      "number": 10,
      "title": "إن كان لي إله",
      "meter": "8.7.8.7",
      "chorus": "القرار",
      "verses": [
        {
          "label": "1",
          "chorus": true,
          "lines": [
            "إنْ كانَ لي إلهٌ يُعْتَنى بي",
            "يسمعُ الربُّ صوتي"
          ]
        },
        {
          "label": "2",
          "lines": [
            "يحفظُني ويُميِّزُني",
            "من الضِّيقِ ينقذُني"
          ]
        },
        {
          "label": "3",
          "lines": [
            "ففيَّ يَسْرٌ وعَجائِبُه",
            "أقتربُ إلى اللهِ وأناجيه"
          ]
        }
      ]
    }
  ]
}
