{
  "hymns": [
    {
      "number": 318,
      "title": "قلبي هذا الأثيم حرره القدير",
      "verses": [
        {
          "label": "١",
          "lines": [
            "١ - قلبي هذا الأثيم حرره القدير",
            "أنار عقلي بضياء صليبه العظيم"
          ]
        },
        {
          "label": "٢",
          "lines": [
            "٢ - العالم حقير تركته وشهوته",
            "ليس فيه من رفيق فخره تعب وضيق"
          ]
        },
        {
          "label": "٣",
          "lines": [
            "٣ - إلهى العلى إنى أنا ملك لك",
            "لك قلبي على الدوام لك نفسي بالتمام"
          ]
        }
      ]
    }
  ]
}