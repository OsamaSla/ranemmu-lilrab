{
  "hymns": [
    {
      "number": 230,
      "title": "اتبعنى فى ذى الحياة إلى الأمام إلى الأمام",
      "meter": "",
      "book": "book3",
      "verses": [
        {
          "label": "١",
          "lines": [
            "١ - اتبعنى فى ذى الحياة · إلى الأمام ، إلى الأمام"
          ]
        },
        {
          "label": "القرار",
          "chorus": true,
          "lines": [
            "أتبــــعك ، أتبــــعك · ربى يســــوع أتبــــعك"
          ]
        },
        {
          "label": "٢",
          "lines": [
            "٢ - اتبعنى بلا ارتخاء · لا تلتـــــفت إلى الوراء"
          ]
        },
        {
          "label": "٣",
          "lines": [
            "٣ - اتبعنى كل الطريق · أنا لك دومــــاً رفــــيــــق"
          ]
        },
        {
          "label": "٤",
          "lines": [
            "٤ - كن أميناً للممات · أعطيك إكليل الحيــــاة"
          ]
        }
      ]
    }
  ]
}