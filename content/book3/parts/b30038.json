{
  "hymns": [
    {
      "number": 38,
      "title": "أحبك إذ قد سمعت صلاتي",
      "verses": [
        {
          "label": "١",
          "lines": [
            "أحبك إذ قد سمعت صلاتي · وكنت نجاتي كل حياتي",
            "هللويا مجداً لك"
          ]
        },
        {
          "label": "القرار",
          "chorus": true,
          "lines": [
            "دفعت ديوني، مسحت جفوني · أنرت عيوني بحب حنون",
            "مجداً لك مجداً لك",
            "سيشدوا لساني ومعه جناني · كل كياني وملء زماني",
            "تسبيحك تسبيحك"
          ]
        },
        {
          "label": "٢",
          "lines": [
            "أحبك إذ قد حللت قيودي · رفعت بنودي صرت وجودي",
            "هللويا مجداً لك"
          ]
        },
        {
          "label": "٣",
          "lines": [
            "أحبك إذ قد ملأتني نوراً · حمداً وسروراً حباً كثيراً",
            "هللويا مجداً لك"
          ]
        },
        {
          "label": "٤",
          "lines": [
            "لك أسكب قلبي حمداً وسجوداً · وطيباً مجيداً أبقى سعيداً",
            "هللويا مجداً لك"
          ]
        }
      ],
      "meter": "",
      "book": "book3"
    }
  ]
}