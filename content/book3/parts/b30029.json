{
  "hymns": [
    {
      "number": 29,
      "title": "يالعمق حب ربي ذاق عني موت الصليب",
      "verses": [
        {
          "label": "١",
          "lines": [
            "يالعمق حب ربي · ذاق عني موت الصليب",
            "فخلصني .. مطهراً قلبي",
            "ومن فرط حب ربي · ستر إثمي وعيبي",
            "هللويا قد محا ذنبي"
          ]
        },
        {
          "label": "القرار",
          "chorus": true,
          "lines": [
            "هللويا قد فداني · وبدمه اشتراني",
            "ومن كل إثم قد حررني",
            "سيكون لحن قلبي · المجد دوماً لربي",
            "هللويا قد محا ذنبي"
          ]
        },
        {
          "label": "٢",
          "lines": [
            "من عمق جب الخطية · إلى الراحة البهية",
            "قد رفعني .. مخلصاً نفسي",
            "من خطاياي العديدة · إلى الحياة الجديدة",
            "هللويا قد محا ذنبي"
          ]
        }
      ],
      "meter": "",
      "book": "book3"
    }
  ]
}