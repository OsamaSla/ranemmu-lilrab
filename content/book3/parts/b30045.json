{
  "hymns": [
    {
      "number": 45,
      "title": "مذ رأتك النفس طابت قد سباها حبك",
      "verses": [
        {
          "label": "١",
          "lines": [
            "مذ رأتك النفس طابت · قد سباها حبك",
            "وتجددت حياتي · عند قربك"
          ]
        },
        {
          "label": "القرار",
          "chorus": true,
          "lines": [
            "طبت نفساً يا يسوع · إذ تعرفت بك",
            "كل أيامي هناء · تحت ظلك"
          ]
        },
        {
          "label": "٢",
          "lines": [
            "جئتني أنعشت روحى · زدت ربى بهجتي",
            "فتأكدت نوالى · منك قوتي"
          ]
        }
      ],
      "meter": "",
      "book": "book3"
    }
  ]
}