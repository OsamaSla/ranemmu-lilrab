{
  "hymns": [
    {
      "number": 314,
      "title": "هل جلست فى هدوء ونظرت للعلاء",
      "verses": [
        {
          "label": "١",
          "lines": [
            "١ - هل جلست فى هدوء · ونظرت للعلاء",
            "وتأملت صليباً · بين أرض وسماء",
            "فوقه الحب تجلى · بجراح ودماء",
            "صافحاً عن صالحيه · بصلاة ودعاء"
          ]
        }
      ]
    }
  ]
}