{
  "hymns": [
    {
      "number": 358,
      "title": "أحبك ... بك ... نفسى تهتف أحبك",
      "verses": [
        {
          "label": "١",
          "lines": [
            "أحبك ... نفسى تهتف أحبك",
            "روحى تفرح بشخصك",
            "ربى إنى لك",
            "يا صخرتي ... فيك وحدك حمايتى",
            "شخصك ترسي وملجأى",
            "يدك تحيط بي"
          ]
        }
      ]
    }
  ]
}